---
import type { PublishedPowerRanking } from "../../lib/queries/powerRankings";
import ManagerLabel from "../teams/ManagerLabel.astro";

interface Props {
  ranking: PublishedPowerRanking | null;
  context?: "homepage" | "gazette";
}

const { ranking, context = "homepage" } = Astro.props;
const entries = ranking?.entries ?? [];
---

{
  ranking && entries.length > 0 && (
    <section
      class:list={["gazette-rankings", `gazette-rankings--${context}`]}
      aria-labelledby={`gazette-rankings-${context}-title`}
    >
      <header>
        <div>
          <p class="eyebrow">Editorial Agenda</p>
          <h2 id={`gazette-rankings-${context}-title`}>The Gazette Poll</h2>
        </div>
        <div class="gazette-rankings__edition">
          <strong>{ranking.seasonYear} · Week {ranking.week}</strong>
          <span>{ranking.title}</span>
        </div>
      </header>

      <div class="gazette-rankings__body">
        <ol aria-label={`${ranking.title} subjective power rankings`}>
          {entries.map((entry) => {
            const movement = entry.previousRank === null
              ? null
              : entry.previousRank - entry.rank;

            return (
              <li>
                <b>{entry.rank}</b>
                <div>
                  <strong>{entry.teamName}</strong>
                  <ManagerLabel teamName={entry.teamName} compact />
                  <span>{entry.note || entry.record}</span>
                </div>
                <small class:list={[movement && movement > 0 && "is-up", movement && movement < 0 && "is-down"]}>
                  {movement === null ? "NEW" : movement > 0 ? `▲ ${movement}` : movement < 0 ? `▼ ${Math.abs(movement)}` : "—"}
                </small>
              </li>
            );
          })}
        </ol>

        <aside>
          <p class="eyebrow">Numbers Optional</p>
          <h3>Ranked by instinct, grudges and editorial convenience.</h3>
          <p>
            The Gazette Poll is the publication’s deliberately subjective view
            of the league. Compare it with the computer model and decide which
            one is more wrong.
          </p>
          <a href="/rankings">Compare both polls <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </section>
  )
}

<style>
  .gazette-rankings{overflow:hidden;border:1px solid rgb(255 255 255 / 10%);border-radius:var(--radius-lg);background:radial-gradient(circle at top right,rgb(255 255 255 / 8%),transparent 24rem),#18231d;color:#f7f5ed}.gazette-rankings--homepage{margin-top:var(--space-7)}.gazette-rankings--gazette{margin-block:var(--space-7)}header{display:flex;align-items:end;justify-content:space-between;gap:var(--space-5);padding:clamp(1.4rem,4vw,2.5rem);border-bottom:1px solid rgb(255 255 255 / 13%)}header h2{margin:0;color:inherit;font-size:clamp(2.5rem,5vw,4.7rem);letter-spacing:-.055em;line-height:.9}.eyebrow{color:#d6bd77}.gazette-rankings__edition{display:grid;gap:.25rem;text-align:right}.gazette-rankings__edition strong{font-family:var(--font-data);font-size:.72rem;letter-spacing:.06em;text-transform:uppercase}.gazette-rankings__edition span{color:rgb(247 245 237 / 60%);font-family:var(--font-editorial)}.gazette-rankings__body{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(18rem,.65fr)}ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));padding:0;margin:0;list-style:none}li{display:grid;grid-template-columns:2.5rem minmax(0,1fr) auto;align-items:center;gap:.75rem;padding:1rem 1.2rem;border-right:1px solid rgb(255 255 255 / 10%);border-bottom:1px solid rgb(255 255 255 / 10%)}li b{font-family:var(--font-display);font-size:2rem;text-align:center}li div{display:grid;gap:.2rem;min-width:0}li div>strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}li div>span{overflow:hidden;color:rgb(247 245 237 / 58%);font-size:.72rem;text-overflow:ellipsis;white-space:nowrap}li small{color:rgb(247 245 237 / 48%);font-family:var(--font-data);font-size:.62rem;font-weight:800}.is-up{color:#9bc7a9}.is-down{color:#e69991}aside{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.5rem,4vw,3rem);background:rgb(255 255 255 / 4%)}aside h3{margin:.2rem 0 1rem;color:inherit;font-size:clamp(1.8rem,3vw,3rem);line-height:1}aside>p:not(.eyebrow){color:rgb(247 245 237 / 66%);font-family:var(--font-editorial);line-height:1.5}aside a{margin-top:1rem;color:#e2cc91;font-weight:800}@media(max-width:900px){.gazette-rankings__body{grid-template-columns:1fr}aside{border-top:1px solid rgb(255 255 255 / 13%)}}@media(max-width:650px){header{align-items:start;flex-direction:column}.gazette-rankings__edition{text-align:left}ol{grid-template-columns:1fr}}
</style>

---
import { generateHTML } from "@tiptap/html/server";
import { Mark, Node, mergeAttributes } from "@tiptap/core";
import StarterKit from "@tiptap/starter-kit";
import Link from "@tiptap/extension-link";
import TextAlign from "@tiptap/extension-text-align";
import type {
  RichTextDocument,
} from "../../lib/gazette/articleBody";

interface Props {
  body: RichTextDocument;
}

const { body } = Astro.props;

const UnderlineMark = Mark.create({
  name: "underline",
  parseHTML: () => [{ tag: "u" }],
  renderHTML: ({ HTMLAttributes }) => ["u", mergeAttributes(HTMLAttributes), 0],
});

function normalizeInlineImageWidth(value: unknown): string | null {
  const raw = String(value ?? "").trim().toLowerCase();

  if (!raw || raw === "auto") {
    return null;
  }

  const match = raw.match(/^(\d+(?:\.\d+)?)%?$/);
  const numeric = match ? Number(match[1]) : Number.NaN;

  return Number.isFinite(numeric) && numeric >= 25 && numeric <= 100
    ? `${numeric}%`
      : null;
}

function normalizeInlineImageAlignment(value: unknown): "left" | "center" | "right" {
  return value === "left" || value === "right" ? value : "center";
}

const InlineImage = Node.create({
  name: "image",
  group: "block",
  atom: true,
  addAttributes: () => ({
    src: { default: null },
    alt: { default: "" },
    title: { default: null },
    caption: { default: "" },
    width: { default: null },
    align: { default: "center" },
  }),
  parseHTML: () => [
    {
      tag: "figure[data-inline-image]",
      getAttrs: (dom) => {
        const figure = dom as HTMLElement;
        const image = figure.querySelector("img");
        return {
          src: image?.getAttribute("src"),
          alt: image?.getAttribute("alt") ?? "",
          title: image?.getAttribute("title"),
          caption: figure.querySelector("figcaption")?.textContent?.trim() ?? "",
          width: figure.getAttribute("data-image-width"),
          align: figure.getAttribute("data-image-align") ?? "center",
        };
      },
    },
    {
      tag: "img[src]",
      getAttrs: (dom) => {
        const image = dom as HTMLImageElement;
        return {
          src: image.getAttribute("src"),
          alt: image.getAttribute("alt") ?? "",
          title: image.getAttribute("title"),
          caption: "",
          width: image.getAttribute("data-image-width"),
          align: image.getAttribute("data-image-align") ?? "center",
        };
      },
    },
  ],
  renderHTML: ({ HTMLAttributes }) => {
    const { src, alt, title, caption, width: rawWidth, align: rawAlign } = HTMLAttributes;
    const width = normalizeInlineImageWidth(rawWidth);
    const align = normalizeInlineImageAlignment(rawAlign);
    return [
      "figure",
      {
        "data-inline-image": "true",
        "data-image-align": align,
        ...(width
          ? { "data-image-width": width, style: `width: ${width}` }
          : {}),
      },
      [
        "img",
        {
          src,
          alt: alt ?? "",
          ...(title ? { title } : {}),
          loading: "lazy",
        },
      ],
      ...(caption ? [["figcaption", {}, caption]] : []),
    ];
  },
});

const PullQuote = Node.create({
  name: "pullQuote",
  group: "block",
  content: "inline*",
  defining: true,
  parseHTML: () => [{ tag: "aside[data-pull-quote]" }],
  renderHTML: ({ HTMLAttributes }) => [
    "aside",
    mergeAttributes(HTMLAttributes, { "data-pull-quote": "true" }),
    0,
  ],
});

const html = generateHTML(body, [
  StarterKit.configure({
    heading: {
      levels: [2, 3],
    },
  }),

  Link.configure({
    openOnClick: false,
    HTMLAttributes: {
      rel: "noopener noreferrer",
    },
  }),
  TextAlign.configure({
    types: ["heading", "paragraph", "blockquote", "pullQuote"],
  }),
  UnderlineMark,
  InlineImage,
  PullQuote,
]);
---

<div class="article-rich-text" set:html={html} />

<style>
  .article-rich-text {
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .article-rich-text :global(p) {
    margin: 0 0 1.5em;
  }

  .article-rich-text :global(img) {
    display: block;
    width: min(100%, 56rem);
    height: auto;
    margin: 2rem auto;
    border-radius: var(--radius-md);
  }

  .article-rich-text :global(figure[data-inline-image]) {
    max-width: 100%;
    width: min(100%, 56rem);
    margin: 2rem auto;
  }

  .article-rich-text :global(figure[data-inline-image][data-image-align="left"]) {
    margin-left: 0;
    margin-right: auto;
  }

  .article-rich-text :global(figure[data-inline-image][data-image-align="right"]) {
    margin-left: auto;
    margin-right: 0;
  }

  .article-rich-text :global(figure[data-inline-image] img) {
    width: 100%;
    margin: 0;
  }

  .article-rich-text :global(figcaption) {
    margin-top: 0.55rem;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.68rem;
    letter-spacing: 0.025em;
    line-height: 1.45;
    text-align: center;
  }

  .article-rich-text :global(h2),
  .article-rich-text :global(h3) {
    color: var(--color-ink);
    font-family: var(--font-editorial);
    letter-spacing: -0.035em;
  }

  .article-rich-text :global(h2) {
    margin: 2em 0 0.65em;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
  }

  .article-rich-text :global(h3) {
    margin: 1.8em 0 0.65em;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    line-height: 1.15;
  }

  .article-rich-text :global(ul),
  .article-rich-text :global(ol) {
    margin: 0 0 1.5em;
    padding-left: 1.5em;
  }

  .article-rich-text :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.3em;
  }

  .article-rich-text :global(li p) {
    margin-bottom: 0.5em;
  }

  .article-rich-text :global(blockquote) {
    margin: 2em 0;
    padding: 0.25em 0 0.25em 1.25em;
    border-left: 4px solid var(--color-green);
    color: var(--color-ink);
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
    font-style: italic;
    line-height: 1.5;
  }

  .article-rich-text :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-rich-text :global(aside[data-pull-quote]) {
    margin: 2.5em 0;
    padding: 1.35rem 1.5rem 1.45rem;
    border-block: 3px double var(--color-green);
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
    text-align: center;
  }

  .article-rich-text :global(aside[data-pull-quote] p:last-child) {
    margin-bottom: 0;
  }

  .article-rich-text :global(a) {
    color: var(--color-green);
    font-weight: 650;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.15em;
  }

  .article-rich-text :global(strong) {
    color: var(--color-ink);
    font-weight: 750;
  }

  .article-rich-text :global(s) {
    text-decoration-thickness: 0.08em;
    text-decoration-color: var(--color-green);
  }

  .article-rich-text :global(code) {
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    font-family: var(--font-data);
    font-size: 0.88em;
  }

  .article-rich-text :global(pre) {
    overflow-x: auto;
    margin: 2em 0;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-ink);
    color: var(--color-paper-light);
  }

  .article-rich-text :global(pre code) {
    padding: 0;
    background: transparent;
    color: inherit;
  }

  .article-rich-text :global(hr) {
    width: min(10rem, 40%);
    margin: 3.5rem auto;
    border: 0;
    border-top: 3px double var(--color-rule-dark);
  }

  .article-rich-text
    :global(> p:first-child::first-letter) {
    float: left;
    margin-right: 0.12em;
    color: var(--color-green);
    font-family: var(--font-editorial);
    font-size: 4.8rem;
    font-weight: 700;
    line-height: 0.78;
  }

  @media (max-width: 600px) {
    .article-rich-text
      :global(> p:first-child::first-letter) {
      font-size: 4rem;
    }
  }
</style>

---
import type { HistoricalStanding } from "../lib/queries/standings";

interface Props {
  standings: HistoricalStanding[];
  compact?: boolean;
  limit?: number;
  caption?: string;
}

const {
  standings,
  compact = false,
  limit,
  caption = "League standings",
} = Astro.props;

const visibleStandings =
  typeof limit === "number"
    ? standings.slice(0, limit)
    : standings;

function formatPoints(value: number | null): string {
  return Number(value ?? 0).toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function formatRecord(team: HistoricalStanding): string {
  const record = `${team.wins ?? 0}-${team.losses ?? 0}`;

  return (team.ties ?? 0) > 0
    ? `${record}-${team.ties}`
    : record;
}
---

<div
  class:list={[
    "standings-table",
    compact && "standings-table--compact",
  ]}
>
  {
    visibleStandings.length > 0 ? (
      <div
        class="standings-table__scroll"
        role="region"
        aria-label={caption}
        tabindex="0"
      >
        <table>
          <caption class="sr-only">{caption}</caption>
          <thead>
            <tr>
              <th scope="col" class="standings-table__rank">Rank</th>
              <th scope="col">Team</th>
              <th scope="col" class="standings-table__record">Record</th>
              <th scope="col" class="standings-table__number">PF</th>

              {
                !compact && (
                  <>
                    <th scope="col" class="standings-table__number">
                      PA
                    </th>

                    <th scope="col" class="standings-table__number">
                      Diff.
                    </th>
                  </>
                )
              }
            </tr>
          </thead>

          <tbody>
            {
              visibleStandings.map((team) => {
                const differential = Number(
                  team.point_differential ?? 0
                );

                return (
                  <tr>
                    <td class="standings-table__rank">
                      <span class="standings-table__rank-number">
                        {team.standings_rank ?? "—"}
                      </span>
                    </td>

                    <td>
                      <span class="standings-table__team">
                        {team.team_name ?? "Unnamed Team"}
                      </span>
                    </td>

                    <td class="standings-table__record">
                      {formatRecord(team)}
                    </td>

                    <td class="standings-table__number">
                      {formatPoints(team.points_for)}
                    </td>

                    {
                      !compact && (
                        <>
                          <td class="standings-table__number">
                            {formatPoints(
                              team.points_against
                            )}
                          </td>

                          <td
                            class:list={[
                              "standings-table__number",
                              "standings-table__differential",
                              differential > 0 &&
                                "standings-table__differential--positive",
                              differential < 0 &&
                                "standings-table__differential--negative",
                            ]}
                          >
                            {differential > 0 ? "+" : ""}
                            {formatPoints(differential)}
                          </td>
                        </>
                      )
                    }
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    ) : (
      <div class="standings-table__empty">
        <p>No standings are available yet.</p>
      </div>
    )
  }
</div>

<style>
  .standings-table {
    min-width: 0;
  }

  .standings-table__scroll {
    overflow-x: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    color: var(--color-ink);
  }

  th,
  td {
    padding: 1rem 0.85rem;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: middle;
  }

  th {
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.3;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
  }

  td {
    font-size: var(--text-sm);
  }

  tbody tr {
    transition: background-color var(--transition-fast);
  }

  tbody tr:hover {
    background: var(--color-green-faint);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  .standings-table__rank {
    width: 4.75rem;
    text-align: center;
  }

  .standings-table__rank-number {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-ink-soft);
    font-family: var(--font-data);
    font-size: 0.7rem;
    font-weight: 600;
  }

  tbody tr:first-child .standings-table__rank-number {
    border-color: var(--color-green);
    background: var(--color-green);
    color: var(--color-paper-light);
  }

  .standings-table__team {
    display: block;
    min-width: 12rem;
    font-family: var(--font-editorial);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .standings-table__record,
  .standings-table__number {
    font-family: var(--font-data);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .standings-table__record {
    text-align: center;
  }

  .standings-table__number {
    text-align: right;
  }

  .standings-table__differential {
    font-weight: 600;
  }

  .standings-table__differential--positive {
    color: var(--color-green);
  }

  .standings-table__differential--negative {
    color: var(--color-danger, #9f2f2f);
  }

  .standings-table__empty {
    padding: var(--space-7);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .standings-table__empty p {
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-editorial);
    font-size: var(--text-lg);
  }

  .standings-table--compact th,
  .standings-table--compact td {
    padding-block: 0.8rem;
  }

  .standings-table--compact .standings-table__rank {
    width: 3.5rem;
  }

  .standings-table--compact
    .standings-table__rank-number {
    width: 1.75rem;
    height: 1.75rem;
  }

  .standings-table--compact .standings-table__team {
    min-width: 9rem;
    font-size: 1rem;
  }

  @media (max-width: 620px) {
    th,
    td {
      padding-inline: 0.6rem;
    }

    .standings-table__rank {
      width: 3.75rem;
    }

    .standings-table__team {
      min-width: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    tbody tr {
      transition: none;
    }
  }
</style>

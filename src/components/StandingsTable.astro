---
import type { SeasonStanding } from "../lib/queries/standings";

interface Props {
  standings: SeasonStanding[];
  compact?: boolean;
}

const {
  standings,
  compact = false,
} = Astro.props;
---

<div
  class:list={[
    "standings-table",
    compact && "standings-table--compact",
  ]}
>
  <table class="w-full border-collapse text-left">
    <thead>
      <tr class="border-b border-slate-300 text-sm uppercase tracking-wide text-slate-500">
        <th class="px-3 py-3">Rank</th>
        <th class="px-3 py-3">Team</th>
        <th class="px-3 py-3 text-center">Record</th>
        <th class="px-3 py-3 text-right">PF</th>
        <th class="px-3 py-3 text-right">PA</th>
        <th class="px-3 py-3 text-right">Diff.</th>
      </tr>
    </thead>

    <tbody>
      {
        standings.map((team) => {
          const differential = Number(team.point_differential ?? 0);

          return (
            <tr class="border-b border-slate-200 last:border-0">
              <td class="px-3 py-4 font-semibold">
                {team.standings_rank ?? "—"}
              </td>

              <td class="px-3 py-4 font-semibold">
                {team.team_name ?? "Unnamed Team"}
              </td>

              <td class="px-3 py-4 text-center tabular-nums">
                {team.wins ?? 0}-{team.losses ?? 0}
                {(team.ties ?? 0) > 0 ? `-${team.ties}` : ""}
              </td>

              <td class="px-3 py-4 text-right tabular-nums">
                {Number(team.points_for ?? 0).toFixed(2)}
              </td>

              <td class="px-3 py-4 text-right tabular-nums">
                {Number(team.points_against ?? 0).toFixed(2)}
              </td>

              <td
                class:list={[
                  "px-3 py-4 text-right font-semibold tabular-nums",
                  differential > 0 && "text-emerald-700",
                  differential < 0 && "text-red-700",
                ]}
              >
                {differential > 0 ? "+" : ""}
                {differential.toFixed(2)}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
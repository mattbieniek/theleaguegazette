---
import type { RosterPlayer } from "../../lib/queries/rosters";

interface Props {
  player: RosterPlayer;
}

const { player } = Astro.props;

const availability = player.isReserve
  ? "Reserve"
  : player.isTaxi
    ? "Taxi"
    : player.injuryStatus
      ? player.injuryStatus
      : player.isStarter
        ? "Starter"
        : "Active";

const showAvailability = availability !== "Active";
---

<article class:list={["player-card", player.isReserve && "player-card--reserve"]}>
  <div class="player-card__position" aria-label={`Position ${player.position}`}>
    {player.position}
  </div>

  <div class="player-card__identity">
    <p>{player.name}</p>
    <span>
      {player.nflTeam ?? "FA"}
      {player.jerseyNumber !== null ? ` · No. ${player.jerseyNumber}` : ""}
    </span>
  </div>

  {showAvailability && (
    <span class:list={["player-card__status", player.injuryStatus && "is-injured"]}>
      {availability}
    </span>
  )}

  <dl>
    <div><dt>Age</dt><dd>{player.age ?? "—"}</dd></div>
    <div><dt>Exp.</dt><dd>{player.yearsExperience !== null ? `${player.yearsExperience} yr` : "—"}</dd></div>
  </dl>
</article>

<style>
  .player-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-4);
    min-width: 0;
    min-height: 5.5rem;
    padding: var(--space-3) var(--space-5);
    border-left: 3px solid var(--team-color, var(--color-green));
    background: var(--color-surface);
  }

  .player-card--reserve { opacity: 0.78; }

  .player-card__position {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--team-color, var(--color-green)) 35%, var(--color-rule));
    border-radius: 50%;
    color: var(--team-color, var(--color-green));
    font-family: var(--font-data);
    font-size: 0.63rem;
    font-weight: 700;
  }

  .player-card__identity { min-width: 0; }
  .player-card__identity p {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .player-card__identity span {
    display: block;
    margin-top: 0.35rem;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.57rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .player-card__status {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.55rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .player-card__status.is-injured { border-color: #a76a31; color: #8b5525; }

  .player-card dl { display: grid; grid-template-columns: repeat(2, auto); gap: var(--space-4); margin: 0; }
  .player-card dl div { min-width: 2.5rem; }
  .player-card dt,.player-card dd { margin: 0; font-family: var(--font-data); }
  .player-card dt { margin-bottom: 0.25rem; color: var(--color-ink-muted); font-size: 0.5rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .player-card dd { color: var(--color-ink-soft); font-size: 0.66rem; font-variant-numeric: tabular-nums; }

  @media (max-width: 580px) {
    .player-card { grid-template-columns: 2.7rem minmax(0, 1fr) auto; padding-inline: var(--space-4); }
    .player-card dl { display: none; }
  }
  @media (max-width: 420px) {
    .player-card { grid-template-columns: 2.7rem minmax(0, 1fr); }
    .player-card__status { grid-column: 2; justify-self: start; }
  }
</style>

---
import type {
  MatchupTeam,
  WeeklyMatchup,
} from "../../lib/queries/matchups";
import {
  teams as leagueTeams,
  type Team,
} from "../../data/teams";

interface Props {
  matchup: WeeklyMatchup;
}

const { matchup } = Astro.props;

function normalizeName(value: string): string {
  return value.trim().toLowerCase();
}

function getTeamProfile(
  team: MatchupTeam
): Team | null {
  return (
    leagueTeams.find(
      (leagueTeam) =>
        normalizeName(leagueTeam.name) ===
        normalizeName(team.teamName)
    ) ?? null
  );
}

function formatPoints(
  value: number | null
): string {
  if (value === null) {
    return "—";
  }

  return value.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function getResultLabel(
  team: MatchupTeam
): string {
  if (team.isTie) {
    return "Tie";
  }

  if (team.isWinner) {
    return "Winner";
  }

  if (team.result?.toLowerCase() === "loss") {
    return "Final";
  }

  return "Team";
}

const firstTeam = matchup.teams[0];
const secondTeam = matchup.teams[1];

const firstProfile = getTeamProfile(firstTeam);
const secondProfile = getTeamProfile(secondTeam);

const scoresAvailable =
  firstTeam.points !== null &&
  secondTeam.points !== null;

const isTie =
  firstTeam.isTie ||
  secondTeam.isTie ||
  (
    scoresAvailable &&
    firstTeam.points === secondTeam.points
  );
---

<article
  class:list={[
    "matchup-card",
    isTie && "matchup-card--tie",
  ]}
>
  <div class="matchup-card__status">
    <span>
      {scoresAvailable ? "Final" : "Scheduled"}
    </span>

    {
      isTie && (
        <span class="matchup-card__tie">
          Tie
        </span>
      )
    }
  </div>

  <div class="matchup-card__teams">
    {
      matchup.teams.map((team) => {
        const profile = getTeamProfile(team);

        return (
          <section
            class:list={[
              "matchup-team",
              team.isWinner &&
                "matchup-team--winner",
            ]}
          >
            <div class="matchup-team__result">
              {getResultLabel(team)}
            </div>

            <div class="matchup-team__identity">
              <div
                class="matchup-team__logo-wrap"
                style={
                  profile
                    ? `--team-color: ${profile.primary};`
                    : undefined
                }
              >
                {
                  profile ? (
                    <img
                      src={profile.logo}
                      alt={`${profile.name} logo`}
                      width="96"
                      height="96"
                      loading="lazy"
                    />
                  ) : (
                    <span aria-hidden="true">
                      {team.teamName
                        .charAt(0)
                        .toUpperCase()}
                    </span>
                  )
                }
              </div>

              <div class="matchup-team__copy">
                {
                  profile ? (
                    <a
                      class="matchup-team__name"
                      href={`/teams/${profile.slug}`}
                    >
                      {team.teamName}
                    </a>
                  ) : (
                    <p class="matchup-team__name">
                      {team.teamName}
                    </p>
                  )
                }

                {
                  profile && (
                    <p class="matchup-team__owner">
                      {profile.owner}
                    </p>
                  )
                }
              </div>
            </div>

            <p class="matchup-team__score">
              {formatPoints(team.points)}
            </p>
          </section>
        );
      })
    }
  </div>

  <dl class="matchup-card__details">
    <div>
      <dt>
        {firstProfile?.name ?? firstTeam.teamName}
        {" "}starters
      </dt>

      <dd>
        {formatPoints(firstTeam.startersPoints)}
      </dd>
    </div>

    <div>
      <dt>
        Margin
      </dt>

      <dd>
        {
          scoresAvailable
            ? formatPoints(
                Math.abs(
                  Number(firstTeam.points) -
                  Number(secondTeam.points)
                )
              )
            : "—"
        }
      </dd>
    </div>

    <div>
      <dt>
        {secondProfile?.name ?? secondTeam.teamName}
        {" "}starters
      </dt>

      <dd>
        {formatPoints(secondTeam.startersPoints)}
      </dd>
    </div>
  </dl>
</article>

<style>
  .matchup-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color var(--transition-standard),
      box-shadow var(--transition-standard),
      transform var(--transition-standard);
  }

  .matchup-card:hover {
    border-color: var(--color-rule-dark);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .matchup-card__status {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-inline:
      clamp(1.15rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
  }

  .matchup-card__tie {
    color: var(--color-green);
  }

  .matchup-card__teams {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
  }

  .matchup-team {
    position: relative;
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .matchup-team + .matchup-team {
    border-left: 1px solid var(--color-rule);
    text-align: right;
  }

  .matchup-team--winner {
    background:
      linear-gradient(
        145deg,
        var(--color-green-faint),
        transparent 68%
      );
  }

  .matchup-team__result {
    margin-bottom: var(--space-4);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .matchup-team--winner
    .matchup-team__result {
    color: var(--color-green);
  }

  .matchup-team__identity {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-4);
  }

  .matchup-team
    + .matchup-team
    .matchup-team__identity {
    flex-direction: row-reverse;
  }

  .matchup-team__logo-wrap {
    display: grid;
    width: clamp(3.8rem, 7vw, 5.25rem);
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid
      color-mix(
        in srgb,
        var(--team-color, var(--color-green)) 30%,
        var(--color-rule)
      );
    border-radius: 50%;
    background: var(--color-paper-light);
    color: var(--color-green);
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .matchup-team__logo-wrap img {
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .matchup-team__copy {
    min-width: 0;
  }

  .matchup-team__name {
    display: block;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 2.6vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
    overflow-wrap: anywhere;
    transition: color var(--transition-fast);
  }

  a.matchup-team__name:hover {
    color: var(--color-green);
  }

  .matchup-team__owner {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.59rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .matchup-team__score {
    margin: var(--space-5) 0 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .matchup-team--winner
    .matchup-team__score {
    color: var(--color-green);
  }

  .matchup-card__details {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }

  .matchup-card__details > div {
    min-width: 0;
    padding: 0.9rem
      clamp(1rem, 2.5vw, 1.5rem);
  }

  .matchup-card__details > div + div {
    border-left: 1px solid var(--color-rule);
  }

  .matchup-card__details > div:last-child {
    text-align: right;
  }

  .matchup-card__details dt {
    overflow: hidden;
    margin-bottom: var(--space-1);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    line-height: 1.35;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .matchup-card__details dd {
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-data);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 620px) {
    .matchup-card__teams {
      grid-template-columns: 1fr;
    }

    .matchup-team + .matchup-team {
      border-top: 1px solid var(--color-rule);
      border-left: 0;
      text-align: left;
    }

    .matchup-team
      + .matchup-team
      .matchup-team__identity {
      flex-direction: row;
    }

    .matchup-card__details {
      grid-template-columns: 1fr;
    }

    .matchup-card__details > div + div {
      border-top: 1px solid var(--color-rule);
      border-left: 0;
    }

    .matchup-card__details > div:last-child {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .matchup-card {
      transition: none;
    }

    .matchup-card:hover {
      transform: none;
    }
  }
</style>
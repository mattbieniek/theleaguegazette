---
import type {
  MatchupPlayer,
  MatchupTeam,
  WeeklyMatchup,
} from "../../lib/queries/matchups";
import {
  findTeamByName,
  type Team,
} from "../../data/teams";

interface Props {
  matchup: WeeklyMatchup;
  showPlayerStatuses?: boolean;
}

const { matchup, showPlayerStatuses = false } = Astro.props;

function getTeamProfile(
  team: MatchupTeam
): Team | null {
  return findTeamByName(team.teamName);
}

function formatPoints(
  value: number | null
): string {
  if (value === null) {
    return "—";
  }

  return value.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}

function getResultLabel(
  team: MatchupTeam
): string {
  if (team.isTie) {
    return "Tie";
  }

  if (team.isWinner) {
    return "Winner";
  }

  if (team.result?.toLowerCase() === "loss") {
    return "Final";
  }

  return "Team";
}

function getPlayerStatus(player: MatchupPlayer): string | null {
  const rosterStatus = player.status?.trim();
  if (rosterStatus && rosterStatus.toLowerCase() !== "active") {
    return rosterStatus;
  }

  return player.injuryStatus?.trim() || null;
}

const firstTeam = matchup.teams[0];
const secondTeam = matchup.teams[1];

const scoresAvailable =
  firstTeam.points !== null &&
  secondTeam.points !== null;

const isTie =
  firstTeam.isTie ||
  secondTeam.isTie ||
  (
    scoresAvailable &&
    firstTeam.points === secondTeam.points
  );
---

<article
  class:list={[
    "matchup-card",
    isTie && "matchup-card--tie",
  ]}
>
  <div class="matchup-card__status">
    <span>
      {scoresAvailable ? "Final" : "Scheduled"}
    </span>

    {
      isTie && (
        <span class="matchup-card__tie">
          Tie
        </span>
      )
    }
  </div>

  <div class="matchup-card__teams">
    {
      matchup.teams.map((team) => {
        const profile = getTeamProfile(team);

        return (
          <section
            class:list={[
              "matchup-team",
              team.isWinner &&
                "matchup-team--winner",
            ]}
          >
            <div class="matchup-team__result">
              {getResultLabel(team)}
            </div>

            <div class="matchup-team__identity">
              <div
                class="matchup-team__logo-wrap"
                style={
                  profile
                    ? `--team-color: ${profile.primary};`
                    : undefined
                }
              >
                {
                  profile ? (
                    <img
                      src={profile.logo}
                      alt={`${profile.name} logo`}
                      width="96"
                      height="96"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span aria-hidden="true">
                      {team.teamName
                        .charAt(0)
                        .toUpperCase()}
                    </span>
                  )
                }
              </div>

              <div class="matchup-team__copy">
                {
                  profile ? (
                    <a
                      class="matchup-team__name"
                      href={`/teams/${profile.slug}`}
                    >
                      {team.teamName}
                    </a>
                  ) : (
                    <p class="matchup-team__name">
                      {team.teamName}
                    </p>
                  )
                }

                {
                  profile && (
                    <p class="matchup-team__owner">
                      Manager · {profile.owner}
                    </p>
                  )
                }
              </div>
            </div>

            <p class="matchup-team__score">
              {formatPoints(team.points)}
            </p>
          </section>
        );
      })
    }
  </div>

  <dl class="matchup-card__details">
    <div>
      <dt>
        {firstTeam.teamName}
        {" "}starters
      </dt>

      <dd>
        {formatPoints(firstTeam.startersPoints)}
      </dd>
    </div>

    <div>
      <dt>
        Margin
      </dt>

      <dd>
        {
          scoresAvailable
            ? formatPoints(
                Math.abs(
                  Number(firstTeam.points) -
                  Number(secondTeam.points)
                )
              )
            : "—"
        }
      </dd>
    </div>

    <div>
      <dt>
        {secondTeam.teamName}
        {" "}starters
      </dt>

      <dd>
        {formatPoints(secondTeam.startersPoints)}
      </dd>
    </div>
  </dl>

  <details class="matchup-card__lineups">
    <summary>
      <span>View weekly lineups</span>
      <span class="matchup-card__lineup-hint">Starters, bench and player scoring</span>
    </summary>
    <div class="lineup-comparison">
      {
        matchup.teams.map((team) => (
          <section class="lineup-team">
            <header>
              <div>
                <p>Week {matchup.week} roster</p>
                <h3>{team.teamName}</h3>
              </div>
              <strong>{formatPoints(team.points)}</strong>
            </header>
            {team.lineup.length ? (
              <div class="lineup-team__players">
                {team.lineup.map((player, index) => {
                  const previousPlayer = team.lineup[index - 1];
                  const startsBench = !player.isStarter && previousPlayer?.isStarter;
                  const playerStatus = showPlayerStatuses ? getPlayerStatus(player) : null;
                  return (
                    <>
                      {startsBench && <p class="lineup-team__divider">Bench</p>}
                      <div class:list={["lineup-player", !player.isStarter && "lineup-player--bench"]}>
                        <span class="lineup-player__position">{player.position}</span>
                        <span class="lineup-player__name">
                          {player.name}
                          {player.nflTeam && <small>{player.nflTeam}</small>}
                          {playerStatus && <em class="lineup-player__status">{playerStatus}</em>}
                        </span>
                        <strong>{formatPoints(player.points)}</strong>
                      </div>
                    </>
                  );
                })}
              </div>
            ) : (
              <p class="lineup-team__empty">Player-level scoring is not available for this imported week.</p>
            )}
          </section>
        ))
      }
    </div>
  </details>
</article>

<style>
  .matchup-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition:
      border-color var(--transition-standard),
      box-shadow var(--transition-standard),
      transform var(--transition-standard);
  }

  .matchup-card:hover {
    border-color: var(--color-rule-dark);
    box-shadow: var(--shadow-card);
    transform: translateY(-2px);
  }

  .matchup-card__status {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-inline:
      clamp(1.15rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.61rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1;
    text-transform: uppercase;
  }

  .matchup-card__tie {
    color: var(--color-green);
  }

  .matchup-card__teams {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
  }

  .matchup-team {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .matchup-team + .matchup-team {
    border-left: 1px solid var(--color-rule);
    text-align: right;
  }

  .matchup-team--winner {
    background:
      linear-gradient(
        145deg,
        var(--color-green-faint),
        transparent 68%
      );
  }

  .matchup-team__result {
    margin-bottom: var(--space-4);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .matchup-team--winner
    .matchup-team__result {
    color: var(--color-green);
  }

  .matchup-team__identity {
    display: flex;
    min-width: 0;
    min-height: 10.5rem;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .matchup-team
    + .matchup-team
    .matchup-team__identity {
    flex-direction: row-reverse;
  }

  .matchup-team__logo-wrap {
    display: grid;
    width: clamp(3.8rem, 7vw, 5.25rem);
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid
      color-mix(
        in srgb,
        var(--team-color, var(--color-green)) 30%,
        var(--color-rule)
      );
    border-radius: 50%;
    background: var(--color-paper-light);
    color: var(--color-green);
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .matchup-team__logo-wrap img {
    width: 76%;
    height: 76%;
    object-fit: contain;
  }

  .matchup-team__copy {
    min-width: 0;
  }

  .matchup-team__name {
    display: block;
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 2.6vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
    overflow-wrap: anywhere;
    transition: color var(--transition-fast);
  }

  a.matchup-team__name:hover {
    color: var(--color-green);
  }

  .matchup-team__owner {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.59rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .matchup-team__score {
    margin: auto 0 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .matchup-team--winner
    .matchup-team__score {
    color: var(--color-green);
  }

  .matchup-card__details {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }

  .matchup-card__details > div {
    min-width: 0;
    padding: 0.9rem
      clamp(1rem, 2.5vw, 1.5rem);
  }

  .matchup-card__details > div + div {
    border-left: 1px solid var(--color-rule);
  }

  .matchup-card__details > div:last-child {
    text-align: right;
  }

  .matchup-card__details dt {
    overflow: hidden;
    margin-bottom: var(--space-1);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    line-height: 1.35;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .matchup-card__details dd {
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-data);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .matchup-card__lineups {
    border-top: 1px solid var(--color-rule);
  }

  .matchup-card__lineups summary {
    display: flex;
    min-height: 3.4rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.9rem clamp(1rem, 2.5vw, 1.5rem);
    color: var(--color-green);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
  }

  .matchup-card__lineups summary::-webkit-details-marker { display: none; }
  .matchup-card__lineups summary::after { content: "+"; font: 700 1.2rem/1 var(--font-data); }
  .matchup-card__lineups[open] summary::after { content: "−"; }
  .matchup-card__lineups[open] summary { border-bottom: 1px solid var(--color-rule); background: var(--color-green-faint); }
  .matchup-card__lineup-hint { color: var(--color-ink-muted); font-size: 0.56rem; font-weight: 500; }

  .lineup-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lineup-team { min-width: 0; }
  .lineup-team + .lineup-team { border-left: 1px solid var(--color-rule); }
  .lineup-team header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-3); padding: 1rem 1.15rem; background: var(--color-paper-light); border-bottom: 1px solid var(--color-rule); }
  .lineup-team header p { margin: 0 0 .2rem; color: var(--color-ink-muted); font-family: var(--font-data); font-size: .54rem; letter-spacing: .06em; text-transform: uppercase; }
  .lineup-team h3 { margin: 0; font-family: var(--font-editorial); font-size: 1rem; line-height: 1.05; }
  .lineup-team header strong { color: var(--color-green); font-family: var(--font-data); font-size: .75rem; font-variant-numeric: tabular-nums; }
  .lineup-team__players { padding: .45rem 1.15rem 1rem; }
  .lineup-player { display: grid; grid-template-columns: 2.2rem minmax(0, 1fr) auto; gap: .55rem; align-items: center; min-height: 2.4rem; border-bottom: 1px solid color-mix(in srgb, var(--color-rule) 65%, transparent); }
  .lineup-player__position { color: var(--color-gold-dark); font-family: var(--font-data); font-size: .59rem; font-weight: 700; }
  .lineup-player__name { min-width: 0; font-size: .75rem; font-weight: 650; overflow-wrap: anywhere; }
  .lineup-player__name small { margin-left: .35rem; color: var(--color-ink-muted); font-family: var(--font-data); font-size: .52rem; font-weight: 400; }
  .lineup-player__status { display: inline-block; margin-left: .4rem; padding: .16rem .35rem; border: 1px solid #c58b3f; border-radius: 999px; color: #8b5525; font-family: var(--font-data); font-size: .48rem; font-style: normal; font-weight: 750; letter-spacing: .04em; line-height: 1.1; text-transform: uppercase; vertical-align: .08rem; }
  .lineup-player > strong { font-family: var(--font-data); font-size: .67rem; font-variant-numeric: tabular-nums; }
  .lineup-player--bench { color: var(--color-ink-muted); }
  .lineup-team__divider { margin: .8rem 0 .2rem; color: var(--color-ink-muted); font-family: var(--font-data); font-size: .52rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .lineup-team__empty { margin: 0; padding: 1.5rem 1.15rem; color: var(--color-ink-muted); font-size: .78rem; line-height: 1.5; }

  @media (max-width: 620px) {
    .matchup-card__teams {
      grid-template-columns: 1fr;
    }

    .matchup-team + .matchup-team {
      border-top: 1px solid var(--color-rule);
      border-left: 0;
      text-align: left;
    }

    .matchup-team {
      display: block;
    }

    .matchup-team__identity {
      min-height: 0;
      align-items: center;
    }

    .matchup-team__score {
      margin: var(--space-5) 0 0;
    }

    .matchup-team
      + .matchup-team
      .matchup-team__identity {
      flex-direction: row;
    }

    .matchup-card__details {
      grid-template-columns: 1fr;
    }

    .matchup-card__details > div + div {
      border-top: 1px solid var(--color-rule);
      border-left: 0;
    }

    .matchup-card__details > div:last-child {
      text-align: left;
    }

    .matchup-card__lineup-hint { display: none; }
    .lineup-comparison { grid-template-columns: 1fr; }
    .lineup-team + .lineup-team { border-top: 1px solid var(--color-rule-dark); border-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .matchup-card {
      transition: none;
    }

    .matchup-card:hover {
      transform: none;
    }
  }
</style>

---
import type { GazetteArticleSummary } from "../../lib/queries/gazette";
import { formatPublicationDate } from "../../lib/formatDate";

interface Props {
  story: GazetteArticleSummary;
  position?: number;
}

const {
  story,
  position,
} = Astro.props;
---

<article class="secondary-story">
  <a
    class="secondary-story__image-link"
    href={`/gazette/${story.slug}`}
    aria-label={`Read ${story.headline}`}
  >
    <div class="secondary-story__image-frame">
      <img
        class="secondary-story__image"
        src={
          story.image_url ??
          "/images/gazette/article-placeholder.webp"
        }
        alt={story.image_alt ?? ""}
        width="1000"
        height="700"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>

  <div class="secondary-story__content">
    <div class="secondary-story__category">
      <p class="eyebrow">{story.category}</p>

      {
        typeof position === "number" && (
          <span aria-hidden="true">
            {String(position).padStart(2, "0")}
          </span>
        )
      }
    </div>

    <h2 class="secondary-story__headline">
      <a href={`/gazette/${story.slug}`}>
        {story.headline}
      </a>
    </h2>

    {
      story.summary && (
        <p class="secondary-story__summary">
          {story.summary}
        </p>
      )
    }

    <div class="secondary-story__footer">
      <p class="secondary-story__meta">
        <span>{story.author_name}</span>

        {
          story.published_at && (
            <>
              <span aria-hidden="true">·</span>

              <time datetime={story.published_at}>
                {formatPublicationDate(story.published_at)}
              </time>
            </>
          )
        }
      </p>

      <a
        class="secondary-story__link"
        href={`/gazette/${story.slug}`}
        aria-label={`Read ${story.headline}`}
      >
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .secondary-story {
    display: grid;
    grid-template-columns:
      minmax(9rem, 0.78fr)
      minmax(0, 1.22fr);
    gap: clamp(1.15rem, 2.5vw, 1.75rem);
    align-items: start;
    min-width: 0;
  }

  .secondary-story__image-link {
    display: block;
    min-width: 0;
  }

  .secondary-story__image-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    background: var(--color-surface-muted);
  }

  .secondary-story__image-frame::after {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(23 32 27 / 12%);
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }

  .secondary-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-standard);
  }

  .secondary-story__image-link:hover .secondary-story__image {
    transform: scale(1.025);
  }

  .secondary-story__content {
    min-width: 0;
  }

  .secondary-story__category {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .secondary-story__category .eyebrow {
    margin-bottom: var(--space-2);
  }

  .secondary-story__category > span {
    color: var(--color-ink-faint);
    font-family: var(--font-data);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .secondary-story__headline {
    margin-bottom: var(--space-3);
    font-size: clamp(1.65rem, 2.5vw, 2.3rem);
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .secondary-story__headline a {
    transition: color var(--transition-fast);
  }

  .secondary-story__headline a:hover {
    color: var(--color-green);
  }

  .secondary-story__summary {
    display: -webkit-box;
    margin-bottom: var(--space-4);
    overflow: hidden;
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: var(--text-base);
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .secondary-story__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
  }

  .secondary-story__meta {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.62rem;
    letter-spacing: 0.03em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .secondary-story__link {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-green);
    font-weight: 700;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .secondary-story__link:hover {
    border-color: var(--color-green);
    background: var(--color-green);
    color: var(--color-paper-light);
    transform: translateX(2px);
  }

  @media (max-width: 1100px) {
    .secondary-story {
      grid-template-columns:
        minmax(8rem, 0.65fr)
        minmax(0, 1.35fr);
    }

    .secondary-story__summary {
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 720px) {
    .secondary-story {
      grid-template-columns:
        minmax(7.5rem, 0.65fr)
        minmax(0, 1.35fr);
    }
  }

  @media (max-width: 480px) {
    .secondary-story {
      grid-template-columns: 1fr;
    }

    .secondary-story__image-frame {
      aspect-ratio: 16 / 9;
    }

    .secondary-story__summary {
      -webkit-line-clamp: 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .secondary-story__image,
    .secondary-story__link {
      transition: none;
    }

    .secondary-story__image-link:hover .secondary-story__image {
      transform: none;
    }

    .secondary-story__link:hover {
      transform: none;
    }
  }
</style>

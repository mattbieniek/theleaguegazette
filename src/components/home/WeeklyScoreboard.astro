---
import type {
  MatchupTeam,
  MatchupWeek,
  WeeklyMatchup,
} from "../../lib/queries/matchups";
import { teams, type Team } from "../../data/teams";

interface Props {
  matchupWeek: MatchupWeek | null;
}

const { matchupWeek } = Astro.props;

function normalizeName(value: string): string {
  return value.trim().toLowerCase();
}

function getTeam(team: MatchupTeam): Team | null {
  return teams.find((profile) =>
    [profile.name, profile.legacyName].some(
      (name) => normalizeName(name) === normalizeName(team.teamName)
    )
  ) ?? null;
}

function formatPoints(value: number | null): string {
  return value === null
    ? "—"
    : value.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
}

function matchupMargin(matchup: WeeklyMatchup): number | null {
  const [first, second] = matchup.teams;
  return first.points === null || second.points === null
    ? null
    : Math.abs(first.points - second.points);
}

function orderedTeams(matchup: WeeklyMatchup): [MatchupTeam, MatchupTeam] {
  const [first, second] = matchup.teams;
  if (second.isWinner && !first.isWinner) return [second, first];
  return [first, second];
}

const completedMatchups = matchupWeek?.matchups.filter(
  (matchup) => matchupMargin(matchup) !== null
) ?? [];

const featuredMatchup = completedMatchups.reduce<WeeklyMatchup | null>(
  (closest, matchup) => {
    if (!closest) return matchup;
    return Number(matchupMargin(matchup)) < Number(matchupMargin(closest))
      ? matchup
      : closest;
  },
  null
) ?? matchupWeek?.matchups[0] ?? null;

const remainingMatchups = matchupWeek?.matchups.filter(
  (matchup) => matchup.id !== featuredMatchup?.id
) ?? [];

const featuredTeams = featuredMatchup
  ? orderedTeams(featuredMatchup)
  : null;
---

{matchupWeek && featuredMatchup && featuredTeams && (
  <section class="weekly-scoreboard" aria-labelledby="weekly-scoreboard-title">
    <header class="weekly-scoreboard__heading">
      <div>
        <p class="eyebrow">
          {matchupWeek.seasonYear ? `${matchupWeek.seasonYear} Scoreboard` : "League Scoreboard"}
        </p>
        <h2 id="weekly-scoreboard-title">Week {matchupWeek.week}</h2>
      </div>

      <div class="weekly-scoreboard__intro">
        <p>
          {matchupWeek.matchups.length} completed {matchupWeek.matchups.length === 1 ? "matchup" : "matchups"}
          {" "}from the latest full league slate.
        </p>
        <a href={`/matchups?week=${matchupWeek.week}`}>
          Full week coverage <span aria-hidden="true">→</span>
        </a>
      </div>
    </header>

    <div class="weekly-scoreboard__layout">
      <article class="featured-matchup">
        <div class="featured-matchup__topline">
          <span>Game of the Week</span>
          <span>
            {matchupMargin(featuredMatchup) === null
              ? "Scheduled"
              : `${formatPoints(matchupMargin(featuredMatchup))}-point finish`}
          </span>
        </div>

        <div class="featured-matchup__teams">
          {featuredTeams.map((team) => {
            const profile = getTeam(team);
            return (
              <div class:list={["featured-team", team.isWinner && "featured-team--winner"]}>
                <div class="featured-team__identity">
                  {profile && (
                    <img src={profile.logo} alt="" width="72" height="72" loading="lazy" decoding="async" />
                  )}
                  <div>
                    <span>{team.isWinner ? "Winner" : team.isTie ? "Tie" : "Final"}</span>
                    {profile ? (
                      <a href={`/teams/${profile.slug}`}>{team.teamName}</a>
                    ) : (
                      <strong>{team.teamName}</strong>
                    )}
                  </div>
                </div>
                <p>{formatPoints(team.points)}</p>
              </div>
            );
          })}
        </div>

        <a class="featured-matchup__link" href={`/matchups?week=${matchupWeek.week}`}>
          Read the complete scoreboard <span aria-hidden="true">→</span>
        </a>
      </article>

      {remainingMatchups.length > 0 && (
        <div class="scoreboard-list" aria-label="More Week matchups">
          {remainingMatchups.map((matchup) => (
            <article class="scoreboard-row">
              <div class="scoreboard-row__meta">
                <span>Final</span>
                <small>{formatPoints(matchupMargin(matchup))} margin</small>
              </div>

              <div class="scoreboard-row__teams">
                {orderedTeams(matchup).map((team) => {
                  const profile = getTeam(team);
                  return (
                    <div class:list={[team.isWinner && "is-winner"]}>
                      <span class="scoreboard-row__team">
                        {profile && <img src={profile.logo} alt="" width="32" height="32" loading="lazy" decoding="async" />}
                        {profile ? <a href={`/teams/${profile.slug}`}>{team.teamName}</a> : team.teamName}
                      </span>
                      <strong>{formatPoints(team.points)}</strong>
                    </div>
                  );
                })}
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .weekly-scoreboard { padding-top:var(--space-9); margin-top:var(--space-9); border-top:3px double var(--color-rule-dark); }
  .weekly-scoreboard__heading { display:grid; grid-template-columns:minmax(0,1fr) minmax(18rem,30rem); align-items:end; gap:clamp(2rem,6vw,6rem); padding-bottom:var(--space-5); border-bottom:1px solid var(--color-rule-dark); }
  .weekly-scoreboard h2 { margin:0; font-size:clamp(2.5rem,5vw,4.6rem); letter-spacing:-.05em; line-height:.9; }
  .weekly-scoreboard__intro { justify-self:end; max-width:30rem; }
  .weekly-scoreboard__intro p { margin:0 0 var(--space-3); color:var(--color-ink-soft); font-family:var(--font-editorial); font-size:clamp(1.05rem,1.7vw,1.25rem); line-height:1.45; }
  .weekly-scoreboard__intro a,.featured-matchup__link { color:var(--color-green); font-size:var(--text-sm); font-weight:700; }
  .weekly-scoreboard__intro a:hover,.featured-matchup__link:hover { text-decoration:underline; text-underline-offset:.25rem; }
  .weekly-scoreboard__layout { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(22rem,.92fr); gap:var(--space-5); padding-top:var(--space-6); }
  .featured-matchup,.scoreboard-list { min-width:0; overflow:hidden; border:1px solid var(--color-rule); border-radius:var(--radius-lg); background:var(--color-surface); }
  .featured-matchup { display:flex; flex-direction:column; background:radial-gradient(circle at 85% 15%,var(--color-green-faint),transparent 38%),var(--color-surface); }
  .featured-matchup__topline { display:flex; align-items:center; justify-content:space-between; gap:var(--space-4); padding:var(--space-4) clamp(1.25rem,3vw,2rem); border-bottom:1px solid var(--color-rule); color:var(--color-ink-muted); font-family:var(--font-data); font-size:.6rem; font-weight:650; letter-spacing:.065em; text-transform:uppercase; }
  .featured-matchup__topline>span:first-child { color:var(--color-green); }
  .featured-matchup__teams { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); flex:1; }
  .featured-team { display:flex; min-width:0; flex-direction:column; justify-content:space-between; gap:var(--space-6); padding:clamp(1.5rem,4vw,2.75rem); }
  .featured-team+.featured-team { border-left:1px solid var(--color-rule); text-align:right; }
  .featured-team__identity { display:flex; min-width:0; align-items:center; gap:var(--space-3); }
  .featured-team+.featured-team .featured-team__identity { flex-direction:row-reverse; }
  .featured-team__identity img { width:clamp(3.25rem,6vw,4.5rem); height:clamp(3.25rem,6vw,4.5rem); flex:0 0 auto; object-fit:contain; }
  .featured-team__identity span { display:block; margin-bottom:var(--space-2); color:var(--color-ink-muted); font-family:var(--font-data); font-size:.56rem; font-weight:650; letter-spacing:.06em; text-transform:uppercase; }
  .featured-team--winner .featured-team__identity span { color:var(--color-green); }
  .featured-team__identity a,.featured-team__identity strong { display:block; color:var(--color-ink); font-family:var(--font-editorial); font-size:clamp(1.3rem,2.8vw,2rem); font-weight:680; letter-spacing:-.035em; line-height:1; overflow-wrap:anywhere; }
  .featured-team__identity a:hover { color:var(--color-green); }
  .featured-team>p { margin:0; font-family:var(--font-editorial); font-size:clamp(2.75rem,6vw,5rem); font-weight:720; letter-spacing:-.055em; line-height:.85; font-variant-numeric:tabular-nums; }
  .featured-team--winner>p { color:var(--color-green); }
  .featured-matchup__link { display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); padding:var(--space-4) clamp(1.25rem,3vw,2rem); border-top:1px solid var(--color-rule); }
  .scoreboard-list { display:grid; }
  .scoreboard-row { display:grid; grid-template-columns:6.5rem minmax(0,1fr); min-width:0; }
  .scoreboard-row+.scoreboard-row { border-top:1px solid var(--color-rule); }
  .scoreboard-row__meta { display:flex; flex-direction:column; justify-content:center; gap:var(--space-2); padding:var(--space-4); border-right:1px solid var(--color-rule); background:linear-gradient(145deg,var(--color-green-faint),transparent 72%); color:var(--color-green); font-family:var(--font-data); font-size:.57rem; font-weight:650; letter-spacing:.06em; text-transform:uppercase; }
  .scoreboard-row__meta small { color:var(--color-ink-muted); font-size:.52rem; line-height:1.35; }
  .scoreboard-row__teams { display:grid; min-width:0; padding:.5rem var(--space-4); }
  .scoreboard-row__teams>div { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:var(--space-3); min-width:0; padding-block:.55rem; color:var(--color-ink-soft); }
  .scoreboard-row__teams>div+div { border-top:1px solid var(--color-rule); }
  .scoreboard-row__teams .is-winner { color:var(--color-ink); }
  .scoreboard-row__team { display:flex; min-width:0; align-items:center; gap:var(--space-2); font-size:var(--text-sm); font-weight:650; overflow-wrap:anywhere; }
  .scoreboard-row__team img { width:2rem; height:2rem; flex:0 0 auto; object-fit:contain; }
  .scoreboard-row__team a:hover { color:var(--color-green); }
  .scoreboard-row__teams strong { color:inherit; font-family:var(--font-data); font-size:.72rem; font-variant-numeric:tabular-nums; }
  .scoreboard-row__teams .is-winner strong { color:var(--color-green); }
  @media (max-width:1050px) { .weekly-scoreboard__layout { grid-template-columns:1fr; } .scoreboard-list { grid-template-columns:repeat(2,minmax(0,1fr)); } .scoreboard-row:nth-child(even) { border-left:1px solid var(--color-rule); } .scoreboard-row:nth-child(2) { border-top:0; } }
  @media (max-width:780px) { .weekly-scoreboard__heading { grid-template-columns:1fr; gap:var(--space-4); } .weekly-scoreboard__intro { justify-self:start; } .scoreboard-list { grid-template-columns:1fr; } .scoreboard-row:nth-child(even) { border-left:0; } .scoreboard-row:nth-child(2) { border-top:1px solid var(--color-rule); } }
  @media (max-width:560px) { .featured-matchup__teams { grid-template-columns:1fr; } .featured-team+.featured-team { border-top:1px solid var(--color-rule); border-left:0; text-align:left; } .featured-team+.featured-team .featured-team__identity { flex-direction:row; } .scoreboard-row { grid-template-columns:5.25rem minmax(0,1fr); } .scoreboard-row__meta { padding:var(--space-3); } }
</style>

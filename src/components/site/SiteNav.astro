---
const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Front Page", href: "/" },
  { label: "The Gazette", href: "/gazette" },
  { label: "Standings", href: "/standings" },
  { label: "Matchups", href: "/matchups" },
  { label: "Teams", href: "/teams" },
  { label: "Power Rankings", href: "/power-rankings" },
  { label: "League History", href: "/history" },
];

function isCurrentPage(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-shell site-nav__inner">
    <ul class="site-nav__list">
      {
        navigation.map((item) => {
          const isCurrent = isCurrentPage(item.href);

          return (
            <li class="site-nav__item">
              <a
                class:list={[
                  "site-nav__link",
                  isCurrent && "site-nav__link--current",
                ]}
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--color-rule);
    background: rgb(250 248 243 / 94%);
  }

  .site-nav__inner {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .site-nav__list {
    display: flex;
    justify-content: center;
    width: max-content;
    min-width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav__item {
    display: flex;
  }

  .site-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: clamp(0.7rem, 1.5vw, 1.25rem);
    color: var(--color-ink-soft);
    font-size: 0.77rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    text-transform: uppercase;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
    white-space: nowrap;
  }

  .site-nav__link::after {
    position: absolute;
    right: 1rem;
    bottom: -1px;
    left: 1rem;
    height: 2px;
    background: transparent;
    content: "";
    transition: background-color var(--transition-fast);
  }

  .site-nav__link:hover {
    color: var(--color-green);
    background: var(--color-green-faint);
  }

  .site-nav__link--current {
    color: var(--color-green);
  }

  .site-nav__link--current::after {
    background: var(--color-green);
  }

  @media (max-width: 840px) {
    .site-nav__list {
      justify-content: flex-start;
    }

    .site-nav__link {
      min-height: 3rem;
    }
  }
</style>
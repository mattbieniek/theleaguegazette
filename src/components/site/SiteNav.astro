---
const currentPath = Astro.url.pathname;

const navigation = [
  { label: "Front Page", href: "/" },
  { label: "Gazette", href: "/gazette" },
  { label: "Matchups", href: "/matchups" },
  { label: "Standings", href: "/standings" },
  { label: "Teams", href: "/teams" },
  { label: "History", href: "/history" },
];

function isCurrentPage(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<nav class="site-nav" aria-label="Primary navigation">
  <div class="site-shell site-nav__inner">
    <ul class="site-nav__list">
      {
        navigation.map((item) => {
          const isCurrent = isCurrentPage(item.href);

          return (
            <li class="site-nav__item">
              <a
                class:list={[
                  "site-nav__link",
                  isCurrent && "site-nav__link--current",
                ]}
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
      <li class="site-nav__item site-nav__item--search">
        <a
          class:list={[
            "site-nav__link",
            "site-nav__search",
            currentPath === "/search" && "site-nav__link--current",
          ]}
          href="/search?focus=1"
          aria-current={currentPath === "/search" ? "page" : undefined}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          Search
          <kbd aria-hidden="true">/</kbd>
        </a>
      </li>
      <li class="site-nav__item site-nav__item--editorial">
        <a class="site-nav__account" href="/account/login" data-account-link>
          Sign In
        </a>
        <a class="site-nav__editorial" href="/admin" data-editorial-link hidden>
          Editorial Desk
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const accountLink = document.querySelector<HTMLAnchorElement>("[data-account-link]");
  const editorialLink = document.querySelector<HTMLAnchorElement>("[data-editorial-link]");
  async function personalizeNavigation() {
    const { supabaseBrowser } = await import("../../lib/supabase-browser");
    const { data } = await supabaseBrowser.auth.getSession();
    const user = data.session?.user;
    if (!user) return;
    if (accountLink) {
      accountLink.href = "/account";
      accountLink.textContent = "My Account";
    }
    const [{ data: admin }, { data: contributor }] = await Promise.all([
      supabaseBrowser.from("admin_users").select("user_id").eq("user_id", user.id).maybeSingle(),
      supabaseBrowser.from("publication_contributors").select("user_id").eq("user_id", user.id).maybeSingle(),
    ]);
    if (editorialLink && (admin || contributor)) editorialLink.hidden = false;
  }

  const idleWindow = window as Window & {
    requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number;
  };
  if (idleWindow.requestIdleCallback) {
    idleWindow.requestIdleCallback(() => void personalizeNavigation(), { timeout: 2000 });
  } else {
    window.setTimeout(() => void personalizeNavigation(), 250);
  }

  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) return;

    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      target instanceof HTMLSelectElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) return;

    event.preventDefault();
    const searchInput = document.querySelector<HTMLInputElement>("[data-site-search]");
    if (searchInput) searchInput.focus();
    else window.location.href = "/search?focus=1";
  });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-rule);
    background: rgb(250 248 243 / 94%);
    backdrop-filter: blur(12px);
  }

  .site-nav__inner {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .site-nav__list {
    display: flex;
    justify-content: center;
    width: max-content;
    min-width: 100%;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-nav__item {
    display: flex;
  }

  .site-nav__item--search {
    margin-left: var(--space-2);
    border-left: 1px solid var(--color-rule);
  }

  .site-nav__item--editorial {
    margin-left: var(--space-2);
  }

  .site-nav__editorial {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: clamp(0.9rem, 1.8vw, 1.35rem);
    background: var(--color-green);
    color: white;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav__editorial[hidden] { display: none; }

  .site-nav__account {
    display:flex;
    align-items:center;
    min-height:3.25rem;
    padding-inline:clamp(.8rem,1.5vw,1.1rem);
    border:1px solid var(--color-green);
    color:var(--color-green);
    font-size:.7rem;
    font-weight:750;
    letter-spacing:.06em;
    text-transform:uppercase;
    white-space:nowrap;
  }

  .site-nav__account:hover { background:color-mix(in srgb,var(--color-green) 8%,transparent); }

  .site-nav__editorial:hover {
    background: var(--color-ink);
    color: white;
  }

  .site-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding-inline: clamp(0.8rem, 1.8vw, 1.4rem);
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
    white-space: nowrap;
  }

  .site-nav__link::after {
    position: absolute;
    right: 1rem;
    bottom: -1px;
    left: 1rem;
    height: 2px;
    background: transparent;
    content: "";
    transition: background-color var(--transition-fast);
  }

  .site-nav__link:hover {
    color: var(--color-green);
    background: var(--color-green-faint);
  }

  .site-nav__link--current {
    color: var(--color-green);
  }

  .site-nav__link--current::after {
    background: var(--color-green);
  }

  .site-nav__search {
    gap: var(--space-2);
  }

  .site-nav__search svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .site-nav__search kbd {
    display: grid;
    min-width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.58rem;
    line-height: 1;
  }

  @supports not (backdrop-filter: blur(12px)) {
    .site-nav {
      background: var(--color-paper-light);
    }
  }

  @media (max-width: 840px) {
    .site-nav__list {
      justify-content: flex-start;
    }

    .site-nav__link {
      min-height: 3rem;
    }

    .site-nav__search kbd {
      display: none;
    }
  }
</style>

---
const now = new Date();

const publicationDate = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "America/Chicago",
}).format(now);

const dateTime = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "America/Chicago",
}).format(now);
---

<header class="masthead">
  <div class="site-shell masthead__inner">
    <div class="masthead__meta masthead__meta--left">
      <span class="masthead__league">
        Far Far Away Football
      </span>

      <span class="masthead__edition">
        Established 2022
      </span>
    </div>

    <a
      class="masthead__identity"
      href="/"
      aria-label="The League Gazette homepage"
    >
      <span class="masthead__kicker">
        The official publication of{" "}
        <span>Far Far Away Football</span>
      </span>

      <span class="masthead__title">
        The League Gazette
      </span>

      <span class="masthead__tagline">
        News, analysis, and some good old-fashioned fuckery from around the league
      </span>
    </a>

    <div class="masthead__meta masthead__meta--right">
      <time datetime={dateTime}>
        {publicationDate}
      </time>

      <span class="masthead__edition">
        Houston, Texas
      </span>
    </div>
  </div>
</header>

<style>
  .masthead {
    padding-top: var(--space-5);
    background: var(--color-paper-light);
  }

  .masthead__inner {
    display: grid;
    grid-template-columns:
      minmax(10rem, 1fr)
      minmax(0, auto)
      minmax(10rem, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 10.75rem;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-rule-dark);
    border-bottom: 1px solid var(--color-rule-dark);
  }

  .masthead__identity {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .masthead__kicker {
    display: none;
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .masthead__kicker span {
    color: var(--color-green);
  }

  .masthead__title {
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(2.7rem, 6vw, 5.9rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.86;
    white-space: nowrap;
  }

  .masthead__tagline {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .masthead__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-ink-soft);
    font-family: var(--font-data);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .masthead__meta--right {
    align-items: flex-end;
    text-align: right;
  }

  .masthead__league {
    color: var(--color-green);
    font-weight: 600;
  }

  .masthead__edition {
    color: var(--color-ink-muted);
  }

  .masthead__identity:hover .masthead__title {
    color: var(--color-green);
  }

  .masthead__title {
    transition: color var(--transition-fast);
  }

  @media (max-width: 960px) {
    .masthead__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 0;
      padding-block: var(--space-6);
    }

    .masthead__meta {
      display: none;
    }

    .masthead__kicker {
      display: block;
    }

    .masthead__title {
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .masthead {
      padding-top: var(--space-3);
    }

    .masthead__inner {
      padding-block: var(--space-5);
    }

    .masthead__title {
      max-width: 9ch;
      font-size: clamp(2.65rem, 15vw, 4rem);
      line-height: 0.88;
    }

    .masthead__kicker {
      max-width: 22rem;
    }

    .masthead__tagline {
      max-width: 20rem;
      font-size: 0.63rem;
      line-height: 1.55;
    }
  }
</style>

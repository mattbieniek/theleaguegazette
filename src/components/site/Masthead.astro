---
const publicationDate = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
}).format(new Date());
---

<header class="masthead">
  <div class="site-shell masthead__inner">
    <div class="masthead__meta masthead__meta--left">
      <span>Far Far Away Football</span>
      <span class="masthead__edition">Established 2022</span>
    </div>

    <a
      class="masthead__identity"
      href="/"
      aria-label="The League Gazette homepage"
    >
      <span class="masthead__title">The League Gazette</span>

      <span class="masthead__tagline">
        News, analysis and nonsense from around the league
      </span>
    </a>

    <div class="masthead__meta masthead__meta--right">
      <time datetime={new Date().toISOString()}>
        {publicationDate}
      </time>

      <span class="masthead__edition">Houston, Texas</span>
    </div>
  </div>
</header>

<style>
  .masthead {
    padding-top: var(--space-5);
    background: var(--color-paper-light);
  }

  .masthead__inner {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
    align-items: center;
    gap: var(--space-6);
    min-height: 10.5rem;
    border-top: 1px solid var(--color-rule-dark);
    border-bottom: 1px solid var(--color-rule-dark);
    padding-block: var(--space-5);
  }

  .masthead__identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .masthead__title {
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(2.7rem, 6vw, 5.9rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.86;
    white-space: nowrap;
  }

  .masthead__tagline {
    margin-top: var(--space-4);
    color: var(--color-ink-soft);
    font-family: var(--font-interface);
    font-size: var(--text-xs);
    font-weight: 550;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .masthead__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    color: var(--color-ink-soft);
    font-family: var(--font-data);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .masthead__meta--right {
    align-items: flex-end;
    text-align: right;
  }

  .masthead__edition {
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .masthead__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--space-4);
      padding-block: var(--space-6);
    }

    .masthead__meta {
      display: none;
    }

    .masthead__title {
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .masthead {
      padding-top: var(--space-3);
    }

    .masthead__inner {
      padding-block: var(--space-5);
    }

    .masthead__title {
      font-size: clamp(2.65rem, 15vw, 4rem);
      line-height: 0.9;
    }

    .masthead__tagline {
      max-width: 19rem;
      font-size: 0.64rem;
      line-height: 1.5;
    }
  }
</style>
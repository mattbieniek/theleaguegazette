---
const currentYear = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  timeZone: "America/Chicago",
}).format(new Date());

const currentPath = Astro.url.pathname;

function isCurrentPage(href: string): boolean {
  if (href.includes("#")) return false;
  const pathname = href.split("#")[0] || "/";
  return pathname === "/"
    ? currentPath === "/"
    : currentPath === pathname || currentPath.startsWith(`${pathname}/`);
}

const navigationGroups = [
  {
    label: "Publication",
    links: [
      { label: "Front Page", href: "/" },
      { label: "The Gazette", href: "/gazette" },
      { label: "Weekly Awards", href: "/awards" },
    ],
  },
  {
    label: "League Data",
    links: [
      { label: "Standings", href: "/standings" },
      { label: "Matchups", href: "/matchups" },
      { label: "Statistics", href: "/stats" },
      { label: "Teams", href: "/teams" },
    ],
  },
  {
    label: "Archive",
    links: [
      { label: "League History", href: "/history" },
      { label: "Season Archive", href: "/history#seasons" },
      { label: "Record Book", href: "/records" },
      { label: "Draft Archive", href: "/draft" },
      { label: "Transactions", href: "/transactions" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-shell">
    <div class="site-footer__rule" aria-hidden="true">
      <span>TLG</span>
    </div>

    <div class="site-footer__main">
      <div class="site-footer__identity">
        <p class="site-footer__kicker">
          The official publication of
          <span>Far Far Away Football</span>
        </p>

        <a href="/" class="site-footer__title">
          The League Gazette
        </a>

        <p class="site-footer__tagline">
          News, analysis and nonsense from around the league.
        </p>

        <p class="site-footer__edition">
          Established 2022 <span aria-hidden="true">·</span> Houston, Texas
        </p>
      </div>

      <nav class="site-footer__navigation" aria-label="Footer navigation">
        {navigationGroups.map((group) => (
          <section aria-labelledby={`footer-${group.label.toLowerCase().replace(" ", "-")}`}>
            <h2 id={`footer-${group.label.toLowerCase().replace(" ", "-")}`}>
              {group.label}
            </h2>

            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    class:list={[isCurrentPage(link.href) && "is-current"]}
                    href={link.href}
                    aria-current={isCurrentPage(link.href) ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {currentYear} The League Gazette. Built for Far Far Away Football.
      </p>

      <p>
        League data synchronized from
        <a href="https://sleeper.com" rel="external">Sleeper</a>.
        The League Gazette is not affiliated with the NFL.
      </p>

      <a class="site-footer__admin" href="/admin/login">
        Editorial login
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 0 var(--space-6);
    background:
      linear-gradient(
        180deg,
        transparent,
        rgb(23 63 50 / 3%) 38%
      ),
      var(--color-paper);
  }

  .site-footer__rule {
    position: relative;
    display: grid;
    place-items: center;
    border-top: 3px double var(--color-rule-dark);
  }

  .site-footer__rule span {
    position: relative;
    top: -0.85rem;
    padding-inline: var(--space-4);
    background: var(--color-paper);
    color: var(--color-green);
    font-family: var(--font-data);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(28rem, 0.85fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: var(--space-7) var(--space-8);
  }

  .site-footer__identity {
    max-width: 40rem;
  }

  .site-footer__kicker {
    margin-bottom: var(--space-4);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .site-footer__kicker span {
    color: var(--color-green);
  }

  .site-footer__title {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(2.7rem, 5vw, 4.8rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.88;
    transition: color var(--transition-fast);
  }

  .site-footer__title:hover {
    color: var(--color-green);
  }

  .site-footer__tagline {
    max-width: 32rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
    line-height: 1.45;
  }

  .site-footer__edition {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .site-footer__navigation {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .site-footer__navigation h2 {
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.59rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .site-footer__navigation ul {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .site-footer__navigation a {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: color var(--transition-fast);
  }

  .site-footer__navigation a:hover {
    color: var(--color-green);
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }

  .site-footer__navigation a.is-current {
    color: var(--color-green);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22rem;
  }

  .site-footer__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: flex-start;
    gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-rule);
  }

  .site-footer__bottom p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.58rem;
    letter-spacing: 0.025em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .site-footer__bottom p:nth-child(2) {
    text-align: right;
  }

  .site-footer__bottom a {
    color: var(--color-green);
    font-weight: 700;
  }

  .site-footer__admin {
    flex: 0 0 auto;
    color: var(--color-ink-muted) !important;
    font-family: var(--font-data);
    font-size: 0.58rem;
    font-weight: 600 !important;
    letter-spacing: 0.045em;
    line-height: 1.6;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-footer__admin:hover {
    color: var(--color-green) !important;
    text-decoration: underline;
    text-underline-offset: 0.22rem;
  }

  @media (max-width: 960px) {
    .site-footer__main {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .site-footer__navigation {
      max-width: 48rem;
    }

    .site-footer__bottom {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__admin {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 650px) {
    .site-footer__navigation {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .site-footer__bottom {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .site-footer__bottom p:nth-child(2) {
      text-align: left;
    }

    .site-footer__admin {
      margin-top: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__title,
    .site-footer__navigation a {
      transition: none;
    }
  }
</style>

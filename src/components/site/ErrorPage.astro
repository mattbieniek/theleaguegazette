---
interface Props {
  code: "404" | "500";
  eyebrow: string;
  title: string;
  description: string;
}

const { code, eyebrow, title, description } = Astro.props;
const isNotFound = code === "404";
---

<div class="site-shell error-page">
  <section
    class="error-page__feature"
    aria-labelledby="error-page-title"
    data-code={code}
  >
    <div class="error-page__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="error-page-title">{title}</h1>
      <p class="error-page__description">{description}</p>

      {isNotFound && (
        <form class="error-search" method="get" action="/search" role="search">
          <label for="error-search-input">Search the Gazette instead</label>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <input
              id="error-search-input"
              type="search"
              name="q"
              placeholder="Search stories, teams and league history…"
              autocomplete="off"
            />
            <button type="submit">Search</button>
          </div>
        </form>
      )}

      <nav class="error-page__actions" aria-label="Recovery links">
        <a class="error-page__primary" href="/">
          Return to the front page <span aria-hidden="true">→</span>
        </a>
        <a href="/gazette">Browse the Gazette</a>
      </nav>
    </div>

    <aside class="error-page__edition" aria-label={`Error ${code}`}>
      <span>Gazette Notice</span>
      <strong>{code}</strong>
      <small>{isNotFound ? "Page not found" : "Publication interrupted"}</small>
    </aside>
  </section>

  <section class="recovery-desk" aria-labelledby="recovery-desk-title">
    <header>
      <p class="eyebrow">Continue Reading</p>
      <h2 id="recovery-desk-title">Elsewhere in the League</h2>
    </header>

    <div class="recovery-desk__grid">
      <a href="/gazette">
        <span>01</span>
        <div><strong>Latest Stories</strong><p>News, analysis and dispatches from the Gazette desk.</p></div>
        <b aria-hidden="true">→</b>
      </a>
      <a href="/teams">
        <span>02</span>
        <div><strong>League Teams</strong><p>Franchise profiles, rosters, records and recent activity.</p></div>
        <b aria-hidden="true">→</b>
      </a>
      <a href="/history">
        <span>03</span>
        <div><strong>League History</strong><p>Champions, seasons, records and the historical archive.</p></div>
        <b aria-hidden="true">→</b>
      </a>
    </div>
  </section>
</div>

<style>
  .error-page { padding-bottom:var(--space-3); }
  .error-page__feature { position:relative; display:grid; grid-template-columns:minmax(0,1fr) minmax(15rem,21rem); align-items:end; gap:clamp(2rem,7vw,7rem); min-height:34rem; padding:clamp(2.5rem,7vw,6rem); overflow:hidden; border:1px solid var(--color-rule); border-radius:var(--radius-lg); background:radial-gradient(circle at 88% 18%,var(--color-green-faint),transparent 32%),linear-gradient(145deg,rgb(255 255 255 / 38%),transparent 50%),var(--color-surface); }
  .error-page__feature::after { position:absolute; right:-.05em; bottom:-.28em; color:var(--color-green); content:attr(data-code); font-family:var(--font-editorial); font-size:clamp(15rem,30vw,29rem); font-weight:750; letter-spacing:-.09em; line-height:1; opacity:.025; pointer-events:none; }
  .error-page__copy { position:relative; z-index:1; min-width:0; }
  .error-page h1 { max-width:12ch; margin-bottom:var(--space-5); font-size:clamp(3.4rem,8vw,7.5rem); letter-spacing:-.065em; line-height:.85; overflow-wrap:anywhere; }
  .error-page__description { max-width:48rem; margin:0; color:var(--color-ink-soft); font-family:var(--font-editorial); font-size:clamp(1.2rem,2.4vw,1.65rem); line-height:1.45; }
  .error-page__edition { position:relative; z-index:1; display:grid; min-width:0; padding:clamp(1.5rem,4vw,2.5rem); border:1px solid var(--color-rule-dark); border-radius:var(--radius-lg); background:rgb(255 253 248 / 78%); text-align:center; }
  .error-page__edition span,.error-page__edition small { color:var(--color-ink-muted); font-family:var(--font-data); font-size:.6rem; font-weight:650; letter-spacing:.065em; text-transform:uppercase; }
  .error-page__edition strong { margin-block:var(--space-3); color:var(--color-green); font-family:var(--font-editorial); font-size:clamp(4rem,9vw,7rem); letter-spacing:-.065em; line-height:.8; }
  .error-search { max-width:48rem; padding-top:var(--space-6); }
  .error-search>label { display:block; margin-bottom:var(--space-2); color:var(--color-ink-muted); font-family:var(--font-data); font-size:.6rem; font-weight:650; letter-spacing:.06em; text-transform:uppercase; }
  .error-search>div { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; overflow:hidden; border:1px solid var(--color-rule-dark); border-radius:999px; background:var(--color-paper-light); }
  .error-search svg { width:1.1rem; height:1.1rem; margin-left:var(--space-4); fill:none; stroke:var(--color-green); stroke-linecap:round; stroke-width:1.8; }
  .error-search input { min-width:0; min-height:3.25rem; padding-inline:var(--space-3); border:0; outline:0; background:transparent; color:var(--color-ink); font:inherit; }
  .error-search button { align-self:stretch; padding-inline:var(--space-5); border:0; background:var(--color-green); color:white; font:inherit; font-size:var(--text-sm); font-weight:750; cursor:pointer; }
  .error-search>div:focus-within { border-color:var(--color-green); box-shadow:0 0 0 3px var(--color-green-faint); }
  .error-page__actions { display:flex; flex-wrap:wrap; align-items:center; gap:var(--space-5); padding-top:var(--space-6); }
  .error-page__actions a { color:var(--color-ink-soft); font-size:var(--text-sm); font-weight:700; }
  .error-page__actions a:hover { color:var(--color-green); text-decoration:underline; text-underline-offset:.25rem; }
  .error-page__actions .error-page__primary { display:inline-flex; align-items:center; gap:var(--space-3); padding:.8rem 1.15rem; border-radius:999px; background:var(--color-green); color:white; }
  .error-page__actions .error-page__primary:hover { background:var(--color-green-hover); color:white; text-decoration:none; }
  .recovery-desk { padding-top:var(--space-8); }
  .recovery-desk>header { padding-bottom:var(--space-4); border-bottom:1px solid var(--color-rule-dark); }
  .recovery-desk h2 { margin:0; font-size:clamp(2.2rem,4.5vw,3.75rem); letter-spacing:-.05em; line-height:.94; }
  .recovery-desk__grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin-top:var(--space-5); overflow:hidden; border:1px solid var(--color-rule); border-radius:var(--radius-lg); background:var(--color-surface); }
  .recovery-desk__grid>a { display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:start; gap:var(--space-4); min-width:0; padding:var(--space-5); transition:background-color var(--transition-fast); }
  .recovery-desk__grid>a+a { border-left:1px solid var(--color-rule); }
  .recovery-desk__grid>a:hover { background:var(--color-green-faint); }
  .recovery-desk__grid>a>span { color:var(--color-ink-faint); font-family:var(--font-data); font-size:.6rem; }
  .recovery-desk__grid strong { display:block; margin-bottom:var(--space-2); font-family:var(--font-editorial); font-size:clamp(1.35rem,2.5vw,1.8rem); letter-spacing:-.03em; line-height:1; }
  .recovery-desk__grid p { margin:0; color:var(--color-ink-soft); font-size:var(--text-sm); line-height:1.5; }
  .recovery-desk__grid b { color:var(--color-green); }
  @media (max-width:850px) { .error-page__feature { grid-template-columns:1fr; min-height:0; } .error-page__edition { grid-template-columns:1fr auto 1fr; align-items:center; gap:var(--space-4); text-align:left; } .error-page__edition strong { margin:0; font-size:3.5rem; text-align:center; } .error-page__edition small { text-align:right; } .recovery-desk__grid { grid-template-columns:1fr; } .recovery-desk__grid>a+a { border-top:1px solid var(--color-rule); border-left:0; } }
  @media (max-width:520px) { .error-page__feature { padding:var(--space-5); } .error-page h1 { max-width:100%; font-size:clamp(3rem,15vw,4.75rem); } .error-page__edition { grid-template-columns:1fr; text-align:center; } .error-page__edition small { text-align:center; } .error-search>div { grid-template-columns:auto minmax(0,1fr); border-radius:var(--radius-lg); } .error-search button { grid-column:1/-1; min-height:3rem; } .error-page__actions { align-items:flex-start; flex-direction:column; gap:var(--space-3); } }
  @media (prefers-reduced-motion:reduce) { .recovery-desk__grid>a { transition:none; } }
</style>

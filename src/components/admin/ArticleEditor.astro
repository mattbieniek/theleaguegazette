---
interface Props {
  articleId?: string;
}

const { articleId } = Astro.props;
const editorMode = articleId ? "edit" : "create";
---

<div
  id="article-editor"
  class="article-editor"
  data-mode={editorMode}
  data-article-id={articleId ?? ""}
>
  <div id="editor-loading" class="editor-loading" hidden={editorMode === "create"}>
    <p>Opening story…</p>
  </div>

  <form id="article-form" class="editor-form" hidden={editorMode === "edit"}>
    <header class="editor-header">
      <div>
        <p class="eyebrow">
          {editorMode === "create" ? "New Story" : "Editorial Desk"}
        </p>

        <h1 id="editor-page-title">
          {editorMode === "create" ? "Untitled story" : "Edit story"}
        </h1>

        <p id="editor-save-status" class="editor-save-status">
          Not yet saved
        </p>
      </div>

      <div class="editor-header__actions">
        <a class="editor-button editor-button--secondary" href="/admin/articles">
          Cancel
        </a>

        <button
          id="save-draft-button"
          class="editor-button editor-button--secondary"
          type="button"
        >
          Save draft
        </button>

        <button
          id="preview-button"
          class="editor-button editor-button--secondary"
          type="button"
        >
          Preview
        </button>

        <button
          id="publish-button"
          class="editor-button editor-button--primary"
          type="button"
        >
          Publish
        </button>
      </div>
    </header>

    <div
      id="editor-message"
      class="editor-message"
      role="status"
      aria-live="polite"
    ></div>

    <div class="editor-layout">
      <main class="editor-canvas">
        <section class="editor-section editor-section--headline">
          <label for="headline">Headline</label>

          <textarea
            id="headline"
            name="headline"
            rows="2"
            placeholder="Give the story a headline"
            required
          ></textarea>

          <label for="summary">Summary</label>

          <textarea
            id="summary"
            name="summary"
            rows="3"
            placeholder="Write a brief introduction or homepage summary"
          ></textarea>
        </section>

        <section class="editor-section editor-section--body">
          <div class="editor-section__heading">
            <div>
              <p class="eyebrow">Story</p>
              <h2>Article body</h2>
            </div>

            <div class="editor-writing-stats">
              <span id="word-count">0 words</span>
              <span id="reading-time">0 min read</span>
            </div>
          </div>

          <label class="sr-only" for="body">
            Article body
          </label>

          <textarea
            id="body"
            name="body"
            rows="22"
            placeholder="Begin writing your story…

Separate paragraphs with a blank line."
          ></textarea>

          <p class="editor-field-help">
            Separate paragraphs with a blank line. Formatting tools will be
            added after the core publishing workflow is stable.
          </p>
        </section>
      </main>

      <aside class="editor-sidebar">
        <section class="editor-panel">
          <div class="editor-panel__heading">
            <p class="eyebrow">Publishing</p>
            <h2>Story details</h2>
          </div>

          <div class="editor-fields">
            <label>
              <span>Category</span>

              <input
                id="category"
                name="category"
                type="text"
                placeholder="Weekly Gazette"
              />
            </label>

            <label>
              <span>Author</span>

              <input
                id="author-name"
                name="author_name"
                type="text"
                value="The Gazette Staff"
              />
            </label>

            <label>
              <span>Slug</span>

              <input
                id="slug"
                name="slug"
                type="text"
                placeholder="story-url"
              />

              <small>
                Used in the public story URL.
              </small>
            </label>

            <label>
              <span>Publication date</span>

              <input
                id="published-at"
                name="published_at"
                type="datetime-local"
              />
            </label>
          </div>
        </section>

        <section class="editor-panel">
  <div class="editor-panel__heading">
    <p class="eyebrow">Artwork</p>
    <h2>Featured image</h2>
  </div>

  <div class="editor-fields">
    <div
      id="featured-image-preview"
      class="featured-image-preview"
      hidden
    >
      <img
        id="featured-image-preview-image"
        src=""
        alt=""
      />
    </div>

    <div
      id="featured-image-empty"
      class="featured-image-empty"
    >
      <span aria-hidden="true">◇</span>
      <p>No featured image selected</p>
    </div>

    <input
      id="image-url"
      name="image_url"
      type="hidden"
    />

    <input
      id="image-file"
      class="sr-only"
      type="file"
      accept="image/jpeg,image/png,image/webp"
    />

    <div class="featured-image-actions">
      <button
        id="upload-image-button"
        class="editor-button editor-button--secondary"
        type="button"
      >
        Upload image
      </button>

      <button
        id="remove-image-button"
        class="editor-button editor-button--text"
        type="button"
        hidden
      >
        Remove
      </button>
    </div>

    <p
      id="image-upload-status"
      class="image-upload-status"
      role="status"
      aria-live="polite"
    ></p>

    <label>
      <span>Alternative text</span>

      <textarea
        id="image-alt"
        name="image_alt"
        rows="3"
        placeholder="Describe the image for readers using screen readers"
      ></textarea>

      <small>
        Required before publishing a story with an image.
      </small>
    </label>

    <small class="featured-image-requirements">
      JPEG, PNG, or WebP. Maximum file size: 6 MB.
    </small>
  </div>
</section>

        <section class="editor-panel">
          <div class="editor-panel__heading">
            <p class="eyebrow">Homepage</p>
            <h2>Placement</h2>
          </div>

          <div class="editor-fields">
            <label class="editor-checkbox">
              <input
                id="is-featured"
                name="is_featured"
                type="checkbox"
              />

              <span>
                <strong>Feature this story</strong>
                <small>
                  Allow the story to receive prominent homepage placement.
                </small>
              </span>
            </label>

            <label>
              <span>Homepage order</span>

              <input
                id="homepage-order"
                name="homepage_order"
                type="number"
                min="1"
                step="1"
                placeholder="1"
              />

              <small>
                Lower numbers appear first.
              </small>
            </label>
          </div>
        </section>

        <section
          id="story-status-panel"
          class="editor-panel editor-status-panel"
          hidden
        >
          <div class="editor-panel__heading">
            <p class="eyebrow">Status</p>
            <h2>Current state</h2>
          </div>

          <dl>
            <div>
              <dt>Status</dt>
              <dd id="current-status">Draft</dd>
            </div>

            <div>
              <dt>Created</dt>
              <dd id="created-date">—</dd>
            </div>

            <div>
              <dt>Last updated</dt>
              <dd id="updated-date">—</dd>
            </div>
          </dl>

          <a
            id="view-published-story"
            class="view-published-story"
            href="#"
            target="_blank"
            rel="noreferrer"
            hidden
          >
            View published story ↗
          </a>
        </section>
      </aside>
    </div>
  </form>
  <dialog id="preview-dialog" class="preview-dialog">
  <div class="preview-shell">
    <header class="preview-toolbar">
      <div>
        <p class="eyebrow">Story Preview</p>
        <p class="preview-toolbar__note">
          This preview has not been published.
        </p>
      </div>

      <button
        id="close-preview-button"
        class="preview-close"
        type="button"
        aria-label="Close preview"
      >
        ×
      </button>
    </header>

    <div class="preview-page">
      <article class="story-preview">
        <header class="story-preview__header">
          <p id="preview-category" class="story-preview__category">
            Uncategorized
          </p>

          <h1 id="preview-headline">
            Untitled story
          </h1>

          <p id="preview-summary" class="story-preview__summary"></p>

          <div class="story-preview__byline">
            <span id="preview-author">The Gazette Staff</span>
            <span aria-hidden="true">•</span>
            <time id="preview-date"></time>
          </div>
        </header>

        <figure id="preview-image-wrapper" class="story-preview__image" hidden>
          <img id="preview-image" src="" alt="" />
        </figure>

        <div id="preview-body" class="story-preview__body"></div>

        <div id="preview-empty-body" class="story-preview__empty" hidden>
          <p>The article body will appear here.</p>
        </div>
      </article>
    </div>
  </div>
</dialog>
</div>

<script>
  import { supabaseBrowser } from "../../lib/supabase-browser";

  type ArticleRecord = {
    id: string;
    slug: string;
    category: string;
    headline: string;
    summary: string;
    author_name: string;
    published_at: string | null;
    image_url: string | null;
    image_alt: string | null;
    body: unknown;
    status: string;
    is_featured: boolean;
    homepage_order: number | null;
    created_at: string;
    updated_at: string;
  };

  type ArticlePayload = {
    slug: string;
    category: string;
    headline: string;
    summary: string;
    author_name: string;
    published_at: string | null;
    image_url: string | null;
    image_alt: string | null;
    body: string[];
    status: "draft" | "published";
    is_featured: boolean;
    homepage_order: number | null;
    updated_at: string;
  };

  const editor =
    document.querySelector<HTMLElement>("#article-editor");

  const form =
    document.querySelector<HTMLFormElement>("#article-form");

  const loading =
    document.querySelector<HTMLElement>("#editor-loading");

  const message =
    document.querySelector<HTMLElement>("#editor-message");

  const saveStatus =
    document.querySelector<HTMLElement>("#editor-save-status");

  const pageTitle =
    document.querySelector<HTMLElement>("#editor-page-title");

  const headlineInput =
    document.querySelector<HTMLTextAreaElement>("#headline");

  const summaryInput =
    document.querySelector<HTMLTextAreaElement>("#summary");

  const bodyInput =
    document.querySelector<HTMLTextAreaElement>("#body");

  const categoryInput =
    document.querySelector<HTMLInputElement>("#category");

  const authorInput =
    document.querySelector<HTMLInputElement>("#author-name");

  const slugInput =
    document.querySelector<HTMLInputElement>("#slug");

  const publishedAtInput =
    document.querySelector<HTMLInputElement>("#published-at");

  const imageUrlInput =
    document.querySelector<HTMLInputElement>("#image-url");

  const imageAltInput =
    document.querySelector<HTMLTextAreaElement>("#image-alt");

  const imageFileInput =
  document.querySelector<HTMLInputElement>("#image-file");

const uploadImageButton =
  document.querySelector<HTMLButtonElement>(
    "#upload-image-button"
  );

const removeImageButton =
  document.querySelector<HTMLButtonElement>(
    "#remove-image-button"
  );

const imageUploadStatus =
  document.querySelector<HTMLElement>(
    "#image-upload-status"
  );

const featuredImagePreview =
  document.querySelector<HTMLElement>(
    "#featured-image-preview"
  );

const featuredImagePreviewImage =
  document.querySelector<HTMLImageElement>(
    "#featured-image-preview-image"
  );

const featuredImageEmpty =
  document.querySelector<HTMLElement>(
    "#featured-image-empty"
  );

  const isFeaturedInput =
    document.querySelector<HTMLInputElement>("#is-featured");

  const homepageOrderInput =
    document.querySelector<HTMLInputElement>("#homepage-order");

  const saveDraftButton =
    document.querySelector<HTMLButtonElement>("#save-draft-button");

  const publishButton =
    document.querySelector<HTMLButtonElement>("#publish-button");

  const wordCount =
    document.querySelector<HTMLElement>("#word-count");

  const readingTime =
    document.querySelector<HTMLElement>("#reading-time");

  const statusPanel =
    document.querySelector<HTMLElement>("#story-status-panel");

  const currentStatus =
    document.querySelector<HTMLElement>("#current-status");

  const createdDate =
    document.querySelector<HTMLElement>("#created-date");

  const updatedDate =
    document.querySelector<HTMLElement>("#updated-date");

  const viewPublishedStory =
    document.querySelector<HTMLAnchorElement>(
      "#view-published-story"
    );

  const previewButton =
  document.querySelector<HTMLButtonElement>("#preview-button");

const previewDialog =
  document.querySelector<HTMLDialogElement>("#preview-dialog");

const closePreviewButton =
  document.querySelector<HTMLButtonElement>(
    "#close-preview-button"
  );

const previewCategory =
  document.querySelector<HTMLElement>("#preview-category");

const previewHeadline =
  document.querySelector<HTMLElement>("#preview-headline");

const previewSummary =
  document.querySelector<HTMLElement>("#preview-summary");

const previewAuthor =
  document.querySelector<HTMLElement>("#preview-author");

const previewDate =
  document.querySelector<HTMLTimeElement>("#preview-date");

const previewImageWrapper =
  document.querySelector<HTMLElement>(
    "#preview-image-wrapper"
  );

const previewImage =
  document.querySelector<HTMLImageElement>("#preview-image");

const previewBody =
  document.querySelector<HTMLElement>("#preview-body");

const previewEmptyBody =
  document.querySelector<HTMLElement>("#preview-empty-body");

  const mode = editor?.dataset.mode ?? "create";
  let articleId = editor?.dataset.articleId ?? "";
let slugWasManuallyEdited = mode === "edit";
let currentArticleStatus: "draft" | "published" = "draft";

let lastSavedSnapshot = "";
let autosaveTimer: number | undefined;
let isSaving = false;
let isHydrating = false;
let hasUnsavedChanges = false;

const AUTOSAVE_DELAY = 1400;

const IMAGE_BUCKET = "gazette-images";
const MAX_IMAGE_SIZE = 6 * 1024 * 1024;

const ALLOWED_IMAGE_TYPES = new Set([
  "image/jpeg",
  "image/png",
  "image/webp",
]);

let isUploadingImage = false;

  function slugify(value: string): string {
    return value
      .toLowerCase()
      .trim()
      .replace(/['’]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function bodyTextToParagraphs(value: string): string[] {
    return value
      .split(/\n\s*\n/)
      .map((paragraph) => paragraph.trim())
      .filter(Boolean);
  }

  function bodyToText(value: unknown): string {
    if (!Array.isArray(value)) {
      return "";
    }

    return value
      .filter(
        (paragraph): paragraph is string =>
          typeof paragraph === "string"
      )
      .join("\n\n");
  }

  function formatDisplayDate(value: string | null): string {
    if (!value) {
      return "—";
    }

    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date(value));
  }

  function toDatetimeLocal(value: string | null): string {
    if (!value) {
      return "";
    }

    const date = new Date(value);
    const offset = date.getTimezoneOffset();
    const localDate = new Date(date.getTime() - offset * 60_000);

    return localDate.toISOString().slice(0, 16);
  }

  function toIsoDate(value: string): string | null {
    if (!value) {
      return null;
    }

    const parsed = new Date(value);

    if (Number.isNaN(parsed.getTime())) {
      return null;
    }

    return parsed.toISOString();
  }

  function capitalize(value: string): string {
    return value.charAt(0).toUpperCase() + value.slice(1);
  }

  function getEditorSnapshot(): string {
  return JSON.stringify({
    headline: headlineInput?.value ?? "",
    summary: summaryInput?.value ?? "",
    body: bodyInput?.value ?? "",
    category: categoryInput?.value ?? "",
    authorName: authorInput?.value ?? "",
    slug: slugInput?.value ?? "",
    publishedAt: publishedAtInput?.value ?? "",
    imageUrl: imageUrlInput?.value ?? "",
    imageAlt: imageAltInput?.value ?? "",
    isFeatured: isFeaturedInput?.checked ?? false,
    homepageOrder: homepageOrderInput?.value ?? "",
  });
}

function setSaveStatus(text: string): void {
  if (saveStatus) {
    saveStatus.textContent = text;
  }
}

function markCurrentStateAsSaved(
  savedAt: string = new Date().toISOString()
): void {
  lastSavedSnapshot = getEditorSnapshot();
  hasUnsavedChanges = false;

  setSaveStatus(
    `Saved ${formatDisplayDate(savedAt)}`
  );
}

function updateDirtyState(): void {
  if (isHydrating) {
    return;
  }

  const currentSnapshot = getEditorSnapshot();

  hasUnsavedChanges =
    currentSnapshot !== lastSavedSnapshot;

  if (hasUnsavedChanges) {
    setSaveStatus(
      articleId
        ? "Unsaved changes"
        : "Not yet saved"
    );
  }
}

function clearAutosaveTimer(): void {
  if (autosaveTimer !== undefined) {
    window.clearTimeout(autosaveTimer);
    autosaveTimer = undefined;
  }
}

function setImageUploadStatus(
  text: string,
  type: "error" | "success" | "neutral" = "neutral"
): void {
  if (!imageUploadStatus) {
    return;
  }

  imageUploadStatus.textContent = text;
  imageUploadStatus.dataset.type = type;
}

function setImageUploadState(uploading: boolean): void {
  isUploadingImage = uploading;

  if (uploadImageButton) {
    uploadImageButton.disabled = uploading;
    uploadImageButton.textContent = uploading
      ? "Uploading…"
      : imageUrlInput?.value
        ? "Replace image"
        : "Upload image";
  }

  if (removeImageButton) {
    removeImageButton.disabled = uploading;
  }
}

function updateFeaturedImagePreview(
  imageUrl: string,
  imageAlt = ""
): void {
  const hasImage = Boolean(imageUrl);

  if (featuredImagePreview) {
    featuredImagePreview.hidden = !hasImage;
  }

  if (featuredImageEmpty) {
    featuredImageEmpty.hidden = hasImage;
  }

  if (removeImageButton) {
    removeImageButton.hidden = !hasImage;
  }

  if (uploadImageButton) {
    uploadImageButton.textContent = hasImage
      ? "Replace image"
      : "Upload image";
  }

  if (!featuredImagePreviewImage) {
    return;
  }

  if (hasImage) {
    featuredImagePreviewImage.src = imageUrl;
    featuredImagePreviewImage.alt = imageAlt;
  } else {
    featuredImagePreviewImage.removeAttribute("src");
    featuredImagePreviewImage.alt = "";
  }
}

function getFileExtension(file: File): string {
  const extensionByType: Record<string, string> = {
    "image/jpeg": "jpg",
    "image/png": "png",
    "image/webp": "webp",
  };

  return extensionByType[file.type] ?? "jpg";
}

function validateImageFile(file: File): string | null {
  if (!ALLOWED_IMAGE_TYPES.has(file.type)) {
    return "Choose a JPEG, PNG, or WebP image.";
  }

  if (file.size > MAX_IMAGE_SIZE) {
    return "The selected image is larger than 6 MB.";
  }

  return null;
}

function getStoragePathFromPublicUrl(
  imageUrl: string
): string | null {
  if (!imageUrl) {
    return null;
  }

  try {
    const url = new URL(imageUrl);

    const marker =
      `/storage/v1/object/public/${IMAGE_BUCKET}/`;

    const markerIndex = url.pathname.indexOf(marker);

    if (markerIndex === -1) {
      return null;
    }

    const encodedPath = url.pathname.slice(
      markerIndex + marker.length
    );

    return decodeURIComponent(encodedPath);
  } catch {
    return null;
  }
}

async function deleteStoredImage(
  imageUrl: string
): Promise<void> {
  const storagePath =
    getStoragePathFromPublicUrl(imageUrl);

  if (!storagePath) {
    return;
  }

  const { error } = await supabaseBrowser.storage
    .from(IMAGE_BUCKET)
    .remove([storagePath]);

  if (error) {
    console.error(
      "Unable to remove previous Gazette image:",
      error
    );
  }
}

function scheduleAutosave(): void {
  updateDirtyState();
  clearAutosaveTimer();

  if (
    !articleId ||
    !hasUnsavedChanges ||
    isSaving
  ) {
    return;
  }

  autosaveTimer = window.setTimeout(() => {
    void saveArticle(currentArticleStatus, {
      isAutosave: true,
    });
  }, AUTOSAVE_DELAY);
}

  function setMessage(
    text: string,
    type: "error" | "success" | "neutral" = "neutral"
  ): void {
    if (!message) {
      return;
    }

    message.textContent = text;
    message.dataset.type = type;
  }

  function setSavingState(
  saving: boolean,
  isAutosave = false
): void {
  isSaving = saving;

  if (saveDraftButton) {
    saveDraftButton.disabled = saving;
    saveDraftButton.textContent = saving
      ? "Saving…"
      : "Save draft";
  }

  if (publishButton) {
    publishButton.disabled = saving;
    publishButton.textContent = saving
      ? "Publishing…"
      : currentArticleStatus === "published"
        ? "Update story"
        : "Publish";
  }

  if (previewButton) {
    previewButton.disabled = saving;
  }

  if (saving) {
    setSaveStatus(
      isAutosave ? "Autosaving…" : "Saving…"
    );
  }
}

  function updateWritingStats(): void {
    const text = bodyInput?.value.trim() ?? "";

    const words = text
      ? text.split(/\s+/).filter(Boolean).length
      : 0;

    const minutes = words === 0 ? 0 : Math.max(1, Math.ceil(words / 225));

    if (wordCount) {
      wordCount.textContent = `${words} ${
        words === 1 ? "word" : "words"
      }`;
    }

    if (readingTime) {
      readingTime.textContent = `${minutes} min read`;
    }
  }

  function updateEditorTitle(): void {
    if (!pageTitle) {
      return;
    }

    const headline = headlineInput?.value.trim();

    pageTitle.textContent = headline || "Untitled story";
  }

  function updateStatusDisplay(article: ArticleRecord): void {
    currentArticleStatus =
  article.status === "published"
    ? "published"
    : "draft";

    if (statusPanel) {
      statusPanel.hidden = false;
    }

    if (currentStatus) {
      currentStatus.textContent = capitalize(article.status);
    }

    if (createdDate) {
      createdDate.textContent = formatDisplayDate(article.created_at);
    }

    if (updatedDate) {
      updatedDate.textContent = formatDisplayDate(article.updated_at);
    }

    if (publishButton) {
      publishButton.textContent =
        article.status === "published"
          ? "Update story"
          : "Publish";
    }

    if (viewPublishedStory) {
      const canView =
        article.status === "published" &&
        Boolean(article.slug);

      viewPublishedStory.hidden = !canView;

      if (canView) {
        viewPublishedStory.href = `/gazette/${article.slug}`;
      }
    }

    markCurrentStateAsSaved(article.updated_at);
  }

  async function verifyAdmin(): Promise<boolean> {
    const {
      data: { user },
      error: userError,
    } = await supabaseBrowser.auth.getUser();

    if (userError || !user) {
      window.location.replace("/admin/login");
      return false;
    }

    const {
      data: adminRecord,
      error: adminError,
    } = await supabaseBrowser
      .from("admin_users")
      .select("user_id")
      .eq("user_id", user.id)
      .maybeSingle();

    if (adminError || !adminRecord) {
      await supabaseBrowser.auth.signOut();
      window.location.replace("/admin/login");
      return false;
    }

    return true;
  }

  function populateForm(article: ArticleRecord): void {
  isHydrating = true;

  if (headlineInput) {
    headlineInput.value = article.headline;
  }

  if (summaryInput) {
    summaryInput.value = article.summary;
  }

  if (bodyInput) {
    bodyInput.value = bodyToText(article.body);
  }

  if (categoryInput) {
    categoryInput.value = article.category;
  }

  if (authorInput) {
    authorInput.value = article.author_name;
  }

  if (slugInput) {
    slugInput.value = article.slug;
  }

  if (publishedAtInput) {
    publishedAtInput.value =
      toDatetimeLocal(article.published_at);
  }

  if (imageUrlInput) {
  imageUrlInput.value = article.image_url ?? "";
}

if (imageAltInput) {
  imageAltInput.value = article.image_alt ?? "";
}

updateFeaturedImagePreview(
  article.image_url ?? "",
  article.image_alt ?? ""
);

  if (isFeaturedInput) {
    isFeaturedInput.checked = article.is_featured;
  }

  if (homepageOrderInput) {
    homepageOrderInput.value =
      article.homepage_order === null
        ? ""
        : String(article.homepage_order);
  }

  updateEditorTitle();
  updateWritingStats();
  updateStatusDisplay(article);

  isHydrating = false;
  markCurrentStateAsSaved(article.updated_at);
}

  function buildPayload(
    requestedStatus: "draft" | "published"
  ): ArticlePayload | null {
    const headline = headlineInput?.value.trim() ?? "";
    const summary = summaryInput?.value.trim() ?? "";
    const category = categoryInput?.value.trim() ?? "";
    const authorName =
      authorInput?.value.trim() || "The Gazette Staff";

    const body = bodyTextToParagraphs(bodyInput?.value ?? "");

    let slug = slugInput?.value.trim() ?? "";

    if (!slug) {
      slug = slugify(headline);
    } else {
      slug = slugify(slug);
    }

    if (!headline) {
      setMessage("Add a headline before saving.", "error");
      headlineInput?.focus();
      return null;
    }

    if (!slug) {
      setMessage(
        "The headline must contain enough text to create a valid URL.",
        "error"
      );
      slugInput?.focus();
      return null;
    }

    if (requestedStatus === "published") {
      if (!category) {
        setMessage(
          "Choose a category before publishing.",
          "error"
        );
        categoryInput?.focus();
        return null;
      }

      if (!summary) {
        setMessage(
          "Add a story summary before publishing.",
          "error"
        );
        summaryInput?.focus();
        return null;
      }

      if (body.length === 0) {
        setMessage(
          "Write the article body before publishing.",
          "error"
        );
        bodyInput?.focus();
        return null;
      }

      if (
        imageUrlInput?.value.trim() &&
        !imageAltInput?.value.trim()
      ) {
        setMessage(
          "Add alternative text for the featured image.",
          "error"
        );
        imageAltInput?.focus();
        return null;
      }
    }

    if (slugInput) {
      slugInput.value = slug;
    }

    let publishedAt =
      toIsoDate(publishedAtInput?.value ?? "");

    if (requestedStatus === "published" && !publishedAt) {
      publishedAt = new Date().toISOString();

      if (publishedAtInput) {
        publishedAtInput.value =
          toDatetimeLocal(publishedAt);
      }
    }

    const homepageOrderValue =
      homepageOrderInput?.value.trim() ?? "";

    return {
      slug,
      category,
      headline,
      summary,
      author_name: authorName,
      published_at:
        requestedStatus === "published"
          ? publishedAt
          : currentArticleStatus === "published"
            ? publishedAt
            : null,
      image_url: imageUrlInput?.value.trim() || null,
      image_alt: imageAltInput?.value.trim() || null,
      body,
      status: requestedStatus,
      is_featured: isFeaturedInput?.checked ?? false,
      homepage_order: homepageOrderValue
        ? Number(homepageOrderValue)
        : null,
      updated_at: new Date().toISOString(),
    };
  }

  async function saveArticle(
  requestedStatus: "draft" | "published",
  options: {
    isAutosave?: boolean;
  } = {}
): Promise<boolean> {
  if (isSaving) {
    return false;
  }

  const { isAutosave = false } = options;
  const payload = buildPayload(requestedStatus);

  if (!payload) {
    if (isAutosave) {
      setSaveStatus("Autosave paused");
    }

    return false;
  }

  clearAutosaveTimer();

  if (!isAutosave) {
    setMessage("");
  }

  setSavingState(true, isAutosave);

  if (articleId) {
    const { data, error } = await supabaseBrowser
      .from("gazette_articles")
      .update(payload)
      .eq("id", articleId)
      .select("*")
      .single();

    setSavingState(false, isAutosave);

    if (error) {
      hasUnsavedChanges = true;

      if (error.code === "23505") {
        setMessage(
          "That story URL is already being used. Choose a different slug.",
          "error"
        );
      } else if (!isAutosave) {
        setMessage(
          `Unable to save the story: ${error.message}`,
          "error"
        );
      }

      setSaveStatus(
        isAutosave
          ? "Unable to autosave"
          : "Save failed"
      );

      return false;
    }

    const article = data as ArticleRecord;

    updateStatusDisplay(article);
    markCurrentStateAsSaved(article.updated_at);

    if (!isAutosave) {
      setMessage(
        requestedStatus === "published"
          ? "Story published successfully."
          : "Draft saved successfully.",
        "success"
      );
    }

    return true;
  }

  const { data, error } = await supabaseBrowser
    .from("gazette_articles")
    .insert(payload)
    .select("*")
    .single();

  setSavingState(false, isAutosave);

  if (error) {
    hasUnsavedChanges = true;

    if (error.code === "23505") {
      setMessage(
        "That story URL is already being used. Choose a different slug.",
        "error"
      );
    } else {
      setMessage(
        `Unable to create the story: ${error.message}`,
        "error"
      );
    }

    setSaveStatus("Save failed");
    return false;
  }

  const article = data as ArticleRecord;

  articleId = article.id;
  currentArticleStatus =
    article.status === "published"
      ? "published"
      : "draft";

  window.history.replaceState(
    {},
    "",
    `/admin/articles/${article.id}`
  );

  updateStatusDisplay(article);
  markCurrentStateAsSaved(article.updated_at);

  setMessage(
    requestedStatus === "published"
      ? "Story published successfully."
      : "Draft created successfully.",
    "success"
  );

  return true;
}

  async function loadArticle(): Promise<void> {
    if (!articleId) {
  form?.removeAttribute("hidden");

  if (loading) {
    loading.hidden = true;
  }

  lastSavedSnapshot = getEditorSnapshot();
  hasUnsavedChanges = false;
  setSaveStatus("Not yet saved");

  return;
}

    const { data, error } = await supabaseBrowser
      .from("gazette_articles")
      .select("*")
      .eq("id", articleId)
      .maybeSingle();

    if (loading) {
      loading.hidden = true;
    }

    if (error || !data) {
      setMessage(
        error
          ? `Unable to load the story: ${error.message}`
          : "This story could not be found.",
        "error"
      );

      form?.removeAttribute("hidden");
      return;
    }

    populateForm(data as ArticleRecord);
    form?.removeAttribute("hidden");
  }

  async function uploadFeaturedImage(
  file: File
): Promise<void> {
  if (isUploadingImage || isSaving) {
    return;
  }

  const validationError = validateImageFile(file);

  if (validationError) {
    setImageUploadStatus(validationError, "error");

    if (imageFileInput) {
      imageFileInput.value = "";
    }

    return;
  }

  if (
    currentArticleStatus === "published" &&
    !imageAltInput?.value.trim()
  ) {
    setImageUploadStatus(
      "Add alternative text before replacing an image on a published story.",
      "error"
    );

    imageAltInput?.focus();

    if (imageFileInput) {
      imageFileInput.value = "";
    }

    return;
  }

  setImageUploadStatus("");
  setImageUploadState(true);

  if (!articleId) {
    const createdDraft = await saveArticle("draft");

    if (!createdDraft || !articleId) {
      setImageUploadState(false);

      setImageUploadStatus(
        "Save the story before uploading an image. A headline is required.",
        "error"
      );

      if (imageFileInput) {
        imageFileInput.value = "";
      }

      return;
    }
  }

  const previousImageUrl =
    imageUrlInput?.value.trim() ?? "";

  const extension = getFileExtension(file);

  const storagePath =
    `articles/${articleId}/featured-${Date.now()}.${extension}`;

  const { error: uploadError } =
    await supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .upload(storagePath, file, {
        cacheControl: "3600",
        contentType: file.type,
        upsert: false,
      });

  if (uploadError) {
    setImageUploadState(false);

    setImageUploadStatus(
      `Unable to upload image: ${uploadError.message}`,
      "error"
    );

    if (imageFileInput) {
      imageFileInput.value = "";
    }

    return;
  }

  const { data: publicUrlData } =
    supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .getPublicUrl(storagePath);

  const newImageUrl = publicUrlData.publicUrl;

  if (!newImageUrl) {
    await supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .remove([storagePath]);

    setImageUploadState(false);

    setImageUploadStatus(
      "The image uploaded, but its public URL could not be created.",
      "error"
    );

    return;
  }

  if (imageUrlInput) {
    imageUrlInput.value = newImageUrl;
  }

  updateFeaturedImagePreview(
    newImageUrl,
    imageAltInput?.value.trim() ?? ""
  );

  updateDirtyState();

  const saved = await saveArticle(
    currentArticleStatus
  );

  if (!saved) {
    await supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .remove([storagePath]);

    if (imageUrlInput) {
      imageUrlInput.value = previousImageUrl;
    }

    updateFeaturedImagePreview(
      previousImageUrl,
      imageAltInput?.value.trim() ?? ""
    );

    setImageUploadState(false);

    setImageUploadStatus(
      "The upload was reversed because the story could not be saved.",
      "error"
    );

    return;
  }

  if (
    previousImageUrl &&
    previousImageUrl !== newImageUrl
  ) {
    await deleteStoredImage(previousImageUrl);
  }

  setImageUploadState(false);

  setImageUploadStatus(
    previousImageUrl
      ? "Featured image replaced."
      : "Featured image uploaded.",
    "success"
  );

  if (imageFileInput) {
    imageFileInput.value = "";
  }
}

async function removeFeaturedImage(): Promise<void> {
  if (
    isUploadingImage ||
    isSaving ||
    !imageUrlInput?.value
  ) {
    return;
  }

  const confirmed = window.confirm(
    "Remove this featured image from the story?"
  );

  if (!confirmed) {
    return;
  }

  const previousImageUrl =
    imageUrlInput.value.trim();

  const previousImageAlt =
    imageAltInput?.value ?? "";

  setImageUploadState(true);
  setImageUploadStatus("Removing image…");

  imageUrlInput.value = "";

  if (imageAltInput) {
    imageAltInput.value = "";
  }

  updateFeaturedImagePreview("", "");
  updateDirtyState();

  const saved = await saveArticle(
    currentArticleStatus
  );

  if (!saved) {
    imageUrlInput.value = previousImageUrl;

    if (imageAltInput) {
      imageAltInput.value = previousImageAlt;
    }

    updateFeaturedImagePreview(
      previousImageUrl,
      previousImageAlt
    );

    setImageUploadState(false);

    setImageUploadStatus(
      "The image could not be removed because the story did not save.",
      "error"
    );

    return;
  }

  await deleteStoredImage(previousImageUrl);

  setImageUploadState(false);

  setImageUploadStatus(
    "Featured image removed.",
    "success"
  );
}

  function renderPreview(): void {
  const headline =
    headlineInput?.value.trim() || "Untitled story";

  const summary =
    summaryInput?.value.trim() || "";

  const category =
    categoryInput?.value.trim() || "Uncategorized";

  const author =
    authorInput?.value.trim() || "The Gazette Staff";

  const publicationDate =
    publishedAtInput?.value
      ? new Date(publishedAtInput.value)
      : new Date();

  const imageUrl =
    imageUrlInput?.value.trim() || "";

  const imageAlt =
    imageAltInput?.value.trim() || "";

  const paragraphs =
    bodyTextToParagraphs(bodyInput?.value ?? "");

  if (previewHeadline) {
    previewHeadline.textContent = headline;
  }

  if (previewSummary) {
    previewSummary.textContent = summary;
    previewSummary.hidden = !summary;
  }

  if (previewCategory) {
    previewCategory.textContent = category;
  }

  if (previewAuthor) {
    previewAuthor.textContent = author;
  }

  if (previewDate) {
    previewDate.dateTime =
      publicationDate.toISOString();

    previewDate.textContent =
      new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      }).format(publicationDate);
  }

  if (
    previewImageWrapper &&
    previewImage
  ) {
    previewImageWrapper.hidden = !imageUrl;

    if (imageUrl) {
      previewImage.src = imageUrl;
      previewImage.alt = imageAlt;
    } else {
      previewImage.removeAttribute("src");
      previewImage.alt = "";
    }
  }

  if (previewBody) {
    previewBody.replaceChildren();

    for (const paragraphText of paragraphs) {
      const paragraph =
        document.createElement("p");

      paragraph.textContent = paragraphText;
      previewBody.append(paragraph);
    }

    previewBody.hidden = paragraphs.length === 0;
  }

  if (previewEmptyBody) {
    previewEmptyBody.hidden =
      paragraphs.length > 0;
  }
}

function openPreview(): void {
  if (!previewDialog) {
    return;
  }

  renderPreview();
  previewDialog.showModal();
  document.body.classList.add("preview-open");
}

function closePreview(): void {
  if (!previewDialog?.open) {
    return;
  }

  previewDialog.close();
  document.body.classList.remove("preview-open");
}

  async function initializeEditor(): Promise<void> {
    const isAdmin = await verifyAdmin();

    if (!isAdmin) {
      return;
    }

    await loadArticle();
  }

  headlineInput?.addEventListener("input", () => {
  updateEditorTitle();

  if (!slugWasManuallyEdited && slugInput) {
    slugInput.value = slugify(headlineInput.value);
  }

  scheduleAutosave();
});

slugInput?.addEventListener("input", () => {
  slugWasManuallyEdited = true;
  scheduleAutosave();
});

bodyInput?.addEventListener("input", () => {
  updateWritingStats();
  scheduleAutosave();
});

const autosaveInputs = [
  summaryInput,
  categoryInput,
  authorInput,
  publishedAtInput,
  imageUrlInput,
  imageAltInput,
  homepageOrderInput,
];

for (const input of autosaveInputs) {
  input?.addEventListener("input", scheduleAutosave);
  input?.addEventListener("change", scheduleAutosave);
}

imageAltInput?.addEventListener("input", () => {
  if (
    featuredImagePreviewImage &&
    imageUrlInput?.value
  ) {
    featuredImagePreviewImage.alt =
      imageAltInput.value.trim();
  }
});

isFeaturedInput?.addEventListener(
  "change",
  scheduleAutosave
);

uploadImageButton?.addEventListener("click", () => {
  imageFileInput?.click();
});

imageFileInput?.addEventListener("change", () => {
  const file = imageFileInput.files?.[0];

  if (!file) {
    return;
  }

  void uploadFeaturedImage(file);
});

removeImageButton?.addEventListener("click", () => {
  void removeFeaturedImage();
});

saveDraftButton?.addEventListener("click", () => {
  void saveArticle("draft");
});

publishButton?.addEventListener("click", () => {
  void saveArticle("published");
});

previewButton?.addEventListener(
  "click",
  openPreview
);

closePreviewButton?.addEventListener(
  "click",
  closePreview
);

previewDialog?.addEventListener(
  "click",
  (event) => {
    if (event.target === previewDialog) {
      closePreview();
    }
  }
);

previewDialog?.addEventListener(
  "close",
  () => {
    document.body.classList.remove("preview-open");
  }
);

form?.addEventListener("submit", (event) => {
  event.preventDefault();
});

window.addEventListener(
  "beforeunload",
  (event) => {
    const shouldWarn =
      isUploadingImage ||
      (hasUnsavedChanges && !isSaving);

    if (!shouldWarn) {
      return;
    }

    event.preventDefault();
    event.returnValue = "";
  }
);

document.addEventListener(
  "keydown",
  (event) => {
    const usesSaveShortcut =
      (event.metaKey || event.ctrlKey) &&
      event.key.toLowerCase() === "s";

    if (!usesSaveShortcut) {
      return;
    }

    event.preventDefault();

    void saveArticle(
      currentArticleStatus === "published"
        ? "published"
        : "draft"
    );
  }
);

initializeEditor();
</script>


  function slugify(value: string): string {
    return value
      .toLowerCase()
      .trim()
      .replace(/['’]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function getCurrentBody(): RichTextDocument {
    return normalizeArticleBody(richTextEditor?.getJSON());
  }

  function getCurrentBodyText(): string {
    return getPlainTextFromBody(getCurrentBody());
  }

  function formatDisplayDate(value: string | null): string {
    if (!value) {
      return "—";
    }

    return new Intl.DateTimeFormat("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(new Date(value));
  }

  function formatScheduledPublicationDate(value: string): string {
    if (!value) {
      return "the selected publication time";
    }

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return "the selected publication time";
    }

    return new Intl.DateTimeFormat("en-US", {
      dateStyle: "long",
      timeStyle: "short",
    }).format(date);
  }

  function toDatetimeLocal(value: string | null): string {
    if (!value) {
      return "";
    }

    const date = new Date(value);
    const offset = date.getTimezoneOffset();
    const localDate = new Date(date.getTime() - offset * 60_000);

    return localDate.toISOString().slice(0, 16);
  }

  function toIsoDate(value: string): string | null {
    if (!value) {
      return null;
    }

    const parsed = new Date(value);

    if (Number.isNaN(parsed.getTime())) {
      return null;
    }

    return parsed.toISOString();
  }

  const STATUS_LABELS: Record<ArticleStatus, string> = {
    draft: "Draft",
    ready_for_review: "Ready for review",
    scheduled: "Scheduled",
    published: "Published",
    archived: "Archived",
  };

  const STATUS_HELP: Record<ArticleStatus, string> = {
    draft: "Drafts are visible only inside the editorial desk.",
    ready_for_review: "The story is complete and awaiting final approval.",
    scheduled:
      "The story becomes public automatically when its publication date is reached.",
    published: "The story is currently available on the public website.",
    archived: "The story is retained but removed from normal public listings.",
  };

  function isArticleStatus(value: string): value is ArticleStatus {
    return value in STATUS_LABELS;
  }

  function getStatusLabel(status: ArticleStatus): string {
    return STATUS_LABELS[status];
  }

  function isArticlePubliclyAvailable(
    status: ArticleStatus,
    publishedAt: string | null,
  ): boolean {
    if (status !== "published" && status !== "scheduled") {
      return false;
    }

    if (!publishedAt) {
      return false;
    }

    const publicationDate = new Date(publishedAt);

    return (
      !Number.isNaN(publicationDate.getTime()) &&
      publicationDate.getTime() <= Date.now()
    );
  }

  function getArticleStatusLabel(
    status: ArticleStatus,
    publishedAt: string | null,
  ): string {
    if (
      status === "scheduled" &&
      isArticlePubliclyAvailable(status, publishedAt)
    ) {
      return "Live — scheduled";
    }

    return getStatusLabel(status);
  }

  function updateStatusHelp(status: ArticleStatus): void {
    if (articleStatusHelp) {
      articleStatusHelp.textContent = STATUS_HELP[status];
    }
  }

  function updatePrimaryAction(): void {
    if (!publishButton) {
      return;
    }

    const labels: Record<ArticleStatus, string> = {
      draft: currentArticleStatus === "draft" ? "Save draft" : "Move to draft",

      ready_for_review:
        currentArticleStatus === "ready_for_review"
          ? "Save review copy"
          : "Submit for review",

      scheduled:
        currentArticleStatus === "scheduled"
          ? "Update schedule"
          : "Schedule story",

      published:
        currentArticleStatus === "published" ? "Update story" : "Publish now",

      archived:
        currentArticleStatus === "archived"
          ? "Save archived story"
          : "Archive story",
    };

    publishButton.textContent = labels[selectedArticleStatus];
  }

  function getStatusConfirmationConfig(
    currentStatus: ArticleStatus,
    targetStatus: ArticleStatus,
  ): StatusConfirmationConfig | null {
    if (currentStatus === targetStatus) {
      return null;
    }

    const currentStoryIsPublic = isArticlePubliclyAvailable(
      currentStatus,
      currentArticlePublishedAt,
    );

    if (targetStatus === "published") {
      return {
        title: "Publish this story?",
        description:
          "This story will become visible on the public website immediately.",
        confirmLabel: "Publish now",
        tone: "standard",
      };
    }

    if (targetStatus === "scheduled") {
      const publicationDate = formatScheduledPublicationDate(
        publishedAtInput?.value ?? "",
      );

      if (currentStatus === "published") {
        return {
          title: "Replace live publication with a schedule?",
          description: `This story will be removed from the public website now and will become public again on ${publicationDate}.`,
          confirmLabel: "Schedule story",
          tone: "danger",
        };
      }

      return {
        title: "Schedule this story?",
        description: `This story will become publicly available on ${publicationDate}.`,
        confirmLabel: "Schedule story",
        tone: "standard",
      };
    }

    if (targetStatus === "archived") {
      return {
        title: "Archive this story?",
        description: currentStoryIsPublic
          ? "This story will be removed from the public website and retained in the editorial archive."
          : "This story will be moved into the editorial archive.",
        confirmLabel: "Archive story",
        tone: "danger",
      };
    }

    if (currentStoryIsPublic && targetStatus === "draft") {
      return {
        title: "Move this story back to draft?",
        description:
          "This story will be removed from the public website and returned to draft status.",
        confirmLabel: "Move to draft",
        tone: "danger",
      };
    }

    if (currentStoryIsPublic && targetStatus === "ready_for_review") {
      return {
        title: "Return this story to review?",
        description:
          "This story will be removed from the public website and returned to the editorial review queue.",
        confirmLabel: "Return to review",
        tone: "danger",
      };
    }

    return null;
  }

  function requestStatusConfirmation(
    config: StatusConfirmationConfig,
  ): Promise<boolean> {
    if (
      !statusConfirmationDialog ||
      !statusConfirmationTitle ||
      !statusConfirmationDescription ||
      !confirmStatusChangeButton ||
      !cancelStatusChangeButton
    ) {
      return Promise.resolve(window.confirm(config.description));
    }

    statusConfirmationTitle.textContent = config.title;

    statusConfirmationDescription.textContent = config.description;

    confirmStatusChangeButton.textContent = config.confirmLabel;

    confirmStatusChangeButton.dataset.tone = config.tone;

    return new Promise((resolve) => {
      let hasResolved = false;

      const finish = (confirmed: boolean): void => {
        if (hasResolved) {
          return;
        }

        hasResolved = true;

        confirmStatusChangeButton.removeEventListener("click", handleConfirm);

        cancelStatusChangeButton.removeEventListener("click", handleCancel);

        statusConfirmationDialog.removeEventListener(
          "cancel",
          handleDialogCancel,
        );

        statusConfirmationDialog.removeEventListener(
          "close",
          handleDialogClose,
        );

        if (statusConfirmationDialog.open) {
          statusConfirmationDialog.close();
        }

        resolve(confirmed);
      };

      const handleConfirm = (): void => {
        finish(true);
      };

      const handleCancel = (): void => {
        finish(false);
      };

      const handleDialogCancel = (event: Event): void => {
        event.preventDefault();
        finish(false);
      };

      const handleDialogClose = (): void => {
        finish(false);
      };

      confirmStatusChangeButton.addEventListener("click", handleConfirm);

      cancelStatusChangeButton.addEventListener("click", handleCancel);

      statusConfirmationDialog.addEventListener("cancel", handleDialogCancel);

      statusConfirmationDialog.addEventListener("close", handleDialogClose);

      statusConfirmationDialog.showModal();

      cancelStatusChangeButton.focus();
    });
  }

  function statusRequiresPublishingReadiness(status: ArticleStatus): boolean {
    return (
      status === "ready_for_review" ||
      status === "scheduled" ||
      status === "published"
    );
  }

  function getSelectedArticleStatus(): ArticleStatus {
    return selectedArticleStatus;
  }

  function isFuturePublicationDate(value: string): boolean {
    if (!value) {
      return false;
    }

    const publicationDate = new Date(value);

    return (
      !Number.isNaN(publicationDate.getTime()) &&
      publicationDate.getTime() > Date.now()
    );
  }

  function isExistingLiveScheduleUnchanged(): boolean {
    if (
      currentArticleStatus !== "scheduled" ||
      !isArticlePubliclyAvailable(
        currentArticleStatus,
        currentArticlePublishedAt,
      )
    ) {
      return false;
    }

    const selectedValue = publishedAtInput?.value ?? "";

    return selectedValue === toDatetimeLocal(currentArticlePublishedAt);
  }

  function getReadinessRequirements(
    status: ArticleStatus = getSelectedArticleStatus(),
  ): ReadinessRequirement[] {
    const headline = headlineInput?.value.trim() ?? "";

    const slugSource = slugInput?.value.trim() || headline;

    const normalizedSlug = slugify(slugSource);

    const category = categoryInput?.value.trim() ?? "";

    const summary = summaryInput?.value.trim() ?? "";

    const body = getCurrentBody();

    const imageUrl = imageUrlInput?.value.trim() ?? "";

    const imageAlt = imageAltInput?.value.trim() ?? "";

    const requirements: ReadinessRequirement[] = [
      {
        key: "headline",
        label: "Headline added",
        isComplete: Boolean(headline),
      },
      {
        key: "slug",
        label: "Valid story URL created",
        isComplete: Boolean(normalizedSlug),
      },
      {
        key: "category",
        label: "Category selected",
        isComplete: Boolean(category),
      },
      {
        key: "summary",
        label: "Story summary added",
        isComplete: Boolean(summary),
      },
      {
        key: "body",
        label: "Article body written",
        isComplete: bodyHasContent(body),
      },
      {
        key: "image_alt",
        label: "Featured image has alternative text",
        isComplete: !imageUrl || Boolean(imageAlt),
      },
    ];

    if (status === "scheduled") {
      const existingLiveScheduleIsUnchanged = isExistingLiveScheduleUnchanged();

      requirements.push({
        key: "publication_date",
        label: existingLiveScheduleIsUnchanged
          ? "Original publication date retained"
          : "Future publication date selected",
        isComplete:
          existingLiveScheduleIsUnchanged ||
          isFuturePublicationDate(publishedAtInput?.value ?? ""),
      });
    }

    return requirements;
  }

  function renderPublishingReadiness(): void {
    if (!publishingReadinessList || !publishingReadinessSummary) {
      return;
    }

    const requirements = getReadinessRequirements();

    const incompleteCount = requirements.filter(
      (requirement) => !requirement.isComplete,
    ).length;

    publishingReadinessList.replaceChildren();

    for (const requirement of requirements) {
      const item = document.createElement("li");

      item.className = requirement.isComplete
        ? "publishing-readiness__item is-complete"
        : "publishing-readiness__item is-incomplete";

      const icon = document.createElement("span");
      icon.className = "publishing-readiness__icon";
      icon.setAttribute("aria-hidden", "true");
      icon.textContent = requirement.isComplete ? "✓" : "○";

      const label = document.createElement("span");
      label.textContent = requirement.label;

      item.append(icon, label);
      publishingReadinessList.append(item);
    }

    publishingReadinessSummary.classList.toggle(
      "is-ready",
      incompleteCount === 0,
    );

    if (incompleteCount === 0) {
      publishingReadinessSummary.textContent =
        getSelectedArticleStatus() === "scheduled"
          ? "This story is ready to schedule."
          : "This story is ready to publish.";

      return;
    }

    publishingReadinessSummary.textContent = `${incompleteCount} ${
      incompleteCount === 1 ? "item" : "items"
    } remaining before publication.`;
  }

  function focusReadinessRequirement(key: ReadinessRequirementKey): void {
    switch (key) {
      case "headline":
        headlineInput?.focus();
        break;

      case "slug":
        slugInput?.focus();
        break;

      case "category":
        categoryInput?.focus();
        break;

      case "summary":
        summaryInput?.focus();
        break;

      case "body":
        richTextEditor?.commands.focus();
        break;

      case "image_alt":
        imageAltInput?.focus();
        break;

      case "publication_date":
        publishedAtInput?.focus();
        break;
    }
  }

  function getReadinessErrorMessage(key: ReadinessRequirementKey): string {
    const messages: Record<ReadinessRequirementKey, string> = {
      headline: "Add a headline before publishing.",
      slug: "Create a valid story URL before publishing.",
      category: "Choose a category before publishing.",
      summary: "Add a story summary before publishing.",
      body: "Write the article body before publishing.",
      image_alt: "Add alternative text for the featured image.",
      publication_date: "Choose a future publication date before scheduling.",
    };

    return messages[key];
  }

  function validatePublishingReadiness(status: ArticleStatus): boolean {
    const firstIncomplete = getReadinessRequirements(status).find(
      (requirement) => !requirement.isComplete,
    );

    if (!firstIncomplete) {
      return true;
    }

    setMessage(getReadinessErrorMessage(firstIncomplete.key), "error");

    focusReadinessRequirement(firstIncomplete.key);

    return false;
  }

  function updateToolbarState(): void {
    if (!richTextEditor) {
      return;
    }

    for (const button of editorToolbarButtons) {
      const command = button.dataset.editorCommand;

      let isActive = false;
      let isDisabled = false;

      switch (command) {
        case "bold":
          isActive = richTextEditor.isActive("bold");
          break;

        case "italic":
          isActive = richTextEditor.isActive("italic");
          break;

        case "link":
          isActive = richTextEditor.isActive("link");
          break;

        case "heading-2":
          isActive = richTextEditor.isActive("heading", { level: 2 });
          break;

        case "heading-3":
          isActive = richTextEditor.isActive("heading", { level: 3 });
          break;

        case "bullet-list":
          isActive = richTextEditor.isActive("bulletList");
          break;

        case "ordered-list":
          isActive = richTextEditor.isActive("orderedList");
          break;

        case "blockquote":
          isActive = richTextEditor.isActive("blockquote");
          break;

        case "undo":
          isDisabled = !richTextEditor.can().chain().focus().undo().run();
          break;

        case "redo":
          isDisabled = !richTextEditor.can().chain().focus().redo().run();
          break;
      }

      button.classList.toggle("is-active", isActive);

      if (
        command !== "undo" &&
        command !== "redo" &&
        command !== "horizontal-rule"
      ) {
        button.setAttribute("aria-pressed", String(isActive));
      }

      button.disabled = isDisabled;
    }
  }

  function editSelectedLink(): void {
    if (!richTextEditor) {
      return;
    }

    const currentHref = richTextEditor.getAttributes("link").href;

    const enteredUrl = window.prompt(
      "Enter the destination URL. Leave blank to remove the current link.",
      typeof currentHref === "string" ? currentHref : "https://",
    );

    if (enteredUrl === null) {
      return;
    }

    const url = enteredUrl.trim();

    if (!url) {
      richTextEditor.chain().focus().extendMarkRange("link").unsetLink().run();

      return;
    }

    richTextEditor
      .chain()
      .focus()
      .extendMarkRange("link")
      .setLink({
        href: url,
        target: "_blank",
        rel: "noopener noreferrer",
      })
      .run();
  }

  function runEditorCommand(command: string): void {
    if (!richTextEditor) {
      return;
    }

    switch (command) {
      case "bold":
        richTextEditor.chain().focus().toggleBold().run();
        break;

      case "italic":
        richTextEditor.chain().focus().toggleItalic().run();
        break;

      case "link":
        editSelectedLink();
        break;

      case "heading-2":
        richTextEditor.chain().focus().toggleHeading({ level: 2 }).run();
        break;

      case "heading-3":
        richTextEditor.chain().focus().toggleHeading({ level: 3 }).run();
        break;

      case "bullet-list":
        richTextEditor.chain().focus().toggleBulletList().run();
        break;

      case "ordered-list":
        richTextEditor.chain().focus().toggleOrderedList().run();
        break;

      case "blockquote":
        richTextEditor.chain().focus().toggleBlockquote().run();
        break;

      case "horizontal-rule":
        richTextEditor.chain().focus().setHorizontalRule().run();
        break;

      case "undo":
        richTextEditor.chain().focus().undo().run();
        break;

      case "redo":
        richTextEditor.chain().focus().redo().run();
        break;
    }

    updateToolbarState();
  }

  function initializeRichTextEditor(): void {
    if (!bodyEditorElement || richTextEditor) {
      return;
    }

    richTextEditor = new Editor({
      element: bodyEditorElement,

      extensions: [
        StarterKit.configure({
          heading: {
            levels: [2, 3],
          },
        }),

        Link.configure({
          openOnClick: false,
          autolink: true,
          linkOnPaste: true,
          HTMLAttributes: {
            rel: "noopener noreferrer",
            target: "_blank",
          },
        }),
      ],

      content: normalizeArticleBody(null),

      editorProps: {
        attributes: {
          class: "article-writing-surface",
          "aria-label": "Article body",
          spellcheck: "true",
        },
      },

      onCreate: () => {
        updateWritingStats();
        updateToolbarState();
        renderPublishingReadiness();
      },

      onUpdate: () => {
        if (isHydrating) {
          return;
        }

        updateWritingStats();
        renderPublishingReadiness();
        scheduleAutosave();
      },

      onSelectionUpdate: () => {
        updateToolbarState();
      },

      onTransaction: () => {
        updateToolbarState();
      },
    });
  }

  function getEditorSnapshot(): string {
    return JSON.stringify({
      headline: headlineInput?.value ?? "",
      summary: summaryInput?.value ?? "",
      body: getCurrentBody(),
      category: categoryInput?.value ?? "",
      authorName: authorInput?.value ?? "",
      slug: slugInput?.value ?? "",
      publishedAt: publishedAtInput?.value ?? "",
      imageUrl: imageUrlInput?.value ?? "",
      imageAlt: imageAltInput?.value ?? "",
      isFeatured: isFeaturedInput?.checked ?? false,
      homepageOrder: homepageOrderInput?.value ?? "",
    });
  }

  function setSaveStatus(text: string): void {
    if (saveStatus) {
      saveStatus.textContent = text;
    }
  }

  function markCurrentStateAsSaved(
    savedAt: string = new Date().toISOString(),
  ): void {
    lastSavedSnapshot = getEditorSnapshot();
    hasUnsavedChanges = false;

    setSaveStatus(`Saved ${formatDisplayDate(savedAt)}`);
  }

  function updateDirtyState(): void {
    if (isHydrating) {
      return;
    }

    const currentSnapshot = getEditorSnapshot();

    hasUnsavedChanges = currentSnapshot !== lastSavedSnapshot;

    if (hasUnsavedChanges) {
      setSaveStatus(articleId ? "Unsaved changes" : "Not yet saved");
    }
  }

  function clearAutosaveTimer(): void {
    if (autosaveTimer !== undefined) {
      window.clearTimeout(autosaveTimer);
      autosaveTimer = undefined;
    }
  }

  function setImageUploadStatus(
    text: string,
    type: "error" | "success" | "neutral" = "neutral",
  ): void {
    if (!imageUploadStatus) {
      return;
    }

    imageUploadStatus.textContent = text;
    imageUploadStatus.dataset.type = type;
  }

  function setImageUploadState(uploading: boolean): void {
    isUploadingImage = uploading;

    if (uploadImageButton) {
      uploadImageButton.disabled = uploading;
      uploadImageButton.textContent = uploading
        ? "Uploading…"
        : imageUrlInput?.value
          ? "Replace image"
          : "Upload image";
    }

    if (removeImageButton) {
      removeImageButton.disabled = uploading;
    }
  }

  function updateFeaturedImagePreview(imageUrl: string, imageAlt = ""): void {
    const hasImage = Boolean(imageUrl);

    if (featuredImagePreview) {
      featuredImagePreview.hidden = !hasImage;
    }

    if (featuredImageEmpty) {
      featuredImageEmpty.hidden = hasImage;
    }

    if (removeImageButton) {
      removeImageButton.hidden = !hasImage;
    }

    if (uploadImageButton) {
      uploadImageButton.textContent = hasImage
        ? "Replace image"
        : "Upload image";
    }

    if (featuredImagePreviewImage) {
      if (hasImage) {
        featuredImagePreviewImage.src = imageUrl;
        featuredImagePreviewImage.alt = imageAlt;
      } else {
        featuredImagePreviewImage.removeAttribute("src");
        featuredImagePreviewImage.alt = "";
      }
    }

    renderPublishingReadiness();
  }

  function renderImageLibrary(): void {
    if (!imageLibraryGrid) return;
    const query = imageLibrarySearch?.value.trim().toLowerCase() ?? "";
    const visible = libraryImages.filter((image) =>
      !query || image.headline.toLowerCase().includes(query) ||
      image.image_alt?.toLowerCase().includes(query)
    );
    imageLibraryGrid.replaceChildren();
    for (const image of visible) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "image-library-item";
      const preview = document.createElement("img");
      preview.src = image.image_url;
      preview.alt = image.image_alt ?? "";
      preview.loading = "lazy";
      const copy = document.createElement("span");
      const title = document.createElement("strong");
      title.textContent = image.headline;
      const description = document.createElement("small");
      description.textContent = image.image_alt || "No alternative text saved";
      copy.append(title, description);
      button.append(preview, copy);
      button.addEventListener("click", () => {
        if (imageUrlInput) imageUrlInput.value = image.image_url;
        if (imageAltInput && !imageAltInput.value.trim() && image.image_alt) imageAltInput.value = image.image_alt;
        updateFeaturedImagePreview(image.image_url, imageAltInput?.value.trim() ?? "");
        updateDirtyState();
        scheduleAutosave();
        imageLibraryDialog?.close();
        setImageUploadStatus("Existing artwork selected.", "success");
      });
      imageLibraryGrid.append(button);
    }
    if (imageLibraryMessage) imageLibraryMessage.textContent = visible.length ? "" : "No artwork matches this search.";
  }

  async function openImageLibrary(): Promise<void> {
    if (!imageLibraryDialog) return;
    imageLibraryDialog.showModal();
    if (imageLibraryMessage) imageLibraryMessage.textContent = "Loading artwork…";
    const { data, error } = await supabaseBrowser
      .from("gazette_articles")
      .select("image_url,image_alt,headline")
      .not("image_url", "is", null)
      .neq("status", "archived")
      .order("updated_at", { ascending: false });
    if (error) {
      if (imageLibraryMessage) imageLibraryMessage.textContent = `Unable to load artwork: ${error.message}`;
      return;
    }
    const seen = new Set<string>();
    libraryImages = (data ?? []).flatMap((image) => {
      if (!image.image_url || seen.has(image.image_url)) return [];
      seen.add(image.image_url);
      return [{ image_url: image.image_url, image_alt: image.image_alt, headline: image.headline }];
    });
    renderImageLibrary();
  }

  function getFileExtension(file: File): string {
    const extensionByType: Record<string, string> = {
      "image/jpeg": "jpg",
      "image/png": "png",
      "image/webp": "webp",
    };

    return extensionByType[file.type] ?? "jpg";
  }

  function validateImageFile(file: File): string | null {
    if (!ALLOWED_IMAGE_TYPES.has(file.type)) {
      return "Choose a JPEG, PNG, or WebP image.";
    }

    if (file.size > MAX_IMAGE_SIZE) {
      return "The selected image is larger than 6 MB.";
    }

    return null;
  }

  function getStoragePathFromPublicUrl(imageUrl: string): string | null {
    if (!imageUrl) {
      return null;
    }

    try {
      const url = new URL(imageUrl);

      const marker = `/storage/v1/object/public/${IMAGE_BUCKET}/`;

      const markerIndex = url.pathname.indexOf(marker);

      if (markerIndex === -1) {
        return null;
      }

      const encodedPath = url.pathname.slice(markerIndex + marker.length);

      return decodeURIComponent(encodedPath);
    } catch {
      return null;
    }
  }

  async function deleteStoredImage(imageUrl: string): Promise<void> {
    const storagePath = getStoragePathFromPublicUrl(imageUrl);

    if (!storagePath) {
      return;
    }

    const { count } = await supabaseBrowser
      .from("gazette_articles")
      .select("id", { count: "exact", head: true })
      .eq("image_url", imageUrl)
      .neq("id", articleId || "00000000-0000-0000-0000-000000000000");

    if ((count ?? 0) > 0) {
      return;
    }

    const { error } = await supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .remove([storagePath]);

    if (error) {
      console.error("Unable to remove previous Gazette image:", error);
    }
  }

  function scheduleAutosave(): void {
    renderPublishingReadiness();
    updateDirtyState();
    clearAutosaveTimer();

    if (!articleId || !hasUnsavedChanges || isSaving) {
      return;
    }

    autosaveTimer = window.setTimeout(() => {
      void saveArticle(currentArticleStatus, {
        isAutosave: true,
      });
    }, AUTOSAVE_DELAY);
  }

  function setMessage(
    text: string,
    type: "error" | "success" | "neutral" = "neutral",
  ): void {
    if (!message) {
      return;
    }

    message.textContent = text;
    message.dataset.type = type;
  }

  function setSavingState(saving: boolean, isAutosave = false): void {
    isSaving = saving;

    if (saveDraftButton) {
      saveDraftButton.disabled = saving;
      saveDraftButton.textContent = saving ? "Saving…" : "Save changes";
    }

    if (publishButton) {
      publishButton.disabled = saving;

      if (saving) {
        const savingLabels: Record<ArticleStatus, string> = {
          draft: "Saving…",
          ready_for_review: "Submitting…",
          scheduled: "Scheduling…",
          published: "Publishing…",
          archived: "Archiving…",
        };

        publishButton.textContent = savingLabels[selectedArticleStatus];
      } else {
        updatePrimaryAction();
      }
    }

    if (previewButton) {
      previewButton.disabled = saving;
    }

    if (approvePublishButton) {
      approvePublishButton.disabled = saving;
      const label = approvePublishButton.querySelector("span");
      if (label) label.textContent = saving ? "Publishing…" : "Approve & Publish";
    }
    if (returnChangesButton) returnChangesButton.disabled = saving;

    if (saving) {
      setSaveStatus(isAutosave ? "Autosaving…" : "Saving…");
    }
  }

  function updateWritingStats(): void {
    const text = getCurrentBodyText().trim();

    const words = text ? text.split(/\s+/).filter(Boolean).length : 0;

    const minutes = words === 0 ? 0 : Math.max(1, Math.ceil(words / 225));

    if (wordCount) {
      wordCount.textContent = `${words} ${words === 1 ? "word" : "words"}`;
    }

    if (readingTime) {
      readingTime.textContent = `${minutes} min read`;
    }
  }

  function updateEditorTitle(): void {
    if (!pageTitle) {
      return;
    }

    const headline = headlineInput?.value.trim();

    pageTitle.textContent = headline || "Untitled story";
  }

  function updateStatusDisplay(
    article: ArticleRecord,
    options: {
      syncSelectedStatus?: boolean;
    } = {},
  ): void {
    const { syncSelectedStatus = true } = options;

    currentArticleStatus = article.status;
    currentArticlePublishedAt = article.published_at;

    if (syncSelectedStatus) {
      selectedArticleStatus = article.status;

      if (articleStatusInput) {
        articleStatusInput.value = article.status;
      }

      updateStatusHelp(article.status);
    }

    if (statusPanel) {
      statusPanel.hidden = false;
    }

    if (currentStatus) {
      currentStatus.textContent = getArticleStatusLabel(
        article.status,
        article.published_at,
      );
    }

    if (createdDate) {
      createdDate.textContent = formatDisplayDate(article.created_at);
    }

    if (updatedDate) {
      updatedDate.textContent = formatDisplayDate(article.updated_at);
    }

    updatePrimaryAction();

    if (reviewWorkflow) reviewWorkflow.hidden = isOpEdContributor || article.status !== "ready_for_review";

    if (viewPublishedStory) {
      const canView =
        Boolean(article.slug) &&
        isArticlePubliclyAvailable(article.status, article.published_at);

      viewPublishedStory.hidden = !canView;

      if (canView) {
        viewPublishedStory.href = `/gazette/${article.slug}`;
      }
    }

    if (deleteStoryPanel) {
      deleteStoryPanel.hidden = !article.id;
    }

    markCurrentStateAsSaved(article.updated_at);
  }

  async function loadReviewHistory(): Promise<void> {
    if (!articleId || !reviewHistory || !reviewHistoryList) return;
    const { data, error } = await supabaseBrowser
      .from("editorial_review_events")
      .select("id,action,note,created_at")
      .eq("article_id", articleId)
      .order("created_at", { ascending: false });
    if (error || !data?.length) { reviewHistory.hidden = true; return; }
    reviewHistoryList.replaceChildren();
    const labels: Record<string, string> = { submitted: "Submitted for review", changes_requested: "Changes requested", approved: "Approved and published" };
    for (const event of data as ReviewEvent[]) {
      const item = document.createElement("article"); item.className = `review-event review-event--${event.action}`;
      const heading = document.createElement("div");
      const title = document.createElement("h3"); title.textContent = labels[event.action] ?? "Editorial update";
      const date = document.createElement("time"); date.dateTime = event.created_at; date.textContent = formatDisplayDate(event.created_at);
      heading.append(title, date); item.append(heading);
      if (event.note) { const note = document.createElement("p"); note.textContent = event.note; item.append(note); }
      reviewHistoryList.append(item);
    }
    reviewHistory.hidden = false;
  }

  async function verifyAdmin(): Promise<boolean> {
    const {
      data: { user },
      error: userError,
    } = await supabaseBrowser.auth.getUser();

    if (userError || !user) {
      window.location.replace("/admin/login");
      return false;
    }

    currentUserId = user.id;

    const { data: adminRecord, error: adminError } = await supabaseBrowser
      .from("admin_users")
      .select("user_id")
      .eq("user_id", user.id)
      .maybeSingle();

    if (!adminError && adminRecord) {
      if (chooseLibraryImageButton) chooseLibraryImageButton.hidden = false;
      return true;
    }

    const { data: contributor } = await supabaseBrowser
      .from("publication_contributors")
      .select("display_name, role")
      .eq("user_id", user.id)
      .eq("role", "op_ed")
      .maybeSingle();

    if (!contributor) {
      await supabaseBrowser.auth.signOut();
      window.location.replace("/admin/login");
      return false;
    }

    isOpEdContributor = true;
    contributorDisplayName = contributor.display_name;
    return true;
  }

  function applyContributorEditor(): void {
    if (!isOpEdContributor) return;
    if (categoryInput) { categoryInput.value = "Op-Ed"; categoryInput.readOnly = true; }
    if (authorInput) { authorInput.value = contributorDisplayName; authorInput.readOnly = true; }
    if (articleStatusInput) {
      for (const option of Array.from(articleStatusInput.options)) {
        if (option.value !== "draft" && option.value !== "ready_for_review") option.remove();
      }
    }
    if (publicationDateField) publicationDateField.hidden = true;
    if (homepagePlacementPanel) homepagePlacementPanel.hidden = true;
    if (cancelEditor) { cancelEditor.href = "/admin/articles"; cancelEditor.textContent = "My stories"; }
    if (pageTitle && mode === "create") pageTitle.textContent = "Op-Ed draft";
    updatePrimaryAction();
    renderPublishingReadiness();
  }

  function populateForm(article: ArticleRecord): void {
    isHydrating = true;

    if (headlineInput) {
      headlineInput.value = article.headline;
    }

    if (summaryInput) {
      summaryInput.value = article.summary;
    }

    richTextEditor?.commands.setContent(normalizeArticleBody(article.body), {
      emitUpdate: false,
    });

    if (categoryInput) {
      categoryInput.value = article.category;
    }

    if (authorInput) {
      authorInput.value = article.author_name;
    }

    if (slugInput) {
      slugInput.value = article.slug;
    }

    currentArticleStatus = article.status;
    selectedArticleStatus = article.status;

    if (articleStatusInput) {
      articleStatusInput.value = article.status;
    }

    updateStatusHelp(article.status);
    updatePrimaryAction();

    if (publishedAtInput) {
      publishedAtInput.value = toDatetimeLocal(article.published_at);
    }

    if (imageUrlInput) {
      imageUrlInput.value = article.image_url ?? "";
    }

    if (imageAltInput) {
      imageAltInput.value = article.image_alt ?? "";
    }

    updateFeaturedImagePreview(
      article.image_url ?? "",
      article.image_alt ?? "",
    );

    if (isFeaturedInput) {
      isFeaturedInput.checked = article.is_featured;
    }

    if (homepageOrderInput) {
      homepageOrderInput.value =
        article.homepage_order === null ? "" : String(article.homepage_order);
    }

    updateEditorTitle();
    updateWritingStats();
    renderPublishingReadiness();
    updateStatusDisplay(article);

    isHydrating = false;
    markCurrentStateAsSaved(article.updated_at);
  }

  function buildPayload(
    requestedStatus: ArticleStatus,
    options: {
      applyWorkflowRules?: boolean;
    } = {},
  ): ArticlePayload | null {
    const { applyWorkflowRules = false } = options;

    const headline = headlineInput?.value.trim() ?? "";
    const summary = summaryInput?.value.trim() ?? "";
    const category = isOpEdContributor ? "Op-Ed" : categoryInput?.value.trim() ?? "";
    const authorName = isOpEdContributor
      ? contributorDisplayName
      : authorInput?.value.trim() || "The Gazette Staff";

    if (
      isOpEdContributor &&
      requestedStatus !== "draft" &&
      requestedStatus !== "ready_for_review"
    ) {
      setMessage("Contributors can save drafts or submit Op-Eds for review. An admin must publish the story.", "error");
      return null;
    }

    const body = getCurrentBody();

    let slug = slugInput?.value.trim() ?? "";

    if (!slug) {
      slug = slugify(headline);
    } else {
      slug = slugify(slug);
    }

    if (!headline) {
      setMessage("Add a headline before saving.", "error");
      headlineInput?.focus();
      return null;
    }

    if (!slug) {
      setMessage(
        "The headline must contain enough text to create a valid URL.",
        "error",
      );
      slugInput?.focus();
      return null;
    }

    const requiresPublishingReadiness =
      requestedStatus === "published" ||
      requestedStatus === "scheduled" ||
      requestedStatus === "ready_for_review";

    if (
      requiresPublishingReadiness &&
      !validatePublishingReadiness(requestedStatus)
    ) {
      return null;
    }

    if (slugInput) {
      slugInput.value = slug;
    }

    const selectedPublicationDate = toIsoDate(publishedAtInput?.value ?? "");

    const isStatusTransition = requestedStatus !== currentArticleStatus;

    let publishedAt: string | null = selectedPublicationDate;

    if (applyWorkflowRules) {
      switch (requestedStatus) {
        case "draft":
        case "ready_for_review":
          publishedAt = isStatusTransition ? null : selectedPublicationDate;
          break;

        case "scheduled":
          publishedAt = selectedPublicationDate;
          break;

        case "published":
          publishedAt = isStatusTransition
            ? new Date().toISOString()
            : currentArticlePublishedAt;
          break;

        case "archived":
          publishedAt = isStatusTransition
            ? currentArticlePublishedAt
            : currentArticlePublishedAt;
          break;
      }
    }

    if (applyWorkflowRules && publishedAtInput) {
      publishedAtInput.value = toDatetimeLocal(publishedAt);
    }

    const homepageOrderValue = homepageOrderInput?.value.trim() ?? "";

    return {
      slug,
      category,
      headline,
      summary,
      author_name: authorName,
      published_at: isOpEdContributor ? null : publishedAt,
      image_url: imageUrlInput?.value.trim() || null,
      image_alt: imageAltInput?.value.trim() || null,
      body: body as unknown as Json,
      status: requestedStatus,
      is_featured: isOpEdContributor ? false : isFeaturedInput?.checked ?? false,
      homepage_order: isOpEdContributor
        ? null
        : homepageOrderValue
          ? Number(homepageOrderValue)
          : null,
      updated_at: new Date().toISOString(),
      ...(articleId ? {} : { created_by: currentUserId }),
    };
  }

  async function saveArticle(
    requestedStatus: ArticleStatus,
    options: {
      isAutosave?: boolean;
      applyWorkflowRules?: boolean;
    } = {},
  ): Promise<boolean> {
    if (isSaving) {
      return false;
    }

    const { isAutosave = false, applyWorkflowRules = false } = options;

    const statusBeforeSave = currentArticleStatus;

    const payload = buildPayload(requestedStatus, {
      applyWorkflowRules,
    });

    if (!payload) {
      if (isAutosave) {
        setSaveStatus("Autosave paused");
      }

      return false;
    }

    clearAutosaveTimer();

    if (!isAutosave) {
      setMessage("");
    }

    setSavingState(true, isAutosave);

    if (articleId) {
      const { data, error } = await supabaseBrowser
        .from("gazette_articles")
        .update(payload)
        .eq("id", articleId)
        .select("*")
        .single();

      setSavingState(false, isAutosave);

      if (error) {
        hasUnsavedChanges = true;

        if (error.code === "23505") {
          setMessage(
            "That story URL is already being used. Choose a different slug.",
            "error",
          );
        } else if (!isAutosave) {
          setMessage(`Unable to save the story: ${error.message}`, "error");
        }

        setSaveStatus(isAutosave ? "Unable to autosave" : "Save failed");

        return false;
      }

      const article = data as ArticleRecord;

      updateStatusDisplay(article, {
        syncSelectedStatus: !isAutosave,
      });

      markCurrentStateAsSaved(article.updated_at);

      if (isAutosave) {
        setMessage("");
      } else {
        const statusChanged = statusBeforeSave !== requestedStatus;

        if (!statusChanged) {
          setMessage("Story saved successfully.", "success");
        } else {
          const transitionMessages: Record<ArticleStatus, string> = {
            draft: "Story moved to draft.",
            ready_for_review: "Story submitted for review.",
            scheduled: "Story scheduled successfully.",
            published: "Story published successfully.",
            archived: "Story archived successfully.",
          };

          setMessage(transitionMessages[requestedStatus], "success");
        }
      }

      return true;
    }

    const { data, error } = await supabaseBrowser
      .from("gazette_articles")
      .insert(payload)
      .select("*")
      .single();

    setSavingState(false, isAutosave);

    if (error) {
      hasUnsavedChanges = true;

      if (error.code === "23505") {
        setMessage(
          "That story URL is already being used. Choose a different slug.",
          "error",
        );
      } else {
        setMessage(`Unable to create the story: ${error.message}`, "error");
      }

      setSaveStatus("Save failed");
      return false;
    }

    const article = data as ArticleRecord;

    articleId = article.id;
    currentArticleStatus = article.status;

    window.history.replaceState({}, "", `/admin/articles/${article.id}`);

    updateStatusDisplay(article);
    markCurrentStateAsSaved(article.updated_at);

    const creationMessages: Record<ArticleStatus, string> = {
      draft: "Draft created successfully.",
      ready_for_review: "Story created and submitted for review.",
      scheduled: "Story created and scheduled.",
      published: "Story published successfully.",
      archived: "Archived story created.",
    };

    setMessage(creationMessages[requestedStatus], "success");

    return true;
  }

  async function deleteArticle(): Promise<void> {
  if (!articleId || isSaving || isUploadingImage) {
    return;
  }

  const isPublic = isArticlePubliclyAvailable(
    currentArticleStatus,
    currentArticlePublishedAt
  );

  const confirmed = await requestStatusConfirmation({
    title: "Permanently delete this story?",
    description: isPublic
      ? "This story will immediately disappear from the public website. Its featured image will also be removed. This action cannot be undone."
      : "This story and its featured image will be permanently removed. This action cannot be undone.",
    confirmLabel: "Delete permanently",
    tone: "danger",
  });

  if (!confirmed) {
    return;
  }

  clearAutosaveTimer();
  setSavingState(true);
  setMessage("");

  const imageUrl = imageUrlInput?.value.trim() ?? "";

  const { error } = await supabaseBrowser
    .from("gazette_articles")
    .delete()
    .eq("id", articleId);

  if (error) {
    setSavingState(false);

    setMessage(
      `Unable to delete the story: ${error.message}`,
      "error"
    );

    return;
  }

  if (imageUrl) {
    try {
      await deleteStoredImage(imageUrl);
    } catch (error) {
      console.warn(
        "Unable to remove featured image after article deletion.",
        error
      );
    }
  }

  window.location.href =
    "/admin/articles?message=story-deleted";
}

  async function loadArticle(): Promise<void> {
    if (!articleId) {
      form?.removeAttribute("hidden");

      if (loading) {
        loading.hidden = true;
      }

      lastSavedSnapshot = getEditorSnapshot();
      hasUnsavedChanges = false;
      setSaveStatus("Not yet saved");

      currentArticleStatus = "draft";
      selectedArticleStatus = "draft";
      currentArticlePublishedAt = null;
      updatePrimaryAction();

      renderPublishingReadiness();
      return;
    }

    const { data, error } = await supabaseBrowser
      .from("gazette_articles")
      .select("*")
      .eq("id", articleId)
      .maybeSingle();

    if (loading) {
      loading.hidden = true;
    }

    if (error || !data) {
      setMessage(
        error
          ? `Unable to load the story: ${error.message}`
          : "This story could not be found.",
        "error",
      );

      form?.removeAttribute("hidden");
      return;
    }

    if (isOpEdContributor && data.status !== "draft" && data.status !== "ready_for_review") {
      window.location.replace(data.slug ? `/gazette/${data.slug}` : "/admin/articles");
      return;
    }

    populateForm(data as ArticleRecord);
    await loadReviewHistory();
    form?.removeAttribute("hidden");
  }

  async function uploadFeaturedImage(file: File): Promise<void> {
    if (isUploadingImage || isSaving) {
      return;
    }

    const validationError = validateImageFile(file);

    if (validationError) {
      setImageUploadStatus(validationError, "error");

      if (imageFileInput) {
        imageFileInput.value = "";
      }

      return;
    }

    if (
      isArticlePubliclyAvailable(
        currentArticleStatus,
        toIsoDate(publishedAtInput?.value ?? ""),
      ) &&
      !imageAltInput?.value.trim()
    ) {
      setImageUploadStatus(
        "Add alternative text before replacing an image on a live story.",
        "error",
      );

      imageAltInput?.focus();

      if (imageFileInput) {
        imageFileInput.value = "";
      }

      return;
    }

    setImageUploadStatus("");
    setImageUploadState(true);

    if (!articleId) {
      const createdDraft = await saveArticle("draft");

      if (!createdDraft || !articleId) {
        setImageUploadState(false);

        setImageUploadStatus(
          "Save the story before uploading an image. A headline is required.",
          "error",
        );

        if (imageFileInput) {
          imageFileInput.value = "";
        }

        return;
      }
    }

    const previousImageUrl = imageUrlInput?.value.trim() ?? "";

    const extension = getFileExtension(file);

    const storagePath = `articles/${articleId}/featured-${Date.now()}.${extension}`;

    const { error: uploadError } = await supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .upload(storagePath, file, {
        cacheControl: "3600",
        contentType: file.type,
        upsert: false,
      });

    if (uploadError) {
      setImageUploadState(false);

      setImageUploadStatus(
        `Unable to upload image: ${uploadError.message}`,
        "error",
      );

      if (imageFileInput) {
        imageFileInput.value = "";
      }

      return;
    }

    const { data: publicUrlData } = supabaseBrowser.storage
      .from(IMAGE_BUCKET)
      .getPublicUrl(storagePath);

    const newImageUrl = publicUrlData.publicUrl;

    if (!newImageUrl) {
      await supabaseBrowser.storage.from(IMAGE_BUCKET).remove([storagePath]);

      setImageUploadState(false);

      setImageUploadStatus(
        "The image uploaded, but its public URL could not be created.",
        "error",
      );

      return;
    }

    if (imageUrlInput) {
      imageUrlInput.value = newImageUrl;
    }

    updateFeaturedImagePreview(newImageUrl, imageAltInput?.value.trim() ?? "");

    updateDirtyState();

    const saved = await saveArticle(currentArticleStatus);

    if (!saved) {
      await supabaseBrowser.storage.from(IMAGE_BUCKET).remove([storagePath]);

      if (imageUrlInput) {
        imageUrlInput.value = previousImageUrl;
      }

      updateFeaturedImagePreview(
        previousImageUrl,
        imageAltInput?.value.trim() ?? "",
      );

      setImageUploadState(false);

      setImageUploadStatus(
        "The upload was reversed because the story could not be saved.",
        "error",
      );

      return;
    }

    if (previousImageUrl && previousImageUrl !== newImageUrl) {
      await deleteStoredImage(previousImageUrl);
    }

    setImageUploadState(false);

    setImageUploadStatus(
      previousImageUrl
        ? "Featured image replaced."
        : "Featured image uploaded.",
      "success",
    );

    if (imageFileInput) {
      imageFileInput.value = "";
    }
  }

  async function removeFeaturedImage(): Promise<void> {
    if (isUploadingImage || isSaving || !imageUrlInput?.value) {
      return;
    }

    const confirmed = window.confirm(
      "Remove this featured image from the story?",
    );

    if (!confirmed) {
      return;
    }

    const previousImageUrl = imageUrlInput.value.trim();

    const previousImageAlt = imageAltInput?.value ?? "";

    setImageUploadState(true);
    setImageUploadStatus("Removing image…");

    imageUrlInput.value = "";

    if (imageAltInput) {
      imageAltInput.value = "";
    }

    updateFeaturedImagePreview("", "");
    updateDirtyState();

    const saved = await saveArticle(currentArticleStatus);

    if (!saved) {
      imageUrlInput.value = previousImageUrl;

      if (imageAltInput) {
        imageAltInput.value = previousImageAlt;
      }

      updateFeaturedImagePreview(previousImageUrl, previousImageAlt);

      setImageUploadState(false);

      setImageUploadStatus(
        "The image could not be removed because the story did not save.",
        "error",
      );

      return;
    }

    await deleteStoredImage(previousImageUrl);

    setImageUploadState(false);

    setImageUploadStatus("Featured image removed.", "success");
  }

  function renderPreview(): void {
    const headline = headlineInput?.value.trim() || "Untitled story";

    const summary = summaryInput?.value.trim() || "";

    const category = categoryInput?.value.trim() || "Uncategorized";

    const author = authorInput?.value.trim() || "The Gazette Staff";

    const publicationDate = publishedAtInput?.value
      ? new Date(publishedAtInput.value)
      : new Date();

    const imageUrl = imageUrlInput?.value.trim() || "";

    const imageAlt = imageAltInput?.value.trim() || "";

    const body = getCurrentBody();
    const hasBody = bodyHasContent(body);
    const bodyHtml = richTextEditor?.getHTML() ?? "";

    if (previewHeadline) {
      previewHeadline.textContent = headline;
    }

    if (previewSummary) {
      previewSummary.textContent = summary;
      previewSummary.hidden = !summary;
    }

    if (previewCategory) {
      previewCategory.textContent = category;
    }

    if (previewAuthor) {
      previewAuthor.textContent = author;
    }

    if (previewDate) {
      previewDate.dateTime = publicationDate.toISOString();

      previewDate.textContent = new Intl.DateTimeFormat("en-US", {
        month: "long",
        day: "numeric",
        year: "numeric",
      }).format(publicationDate);
    }

    if (previewImageWrapper && previewImage) {
      previewImageWrapper.hidden = !imageUrl;

      if (imageUrl) {
        previewImage.src = imageUrl;
        previewImage.alt = imageAlt;
      } else {
        previewImage.removeAttribute("src");
        previewImage.alt = "";
      }
    }

    if (previewBody) {
      previewBody.innerHTML = bodyHtml;
      previewBody.hidden = !hasBody;
    }

    if (previewEmptyBody) {
      previewEmptyBody.hidden = hasBody;
    }
  }

  function openPreview(): void {
    if (!previewDialog) {
      return;
    }

    renderPreview();
    previewDialog.showModal();
    document.body.classList.add("preview-open");
  }

  function closePreview(): void {
    if (!previewDialog?.open) {
      return;
    }

    previewDialog.close();
    document.body.classList.remove("preview-open");
  }

  async function initializeEditor(): Promise<void> {
    const isAdmin = await verifyAdmin();

    if (!isAdmin) {
      return;
    }

    initializeRichTextEditor();
    applyContributorEditor();
    await loadArticle();
    applyContributorEditor();
  }

  headlineInput?.addEventListener("input", () => {
    updateEditorTitle();

    if (!slugWasManuallyEdited && slugInput) {
      slugInput.value = slugify(headlineInput.value);
    }

    scheduleAutosave();
  });

  slugInput?.addEventListener("input", () => {
    slugWasManuallyEdited = true;
    scheduleAutosave();
  });

  const autosaveInputs = [
    summaryInput,
    categoryInput,
    authorInput,
    publishedAtInput,
    imageUrlInput,
    imageAltInput,
    homepageOrderInput,
  ];

  for (const input of autosaveInputs) {
    input?.addEventListener("input", scheduleAutosave);
    input?.addEventListener("change", scheduleAutosave);
  }

  imageAltInput?.addEventListener("input", () => {
    if (featuredImagePreviewImage && imageUrlInput?.value) {
      featuredImagePreviewImage.alt = imageAltInput.value.trim();
    }
  });

  isFeaturedInput?.addEventListener("change", scheduleAutosave);

  uploadImageButton?.addEventListener("click", () => {
    imageFileInput?.click();
  });

  chooseLibraryImageButton?.addEventListener("click", () => void openImageLibrary());
  closeImageLibraryButton?.addEventListener("click", () => imageLibraryDialog?.close());
  imageLibrarySearch?.addEventListener("input", renderImageLibrary);

  imageFileInput?.addEventListener("change", () => {
    const file = imageFileInput.files?.[0];

    if (!file) {
      return;
    }

    void uploadFeaturedImage(file);
  });

  removeImageButton?.addEventListener("click", () => {
    void removeFeaturedImage();
  });

  editorToolbar?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const button = target.closest<HTMLButtonElement>("[data-editor-command]");

    const command = button?.dataset.editorCommand;

    if (!button || !command) {
      return;
    }

    runEditorCommand(command);
  });

  saveDraftButton?.addEventListener("click", () => {
    void saveArticle(currentArticleStatus);
  });

  publishButton?.addEventListener("click", async () => {
    const targetStatus = selectedArticleStatus;

    if (
      statusRequiresPublishingReadiness(targetStatus) &&
      !validatePublishingReadiness(targetStatus)
    ) {
      return;
    }

    const confirmationConfig = getStatusConfirmationConfig(
      currentArticleStatus,
      targetStatus,
    );

    if (confirmationConfig) {
      const confirmed = await requestStatusConfirmation(confirmationConfig);

      if (!confirmed) {
        return;
      }
    }

    await saveArticle(targetStatus, {
      applyWorkflowRules: true,
    });
  });

  approvePublishButton?.addEventListener("click", async () => {
    if (isOpEdContributor || currentArticleStatus !== "ready_for_review") {
      return;
    }

    if (!validatePublishingReadiness("published")) {
      return;
    }

    const previousSelectedStatus = selectedArticleStatus;
    selectedArticleStatus = "published";

    if (articleStatusInput) {
      articleStatusInput.value = "published";
    }

    updateStatusHelp("published");
    renderPublishingReadiness();

    const published = await saveArticle("published", {
      applyWorkflowRules: true,
    });

    if (!published) {
      selectedArticleStatus = previousSelectedStatus;
      if (articleStatusInput) articleStatusInput.value = previousSelectedStatus;
      updateStatusHelp(previousSelectedStatus);
      renderPublishingReadiness();
    }
  });

  returnChangesButton?.addEventListener("click", () => {
    if (!isOpEdContributor && currentArticleStatus === "ready_for_review") {
      returnChangesDialog?.showModal(); returnChangesNote?.focus();
    }
  });
  cancelReturnChanges?.addEventListener("click", () => returnChangesDialog?.close());
  returnChangesForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const note = returnChangesNote?.value.trim() ?? "";
    if (!articleId || !note) { returnChangesNote?.focus(); return; }
    setSavingState(true);
    const { error } = await supabaseBrowser.rpc("admin_return_article_for_changes", { target_article_id: articleId, review_note: note });
    setSavingState(false);
    if (error) { setMessage(`Unable to return the story: ${error.message}`, "error"); return; }
    returnChangesDialog?.close(); if (returnChangesNote) returnChangesNote.value = "";
    setMessage("Story returned to the contributor with your review note.", "success");
    await loadArticle();
  });

  previewButton?.addEventListener("click", openPreview);

  closePreviewButton?.addEventListener("click", closePreview);

  previewDialog?.addEventListener("click", (event) => {
    if (event.target === previewDialog) {
      closePreview();
    }
  });

  previewDialog?.addEventListener("close", () => {
    document.body.classList.remove("preview-open");
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });

  articleStatusInput?.addEventListener("change", () => {
    const selectedStatus = articleStatusInput.value;

    if (!isArticleStatus(selectedStatus)) {
      return;
    }

    selectedArticleStatus = selectedStatus;

    updateStatusHelp(selectedStatus);
    updatePrimaryAction();
    renderPublishingReadiness();
  });

  deleteStoryButton?.addEventListener("click", () => {
    void deleteArticle();
  });

  window.addEventListener("beforeunload", (event) => {
    const shouldWarn = isUploadingImage || (hasUnsavedChanges && !isSaving);

    if (!shouldWarn) {
      return;
    }

    event.preventDefault();
  });

  document.addEventListener("keydown", (event) => {
    const usesSaveShortcut =
      (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "s";

    if (!usesSaveShortcut) {
      return;
    }

    event.preventDefault();

    void saveArticle(currentArticleStatus);
  });

  initializeEditor();
</script>


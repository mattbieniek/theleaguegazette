---
interface Props {
  articleId?: string;
}

const { articleId } = Astro.props;
const editorMode = articleId ? "edit" : "create";
---

<div
  id="article-editor"
  class="article-editor"
  data-mode={editorMode}
  data-article-id={articleId ?? ""}
>
  <div
    id="editor-loading"
    class="editor-loading"
    hidden={editorMode === "create"}
  >
    <p>Opening story…</p>
  </div>

  <form id="article-form" class="editor-form" hidden={editorMode === "edit"}>
    <header class="editor-header">
      <div>
        <p class="eyebrow">
          {editorMode === "create" ? "New Story" : "Editorial Desk"}
        </p>

        <h1 id="editor-page-title">
          {editorMode === "create" ? "Untitled story" : "Edit story"}
        </h1>

        <p id="editor-save-status" class="editor-save-status">Not yet saved</p>
      </div>

      <div class="editor-header__actions">
        <a
          id="cancel-editor"
          class="editor-button editor-button--secondary"
          href="/admin/articles"
        >
          Cancel
        </a>

        <button
          id="save-draft-button"
          class="editor-button editor-button--secondary"
          type="button"
        >
          Save changes
        </button>

        <button
          id="preview-button"
          class="editor-button editor-button--secondary"
          type="button"
        >
          Preview
        </button>

        <button
          id="publish-button"
          class="editor-button editor-button--primary"
          type="button"
        >
          Publish
        </button>
      </div>
    </header>

    <div
      id="editor-message"
      class="editor-message"
      role="status"
      aria-live="polite"
    >
    </div>

    <section id="review-workflow" class="review-workflow" hidden>
      <div><p class="eyebrow">Editorial decision</p><h2>This story is ready for review</h2></div>
      <div class="review-workflow__actions">
        <button id="return-changes-button" class="editor-button editor-button--secondary" type="button">Return for Changes</button>
        <button id="approve-publish-button" class="approve-publish-button" type="button">
          <span>Approve &amp; Publish</span><small>Publish this reviewed story now</small>
        </button>
      </div>
    </section>

    <section id="review-history" class="review-history" hidden>
      <div class="review-history__heading"><p class="eyebrow">Review history</p><h2>Editorial feedback</h2></div>
      <div id="review-history-list" class="review-history__list"></div>
    </section>

    <div class="editor-layout">
      <main class="editor-canvas">
        <section class="editor-section editor-section--headline">
          <label for="headline">Headline</label>

          <textarea
            id="headline"
            name="headline"
            rows="2"
            placeholder="Give the story a headline"
            required></textarea>

          <label for="summary">Summary</label>

          <textarea
            id="summary"
            name="summary"
            rows="3"
            placeholder="Write a brief introduction or homepage summary"
          ></textarea>
        </section>

        <section class="editor-section editor-section--body">
          <div class="editor-section__heading">
            <div>
              <p class="eyebrow">Story</p>
              <h2>Article body</h2>
            </div>

            <div class="editor-writing-stats">
              <span id="word-count">0 words</span>
              <span id="reading-time">0 min read</span>
            </div>
          </div>

          <div class="rich-text-editor">
            <div
              id="editor-toolbar"
              class="editor-toolbar"
              role="toolbar"
              aria-label="Article formatting"
            >
              <div class="editor-toolbar__group">
                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="bold"
                  aria-label="Bold"
                  aria-pressed="false"
                  title="Bold"
                >
                  <strong>B</strong>
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="italic"
                  aria-label="Italic"
                  aria-pressed="false"
                  title="Italic"
                >
                  <em>I</em>
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="link"
                  aria-label="Add or edit link"
                  aria-pressed="false"
                  title="Add or edit link"
                >
                  Link
                </button>
              </div>

              <div class="editor-toolbar__divider" aria-hidden="true"></div>

              <div class="editor-toolbar__group">
                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="heading-2"
                  aria-label="Heading level 2"
                  aria-pressed="false"
                  title="Heading level 2"
                >
                  H2
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="heading-3"
                  aria-label="Heading level 3"
                  aria-pressed="false"
                  title="Heading level 3"
                >
                  H3
                </button>
              </div>

              <div class="editor-toolbar__divider" aria-hidden="true"></div>

              <div class="editor-toolbar__group">
                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="bullet-list"
                  aria-label="Bulleted list"
                  aria-pressed="false"
                  title="Bulleted list"
                >
                  • List
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="ordered-list"
                  aria-label="Numbered list"
                  aria-pressed="false"
                  title="Numbered list"
                >
                  1. List
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="blockquote"
                  aria-label="Blockquote"
                  aria-pressed="false"
                  title="Blockquote"
                >
                  Quote
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="horizontal-rule"
                  aria-label="Horizontal divider"
                  title="Horizontal divider"
                >
                  Divider
                </button>
              </div>

              <div class="editor-toolbar__divider" aria-hidden="true"></div>

              <div class="editor-toolbar__group">
                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="undo"
                  aria-label="Undo"
                  title="Undo"
                >
                  ↶
                </button>

                <button
                  type="button"
                  class="editor-toolbar__button"
                  data-editor-command="redo"
                  aria-label="Redo"
                  title="Redo"
                >
                  ↷
                </button>
              </div>
            </div>

            <div id="body-editor" class="body-editor" aria-label="Article body">
            </div>
          </div>

          <p class="editor-field-help">
            Use the toolbar to add headings, emphasis, links, lists, quotes, and
            section dividers. Changes autosave after the story has been created.
          </p>
        </section>
      </main>

      <aside class="editor-sidebar">
        <section class="editor-panel">
          <div class="editor-panel__heading">
            <p class="eyebrow">Publishing</p>
            <h2>Story details</h2>
          </div>

          <div class="editor-fields">
            <label id="category-field">
              <span>Category</span>

              <input
                id="category"
                name="category"
                type="text"
                placeholder="Weekly Gazette"
              />
            </label>

            <label id="author-field">
              <span>Author</span>

              <input
                id="author-name"
                name="author_name"
                type="text"
                value="The Gazette Staff"
              />
            </label>

            <label id="publication-date-field">
              <span>Slug</span>

              <input
                id="slug"
                name="slug"
                type="text"
                placeholder="story-url"
              />

              <small> Used in the public story URL. </small>
            </label>

            <label>
              <span>Editorial status</span>

              <select id="article-status" name="status">
                <option value="draft">Draft</option>
                <option value="ready_for_review">Ready for review</option>
                <option value="scheduled">Scheduled</option>
                <option value="published">Published</option>
                <option value="archived">Archived</option>
              </select>

              <small id="article-status-help">
                Drafts are visible only inside the editorial desk.
              </small>
            </label>

            <label>
              <span>Publication date</span>

              <input
                id="published-at"
                name="published_at"
                type="datetime-local"
              />
            </label>
          </div>
        </section>

        <section class="editor-panel">
          <div class="editor-panel__heading">
            <p class="eyebrow">Artwork</p>
            <h2>Featured image</h2>
          </div>

          <div class="editor-fields">
            <div
              id="featured-image-preview"
              class="featured-image-preview"
              hidden
            >
              <img id="featured-image-preview-image" src="" alt="" />
            </div>

            <div id="featured-image-empty" class="featured-image-empty">
              <span aria-hidden="true">◇</span>
              <p>No featured image selected</p>
            </div>

            <input id="image-url" name="image_url" type="hidden" />

            <input
              id="image-file"
              class="sr-only"
              type="file"
              accept="image/jpeg,image/png,image/webp"
            />

            <div class="featured-image-actions">
              <button
                id="choose-library-image-button"
                class="editor-button editor-button--secondary"
                type="button"
                hidden
              >
                Choose from Photo Desk
              </button>

              <button
                id="upload-image-button"
                class="editor-button editor-button--secondary"
                type="button"
              >
                Upload image
              </button>

              <button
                id="remove-image-button"
                class="editor-button editor-button--text"
                type="button"
                hidden
              >
                Remove
              </button>
            </div>

            <p
              id="image-upload-status"
              class="image-upload-status"
              role="status"
              aria-live="polite"
            >
            </p>

            <label>
              <span>Alternative text</span>

              <textarea
                id="image-alt"
                name="image_alt"
                rows="3"
                placeholder="Describe the image for readers using screen readers"
              ></textarea>

              <small> Required before publishing a story with an image. </small>
            </label>

            <small class="featured-image-requirements">
              JPEG, PNG, or WebP. Maximum file size: 6 MB.
            </small>
          </div>
        </section>

        <section id="homepage-placement-panel" class="editor-panel">
          <div class="editor-panel__heading">
            <p class="eyebrow">Homepage</p>
            <h2>Placement</h2>
          </div>

          <div class="editor-fields">
            <label class="editor-checkbox">
              <input id="is-featured" name="is_featured" type="checkbox" />

              <span>
                <strong>Feature this story</strong>
                <small>
                  Allow the story to receive prominent homepage placement.
                </small>
              </span>
            </label>

            <label>
              <span>Homepage order</span>

              <input
                id="homepage-order"
                name="homepage_order"
                type="number"
                min="1"
                step="1"
                placeholder="1"
              />

              <small> Lower numbers appear first. </small>
            </label>
          </div>
        </section>

        <section class="editor-panel publishing-readiness">
          <div class="editor-panel__heading">
            <p class="eyebrow">Readiness</p>
            <h2>Before publishing</h2>
          </div>

          <div class="publishing-readiness__content">
            <p
              id="publishing-readiness-summary"
              class="publishing-readiness__summary"
            >
              Complete the story details below.
            </p>

            <ul
              id="publishing-readiness-list"
              class="publishing-readiness__list"
              aria-live="polite"
            >
            </ul>
          </div>
        </section>

        <section
          id="story-status-panel"
          class="editor-panel editor-status-panel"
          hidden
        >
          <div class="editor-panel__heading">
            <p class="eyebrow">Status</p>
            <h2>Current state</h2>
          </div>

          <dl>
            <div>
              <dt>Status</dt>
              <dd id="current-status">Draft</dd>
            </div>

            <div>
              <dt>Created</dt>
              <dd id="created-date">—</dd>
            </div>

            <div>
              <dt>Last updated</dt>
              <dd id="updated-date">—</dd>
            </div>
          </dl>

          <a
            id="view-published-story"
            class="view-published-story"
            href="#"
            target="_blank"
            rel="noreferrer"
            hidden
          >
            View published story ↗
          </a>
        </section>
        <section
          id="delete-story-panel"
          class="editor-panel editor-danger-panel"
          hidden
        >
          <div class="editor-panel__heading">
            <p class="eyebrow">Danger zone</p>
            <h2>Delete story</h2>
          </div>

          <div class="editor-danger-panel__content">
            <p>
              Permanently remove this story and its featured image. This action
              cannot be undone.
            </p>

            <button
              id="delete-story-button"
              class="editor-button editor-button--danger"
              type="button"
            >
              Delete story
            </button>
          </div>
        </section>
      </aside>
    </div>
  </form>
  <dialog
    id="status-confirmation-dialog"
    class="status-confirmation"
    aria-labelledby="status-confirmation-title"
    aria-describedby="status-confirmation-description"
  >
    <div class="status-confirmation__panel">
      <div class="status-confirmation__heading">
        <p class="eyebrow">Confirm action</p>

        <h2 id="status-confirmation-title">Confirm status change</h2>
      </div>

      <p
        id="status-confirmation-description"
        class="status-confirmation__description"
      >
        Confirm this editorial workflow change.
      </p>

      <div class="status-confirmation__actions">
        <button
          id="cancel-status-change"
          class="editor-button editor-button--secondary"
          type="button"
        >
          Cancel
        </button>

        <button
          id="confirm-status-change"
          class="editor-button editor-button--primary"
          type="button"
        >
          Confirm
        </button>
      </div>
    </div>
  </dialog>
  <dialog id="image-library-dialog" class="image-library-dialog" aria-labelledby="image-library-title">
    <div class="image-library-panel">
      <header>
        <div><p class="eyebrow">Photo Desk</p><h2 id="image-library-title">Choose existing artwork</h2></div>
        <button id="close-image-library" type="button" aria-label="Close artwork library">×</button>
      </header>
      <label class="image-library-search">Find artwork<input id="image-library-search" type="search" placeholder="Search by story or image description" /></label>
      <p id="image-library-message" role="status" aria-live="polite"></p>
      <section id="image-library-grid" class="image-library-grid" aria-label="Available artwork"></section>
    </div>
  </dialog>
  <dialog id="return-changes-dialog" class="status-confirmation" aria-labelledby="return-changes-title">
    <form id="return-changes-form" class="status-confirmation__panel">
      <div class="status-confirmation__heading"><p class="eyebrow">Editorial feedback</p><h2 id="return-changes-title">Return story for changes</h2></div>
      <div class="return-changes__body">
        <p>Explain what the contributor should revise. This note will remain in the story's review history.</p>
        <label for="return-changes-note">Revision note</label>
        <textarea id="return-changes-note" rows="5" required placeholder="Describe the changes needed before publication…"></textarea>
      </div>
      <div class="status-confirmation__actions">
        <button id="cancel-return-changes" class="editor-button editor-button--secondary" type="button">Cancel</button>
        <button id="confirm-return-changes" class="editor-button editor-button--primary" type="submit">Return to contributor</button>
      </div>
    </form>
  </dialog>
  <dialog id="preview-dialog" class="preview-dialog">
    <div class="preview-shell">
      <header class="preview-toolbar">
        <div>
          <p class="eyebrow">Story Preview</p>
          <p class="preview-toolbar__note">
            This preview has not been published.
          </p>
        </div>

        <button
          id="close-preview-button"
          class="preview-close"
          type="button"
          aria-label="Close preview"
        >
          ×
        </button>
      </header>

      <div class="preview-page">
        <article class="story-preview">
          <header class="story-preview__header">
            <p id="preview-category" class="story-preview__category">
              Uncategorized
            </p>

            <h1 id="preview-headline">Untitled story</h1>

            <p id="preview-summary" class="story-preview__summary"></p>

            <div class="story-preview__byline">
              <span id="preview-author">The Gazette Staff</span>
              <span aria-hidden="true">•</span>
              <time id="preview-date"></time>
            </div>
          </header>

          <figure
            id="preview-image-wrapper"
            class="story-preview__image"
            hidden
          >
            <img id="preview-image" src="" alt="" />
          </figure>

          <div id="preview-body" class="story-preview__body"></div>

          <div id="preview-empty-body" class="story-preview__empty" hidden>
            <p>The article body will appear here.</p>
          </div>
        </article>
      </div>
    </div>
  </dialog>
</div>

<script>
  import { Editor } from "@tiptap/core";
  import StarterKit from "@tiptap/starter-kit";
  import Link from "@tiptap/extension-link";
  import { supabaseBrowser } from "../../lib/supabase-browser";
  import {
    bodyHasContent,
    getPlainTextFromBody,
    normalizeArticleBody,
    type RichTextDocument,
  } from "../../lib/gazette/articleBody";
  import type { Json } from "../../types/database";

  type ArticleStatus =
    "draft" | "ready_for_review" | "scheduled" | "published" | "archived";

  type ArticleRecord = {
    id: string;
    slug: string;
    category: string;
    headline: string;
    summary: string;
    author_name: string;
    published_at: string | null;
    image_url: string | null;
    image_alt: string | null;
    body: unknown;
    status: ArticleStatus;
    is_featured: boolean;
    homepage_order: number | null;
    created_at: string;
    updated_at: string;
  };

  type ArticlePayload = {
    slug: string;
    category: string;
    headline: string;
    summary: string;
    author_name: string;
    published_at: string | null;
    image_url: string | null;
    image_alt: string | null;
    body: Json;
    status: ArticleStatus;
    is_featured: boolean;
    homepage_order: number | null;
    updated_at: string;
    created_by?: string;
  };

  type ReviewEvent = { id: string; action: string; note: string | null; created_at: string };

  type ReadinessRequirementKey =
    | "headline"
    | "slug"
    | "category"
    | "summary"
    | "body"
    | "image_alt"
    | "publication_date";

  type ReadinessRequirement = {
    key: ReadinessRequirementKey;
    label: string;
    isComplete: boolean;
  };

  type StatusConfirmationConfig = {
    title: string;
    description: string;
    confirmLabel: string;
    tone: "standard" | "danger";
  };

  const editor = document.querySelector<HTMLElement>("#article-editor");

  const form = document.querySelector<HTMLFormElement>("#article-form");

  const loading = document.querySelector<HTMLElement>("#editor-loading");

  const message = document.querySelector<HTMLElement>("#editor-message");

  const saveStatus = document.querySelector<HTMLElement>("#editor-save-status");

  const pageTitle = document.querySelector<HTMLElement>("#editor-page-title");

  const headlineInput =
    document.querySelector<HTMLTextAreaElement>("#headline");

  const summaryInput = document.querySelector<HTMLTextAreaElement>("#summary");

  const bodyEditorElement = document.querySelector<HTMLElement>("#body-editor");

  const editorToolbar = document.querySelector<HTMLElement>("#editor-toolbar");

  const editorToolbarButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-editor-command]"),
  );

  const categoryInput = document.querySelector<HTMLInputElement>("#category");

  const authorInput = document.querySelector<HTMLInputElement>("#author-name");
  const publicationDateField = document.querySelector<HTMLElement>("#publication-date-field");
  const homepagePlacementPanel = document.querySelector<HTMLElement>("#homepage-placement-panel");
  const cancelEditor = document.querySelector<HTMLAnchorElement>("#cancel-editor");

  const slugInput = document.querySelector<HTMLInputElement>("#slug");

  const articleStatusInput =
    document.querySelector<HTMLSelectElement>("#article-status");

  const articleStatusHelp = document.querySelector<HTMLElement>(
    "#article-status-help",
  );

  const publishedAtInput =
    document.querySelector<HTMLInputElement>("#published-at");

  const imageUrlInput = document.querySelector<HTMLInputElement>("#image-url");

  const imageAltInput =
    document.querySelector<HTMLTextAreaElement>("#image-alt");

  const imageFileInput =
    document.querySelector<HTMLInputElement>("#image-file");

  const uploadImageButton = document.querySelector<HTMLButtonElement>(
    "#upload-image-button",
  );
  const chooseLibraryImageButton = document.querySelector<HTMLButtonElement>("#choose-library-image-button");
  const imageLibraryDialog = document.querySelector<HTMLDialogElement>("#image-library-dialog");
  const closeImageLibraryButton = document.querySelector<HTMLButtonElement>("#close-image-library");
  const imageLibrarySearch = document.querySelector<HTMLInputElement>("#image-library-search");
  const imageLibraryGrid = document.querySelector<HTMLElement>("#image-library-grid");
  const imageLibraryMessage = document.querySelector<HTMLElement>("#image-library-message");

  const removeImageButton = document.querySelector<HTMLButtonElement>(
    "#remove-image-button",
  );

  const imageUploadStatus = document.querySelector<HTMLElement>(
    "#image-upload-status",
  );

  const featuredImagePreview = document.querySelector<HTMLElement>(
    "#featured-image-preview",
  );

  const featuredImagePreviewImage = document.querySelector<HTMLImageElement>(
    "#featured-image-preview-image",
  );

  const featuredImageEmpty = document.querySelector<HTMLElement>(
    "#featured-image-empty",
  );

  const isFeaturedInput =
    document.querySelector<HTMLInputElement>("#is-featured");

  const homepageOrderInput =
    document.querySelector<HTMLInputElement>("#homepage-order");

  const publishingReadinessSummary = document.querySelector<HTMLElement>(
    "#publishing-readiness-summary",
  );

  const publishingReadinessList = document.querySelector<HTMLUListElement>(
    "#publishing-readiness-list",
  );

  const saveDraftButton =
    document.querySelector<HTMLButtonElement>("#save-draft-button");

  const publishButton =
    document.querySelector<HTMLButtonElement>("#publish-button");

  const approvePublishButton = document.querySelector<HTMLButtonElement>(
    "#approve-publish-button",
  );
  const reviewWorkflow = document.querySelector<HTMLElement>("#review-workflow");
  const returnChangesButton = document.querySelector<HTMLButtonElement>("#return-changes-button");
  const reviewHistory = document.querySelector<HTMLElement>("#review-history");
  const reviewHistoryList = document.querySelector<HTMLElement>("#review-history-list");
  const returnChangesDialog = document.querySelector<HTMLDialogElement>("#return-changes-dialog");
  const returnChangesForm = document.querySelector<HTMLFormElement>("#return-changes-form");
  const returnChangesNote = document.querySelector<HTMLTextAreaElement>("#return-changes-note");
  const cancelReturnChanges = document.querySelector<HTMLButtonElement>("#cancel-return-changes");

  const wordCount = document.querySelector<HTMLElement>("#word-count");

  const readingTime = document.querySelector<HTMLElement>("#reading-time");

  const statusPanel = document.querySelector<HTMLElement>(
    "#story-status-panel",
  );

  const currentStatus = document.querySelector<HTMLElement>("#current-status");

  const createdDate = document.querySelector<HTMLElement>("#created-date");

  const updatedDate = document.querySelector<HTMLElement>("#updated-date");

  const viewPublishedStory = document.querySelector<HTMLAnchorElement>(
    "#view-published-story",
  );

  const previewButton =
    document.querySelector<HTMLButtonElement>("#preview-button");

  const previewDialog =
    document.querySelector<HTMLDialogElement>("#preview-dialog");

  const closePreviewButton = document.querySelector<HTMLButtonElement>(
    "#close-preview-button",
  );

  const previewCategory =
    document.querySelector<HTMLElement>("#preview-category");

  const previewHeadline =
    document.querySelector<HTMLElement>("#preview-headline");

  const previewSummary =
    document.querySelector<HTMLElement>("#preview-summary");

  const previewAuthor = document.querySelector<HTMLElement>("#preview-author");

  const previewDate = document.querySelector<HTMLTimeElement>("#preview-date");

  const previewImageWrapper = document.querySelector<HTMLElement>(
    "#preview-image-wrapper",
  );

  const previewImage =
    document.querySelector<HTMLImageElement>("#preview-image");


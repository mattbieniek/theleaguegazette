---
interface Props {
  season: number | null;
  activeSeason?: number | null;
  activeWeek?: number | null;
  selectedWeek?: number | null;
  subject: string;
}

const {
  season,
  activeSeason = null,
  activeWeek = null,
  selectedWeek = null,
  subject,
} = Astro.props;

const isActiveSeason = season !== null && activeSeason !== null && season === activeSeason;
const isCurrentWeek = isActiveSeason && selectedWeek !== null && activeWeek !== null && selectedWeek === activeWeek;
const label = isCurrentWeek ? "Live season" : isActiveSeason ? "Active season" : "Archive view";
const detail = isCurrentWeek
  ? `Week ${activeWeek} is the current league week.`
  : isActiveSeason && activeWeek !== null
    ? `The active league is currently on Week ${activeWeek}.`
    : "Historical results are preserved as they were recorded.";
---

<aside class:list={["season-context", isActiveSeason && "season-context--active", isCurrentWeek && "season-context--current"]}>
  <div class="season-context__mark" aria-hidden="true">{isCurrentWeek ? "●" : "◆"}</div>
  <div class="season-context__copy">
    <p>{label} <span>·</span> {season ?? "League"}</p>
    <strong>{subject}</strong>
    <span>{detail}</span>
  </div>
</aside>

<style>
  .season-context {
    display: flex;
    align-items: center;
    gap: .85rem;
    margin-top: var(--space-5);
    padding: .9rem 1rem;
    border: 1px solid var(--color-rule);
    border-left: 4px solid var(--color-rule-dark);
    background: color-mix(in srgb, var(--color-surface) 78%, var(--color-paper) 22%);
  }

  .season-context--active { border-left-color: var(--color-green); }
  .season-context--current { background: color-mix(in srgb, var(--color-green) 8%, var(--color-surface)); }

  .season-context__mark {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--color-ink-muted);
    font-size: .65rem;
  }

  .season-context--active .season-context__mark { color: var(--color-green); }
  .season-context--current .season-context__mark { color: var(--color-gold-dark, #9b792f); }

  .season-context__copy { display: grid; gap: .14rem; min-width: 0; }
  .season-context__copy p { margin: 0; color: var(--color-ink-muted); font-family: var(--font-data); font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .season-context__copy p span { padding-inline: .25rem; color: var(--color-rule-dark); }
  .season-context__copy strong { color: var(--color-ink); font-family: var(--font-editorial); font-size: 1.08rem; line-height: 1.05; }
  .season-context__copy>span { color: var(--color-ink-soft); font-size: .78rem; line-height: 1.35; }
</style>

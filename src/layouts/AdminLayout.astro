---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const currentPath = Astro.url.pathname;
const isLoginPage = currentPath === "/admin/login";

function isActive(path: string, exact = false) {
  if (exact) {
    return currentPath === path;
  }

  return currentPath.startsWith(path);
}
---

<BaseLayout title={title} noindex>
  {
    isLoginPage ? (
      <main class="admin-login-layout">
        <slot />
      </main>
    ) : (
      <div class="admin-app">
        <aside class="admin-sidebar" id="admin-sidebar">
          <div class="admin-sidebar__header">
            <a class="admin-brand" href="/admin">
              <span class="admin-brand__mark" aria-hidden="true">
                LG
              </span>

              <span class="admin-brand__text">
                <strong>The League Gazette</strong>
                <small>Editorial Office</small>
              </span>
            </a>

            <button
              id="admin-sidebar-close"
              class="admin-sidebar__close"
              type="button"
              aria-label="Close admin navigation"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          </div>

          <nav
            class="admin-navigation"
            aria-label="Admin navigation"
          >
            <div class="admin-navigation__group">
              <p class="admin-navigation__label">
                Editorial
              </p>

              <a
                class:list={[
                  "admin-navigation__link",
                  {
                    "admin-navigation__link--active":
                      isActive("/admin", true),
                  },
                ]}
                href="/admin"
                data-admin-only
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z" />
                </svg>

                <span>Editorial Desk</span>
              </a>

              <a
                class:list={[
                  "admin-navigation__link",
                  {
                    "admin-navigation__link--active":
                      isActive("/admin/articles"),
                  },
                ]}
                href="/admin/articles"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 4h14v16H5V4Zm3 4h8M8 12h8M8 16h5" />
                </svg>

                <span>Stories</span>
              </a>

              <a
                class:list={[
                  "admin-navigation__link",
                  "admin-navigation__link--primary",
                  {
                    "admin-navigation__link--active":
                      currentPath === "/admin/articles/new",
                  },
                ]}
                href="/admin/articles/new"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>

                <span>New Story</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/notifications" }]}
                href="/admin/notifications"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" />
                </svg>
                <span>Notifications</span>
                <span id="admin-notification-count" class="admin-navigation__count" hidden></span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/contributors" }]}
                href="/admin/contributors"
                data-admin-only
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" />
                </svg>
                <span>Contributors</span>
              </a>
            </div>

            <div class="admin-navigation__group" data-admin-only>
              <p class="admin-navigation__label">
                Publication
              </p>

              <a
                class:list={[
                  "admin-navigation__link",
                  { "admin-navigation__link--active": currentPath === "/admin/homepage" },
                ]}
                href="/admin/homepage"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M4 6h16v12H4V6Zm3 3h5v6H7V9Zm8 0h2M15 12h2M15 15h2" />
                </svg>

                <span>Homepage Curation</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/rankings" }]}
                href="/admin/rankings"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M4 19V9M10 19V5M16 19v-7M3 19h18" />
                </svg>

                <span>Power Rankings</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/awards" }]}
                href="/admin/awards"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M8 4h8v3a4 4 0 0 1-8 0V4Zm-3 2h3M16 6h3v1a4 4 0 0 1-4 4M9 11a4 4 0 0 1-4-4V6M12 11v5M8 20h8M9 16h6v4H9v-4Z" />
                </svg>

                <span>Weekly Awards</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/photos" }]}
                href="/admin/photos"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <rect x="4" y="5" width="16" height="14" rx="2" />
                  <circle cx="9" cy="10" r="1.5" />
                  <path d="m6 17 4-4 3 3 2-2 3 3" />
                </svg>

                <span>Photo Desk</span>
              </a>
            </div>

            <div class="admin-navigation__group" data-admin-only>
              <p class="admin-navigation__label">
                League
              </p>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/teams" }]}
                href="/admin/teams"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle cx="9" cy="8" r="3" />
                  <circle cx="17" cy="9" r="2" />
                  <path d="M4 19c0-4 2-6 5-6s5 2 5 6M14 14c3 0 5 2 5 5" />
                </svg>

                <span>Teams</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/archive" }]}
                href="/admin/archive"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M5 4h14v16H5V4Zm4 0v16M9 8h10M9 12h10M9 16h10" />
                </svg>

                <span>Archive</span>
              </a>

              <a
                class:list={["admin-navigation__link", { "admin-navigation__link--active": currentPath === "/admin/sleeper" }]}
                href="/admin/sleeper"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7 7h10v10H7V7Zm-3 5h3M17 12h3M12 4v3M12 17v3" />
                </svg>
                <span>Sleeper Data</span>
              </a>
            </div>
          </nav>

          <div class="admin-sidebar__footer">
            <a
              class="admin-view-site"
              href="/"
              target="_blank"
              rel="noreferrer"
            >
              <span>View live site</span>

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14 5h5v5M19 5l-8 8M18 13v6H5V6h6" />
              </svg>
            </a>

            <button
              id="admin-sign-out"
              class="admin-sign-out"
              type="button"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9" />
              </svg>

              <span>Sign out</span>
            </button>
          </div>
        </aside>

        <div
          id="admin-sidebar-backdrop"
          class="admin-sidebar-backdrop"
          hidden
        ></div>

        <section class="admin-workspace">
          <header class="admin-topbar">
            <button
              id="admin-sidebar-open"
              class="admin-menu-button"
              type="button"
              aria-label="Open admin navigation"
              aria-controls="admin-sidebar"
              aria-expanded="false"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </button>

            <div class="admin-topbar__identity">
              <span class="admin-topbar__publication">
                The League Gazette
              </span>

              <span class="admin-topbar__divider">
                /
              </span>

              <span class="admin-topbar__section">
                Editorial Office
              </span>
            </div>

            <div class="admin-topbar__actions">
              <a
                class="admin-topbar__new"
                href="/admin/articles/new"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>

                <span>New Story</span>
              </a>
            </div>
          </header>

          <main class="admin-content">
            <slot />
          </main>
        </section>
      </div>
    )
  }

  {
    !isLoginPage && (
      <script>
        import { supabaseBrowser } from "../lib/supabase-browser";

        const sidebar =
          document.querySelector<HTMLElement>(
            "#admin-sidebar"
          );

        const backdrop =
          document.querySelector<HTMLElement>(
            "#admin-sidebar-backdrop"
          );

        const openButton =
          document.querySelector<HTMLButtonElement>(
            "#admin-sidebar-open"
          );

        const closeButton =
          document.querySelector<HTMLButtonElement>(
            "#admin-sidebar-close"
          );

        const signOutButton =
          document.querySelector<HTMLButtonElement>(
            "#admin-sign-out"
          );

        async function personalizeNavigation() {
          const { data: { user } } = await supabaseBrowser.auth.getUser();
          if (!user) return;
          const { count } = await supabaseBrowser
            .from("editorial_notifications")
            .select("id", { count: "exact", head: true })
            .is("read_at", null);
          const notificationCount = document.querySelector<HTMLElement>("#admin-notification-count");
          if (notificationCount && count) {
            notificationCount.textContent = count > 99 ? "99+" : String(count);
            notificationCount.hidden = false;
          }
          const { data: contributor } = await supabaseBrowser
            .from("publication_contributors")
            .select("role")
            .eq("user_id", user.id)
            .maybeSingle();
          if (contributor?.role === "commissioner") {
            document.querySelectorAll<HTMLElement>("[data-admin-only]").forEach((element) => {
              element.hidden = true;
            });
          }
        }

        void personalizeNavigation();

        function openSidebar() {
          if (!sidebar || !backdrop || !openButton) {
            return;
          }

          sidebar.classList.add("admin-sidebar--open");
          backdrop.hidden = false;
          document.body.classList.add(
            "admin-navigation-open"
          );
          openButton.setAttribute(
            "aria-expanded",
            "true"
          );
        }

        function closeSidebar() {
          if (!sidebar || !backdrop || !openButton) {
            return;
          }

          sidebar.classList.remove(
            "admin-sidebar--open"
          );
          backdrop.hidden = true;
          document.body.classList.remove(
            "admin-navigation-open"
          );
          openButton.setAttribute(
            "aria-expanded",
            "false"
          );
        }

        openButton?.addEventListener(
          "click",
          openSidebar
        );

        closeButton?.addEventListener(
          "click",
          closeSidebar
        );

        backdrop?.addEventListener(
          "click",
          closeSidebar
        );

        document.addEventListener(
          "keydown",
          (event) => {
            if (event.key === "Escape") {
              closeSidebar();
            }
          }
        );

        signOutButton?.addEventListener(
          "click",
          async () => {
            signOutButton.disabled = true;

            const label =
              signOutButton.querySelector("span");

            if (label) {
              label.textContent = "Signing out…";
            }

            await supabaseBrowser.auth.signOut();
            window.location.replace("/admin/login");
          }
        );
      </script>
    )
  }
</BaseLayout>

<style is:global>
  body:has(.admin-app),
  body:has(.admin-login-layout) {
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.46),
        rgba(255, 255, 255, 0)
      ),
      var(--color-paper, #f3f1e9);
  }

  body:has(.admin-app) {
    margin: 0;
  }

  body.admin-navigation-open {
    overflow: hidden;
  }

  .admin-login-layout {
    min-height: 100vh;
  }

  .admin-app {
    --admin-sidebar-width: 17.5rem;
    min-height: 100vh;
    color: var(--color-ink, #1e211e);
  }

  body:has(.admin-app) > :is(.masthead, .site-nav, .site-footer) {
    width: calc(100% - var(--admin-sidebar-width, 17.5rem));
    margin-left: var(--admin-sidebar-width, 17.5rem);
  }

  .admin-sidebar {
    position: fixed;
    z-index: 40;
    inset: 0 auto 0 0;
    display: flex;
    width: var(--admin-sidebar-width);
    flex-direction: column;
    overflow-y: auto;
    border-right: 1px solid rgba(255, 255, 255, 0.09);
    background:
      radial-gradient(
        circle at top left,
        rgba(255, 255, 255, 0.07),
        transparent 17rem
      ),
      #18231d;
    color: #f7f5ed;
  }

  .admin-sidebar__header {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .admin-brand {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .admin-brand__mark {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.08);
    font-family: var(--font-display, Georgia, serif);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .admin-brand__text {
    display: grid;
    min-width: 0;
    gap: 0.15rem;
  }

  .admin-brand__text strong {
    overflow: hidden;
    font-family: var(--font-display, Georgia, serif);
    font-size: 0.95rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-brand__text small {
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .admin-sidebar__close {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 0;
    border-radius: 0.55rem;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .admin-sidebar__close:hover {
    background: rgba(255, 255, 255, 0.09);
  }

  .admin-navigation {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 1.65rem;
    padding: 1.5rem 0.85rem;
  }

  .admin-navigation__group {
    display: grid;
    gap: 0.3rem;
  }

  [data-admin-only][hidden] {
    display: none !important;
  }

  .admin-navigation__count {
    margin-left: auto;
    min-width: 1.4rem;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: #a32320;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    text-align: center;
  }

  .admin-navigation__label {
    margin: 0 0 0.45rem;
    padding-inline: 0.75rem;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .admin-navigation__link {
    display: grid;
    min-height: 2.75rem;
    grid-template-columns: 1.2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.62rem 0.75rem;
    border-radius: 0.65rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  .admin-navigation__link svg,
  .admin-sidebar__footer svg,
  .admin-menu-button svg,
  .admin-topbar__new svg,
  .admin-sidebar__close svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .admin-navigation__link:hover:not(
      .admin-navigation__link--disabled
    ) {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .admin-navigation__link--active {
    background: rgba(255, 255, 255, 0.11);
    color: #fff;
  }

  .admin-navigation__link--active::before {
    position: absolute;
    left: 0;
    width: 0.2rem;
    height: 1.5rem;
    border-radius: 0 1rem 1rem 0;
    background: #94b49f;
    content: "";
  }

  .admin-navigation__link {
    position: relative;
  }

  .admin-navigation__link--primary {
    margin-top: 0.3rem;
    background: #e8e4d7;
    color: #18231d;
  }

  .admin-navigation__link--primary:hover:not(
      .admin-navigation__link--disabled
    ) {
    background: #fff;
    color: #18231d;
    transform: translateY(-1px);
  }

  .admin-navigation__link--disabled {
    color: rgba(255, 255, 255, 0.34);
    cursor: default;
  }

  .admin-navigation__link small {
    padding: 0.17rem 0.35rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.36);
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .admin-sidebar__footer {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 0.85rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .admin-view-site,
  .admin-sign-out {
    display: flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-radius: 0.6rem;
    background: transparent;
    color: rgba(255, 255, 255, 0.62);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
  }

  .admin-view-site:hover,
  .admin-sign-out:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  .admin-sign-out:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .admin-workspace {
    min-width: 0;
    min-height: 100vh;
    margin-left: var(--admin-sidebar-width);
  }

  .admin-topbar {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(1rem, 3vw, 2.25rem);
    border-bottom: 1px solid
      var(--color-rule, #d9d5c9);
    background: color-mix(
      in srgb,
      var(--color-paper, #f3f1e9) 88%,
      transparent
    );
    backdrop-filter: blur(16px);
  }

  .admin-topbar__identity {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
  }

  .admin-topbar__publication {
    overflow: hidden;
    font-family: var(--font-display, Georgia, serif);
    font-weight: 800;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .admin-topbar__divider {
    color: var(--color-rule-dark, #aaa69c);
  }

  .admin-topbar__section {
    color: var(--color-ink-soft, #666b65);
    white-space: nowrap;
  }

  .admin-topbar__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .admin-topbar__new {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.65rem;
    background: var(--color-green, #315c45);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 750;
    text-decoration: none;
  }

  .admin-topbar__new:hover {
    filter: brightness(1.08);
  }

  .admin-menu-button {
    display: none;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 1px solid var(--color-rule, #d9d5c9);
    border-radius: 0.65rem;
    background: var(--color-surface, #fff);
    color: var(--color-ink, #1e211e);
    cursor: pointer;
  }

  .admin-content {
    width: min(100%, 96rem);
    margin-inline: auto;
    padding:
      clamp(1.5rem, 4vw, 3.5rem)
      clamp(1rem, 4vw, 3rem)
      5rem;
  }

  .admin-content .admin-shell {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .admin-sidebar-backdrop {
    position: fixed;
    z-index: 30;
    inset: 0;
    background: rgba(10, 14, 11, 0.52);
    backdrop-filter: blur(2px);
  }

  @media (max-width: 960px) {
    body:has(.admin-app) > :is(.masthead, .site-nav, .site-footer) {
      width: 100%;
      margin-left: 0;
    }

    .admin-sidebar {
      width: min(19rem, 88vw);
      transform: translateX(-102%);
      box-shadow: 1.5rem 0 4rem rgba(0, 0, 0, 0.2);
      transition: transform 200ms ease;
    }

    .admin-sidebar--open {
      transform: translateX(0);
    }

    .admin-sidebar__close,
    .admin-menu-button {
      display: grid;
    }

    .admin-workspace {
      margin-left: 0;
    }

    .admin-topbar {
      justify-content: initial;
    }

    .admin-topbar__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 560px) {
    .admin-topbar__section,
    .admin-topbar__divider {
      display: none;
    }

    .admin-topbar__new span {

---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="My Account" noindex>
  <main id="account-page" class="account-page site-shell" hidden>
    <header class="account-header"><div><p class="eyebrow">Gazette membership</p><h1>My account</h1><p id="account-email"></p></div><button id="sign-out" type="button">Sign out</button></header>
    <div class="account-grid">
      <section class="account-panel"><p class="eyebrow">Public identity</p><h2>Reader profile</h2><form id="profile-form"><label>Display name<input id="display-name" minlength="2" maxlength="40" required /></label><label class="digest-setting"><input id="digest-enabled" type="checkbox" /><span><strong>Weekly Gazette digest</strong><small>Receive the complete weekly edition by email.</small></span></label><p id="profile-message" role="status"></p><button type="submit">Save preferences</button></form></section>
      <section class="account-panel account-panel--poll"><p class="eyebrow">Readers Poll</p><h2>Rank the league</h2><p>Submit one private ballot for the current week. Your ranking appears with the combined readers’ results after voting closes.</p><a href="/poll">Open this week’s ballot →</a></section>
      <section id="editorial-panel" class="account-panel" hidden><p class="eyebrow">Publication access</p><h2>Editorial Desk</h2><p id="editorial-description">Your account includes publication access.</p><a href="/admin">Enter the Editorial Desk →</a></section>
      <section id="delete-account-panel" class="account-panel account-panel--danger" hidden><p class="eyebrow">Account settings</p><h2>Delete reader account</h2><p>Permanently remove your reader profile, ballots, comments, and account access. This cannot be undone.</p><button id="delete-account" type="button">Delete my account</button><p id="delete-account-message" role="status" aria-live="polite"></p></section>
    </div>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    const page=document.querySelector<HTMLElement>("#account-page"),email=document.querySelector<HTMLElement>("#account-email"),form=document.querySelector<HTMLFormElement>("#profile-form"),nameInput=document.querySelector<HTMLInputElement>("#display-name"),digestInput=document.querySelector<HTMLInputElement>("#digest-enabled"),message=document.querySelector<HTMLElement>("#profile-message"),editorial=document.querySelector<HTMLElement>("#editorial-panel"),editorialDescription=document.querySelector<HTMLElement>("#editorial-description"),deletePanel=document.querySelector<HTMLElement>("#delete-account-panel"),deleteButton=document.querySelector<HTMLButtonElement>("#delete-account"),deleteMessage=document.querySelector<HTMLElement>("#delete-account-message");let userId="";
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/account/login");return}userId=user.id;if(email)email.textContent=user.email??"";const[{data:profile},{data:admin},{data:contributor}]=await Promise.all([supabaseBrowser.from("reader_profiles").select("display_name,digest_enabled").eq("user_id",user.id).single(),supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle(),supabaseBrowser.from("publication_contributors").select("role").eq("user_id",user.id).maybeSingle()]);if(nameInput)nameInput.value=profile?.display_name??user.email?.split("@")[0]??"Gazette Reader";if(digestInput)digestInput.checked=profile?.digest_enabled??true;if(admin||contributor){if(editorial)editorial.hidden=false;if(editorialDescription)editorialDescription.textContent=admin?"You have full administrative access.":"You can write Op-Ed stories and submit them for editorial review."}else if(deletePanel){deletePanel.hidden=false}if(page)page.hidden=false}
    form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!message)return;const{error}=await supabaseBrowser.from("reader_profiles").update({display_name:nameInput?.value.trim()??"",digest_enabled:digestInput?.checked??true}).eq("user_id",userId);message.textContent=error?error.message:"Preferences saved."});
    document.querySelector<HTMLButtonElement>("#sign-out")?.addEventListener("click",async()=>{await supabaseBrowser.auth.signOut();window.location.assign("/")});void initialize();
    deleteButton?.addEventListener("click",async()=>{if(!deleteMessage||!window.confirm("Permanently delete your Gazette reader account? Your profile, ballots, comments, and account access will be removed. This cannot be undone."))return;deleteButton.disabled=true;deleteButton.textContent="Deleting…";deleteMessage.textContent="Deleting your account…";const{data,error}=await supabaseBrowser.functions.invoke("delete-reader-account",{body:{}});if(error||data?.success===false){deleteButton.disabled=false;deleteButton.textContent="Delete my account";deleteMessage.textContent=data?.error??error?.message??"The account could not be deleted. Try again.";return}await supabaseBrowser.auth.signOut({scope:"local"});window.location.assign("/account/login?deleted=1")});
  </script>
</BaseLayout>
<style>
  .account-page{padding-block:clamp(2.5rem,7vw,6rem)}.account-page[hidden]{display:none}.account-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:2rem;border-bottom:3px double var(--color-rule-dark)}.account-header h1{margin:.2rem 0;font-size:clamp(3.5rem,8vw,7rem);line-height:.85}.account-header p:last-child{margin:0;color:var(--color-ink-soft);font-family:var(--font-data)}.account-header button{padding:.7rem 1rem;border:1px solid var(--color-rule-dark);background:transparent;font-weight:750}.account-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem;margin-top:2rem}.account-panel{padding:1.5rem;border:1px solid var(--color-rule);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card)}.account-panel--poll{background:var(--color-green);color:#fff}.account-panel--danger{border-color:#d7b0aa;background:#fff8f5}.account-panel h2{margin:.2rem 0 .8rem;font-size:2rem}.account-panel p:not(.eyebrow){color:inherit;opacity:.78;line-height:1.55}.account-panel a{font-weight:800}.account-panel--poll a{color:#ead79b}#profile-form{display:grid;gap:1rem;margin-top:1rem}#profile-form>label:not(.digest-setting){display:grid;gap:.35rem;font-weight:750}#profile-form input[type="text"],#profile-form input:not([type]){padding:.7rem;border:1px solid var(--color-rule-dark);background:var(--color-paper-light);font:inherit}.digest-setting{display:flex;align-items:start;gap:.7rem}.digest-setting span{display:grid;gap:.2rem}.digest-setting small{color:var(--color-ink-soft)}#profile-form button{width:max-content;padding:.7rem 1rem;border:0;background:var(--color-green);color:#fff;font-weight:800}#delete-account{width:max-content;padding:.7rem 1rem;border:1px solid #b9685e;border-radius:999px;background:#9a3d34;color:#fff;font-weight:800;cursor:pointer}#delete-account:hover{background:#71251f}#delete-account:disabled{cursor:wait;opacity:.65}#profile-message,#delete-account-message{min-height:1.2rem;margin:.8rem 0 0;color:var(--color-green);font-size:.8rem}#delete-account-message{color:#9a3d34}@media(max-width:720px){.account-grid{grid-template-columns:1fr}.account-header{align-items:start;flex-direction:column}}
</style>

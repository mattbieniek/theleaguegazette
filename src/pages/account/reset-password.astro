---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountCard from "../../components/account/AccountCard.astro";
---
<BaseLayout title="Choose a New Password" noindex>
  <AccountCard eyebrow="Account recovery" title="Choose a new password" intro="Use at least eight characters and choose something unique to this account.">
    <form id="reset-form" class="account-form">
      <label>New password<input id="password" type="password" autocomplete="new-password" minlength="8" required /></label>
      <label>Confirm password<input id="confirmation" type="password" autocomplete="new-password" minlength="8" required /></label>
      <p id="message" class="account-message" role="status" aria-live="polite"></p>
      <button type="submit">Save new password</button>
    </form>
  </AccountCard>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    const form=document.querySelector<HTMLFormElement>("#reset-form"),message=document.querySelector<HTMLElement>("#message"),button=form?.querySelector<HTMLButtonElement>("button");
    form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!message||!button)return;const password=document.querySelector<HTMLInputElement>("#password")?.value??"",confirmation=document.querySelector<HTMLInputElement>("#confirmation")?.value??"";if(password!==confirmation){message.dataset.error="true";message.textContent="The passwords do not match.";return}button.disabled=true;button.textContent="Saving…";const{error}=await supabaseBrowser.auth.updateUser({password});button.disabled=false;button.textContent="Save new password";message.dataset.error=String(Boolean(error));message.textContent=error?error.message:"Password updated. Redirecting to your account…";if(!error)window.setTimeout(()=>window.location.assign("/account"),900)});
  </script>
</BaseLayout>

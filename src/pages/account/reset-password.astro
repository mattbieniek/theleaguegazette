---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountCard from "../../components/account/AccountCard.astro";
---
<BaseLayout title="Choose a New Password" noindex>
  <AccountCard eyebrow="Account recovery" title="Choose a new password" intro="Use at least eight characters and choose something unique to this account.">
    <form id="reset-form" class="account-form">
      <label>New password<input id="password" type="password" autocomplete="new-password" minlength="8" required /></label>
      <label>Confirm password<input id="confirmation" type="password" autocomplete="new-password" minlength="8" required /></label>
      <p id="message" class="account-message" role="status" aria-live="polite"></p>
      <button type="submit" disabled>Validating recovery link…</button>
    </form>
  </AccountCard>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    const form=document.querySelector<HTMLFormElement>("#reset-form"),message=document.querySelector<HTMLElement>("#message"),button=form?.querySelector<HTMLButtonElement>("button");
    let recoveryReady=false;
    function setRecoveryReady(){recoveryReady=true;if(button){button.disabled=false;button.textContent="Save new password"}if(message){message.dataset.error="false";message.textContent="Recovery link verified. Choose your new password."}}
    async function initializeRecovery(){
      if(!message||!button)return;
      const query=new URLSearchParams(window.location.search),code=query.get("code");
      if(code){const{error}=await supabaseBrowser.auth.exchangeCodeForSession(code);if(error){message.dataset.error="true";message.textContent="This recovery link is invalid or has expired. Request a new one.";button.textContent="Recovery link unavailable";return}window.history.replaceState({},"",window.location.pathname)}
      const hash=new URLSearchParams(window.location.hash.slice(1)),accessToken=hash.get("access_token"),refreshToken=hash.get("refresh_token");
      if(accessToken&&refreshToken){const{error}=await supabaseBrowser.auth.setSession({access_token:accessToken,refresh_token:refreshToken});if(error){message.dataset.error="true";message.textContent="This recovery link is invalid or has expired. Request a new one.";button.textContent="Recovery link unavailable";return}window.history.replaceState({},"",window.location.pathname)}
      const{data:{session}}=await supabaseBrowser.auth.getSession();
      if(session){setRecoveryReady();return}
      message.dataset.error="true";message.textContent="No recovery session was found. Request a new password-reset email.";button.textContent="Recovery link unavailable";
    }
    form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!message||!button||!recoveryReady)return;const password=document.querySelector<HTMLInputElement>("#password")?.value??"",confirmation=document.querySelector<HTMLInputElement>("#confirmation")?.value??"";if(password!==confirmation){message.dataset.error="true";message.textContent="The passwords do not match.";return}button.disabled=true;button.textContent="Saving…";const{error}=await supabaseBrowser.auth.updateUser({password});button.disabled=false;button.textContent="Save new password";message.dataset.error=String(Boolean(error));message.textContent=error?error.message:"Password updated. Redirecting to your account…";if(!error)window.setTimeout(()=>window.location.assign("/account"),900)});
    void initializeRecovery();
  </script>
</BaseLayout>

---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Weekly Awards | The League Gazette">
  <main id="awards-desk" class="admin-shell awards-desk" hidden>
    <header class="awards-header">
      <div><p class="eyebrow">Publication</p><h1>Weekly Awards</h1><p>Review the automatically calculated winners and verify that the selected week has complete matchup data.</p></div>
      <a id="view-public-awards" href="/awards" target="_blank" rel="noreferrer">View public edition ↗</a>
    </header>
    <section class="awards-toolbar">
      <label>Season<select id="awards-season"></select></label>
      <label>Week<select id="awards-week"></select></label>
      <button id="sync-awards-week" type="button">Resync matchup data</button>
    </section>
    <p id="awards-message" class="awards-message" role="status" aria-live="polite"></p>
    <aside id="awards-completeness" class="awards-completeness"></aside>
    <section id="awards-grid" class="awards-grid"></section>
    <section id="awards-empty" class="awards-empty" hidden><h2>No weekly results available</h2><p>Sync matchup data for a completed week to calculate its awards.</p></section>
  </main>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    import { buildWeeklyAwards } from "../../lib/gazette/awards";
    import type { WeeklyTeamResult } from "../../lib/queries/awards";
    type WeekOption = { season: number; week: number; results: number; matchups: number };
    const page=document.querySelector<HTMLElement>("#awards-desk");
    const seasonSelect=document.querySelector<HTMLSelectElement>("#awards-season");
    const weekSelect=document.querySelector<HTMLSelectElement>("#awards-week");
    const grid=document.querySelector<HTMLElement>("#awards-grid");
    const empty=document.querySelector<HTMLElement>("#awards-empty");
    const completeness=document.querySelector<HTMLElement>("#awards-completeness");
    const message=document.querySelector<HTMLElement>("#awards-message");
    const publicLink=document.querySelector<HTMLAnchorElement>("#view-public-awards");
    const syncButton=document.querySelector<HTMLButtonElement>("#sync-awards-week");
    let options:WeekOption[]=[]; let leagueId="";
    function setMessage(text:string,error=false){if(message){message.textContent=text;message.dataset.error=String(error)}}
    function selected(){return{season:Number(seasonSelect?.value),week:Number(weekSelect?.value)}}
    function populateWeeks(){if(!weekSelect||!seasonSelect)return;weekSelect.replaceChildren();for(const option of options.filter(item=>item.season===Number(seasonSelect.value))){const element=document.createElement("option");element.value=String(option.week);element.textContent=`Week ${option.week}${option.results<10?" — Partial":""}`;weekSelect.append(element)}}
    function normalize(row:Record<string,unknown>):WeeklyTeamResult{return{matchup_id:String(row.matchup_id??""),season_year:Number(row.season_year),week:Number(row.week),sleeper_matchup_id:Number(row.sleeper_matchup_id),fantasy_team_id:String(row.fantasy_team_id),team_name:String(row.team_name??"Unknown Team"),opponent_fantasy_team_id:typeof row.opponent_fantasy_team_id==="string"?row.opponent_fantasy_team_id:null,opponent_team_name:typeof row.opponent_team_name==="string"?row.opponent_team_name:null,points_for:Number(row.points_for??0),points_against:Number(row.points_against??0),point_differential:Number(row.point_differential??0),starters_points:Number(row.starters_points??0),bench_points:Number(row.bench_points??0),result:String(row.result??""),is_winner:Boolean(row.is_winner),is_tie:Boolean(row.is_tie)}}
    async function loadAwards(){const choice=selected();if(!choice.season||!choice.week)return;setMessage("Loading awards…");const{data,error}=await supabaseBrowser.from("team_weekly_results").select("matchup_id,season_year,week,sleeper_matchup_id,fantasy_team_id,team_name,opponent_fantasy_team_id,opponent_team_name,points_for,points_against,point_differential,starters_points,bench_points,result,is_winner,is_tie").eq("season_year",choice.season).eq("week",choice.week).order("sleeper_matchup_id");if(error){setMessage(error.message,true);return}const results=(data??[]).map(row=>normalize(row as Record<string,unknown>));const awards=buildWeeklyAwards(results,choice.week);if(grid){grid.replaceChildren();for(const award of awards){const card=document.createElement("article");card.className=`award-review award-review--${award.tone}`;const label=document.createElement("p");label.textContent=`${award.symbol} ${award.label}`;const title=document.createElement("h2");title.textContent=award.title;const team=document.createElement("strong");team.textContent=award.teamName;const value=document.createElement("b");value.textContent=award.primaryValue;const description=document.createElement("p");description.textContent=award.description;card.append(label,title,team,value,description);grid.append(card)}grid.hidden=awards.length===0}if(empty)empty.hidden=awards.length>0;const option=options.find(item=>item.season===choice.season&&item.week===choice.week);if(completeness){const complete=(option?.results??0)>=10;completeness.dataset.complete=String(complete);completeness.innerHTML=`<strong>${complete?"Complete week":"Partial week"}</strong><span>${option?.results??0} team results across ${option?.matchups??0} matchups.</span>`}if(publicLink)publicLink.href=`/awards?season=${choice.season}&week=${choice.week}`;setMessage("")}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}const[{data,error},{data:statusData}]=await Promise.all([supabaseBrowser.from("team_weekly_results").select("season_year,week,matchup_id").order("season_year",{ascending:false}).order("week",{ascending:false}),supabaseBrowser.rpc("admin_sleeper_status")]);if(error){if(page)page.hidden=false;setMessage(error.message,true);return}const grouped=new Map<string,{season:number;week:number;results:number;ids:Set<string>}>();for(const row of data??[]){const key=`${row.season_year}-${row.week}`;const item=grouped.get(key)??{season:Number(row.season_year),week:Number(row.week),results:0,ids:new Set<string>()};item.results++;if(row.matchup_id)item.ids.add(String(row.matchup_id));grouped.set(key,item)}options=[...grouped.values()].map(item=>({season:item.season,week:item.week,results:item.results,matchups:item.ids.size}));leagueId=String((statusData as any)?.league?.sleeper_league_id??"");if(seasonSelect){for(const season of [...new Set(options.map(item=>item.season))]){const option=document.createElement("option");option.value=String(season);option.textContent=String(season);seasonSelect.append(option)}}populateWeeks();if(page)page.hidden=false;await loadAwards()}
    seasonSelect?.addEventListener("change",()=>{populateWeeks();void loadAwards()});weekSelect?.addEventListener("change",()=>void loadAwards());syncButton?.addEventListener("click",async()=>{const choice=selected();if(!leagueId||!choice.week){setMessage("League or week information is unavailable.",true);return}syncButton.disabled=true;syncButton.textContent="Syncing…";const{data,error}=await supabaseBrowser.functions.invoke("sync-sleeper-matchups",{body:{sleeper_league_id:leagueId,week:choice.week,status:"complete"}});syncButton.disabled=false;syncButton.textContent="Resync matchup data";if(error||data?.success===false){setMessage(`Sync failed: ${data?.error?.message??data?.error??error?.message}`,true);return}setMessage("Matchup data refreshed.");window.location.reload()});void initialize();
  </script>
</AdminLayout>

<style>
  .awards-desk{display:grid;gap:1.5rem}.awards-desk[hidden],.awards-empty[hidden],.awards-grid[hidden]{display:none}.awards-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.awards-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.awards-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.awards-header>a{color:var(--color-green);font-weight:750}.awards-toolbar{display:flex;align-items:end;gap:1rem;padding:1rem 1.25rem;border:1px solid var(--color-rule);background:var(--color-surface)}.awards-toolbar label{display:grid;gap:.35rem;font-weight:750}.awards-toolbar select{min-width:9rem;padding:.65rem;border:1px solid var(--color-rule-dark);background:white}.awards-toolbar button{margin-left:auto;padding:.7rem 1rem;border:0;border-radius:.45rem;background:var(--color-green);color:white;font-weight:750}.awards-message{min-height:1.25rem;margin:0;color:var(--color-green)}.awards-message[data-error="true"]{color:#a32320}.awards-completeness{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;border:1px solid #d3b26a;background:#fff7df;color:#6d521a}.awards-completeness[data-complete="true"]{border-color:#a9c8b3;background:#edf6f0;color:var(--color-green)}.awards-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.award-review{display:grid;gap:.55rem;padding:1.25rem;border:1px solid var(--color-rule);border-top:4px solid #777;background:var(--color-surface)}.award-review--positive{border-top-color:var(--color-green)}.award-review--negative{border-top-color:#a32320}.award-review--warning{border-top-color:#b37b22}.award-review p,.award-review h2{margin:0}.award-review>p:first-child{color:var(--color-ink-soft);font-size:.7rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.award-review b{font-family:var(--font-display);font-size:1.35rem}.award-review>p:last-child{color:var(--color-ink-soft);line-height:1.5}.awards-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:750px){.awards-header,.awards-toolbar,.awards-completeness{align-items:flex-start;flex-direction:column}.awards-toolbar button{margin-left:0}.awards-grid{grid-template-columns:1fr}}
</style>

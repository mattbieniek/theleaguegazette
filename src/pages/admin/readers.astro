---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Readers Poll | The League Gazette">
  <main id="readers-page" class="admin-shell readers-page" hidden>
    <header><div><p class="eyebrow">Community desk</p><h1>Readers Poll</h1><p>Control weekly ballot availability and monitor reader participation.</p></div><a href="/poll" target="_blank">View public poll ↗</a></header>
    <section id="reader-summary" class="reader-summary"></section>
    <div class="reader-grid">
      <section class="reader-panel"><div><p class="eyebrow">Ballot window</p><h2>Edition controls</h2></div><form id="window-form"><label>Season<input id="season" type="number" min="2022" required /></label><label>Week<input id="week" type="number" min="1" max="18" required /></label><label>Optional closing time<input id="closes-at" type="datetime-local" /></label><label class="open-toggle"><input id="is-open" type="checkbox" checked /><span>Accept ballots</span></label><p id="window-message" role="status"></p><button type="submit">Save ballot window</button></form></section>
      <section class="reader-panel"><div><p class="eyebrow">Email operations</p><h2>Weekly digest</h2><p>Delivered Wednesday mornings. Send a single-address preview whenever you need to review the next edition.</p></div><form id="digest-test-form"><label>Test recipient<input id="digest-test-email" type="email" autocomplete="email" required /></label><p id="digest-message" role="status"></p><button type="submit">Send test digest</button></form><div id="digest-runs" class="digest-runs"></div><p id="digest-empty">No digest has been sent yet.</p></section>
    </div>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    const db=supabaseBrowser as any,page=document.querySelector<HTMLElement>("#readers-page"),summary=document.querySelector<HTMLElement>("#reader-summary"),form=document.querySelector<HTMLFormElement>("#window-form"),seasonInput=document.querySelector<HTMLInputElement>("#season"),weekInput=document.querySelector<HTMLInputElement>("#week"),closesInput=document.querySelector<HTMLInputElement>("#closes-at"),openInput=document.querySelector<HTMLInputElement>("#is-open"),message=document.querySelector<HTMLElement>("#window-message"),runs=document.querySelector<HTMLElement>("#digest-runs"),empty=document.querySelector<HTMLElement>("#digest-empty"),digestForm=document.querySelector<HTMLFormElement>("#digest-test-form"),digestEmail=document.querySelector<HTMLInputElement>("#digest-test-email"),digestMessage=document.querySelector<HTMLElement>("#digest-message");
    function stat(label:string,value:string){const item=document.createElement("div"),small=document.createElement("span"),strong=document.createElement("strong");small.textContent=label;strong.textContent=value;item.append(small,strong);return item}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}const[{data:statusData,error:statusError},{count:readers},{count:ballots},{data:digestRuns}]=await Promise.all([db.rpc("admin_sleeper_status"),db.from("reader_profiles").select("user_id",{count:"exact",head:true}),db.from("reader_power_ballots").select("id",{count:"exact",head:true}),db.from("weekly_digest_runs").select("season_year,week,subject,recipient_count,delivered_count,failed_count,status,created_at").order("created_at",{ascending:false}).limit(5)]);const activeSeason=Number(statusData?.active_season_year??new Date().getFullYear());const activeWeek=Math.min(Math.max(Number(statusData?.league?.current_week??1),1),17);if(seasonInput)seasonInput.value=String(activeSeason);if(weekInput)weekInput.value=String(activeWeek);if(statusError&&message)message.textContent=`Unable to load the active season: ${statusError.message}`;summary?.replaceChildren(stat("Registered readers",String(readers??0)),stat("Ballots submitted",String(ballots??0)),stat("Digest delivery","Wednesday mornings"));if(runs&&empty){runs.replaceChildren();for(const run of digestRuns??[]){const row=document.createElement("article"),copy=document.createElement("div"),title=document.createElement("strong"),detail=document.createElement("small"),badge=document.createElement("span");title.textContent=run.subject;detail.textContent=`${run.delivered_count}/${run.recipient_count} delivered${run.failed_count?` · ${run.failed_count} failed`:""}`;badge.textContent=run.status;copy.append(title,detail);row.append(copy,badge);runs.append(row)}empty.hidden=Boolean(digestRuns?.length)}if(page)page.hidden=false;await loadWindow()}
    async function loadWindow(){const season=Number(seasonInput?.value),week=Number(weekInput?.value);const{data}=await db.from("reader_poll_windows").select("is_open,closes_at").eq("season_year",season).eq("week",week).maybeSingle();if(openInput)openInput.checked=data?.is_open??true;if(closesInput)closesInput.value=data?.closes_at?new Date(data.closes_at).toISOString().slice(0,16):""}
    form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!message)return;const payload={season_year:Number(seasonInput?.value),week:Number(weekInput?.value),is_open:openInput?.checked??true,closes_at:closesInput?.value?new Date(closesInput.value).toISOString():null};const{error}=await db.from("reader_poll_windows").upsert(payload,{onConflict:"season_year,week"});message.textContent=error?error.message:"Ballot window saved."});seasonInput?.addEventListener("change",()=>void loadWindow());weekInput?.addEventListener("change",()=>void loadWindow());
    digestForm?.addEventListener("submit",async(event)=>{event.preventDefault();const button=digestForm.querySelector<HTMLButtonElement>("button"),testEmail=digestEmail?.value.trim()??"";if(!button||!digestMessage||!testEmail)return;button.disabled=true;button.textContent="Sending…";digestMessage.textContent="";const{data,error}=await supabaseBrowser.functions.invoke("send-weekly-digest",{body:{test_email:testEmail}});button.disabled=false;button.textContent="Send test digest";digestMessage.textContent=error?`Test failed: ${error.message}`:data?.success?`Test delivered to ${testEmail}.`:`Test failed: ${data?.error??"Unknown error"}`});
    void initialize();
  </script>
</AdminLayout>
<style>
  .readers-page{display:grid;gap:1.5rem}.readers-page[hidden]{display:none}.readers-page>header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.readers-page h1{margin:.2rem 0;font-size:clamp(3.5rem,8vw,6rem)}.readers-page header p:last-child{color:var(--color-ink-soft)}.readers-page header a{padding:.7rem 1rem;border:1px solid var(--color-rule-dark);font-weight:750}.reader-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--color-rule);background:var(--color-rule)}.reader-summary>div{display:grid;gap:.35rem;padding:1.25rem;background:var(--color-surface)}.reader-summary span{color:var(--color-ink-soft);font-size:.7rem;font-weight:800;text-transform:uppercase}.reader-summary strong{font-size:1.5rem}.reader-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.reader-panel{padding:1.5rem;border:1px solid var(--color-rule);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card)}.reader-panel h2{margin:.2rem 0;font-size:2rem}.reader-panel>div>p:last-child{color:var(--color-ink-soft);line-height:1.5}#window-form{display:grid;gap:1rem;margin-top:1.5rem}#window-form label:not(.open-toggle){display:grid;gap:.35rem;font-weight:750}#window-form input{padding:.65rem;border:1px solid var(--color-rule-dark);font:inherit}.open-toggle{display:flex;gap:.6rem;font-weight:750}#window-form button{padding:.75rem 1rem;border:0;background:var(--color-green);color:#fff;font-weight:800}#window-message{min-height:1.2rem;margin:0;color:var(--color-green)}#digest-test-form{display:grid;gap:.75rem;padding-block:1.25rem;border-bottom:1px solid var(--color-rule)}#digest-test-form label{display:grid;gap:.35rem;font-weight:750}#digest-test-form input{padding:.65rem;border:1px solid var(--color-rule-dark);font:inherit}#digest-test-form button{width:max-content;padding:.7rem 1rem;border:0;background:var(--color-green);color:#fff;font-weight:800}#digest-test-form button:disabled{opacity:.6}#digest-message{min-height:1.2rem;margin:0;color:var(--color-green);font-size:.8rem}.digest-runs article{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:.9rem;border-bottom:1px solid var(--color-rule)}.digest-runs article div{display:grid;gap:.25rem}.digest-runs small{color:var(--color-ink-soft)}.digest-runs span{font-size:.65rem;font-weight:800;text-transform:uppercase}@media(max-width:800px){.reader-grid,.reader-summary{grid-template-columns:1fr}.readers-page>header{align-items:start;flex-direction:column}}
</style>

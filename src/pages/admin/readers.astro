---
import AdminLayout from "../../layouts/AdminLayout.astro";
---
<AdminLayout title="Readers Poll | The League Gazette">
  <main id="readers-page" class="admin-shell readers-page" hidden>
    <header class="readers-header"><div><p class="eyebrow">Community desk</p><h1>Readers Poll</h1><p>Control weekly ballot availability, monitor participation, and review Gazette email delivery.</p></div><a class="readers-header__link" href="/poll" target="_blank">View public poll <span aria-hidden="true">↗</span></a></header>
    <section id="reader-summary" class="reader-summary" aria-label="Reader activity summary"></section>
    <div class="reader-grid">
      <section class="reader-panel reader-panel--ballot"><div class="reader-panel__heading"><p class="eyebrow">Ballot window</p><h2>Edition controls</h2><p>Choose the active voting period and decide when submissions should close.</p></div><form id="window-form" class="reader-form"><div class="reader-form__row"><label>Season<input id="season" type="number" min="2022" required /></label><label>Week<input id="week" type="number" min="1" max="18" required /></label></div><label>Optional closing time<input id="closes-at" type="datetime-local" /></label><label class="open-toggle"><input id="is-open" type="checkbox" checked /><span><strong>Accept ballots</strong><small>Readers can submit or update their current-week ranking.</small></span></label><p id="window-message" role="status" aria-live="polite"></p><button type="submit">Save ballot window</button></form></section>
      <section class="reader-panel reader-panel--digest"><div class="reader-panel__heading"><p class="eyebrow">Email operations</p><h2>Weekly digest</h2><p>Delivered Wednesday mornings. Send a single-address preview whenever you need to review the next edition.</p><span class="schedule-badge">Wednesday mornings</span></div><form id="digest-test-form" class="reader-form"><label>Test recipient<input id="digest-test-email" type="email" autocomplete="email" required /></label><p id="digest-message" role="status" aria-live="polite"></p><button type="submit">Send test digest</button></form><div class="digest-history__heading"><div><p class="eyebrow">Delivery log</p><h3>Recent deliveries</h3></div><span>Latest 5</span></div><div id="digest-runs" class="digest-runs"></div><p id="digest-empty" class="digest-empty">No digest has been sent yet.</p></section>
    </div>
    <section class="reader-panel ballot-review" aria-labelledby="ballot-review-title"><div class="reader-panel__heading ballot-review__heading"><div><p class="eyebrow">Administrator review</p><h2 id="ballot-review-title">Submitted ballots</h2><p>Review the selected edition before its combined results are released publicly.</p></div><span id="ballot-review-edition" class="edition-badge">Loading edition…</span></div><div class="ballot-review__notice"><span aria-hidden="true">✦</span><p><strong>Private administrator view</strong> Current-week rankings remain sealed on the public poll until voting closes.</p></div><p id="ballot-review-message" class="ballot-review__message" role="status" aria-live="polite"></p><div id="submitted-ballots" class="submitted-ballots"></div><p id="submitted-ballots-empty" class="digest-empty" hidden>No ballots have been submitted for this edition.</p></section>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    const db=supabaseBrowser as any,page=document.querySelector<HTMLElement>("#readers-page"),summary=document.querySelector<HTMLElement>("#reader-summary"),form=document.querySelector<HTMLFormElement>("#window-form"),seasonInput=document.querySelector<HTMLInputElement>("#season"),weekInput=document.querySelector<HTMLInputElement>("#week"),closesInput=document.querySelector<HTMLInputElement>("#closes-at"),openInput=document.querySelector<HTMLInputElement>("#is-open"),message=document.querySelector<HTMLElement>("#window-message"),runs=document.querySelector<HTMLElement>("#digest-runs"),empty=document.querySelector<HTMLElement>("#digest-empty"),digestForm=document.querySelector<HTMLFormElement>("#digest-test-form"),digestEmail=document.querySelector<HTMLInputElement>("#digest-test-email"),digestMessage=document.querySelector<HTMLElement>("#digest-message"),ballotEdition=document.querySelector<HTMLElement>("#ballot-review-edition"),ballotMessage=document.querySelector<HTMLElement>("#ballot-review-message"),submittedBallots=document.querySelector<HTMLElement>("#submitted-ballots"),submittedBallotsEmpty=document.querySelector<HTMLElement>("#submitted-ballots-empty");
    function stat(label:string,value:string){const item=document.createElement("div"),small=document.createElement("span"),strong=document.createElement("strong");item.className="reader-summary__card";small.textContent=label;strong.textContent=value;item.append(small,strong);return item}
    function formatDate(value:string){return new Intl.DateTimeFormat("en-US",{month:"short",day:"numeric",hour:"numeric",minute:"2-digit"}).format(new Date(value))}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}const[{data:statusData,error:statusError},{count:readers},{count:ballots},{data:digestRuns}]=await Promise.all([db.rpc("admin_sleeper_status"),db.from("reader_profiles").select("user_id",{count:"exact",head:true}),db.from("reader_power_ballots").select("id",{count:"exact",head:true}),db.from("weekly_digest_runs").select("season_year,week,subject,recipient_count,delivered_count,failed_count,status,created_at").order("created_at",{ascending:false}).limit(5)]);const activeSeason=Number(statusData?.active_season_year??new Date().getFullYear());const activeWeek=Math.min(Math.max(Number(statusData?.league?.current_week??1),1),17);if(seasonInput)seasonInput.value=String(activeSeason);if(weekInput)weekInput.value=String(activeWeek);if(statusError&&message)message.textContent=`Unable to load the active season: ${statusError.message}`;summary?.replaceChildren(stat("Registered readers",String(readers??0)),stat("Ballots submitted",String(ballots??0)),stat("Digest delivery","Wednesday mornings"));if(runs&&empty){runs.replaceChildren();for(const run of digestRuns??[]){const row=document.createElement("article"),copy=document.createElement("div"),title=document.createElement("strong"),detail=document.createElement("small"),badge=document.createElement("span");row.className="digest-run";copy.className="digest-run__copy";title.className="digest-run__title";detail.className="digest-run__detail";badge.className=`digest-run__badge digest-run__badge--${run.status}`;title.textContent=run.subject;detail.textContent=`${run.delivered_count}/${run.recipient_count} delivered${run.failed_count?` · ${run.failed_count} failed`:""} · ${formatDate(run.created_at)}`;badge.textContent=run.status;copy.append(title,detail);row.append(copy,badge);runs.append(row)}empty.hidden=Boolean(digestRuns?.length)}if(page)page.hidden=false;await loadWindow()}
    async function loadWindow(){const season=Number(seasonInput?.value),week=Number(weekInput?.value);const{data}=await db.from("reader_poll_windows").select("is_open,closes_at").eq("season_year",season).eq("week",week).maybeSingle();if(openInput)openInput.checked=data?.is_open??true;if(closesInput)closesInput.value=data?.closes_at?new Date(data.closes_at).toISOString().slice(0,16):"";await loadSubmittedBallots(season,week)}
    async function loadSubmittedBallots(season:number,week:number){if(!submittedBallots||!submittedBallotsEmpty||!ballotMessage)return;if(ballotEdition)ballotEdition.textContent=`${season} · Week ${week}`;ballotMessage.textContent="Loading submitted ballots…";const[{data:ballots,error},{data:profiles}]=await Promise.all([db.from("reader_power_ballots").select("user_id,rankings,updated_at").eq("season_year",season).eq("week",week).order("updated_at",{ascending:false}),db.from("public_reader_profiles").select("user_id,display_name")]);if(error){ballotMessage.textContent=`Unable to load ballots: ${error.message}`;return}const names=new Map<string,string>((profiles??[]).map((profile:any):[string,string]=>[String(profile.user_id),String(profile.display_name)]));submittedBallots.replaceChildren();for(const ballot of ballots??[]){const card=document.createElement("article"),header=document.createElement("header"),identity=document.createElement("div"),name=document.createElement("h3"),time=document.createElement("time"),ranking=document.createElement("ol");card.className="submitted-ballot";header.className="submitted-ballot__header";name.textContent=names.get(String(ballot.user_id))??"Gazette Reader";time.dateTime=ballot.updated_at;time.textContent=`Updated ${formatDate(ballot.updated_at)}`;identity.append(name,time);const entries=[...(Array.isArray(ballot.rankings)?ballot.rankings:[])].sort((first:any,second:any)=>Number(first.rank)-Number(second.rank));const count=document.createElement("span");count.textContent=`${entries.length} ranked`;header.append(identity,count);for(const entry of entries){const item=document.createElement("li"),rank=document.createElement("b"),team=document.createElement("span");rank.textContent=String(entry.rank);team.textContent=String(entry.teamName??"Unknown team");item.append(rank,team);ranking.append(item)}card.append(header,ranking);submittedBallots.append(card)}submittedBallotsEmpty.hidden=Boolean(ballots?.length);ballotMessage.textContent=ballots?.length?`${ballots.length} ${ballots.length===1?"ballot":"ballots"} submitted for this edition.`:""}
    form?.addEventListener("submit",async(event)=>{event.preventDefault();if(!message)return;const payload={season_year:Number(seasonInput?.value),week:Number(weekInput?.value),is_open:openInput?.checked??true,closes_at:closesInput?.value?new Date(closesInput.value).toISOString():null};const{error}=await db.from("reader_poll_windows").upsert(payload,{onConflict:"season_year,week"});message.textContent=error?error.message:"Ballot window saved."});seasonInput?.addEventListener("change",()=>void loadWindow());weekInput?.addEventListener("change",()=>void loadWindow());
    digestForm?.addEventListener("submit",async(event)=>{event.preventDefault();const button=digestForm.querySelector<HTMLButtonElement>("button"),testEmail=digestEmail?.value.trim()??"";if(!button||!digestMessage||!testEmail)return;button.disabled=true;button.textContent="Sending…";digestMessage.textContent="";const{data,error}=await supabaseBrowser.functions.invoke("send-weekly-digest",{body:{test_email:testEmail}});button.disabled=false;button.textContent="Send test digest";digestMessage.textContent=error?`Test failed: ${error.message}`:data?.success?`Test delivered to ${testEmail}.`:`Test failed: ${data?.error??"Unknown error"}`});
    void initialize();
  </script>
</AdminLayout>
<style>
  .readers-page{display:grid;gap:1.75rem}.readers-page[hidden],.digest-empty[hidden]{display:none}.readers-header{position:relative;display:flex;overflow:hidden;align-items:end;justify-content:space-between;gap:2rem;padding:clamp(1.5rem,4vw,2.5rem);border:1px solid #29473b;border-radius:var(--radius-lg);background:linear-gradient(135deg,#132d23,#234a39);color:#fff;box-shadow:0 16px 36px rgb(25 42 34 / 12%)}.readers-header::after{position:absolute;right:-4rem;bottom:-7rem;width:17rem;height:17rem;border:1px solid rgb(255 255 255 / 8%);border-radius:50%;box-shadow:0 0 0 3rem rgb(255 255 255 / 3%),0 0 0 6rem rgb(255 255 255 / 2%);content:""}.readers-header>div,.readers-header__link{position:relative;z-index:1}.readers-header h1{margin:.2rem 0;color:#fff;font-size:clamp(3.5rem,8vw,6rem);letter-spacing:-.05em}.readers-header .eyebrow{color:#d9c47f}.readers-header p:last-child{max-width:44rem;margin:0;color:#d7e0dc;font-family:var(--font-display);font-size:1.05rem;line-height:1.5}.readers-header__link{display:inline-flex;align-items:center;gap:.65rem;flex:0 0 auto;padding:.8rem 1rem;border:1px solid rgb(255 255 255 / 28%);border-radius:999px;background:rgb(255 255 255 / 8%);color:#fff;font-family:var(--font-data);font-size:.65rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;backdrop-filter:blur(8px)}.readers-header__link:hover{background:rgb(255 255 255 / 14%)}.reader-summary{display:grid;overflow:hidden;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;border:1px solid var(--color-rule);border-radius:var(--radius-lg);background:var(--color-rule);box-shadow:var(--shadow-card)}:global(.reader-summary__card){position:relative;display:grid;min-height:7.5rem;align-content:center;gap:.55rem;padding:1.35rem 1.5rem;background:var(--color-surface)}:global(.reader-summary__card)::before{position:absolute;top:0;right:0;left:0;height:3px;background:var(--color-gold);content:""}:global(.reader-summary__card span){color:var(--color-ink-muted);font-family:var(--font-data);font-size:.6rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}:global(.reader-summary__card strong){font-family:var(--font-display);font-size:clamp(1.45rem,3vw,2rem);line-height:1.1}.reader-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:1.5rem;align-items:start}.reader-panel{overflow:hidden;border:1px solid var(--color-rule);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card)}.reader-panel__heading{position:relative;padding:1.5rem 1.65rem;border-bottom:1px solid var(--color-rule);background:linear-gradient(135deg,color-mix(in srgb,var(--color-green) 7%,var(--color-surface)),var(--color-surface) 70%)}.reader-panel__heading h2{margin:.15rem 0 0;font-size:clamp(1.8rem,3vw,2.35rem)}.reader-panel__heading>p:last-of-type{max-width:34rem;margin:.55rem 0 0;color:var(--color-ink-soft);font-size:.88rem;line-height:1.55}.schedule-badge,.edition-badge{display:inline-flex;margin-top:1rem;padding:.35rem .65rem;border-radius:999px;background:color-mix(in srgb,var(--color-gold) 22%,transparent);color:var(--color-green);font-family:var(--font-data);font-size:.58rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.reader-form{display:grid;gap:1.1rem;padding:1.5rem 1.65rem}.reader-form__row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.reader-form label:not(.open-toggle){display:grid;gap:.45rem;color:var(--color-ink);font-size:.78rem;font-weight:800}.reader-form input:not([type="checkbox"]){width:100%;min-width:0;padding:.75rem .8rem;border:1px solid var(--color-rule-dark);border-radius:.35rem;background:var(--color-paper);font:inherit;transition:border-color .15s ease,box-shadow .15s ease}.reader-form input:not([type="checkbox"]):focus{border-color:var(--color-green);outline:0;box-shadow:0 0 0 3px color-mix(in srgb,var(--color-green) 14%,transparent)}.open-toggle{display:flex;align-items:center;gap:.8rem;padding:1rem;border:1px solid color-mix(in srgb,var(--color-green) 24%,var(--color-rule));border-radius:.5rem;background:color-mix(in srgb,var(--color-green) 5%,var(--color-paper));cursor:pointer}.open-toggle input{width:1.1rem;height:1.1rem;margin:0;accent-color:var(--color-green)}.open-toggle span{display:grid;gap:.2rem}.open-toggle strong{font-size:.82rem}.open-toggle small{color:var(--color-ink-soft);font-size:.7rem;font-weight:500;line-height:1.4}.reader-form button{width:max-content;padding:.8rem 1.05rem;border:1px solid var(--color-green);border-radius:.35rem;background:var(--color-green);color:#fff;font-weight:800;box-shadow:0 6px 14px rgb(20 65 47 / 12%)}.reader-form button:hover{background:color-mix(in srgb,var(--color-green) 88%,#000)}.reader-form button:disabled{cursor:wait;opacity:.6}.reader-form [role="status"]{min-height:1.15rem;margin:0;color:var(--color-green);font-size:.75rem;line-height:1.4}#digest-test-form{border-bottom:1px solid var(--color-rule)}.digest-history__heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:1.2rem 1.65rem;border-bottom:1px solid var(--color-rule);background:var(--color-paper)}.digest-history__heading h3{margin:.15rem 0 0;font-size:1.35rem}.digest-history__heading>span{color:var(--color-ink-muted);font-family:var(--font-data);font-size:.58rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.digest-runs{display:grid}:global(.digest-run){display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.65rem;border-bottom:1px solid color-mix(in srgb,var(--color-rule) 72%,transparent)}:global(.digest-run:last-child){border-bottom:0}:global(.digest-run__copy){display:grid;min-width:0;gap:.3rem}:global(.digest-run__title){overflow:hidden;font-family:var(--font-display);font-size:.95rem;text-overflow:ellipsis;white-space:nowrap}:global(.digest-run__detail){color:var(--color-ink-soft);font-family:var(--font-data);font-size:.62rem;line-height:1.45}:global(.digest-run__badge){flex:0 0 auto;padding:.3rem .55rem;border-radius:999px;background:#ececeb;color:var(--color-ink-soft);font-family:var(--font-data);font-size:.55rem;font-weight:850;letter-spacing:.05em;text-transform:uppercase}:global(.digest-run__badge--completed){background:#e4f0e8;color:var(--color-green)}:global(.digest-run__badge--partial){background:#f7eedb;color:#8a5a16}:global(.digest-run__badge--failed){background:#f6e5e3;color:#a32320}.digest-empty{margin:0;padding:2rem;color:var(--color-ink-soft);text-align:center}.ballot-review__heading{display:flex;align-items:end;justify-content:space-between;gap:1.5rem}.edition-badge{flex:0 0 auto;margin:0}.ballot-review__notice{display:flex;align-items:center;gap:.85rem;padding:1rem 1.65rem;border-bottom:1px solid var(--color-rule);background:color-mix(in srgb,var(--color-gold) 10%,var(--color-paper))}.ballot-review__notice>span{display:grid;width:2rem;height:2rem;flex:0 0 auto;place-items:center;border-radius:50%;background:var(--color-green);color:#fff}.ballot-review__notice p{margin:0;color:var(--color-ink-soft);font-size:.78rem;line-height:1.5}.ballot-review__notice strong{display:block;color:var(--color-ink)}.ballot-review__message{min-height:1.1rem;margin:0;padding:1rem 1.65rem 0;color:var(--color-green);font-family:var(--font-data);font-size:.62rem;text-transform:uppercase}.submitted-ballots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding:1rem 1.65rem 1.65rem}:global(.submitted-ballot){overflow:hidden;border:1px solid var(--color-rule);border-radius:.65rem;background:var(--color-paper)}:global(.submitted-ballot__header){display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.1rem;border-bottom:1px solid var(--color-rule);background:color-mix(in srgb,var(--color-green) 5%,var(--color-surface))}:global(.submitted-ballot__header div){display:grid;min-width:0;gap:.2rem}:global(.submitted-ballot__header h3){overflow:hidden;margin:0;font-size:1.15rem;text-overflow:ellipsis;white-space:nowrap}:global(.submitted-ballot__header time){color:var(--color-ink-soft);font-family:var(--font-data);font-size:.58rem}:global(.submitted-ballot__header>span){flex:0 0 auto;color:var(--color-green);font-family:var(--font-data);font-size:.57rem;font-weight:800;text-transform:uppercase}:global(.submitted-ballot ol){display:grid;margin:0;padding:0;list-style:none}:global(.submitted-ballot li){display:grid;grid-template-columns:2.25rem 1fr;align-items:center;min-height:2.65rem;border-bottom:1px solid color-mix(in srgb,var(--color-rule) 70%,transparent)}:global(.submitted-ballot li:last-child){border-bottom:0}:global(.submitted-ballot li b){display:grid;align-self:stretch;place-items:center;border-right:1px solid var(--color-rule);color:var(--color-green);font-family:var(--font-display);font-size:1rem}:global(.submitted-ballot li span){padding:.55rem .75rem;font-size:.78rem;font-weight:700}@media(max-width:900px){.reader-grid{grid-template-columns:1fr}.submitted-ballots{grid-template-columns:1fr}}@media(max-width:700px){.readers-header,.ballot-review__heading{align-items:flex-start;flex-direction:column}.readers-header__link{width:100%;justify-content:center}.reader-summary{grid-template-columns:1fr}.reader-form__row{grid-template-columns:1fr}:global(.digest-run){align-items:flex-start;flex-direction:column}:global(.digest-run__badge){align-self:flex-start}.edition-badge{align-self:flex-start}}
</style>

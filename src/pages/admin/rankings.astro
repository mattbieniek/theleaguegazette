---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Power Rankings | The League Gazette">
  <main id="rankings-desk" class="admin-shell rankings-desk" hidden>
    <header class="rankings-header"><div><p class="eyebrow">Publication workspace</p><h1>Power Rankings</h1><p>Arrange the league, add the editorial case for each position, and save a private weekly edition.</p></div><span>Admin only</span></header>
    <section class="rankings-toolbar">
      <label>Season<select id="ranking-season"></select></label><label>Week<input id="ranking-week" type="number" min="0" max="18" value="1" /></label><label class="ranking-title">Edition title<input id="ranking-title" value="Power Rankings" /></label><label>Status<select id="ranking-status"><option value="draft">Draft</option><option value="ready">Ready</option></select></label><button id="save-rankings" type="button">Save rankings</button>
    </section>
    <p id="rankings-message" class="rankings-message" role="status" aria-live="polite"></p>
    <aside class="rankings-note"><strong>Private workspace</strong><span>Saving here does not change the public site. A public rankings presentation can be added later.</span></aside>
    <section id="rankings-list" class="rankings-list" aria-label="Ordered power rankings"></section>
    <section id="rankings-empty" class="rankings-empty" hidden><h2>No standings are available</h2><p>Sync the current league before creating a ranking.</p></section>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    type Entry={teamId:string;teamName:string;rank:number;previousRank:number|null;record:string;pointsFor:number;note:string};
    const db=supabaseBrowser as any;const page=document.querySelector<HTMLElement>("#rankings-desk");const seasonSelect=document.querySelector<HTMLSelectElement>("#ranking-season");const weekInput=document.querySelector<HTMLInputElement>("#ranking-week");const titleInput=document.querySelector<HTMLInputElement>("#ranking-title");const statusSelect=document.querySelector<HTMLSelectElement>("#ranking-status");const list=document.querySelector<HTMLElement>("#rankings-list");const empty=document.querySelector<HTMLElement>("#rankings-empty");const message=document.querySelector<HTMLElement>("#rankings-message");const saveButton=document.querySelector<HTMLButtonElement>("#save-rankings");let standings:any[]=[];let entries:Entry[]=[];let savedId:string|null=null;
    function setMessage(text:string,error=false){if(message){message.textContent=text;message.dataset.error=String(error)}}function record(row:any){const base=`${row.wins??0}-${row.losses??0}`;return row.ties?`${base}-${row.ties}`:base}
    function normalizeRanks(){entries.forEach((entry,index)=>entry.rank=index+1)}function render(){if(!list||!empty)return;list.replaceChildren();for(const entry of entries){const card=document.createElement("article");card.className="ranking-entry";const rank=document.createElement("strong");rank.className="ranking-entry__rank";rank.textContent=String(entry.rank);const body=document.createElement("div");body.className="ranking-entry__body";const heading=document.createElement("div");const title=document.createElement("h2");title.textContent=entry.teamName;const meta=document.createElement("p");meta.textContent=`${entry.record} · ${entry.pointsFor.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2})} PF`;heading.append(title,meta);const note=document.createElement("textarea");note.rows=2;note.placeholder="Why does this team belong here?";note.value=entry.note;note.addEventListener("input",()=>entry.note=note.value);body.append(heading,note);const controls=document.createElement("div");controls.className="ranking-entry__controls";for(const [label,direction] of [["Move up",-1],["Move down",1]] as const){const button=document.createElement("button");button.type="button";button.textContent=direction<0?"↑":"↓";button.title=label;button.ariaLabel=label;button.disabled=(direction<0&&entry.rank===1)||(direction>0&&entry.rank===entries.length);button.addEventListener("click",()=>{const index=entries.indexOf(entry);const target=index+direction;[entries[index],entries[target]]=[entries[target],entries[index]];normalizeRanks();render()});controls.append(button)}card.append(rank,body,controls);list.append(card)}empty.hidden=entries.length>0;list.hidden=entries.length===0}
    async function loadEdition(){const season=Number(seasonSelect?.value),week=Number(weekInput?.value);if(!season)return;setMessage("Loading ranking…");const{data,error}=await db.from("power_rankings").select("id,title,status,entries").eq("season_year",season).eq("week",week).maybeSingle();if(error){setMessage(error.message,true);return}savedId=data?.id??null;if(data){titleInput!.value=data.title;statusSelect!.value=data.status;entries=(data.entries??[]) as Entry[]}else{titleInput!.value="Power Rankings";statusSelect!.value="draft";entries=standings.filter(row=>Number(row.season_year)===season).map((row,index)=>({teamId:String(row.fantasy_team_id),teamName:String(row.team_name??"Unknown Team"),rank:index+1,previousRank:null,record:record(row),pointsFor:Number(row.points_for??0),note:""}))}normalizeRanks();render();setMessage(data?"Saved edition loaded.":"New edition started from the current standings.")}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}const{data,error}=await supabaseBrowser.from("season_standings").select("season_year,fantasy_team_id,team_name,standings_rank,wins,losses,ties,points_for").order("season_year",{ascending:false}).order("standings_rank");if(page)page.hidden=false;if(error){setMessage(error.message,true);return}standings=data??[];if(seasonSelect){for(const season of [...new Set(standings.map(row=>Number(row.season_year)))]){const option=document.createElement("option");option.value=String(season);option.textContent=String(season);seasonSelect.append(option)}}await loadEdition()}
    seasonSelect?.addEventListener("change",()=>void loadEdition());weekInput?.addEventListener("change",()=>void loadEdition());saveButton?.addEventListener("click",async()=>{if(!entries.length)return;saveButton.disabled=true;saveButton.textContent="Saving…";setMessage("Saving rankings…");const payload={season_year:Number(seasonSelect?.value),week:Number(weekInput?.value),title:titleInput?.value.trim()||"Power Rankings",status:statusSelect?.value??"draft",entries};const query=savedId?db.from("power_rankings").update(payload).eq("id",savedId):db.from("power_rankings").insert(payload);const{data,error}=await query.select("id").single();saveButton.disabled=false;saveButton.textContent="Save rankings";if(error){setMessage(error.message,true);return}savedId=data.id;setMessage("Rankings saved.")});void initialize();
  </script>
</AdminLayout>
<style>
  .rankings-desk{display:grid;gap:1.5rem}.rankings-desk[hidden],.rankings-empty[hidden],.rankings-list[hidden]{display:none}.rankings-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.rankings-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.rankings-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.rankings-header>span{padding:.35rem .65rem;border-radius:999px;background:#ece8df;font-size:.7rem;font-weight:850;text-transform:uppercase}.rankings-toolbar{display:flex;align-items:end;gap:1rem;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface)}.rankings-toolbar label{display:grid;gap:.35rem;font-weight:750}.rankings-toolbar select,.rankings-toolbar input{min-height:2.65rem;padding:.6rem;border:1px solid var(--color-rule-dark);background:#fff}.ranking-title{flex:1}.rankings-toolbar button{padding:.75rem 1rem;border:0;border-radius:.45rem;background:var(--color-green);color:#fff;font-weight:750}.rankings-message{min-height:1.25rem;margin:0;color:var(--color-green)}.rankings-message[data-error="true"]{color:#a32320}.rankings-note{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid #d3b26a;background:#fff7df;color:#6d521a}.rankings-list{display:grid;gap:.75rem}.ranking-entry{display:grid;grid-template-columns:4rem 1fr auto;align-items:center;border:1px solid var(--color-rule);border-left:5px solid var(--color-green);background:var(--color-surface)}.ranking-entry__rank{padding:1rem;text-align:center;font-family:var(--font-display);font-size:2.25rem}.ranking-entry__body{display:grid;grid-template-columns:minmax(12rem,.55fr) 1fr;align-items:center;gap:1rem;padding:1rem;border-left:1px solid var(--color-rule)}.ranking-entry h2,.ranking-entry p{margin:0}.ranking-entry h2{font-size:1.4rem}.ranking-entry p{margin-top:.2rem;color:var(--color-ink-soft);font-size:.75rem}.ranking-entry textarea{width:100%;padding:.65rem;border:1px solid var(--color-rule);resize:vertical}.ranking-entry__controls{display:grid;gap:.35rem;padding:1rem}.ranking-entry__controls button{width:2.4rem;height:2.4rem;border:1px solid var(--color-rule-dark);background:#fff;font-weight:850}.ranking-entry__controls button:disabled{opacity:.25}.rankings-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:800px){.rankings-toolbar,.rankings-note{align-items:flex-start;flex-direction:column}.rankings-toolbar label,.rankings-toolbar button{width:100%}.ranking-entry__body{grid-template-columns:1fr}}@media(max-width:520px){.ranking-entry{grid-template-columns:3rem 1fr}.ranking-entry__controls{grid-column:1/-1;display:flex;justify-content:flex-end;border-top:1px solid var(--color-rule)}}
</style>

---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Power Rankings | The League Gazette">
  <main id="rankings-desk" class="admin-shell rankings-desk" hidden>
    <header class="rankings-header"><div><p class="eyebrow">Publication workspace</p><h1>Power Rankings</h1><p>Arrange the league, add the editorial case for each position, and save a private weekly edition.</p></div><span>Admin only</span></header>
    <section class="rankings-toolbar">
      <label>Season<select id="ranking-season"></select></label><label>Week<input id="ranking-week" type="number" min="0" max="18" value="1" /></label><label class="ranking-title">Edition title<input id="ranking-title" value="Power Rankings" /></label><label>Status<select id="ranking-status"><option value="draft">Draft</option><option value="ready">Ready</option></select></label><button id="save-rankings" type="button">Save rankings</button>
    </section>
    <p id="rankings-message" class="rankings-message" role="status" aria-live="polite"></p>
    <aside class="rankings-note"><strong>Drafts stay private</strong><span>Marking an edition Ready publishes the Computer Poll and Gazette Poll together at <a href="/rankings" target="_blank">/rankings ↗</a>.</span></aside>
    <section class="computer-preview"><header><div><p class="eyebrow">Automatically calculated</p><h2>Computer Poll</h2></div><small>35% season scoring · 35% recent scoring · 20% win rate · 10% point differential</small></header><div id="computer-rankings"></div></section>
    <div class="gazette-heading"><p class="eyebrow">Completely Subjective</p><h2>Gazette Poll</h2><p>Move teams wherever your preferred narrative requires.</p></div>
    <section id="rankings-list" class="rankings-list" aria-label="Ordered power rankings"></section>
    <section id="rankings-empty" class="rankings-empty" hidden><h2>No standings are available</h2><p>Sync the current league before creating a ranking.</p></section>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    import { buildComputerPoll, type RankingResult } from "../../lib/gazette/powerRankings";
    type Entry={teamId:string;teamName:string;rank:number;previousRank:number|null;record:string;pointsFor:number;note:string};
    const db=supabaseBrowser as any;const page=document.querySelector<HTMLElement>("#rankings-desk");const seasonSelect=document.querySelector<HTMLSelectElement>("#ranking-season");const weekInput=document.querySelector<HTMLInputElement>("#ranking-week");const titleInput=document.querySelector<HTMLInputElement>("#ranking-title");const statusSelect=document.querySelector<HTMLSelectElement>("#ranking-status");const list=document.querySelector<HTMLElement>("#rankings-list");const computerList=document.querySelector<HTMLElement>("#computer-rankings");const empty=document.querySelector<HTMLElement>("#rankings-empty");const message=document.querySelector<HTMLElement>("#rankings-message");const saveButton=document.querySelector<HTMLButtonElement>("#save-rankings");let standings:any[]=[];let entries:Entry[]=[];let computer:RankingResult[]=[];let savedId:string|null=null;
    function setMessage(text:string,error=false){if(message){message.textContent=text;message.dataset.error=String(error)}}
    function normalizeRanks(){entries.forEach((entry,index)=>entry.rank=index+1)}function render(){if(!list||!empty)return;list.replaceChildren();for(const entry of entries){const card=document.createElement("article");card.className="ranking-entry";const rank=document.createElement("strong");rank.className="ranking-entry__rank";rank.textContent=String(entry.rank);const body=document.createElement("div");body.className="ranking-entry__body";const heading=document.createElement("div");const title=document.createElement("h2");title.textContent=entry.teamName;const meta=document.createElement("p");meta.textContent=`${entry.record} · ${entry.pointsFor.toLocaleString("en-US",{minimumFractionDigits:2,maximumFractionDigits:2})} PF`;heading.append(title,meta);const note=document.createElement("textarea");note.rows=2;note.placeholder="Why does this team belong here?";note.value=entry.note;note.addEventListener("input",()=>entry.note=note.value);body.append(heading,note);const controls=document.createElement("div");controls.className="ranking-entry__controls";for(const [label,direction] of [["Move up",-1],["Move down",1]] as const){const button=document.createElement("button");button.type="button";button.textContent=direction<0?"↑":"↓";button.title=label;button.ariaLabel=label;button.disabled=(direction<0&&entry.rank===1)||(direction>0&&entry.rank===entries.length);button.addEventListener("click",()=>{const index=entries.indexOf(entry);const target=index+direction;[entries[index],entries[target]]=[entries[target],entries[index]];normalizeRanks();render()});controls.append(button)}card.append(rank,body,controls);list.append(card)}empty.hidden=entries.length>0;list.hidden=entries.length===0}
    function renderComputer(){if(!computerList)return;computerList.replaceChildren();for(const team of computer){const row=document.createElement("div"),rank=document.createElement("b"),copy=document.createElement("span"),name=document.createElement("strong"),detail=document.createElement("small"),score=document.createElement("em");rank.textContent=String(team.rank);name.textContent=team.teamName;detail.textContent=`${team.record} · ${team.recentAverage.toFixed(2)} recent avg`;score.textContent=team.score.toFixed(1);copy.append(name,detail);row.append(rank,copy,score);computerList.append(row)}}
    async function loadEdition(){const season=Number(seasonSelect?.value),week=Number(weekInput?.value);if(!season)return;setMessage("Loading ranking…");const[{data,error},{data:weekly},{data:previous}]=await Promise.all([db.from("power_rankings").select("id,title,status,entries").eq("season_year",season).eq("week",week).maybeSingle(),supabaseBrowser.from("team_weekly_results").select("fantasy_team_id,team_name,week,points_for,point_differential,result").eq("season_year",season).lte("week",week),db.from("power_rankings").select("entries").eq("season_year",season).lt("week",week).order("week",{ascending:false}).limit(1).maybeSingle()]);if(error){setMessage(error.message,true);return}computer=buildComputerPoll(weekly??[],week);renderComputer();savedId=data?.id??null;if(data){titleInput!.value=data.title;statusSelect!.value=data.status;entries=(data.entries??[]) as Entry[]}else{const prior=new Map(((previous?.entries??[]) as Entry[]).map(entry=>[entry.teamId,entry.rank]));titleInput!.value=`Week ${week} Power Rankings`;statusSelect!.value="draft";entries=computer.map(team=>({teamId:team.teamId,teamName:team.teamName,rank:team.rank,previousRank:prior.get(team.teamId)??null,record:team.record,pointsFor:team.pointsFor,note:""}))}normalizeRanks();render();setMessage(data?"Saved edition loaded.":"New Gazette Poll started from the Computer Poll.")}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}const{data,error}=await supabaseBrowser.from("season_standings").select("season_year,fantasy_team_id,team_name,standings_rank,wins,losses,ties,points_for").order("season_year",{ascending:false}).order("standings_rank");if(page)page.hidden=false;if(error){setMessage(error.message,true);return}standings=data??[];if(seasonSelect){for(const season of [...new Set(standings.map(row=>Number(row.season_year)))]){const option=document.createElement("option");option.value=String(season);option.textContent=String(season);seasonSelect.append(option)}}await loadEdition()}
    seasonSelect?.addEventListener("change",()=>void loadEdition());weekInput?.addEventListener("change",()=>void loadEdition());saveButton?.addEventListener("click",async()=>{if(!entries.length)return;saveButton.disabled=true;saveButton.textContent="Saving…";setMessage("Saving rankings…");const payload={season_year:Number(seasonSelect?.value),week:Number(weekInput?.value),title:titleInput?.value.trim()||"Power Rankings",status:statusSelect?.value??"draft",entries};const query=savedId?db.from("power_rankings").update(payload).eq("id",savedId):db.from("power_rankings").insert(payload);const{data,error}=await query.select("id").single();saveButton.disabled=false;saveButton.textContent="Save rankings";if(error){setMessage(error.message,true);return}savedId=data.id;setMessage("Rankings saved.")});void initialize();
  </script>
</AdminLayout>
<style>
  .rankings-desk{display:grid;gap:1.5rem}.rankings-desk[hidden],.rankings-empty[hidden],.rankings-list[hidden]{display:none}.rankings-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.rankings-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.rankings-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.rankings-header>span{padding:.35rem .65rem;border-radius:999px;background:#ece8df;font-size:.7rem;font-weight:850;text-transform:uppercase}.rankings-toolbar{display:flex;align-items:end;gap:1rem;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface)}.rankings-toolbar label{display:grid;gap:.35rem;font-weight:750}.rankings-toolbar select,.rankings-toolbar input{min-height:2.65rem;padding:.6rem;border:1px solid var(--color-rule-dark);background:#fff}.ranking-title{flex:1}.rankings-toolbar button{padding:.75rem 1rem;border:0;border-radius:.45rem;background:var(--color-green);color:#fff;font-weight:750}.rankings-message{min-height:1.25rem;margin:0;color:var(--color-green)}.rankings-message[data-error="true"]{color:#a32320}.rankings-note{display:flex;justify-content:space-between;gap:1rem;padding:1rem;border:1px solid #d3b26a;background:#fff7df;color:#6d521a}.rankings-note a{color:inherit;font-weight:800}.computer-preview{border:1px solid var(--color-rule);background:var(--color-surface)}.computer-preview>header{display:flex;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;border-bottom:1px solid var(--color-rule)}.computer-preview h2,.computer-preview p{margin:0}.computer-preview small{max-width:30rem;color:var(--color-ink-soft);text-align:right}.computer-preview #computer-rankings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.computer-preview #computer-rankings>div{display:grid;grid-template-columns:2.5rem 1fr auto;align-items:center;gap:.75rem;padding:.75rem 1rem;border-bottom:1px solid var(--color-rule)}.computer-preview #computer-rankings>div:nth-child(odd){border-right:1px solid var(--color-rule)}.computer-preview b{font-family:var(--font-display);font-size:1.5rem;text-align:center}.computer-preview span{display:grid}.computer-preview small{font-size:.7rem}.computer-preview em{font-style:normal;font-weight:800}.gazette-heading h2,.gazette-heading p{margin:0}.gazette-heading h2{font-size:2.5rem}.gazette-heading>p:last-child{margin-top:.3rem;color:var(--color-ink-soft)}.rankings-list{display:grid;gap:.75rem}.ranking-entry{display:grid;grid-template-columns:4rem 1fr auto;align-items:center;border:1px solid var(--color-rule);border-left:5px solid #9b352d;background:var(--color-surface)}.ranking-entry__rank{padding:1rem;text-align:center;font-family:var(--font-display);font-size:2.25rem}.ranking-entry__body{display:grid;grid-template-columns:minmax(12rem,.55fr) 1fr;align-items:center;gap:1rem;padding:1rem;border-left:1px solid var(--color-rule)}.ranking-entry h2,.ranking-entry p{margin:0}.ranking-entry h2{font-size:1.4rem}.ranking-entry p{margin-top:.2rem;color:var(--color-ink-soft);font-size:.75rem}.ranking-entry textarea{width:100%;padding:.65rem;border:1px solid var(--color-rule);resize:vertical}.ranking-entry__controls{display:grid;gap:.35rem;padding:1rem}.ranking-entry__controls button{width:2.4rem;height:2.4rem;border:1px solid var(--color-rule-dark);background:#fff;font-weight:850}.ranking-entry__controls button:disabled{opacity:.25}.rankings-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:800px){.rankings-toolbar,.rankings-note,.computer-preview>header{align-items:flex-start;flex-direction:column}.rankings-toolbar label,.rankings-toolbar button{width:100%}.ranking-entry__body{grid-template-columns:1fr}.computer-preview small{text-align:left}}@media(max-width:600px){.computer-preview #computer-rankings{grid-template-columns:1fr}.computer-preview #computer-rankings>div:nth-child(odd){border-right:0}}@media(max-width:520px){.ranking-entry{grid-template-columns:3rem 1fr}.ranking-entry__controls{grid-column:1/-1;display:flex;justify-content:flex-end;border-top:1px solid var(--color-rule)}}
</style>

<style>
  .rankings-desk{position:relative}.rankings-desk::before{position:absolute;z-index:-1;inset:-2rem -2rem auto;min-height:20rem;background:radial-gradient(circle at 82% 0,color-mix(in srgb,#9b352d 11%,transparent),transparent 48%);content:""}.rankings-header h1{font-size:clamp(3.5rem,8vw,6.5rem);letter-spacing:-.06em;line-height:.88}.rankings-header>span{border:1px solid #b9aea0;border-radius:0;background:#f2ede3;letter-spacing:.08em}.rankings-toolbar{border:1px solid var(--color-rule-dark);border-top:5px solid var(--color-green);background:#f3efe6;box-shadow:var(--shadow-card)}.rankings-toolbar select,.rankings-toolbar input,.rankings-toolbar button{min-height:2.8rem;border-radius:0}.rankings-toolbar button{box-shadow:4px 4px 0 color-mix(in srgb,var(--color-green) 25%,transparent)}.rankings-note{border-radius:0;border-left:5px solid #b37b22}.computer-preview{overflow:hidden;border-color:#17382b;box-shadow:var(--shadow-card)}.computer-preview>header{padding:1.4rem 1.5rem;border-bottom:0;background:linear-gradient(110deg,#142f25,#28543e);color:#fff}.computer-preview>header .eyebrow,.computer-preview>header small{color:#cddbd1}.computer-preview #computer-rankings{background:#f7f4ec}.computer-preview #computer-rankings>div{min-height:4.75rem}.computer-preview b{display:grid;width:2.2rem;height:2.2rem;place-items:center;border-radius:50%;background:#17382b;color:#fff}.computer-preview em{color:var(--color-green);font-family:var(--font-display);font-size:1.15rem}.gazette-heading{padding:1.25rem 1.5rem;border-left:5px solid #9b352d;background:linear-gradient(90deg,color-mix(in srgb,#9b352d 8%,transparent),transparent)}.gazette-heading h2{font-size:clamp(2.5rem,5vw,4rem)}.ranking-entry{border-left:0;border-top:4px solid #9b352d;box-shadow:var(--shadow-card);transition:transform .15s ease}.ranking-entry:hover{transform:translateY(-2px)}.ranking-entry__rank{align-self:stretch;display:grid;place-items:center;background:#9b352d;color:#fff}.ranking-entry textarea{min-height:4.5rem;border-color:#c7beb2;background:#fbfaf6}.ranking-entry__controls button{border-radius:50%;background:#f7f4ec}.ranking-entry__controls button:not(:disabled):hover{background:#17382b;color:#fff}@media(max-width:520px){.ranking-entry__rank{align-self:stretch}}
</style>

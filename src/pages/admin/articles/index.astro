---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Stories | The League Gazette">
  <div id="stories-loading" class="admin-shell stories-loading">
    <p>Loading the story archive…</p>
  </div>

  <div id="stories-page" class="admin-shell stories-page" hidden>
    <header class="stories-header">
      <div>
        <p class="eyebrow">Editorial</p>
        <h1>Stories</h1>
        <p class="stories-header__description">
          Manage Gazette drafts, published stories and archived work.
        </p>
      </div>
    </header>

    <section class="stories-summary" aria-label="Story totals">
      <button class="stories-summary__card" type="button" data-status-card="all">
        <span>All stories</span>
        <strong id="all-count">0</strong>
      </button>

      <button class="stories-summary__card" type="button" data-status-card="draft">
        <span>Drafts</span>
        <strong id="draft-count">0</strong>
      </button>

      <button
        class="stories-summary__card"
        type="button"
        data-status-card="ready_for_review"
      >
        <span>Ready for review</span>
        <strong id="review-count">0</strong>
      </button>

      <button
        class="stories-summary__card"
        type="button"
        data-status-card="scheduled"
      >
        <span>Scheduled</span>
        <strong id="scheduled-count">0</strong>
      </button>

      <button
        class="stories-summary__card"
        type="button"
        data-status-card="published"
      >
        <span>Published</span>
        <strong id="published-count">0</strong>
      </button>

      <button
        class="stories-summary__card"
        type="button"
        data-status-card="archived"
      >
        <span>Archived</span>
        <strong id="archived-count">0</strong>
      </button>
    </section>

    <section class="stories-toolbar" aria-label="Story controls">
      <label class="stories-search">
        <span class="sr-only">Search stories</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="6"></circle>
          <path d="m16 16 4 4"></path>
        </svg>

        <input
          id="story-search"
          type="search"
          placeholder="Search headline, category or author"
          autocomplete="off"
        />
      </label>

      <div class="stories-toolbar__filters">
        <label class="stories-filter">
          <span class="stories-filter__label">Status</span>

          <select id="status-filter">
            <option value="all">All statuses</option>
            <option value="draft">Drafts</option>
            <option value="ready_for_review">Ready for review</option>
            <option value="scheduled">Scheduled</option>
            <option value="published">Published</option>
            <option value="archived">Archived</option>
          </select>
        </label>

        <label class="stories-filter">
          <span class="stories-filter__label">Category</span>

          <select id="category-filter">
            <option value="all">All categories</option>
          </select>
        </label>

        <label class="stories-filter">
          <span class="stories-filter__label">Sort</span>

          <select id="sort-filter">
            <option value="updated-desc">Recently updated</option>
            <option value="created-desc">Recently created</option>
            <option value="published-desc">Publication date: newest</option>
            <option value="published-asc">Publication date: oldest</option>
            <option value="headline-asc">Headline: A–Z</option>
            <option value="headline-desc">Headline: Z–A</option>
          </select>
        </label>

        <button id="clear-filters" class="stories-clear" type="button" hidden>
          Clear
        </button>
      </div>
    </section>

    <div
      id="stories-message"
      class="stories-message"
      role="status"
      aria-live="polite"
    ></div>

    <section class="stories-panel">
      <div class="stories-panel__heading">
        <div>
          <p class="eyebrow">Archive</p>
          <h2 id="stories-panel-title">All stories</h2>
        </div>

        <span id="visible-count" class="stories-panel__count">
          0 stories
        </span>
      </div>

      <div id="story-list" class="story-list"></div>

      <div id="stories-empty" class="stories-empty" hidden>
        <p class="eyebrow">No results</p>
        <h3>No stories found</h3>
        <p>Try changing your search, filters or sort order.</p>
      </div>
    </section>
  </div>

  <script>
    import { supabaseBrowser } from "../../../lib/supabase-browser";

    type ArticleStatus =
      | "draft"
      | "ready_for_review"
      | "scheduled"
      | "published"
      | "archived";

    type SortOption =
      | "updated-desc"
      | "created-desc"
      | "published-desc"
      | "published-asc"
      | "headline-asc"
      | "headline-desc";

    type ArticleSummary = {
      id: string;
      slug: string | null;
      category: string | null;
      headline: string | null;
      author_name: string | null;
      status: ArticleStatus;
      status_label: string;
      is_featured: boolean;
      published_at: string | null;
      created_at: string;
      updated_at: string;
      editorial_date: string;
      editorial_sort_at: string;
      can_publish: boolean;
      needs_image_alt: boolean;
      is_due_for_publishing: boolean;
      is_publicly_available: boolean;
    };

    const STATUS_LABELS: Record<ArticleStatus | "all", string> = {
      all: "All stories",
      draft: "Drafts",
      ready_for_review: "Ready for review",
      scheduled: "Scheduled stories",
      published: "Published stories",
      archived: "Archived stories",
    };

    const VALID_SORT_OPTIONS = new Set<SortOption>([
      "updated-desc",
      "created-desc",
      "published-desc",
      "published-asc",
      "headline-asc",
      "headline-desc",
    ]);

    const loading = document.querySelector<HTMLElement>("#stories-loading");
    const page = document.querySelector<HTMLElement>("#stories-page");
    const storyList = document.querySelector<HTMLElement>("#story-list");
    const message = document.querySelector<HTMLElement>("#stories-message");
    const emptyState = document.querySelector<HTMLElement>("#stories-empty");
    const searchInput =
      document.querySelector<HTMLInputElement>("#story-search");
    const statusFilter =
      document.querySelector<HTMLSelectElement>("#status-filter");
    const categoryFilter =
      document.querySelector<HTMLSelectElement>("#category-filter");
    const sortFilter =
      document.querySelector<HTMLSelectElement>("#sort-filter");
    const clearFiltersButton =
      document.querySelector<HTMLButtonElement>("#clear-filters");
    const panelTitle =
      document.querySelector<HTMLElement>("#stories-panel-title");
    const summaryCards = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-status-card]"),
    );

    const allCount = document.querySelector<HTMLElement>("#all-count");
    const draftCount = document.querySelector<HTMLElement>("#draft-count");
    const reviewCount = document.querySelector<HTMLElement>("#review-count");
    const scheduledCount =
      document.querySelector<HTMLElement>("#scheduled-count");
    const publishedCount =
      document.querySelector<HTMLElement>("#published-count");
    const archivedCount =
      document.querySelector<HTMLElement>("#archived-count");
    const visibleCount =
      document.querySelector<HTMLElement>("#visible-count");

    let articles: ArticleSummary[] = [];
    let searchUrlTimer: number | undefined;
    let isOpEdContributor = false;
    let currentUserId = "";

    function normalizeText(value: string | null | undefined): string {
      return value?.trim() ?? "";
    }

    function formatDate(value: string | null): string {
      if (!value) {
        return "Not published";
      }

      const parsedDate = new Date(value);

      if (Number.isNaN(parsedDate.getTime())) {
        return "Date unavailable";
      }

      return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(parsedDate);
    }

    function getArticleDateLabel(article: ArticleSummary): string {
      if (
        article.status === "scheduled" &&
        article.is_due_for_publishing &&
        article.published_at
      ) {
        return `Published automatically ${formatDate(article.published_at)}`;
      }

      if (article.status === "scheduled" && article.published_at) {
        return `Scheduled for ${formatDate(article.published_at)}`;
      }

      if (article.status === "published" && article.published_at) {
        return `Published ${formatDate(article.published_at)}`;
      }

      if (article.status === "archived") {
        return `Archived · Updated ${formatDate(article.updated_at)}`;
      }

      return `Updated ${formatDate(article.updated_at)}`;
    }

    function createStoryRow(article: ArticleSummary): HTMLElement {
      const row = document.createElement("article");
      row.className = "story-row";

      const main = document.createElement("div");
      main.className = "story-row__main";

      const categoryRow = document.createElement("div");
      categoryRow.className = "story-row__category-row";

      const category = document.createElement("p");
      category.className = "story-row__category";
      category.textContent = normalizeText(article.category) || "Uncategorized";

      categoryRow.append(category);

      if (article.is_featured) {
        const featured = document.createElement("span");
        featured.className = "story-row__featured";
        featured.textContent = "Featured";
        categoryRow.append(featured);
      }

      if (article.needs_image_alt) {
        const warning = document.createElement("span");
        warning.className = "story-row__warning";
        warning.textContent = "Needs image alt text";
        categoryRow.append(warning);
      }

      const headline = document.createElement("h3");
      const headlineText = normalizeText(article.headline) || "Untitled story";
      const contributorCanEdit = article.status === "draft" || article.status === "ready_for_review";
      if (!isOpEdContributor || contributorCanEdit) {
        const editLink = document.createElement("a");
        editLink.href = `/admin/articles/${article.id}`;
        editLink.textContent = headlineText;
        headline.append(editLink);
      } else {
        headline.textContent = headlineText;
      }

      const meta = document.createElement("p");
      meta.className = "story-row__meta";

      const authorName = normalizeText(article.author_name);
      const dateLabel = getArticleDateLabel(article);
      meta.textContent = authorName ? `${authorName} · ${dateLabel}` : dateLabel;

      main.append(categoryRow, headline, meta);

      const status = document.createElement("span");
      const statusModifier =
        article.status === "scheduled" && article.is_due_for_publishing
          ? "live-scheduled"
          : article.status;

      status.className = `status-badge status-badge--${statusModifier}`;
      status.textContent = article.status_label;

      const actions = document.createElement("div");
      actions.className = "story-row__actions";

      const editAction = document.createElement("a");
      editAction.href = `/admin/articles/${article.id}`;
      editAction.textContent = "Edit";

      if (article.is_publicly_available && article.slug) {
        const viewAction = document.createElement("a");
        viewAction.href = `/gazette/${article.slug}`;
        viewAction.target = "_blank";
        viewAction.rel = "noreferrer";
        viewAction.textContent = "View live";
        actions.append(viewAction);
      }

      if (!isOpEdContributor || contributorCanEdit) actions.append(editAction);
      row.append(main, status, actions);

      return row;
    }

    function compareDateValues(
      firstValue: string | null,
      secondValue: string | null,
      direction: "asc" | "desc",
    ): number {
      const firstTime = firstValue ? new Date(firstValue).getTime() : NaN;
      const secondTime = secondValue ? new Date(secondValue).getTime() : NaN;
      const firstIsValid = !Number.isNaN(firstTime);
      const secondIsValid = !Number.isNaN(secondTime);

      if (!firstIsValid && !secondIsValid) {
        return 0;
      }

      if (!firstIsValid) {
        return 1;
      }

      if (!secondIsValid) {
        return -1;
      }

      return direction === "asc"
        ? firstTime - secondTime
        : secondTime - firstTime;
    }

    function sortArticles(
      items: ArticleSummary[],
      selectedSort: SortOption,
    ): ArticleSummary[] {
      return [...items].sort((first, second) => {
        switch (selectedSort) {
          case "created-desc":
            return compareDateValues(first.created_at, second.created_at, "desc");

          case "published-desc":
            return compareDateValues(
              first.published_at,
              second.published_at,
              "desc",
            );

          case "published-asc":
            return compareDateValues(
              first.published_at,
              second.published_at,
              "asc",
            );

          case "headline-asc":
            return normalizeText(first.headline).localeCompare(
              normalizeText(second.headline),
              "en-US",
              { sensitivity: "base" },
            );

          case "headline-desc":
            return normalizeText(second.headline).localeCompare(
              normalizeText(first.headline),
              "en-US",
              { sensitivity: "base" },
            );

          case "updated-desc":
          default:
            return compareDateValues(first.updated_at, second.updated_at, "desc");
        }
      });
    }

    function getSelectedStatus(): ArticleStatus | "all" {
      const selectedStatus = statusFilter?.value ?? "all";

      return selectedStatus === "draft" ||
        selectedStatus === "ready_for_review" ||
        selectedStatus === "scheduled" ||
        selectedStatus === "published" ||
        selectedStatus === "archived"
        ? selectedStatus
        : "all";
    }

    function getSelectedSort(): SortOption {
      const selectedSort = sortFilter?.value as SortOption | undefined;

      return selectedSort && VALID_SORT_OPTIONS.has(selectedSort)
        ? selectedSort
        : "updated-desc";
    }

    function updateSummaryCardState(selectedStatus: ArticleStatus | "all"): void {
      for (const card of summaryCards) {
        const isActive = card.dataset.statusCard === selectedStatus;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-pressed", String(isActive));
      }
    }

    function updateClearButtonState(): void {
      if (!clearFiltersButton) {
        return;
      }

      const hasActiveControls =
        Boolean(searchInput?.value.trim()) ||
        getSelectedStatus() !== "all" ||
        (categoryFilter?.value ?? "all") !== "all" ||
        getSelectedSort() !== "updated-desc";

      clearFiltersButton.hidden = !hasActiveControls;
    }

    function renderStories(): void {
      if (!storyList || !emptyState) {
        return;
      }

      const query = searchInput?.value.trim().toLowerCase() ?? "";
      const selectedStatus = getSelectedStatus();
      const selectedCategory = categoryFilter?.value ?? "all";
      const selectedSort = getSelectedSort();

      const filteredArticles = articles.filter((article) => {
        const searchableText = [
          normalizeText(article.headline),
          normalizeText(article.category),
          normalizeText(article.author_name),
        ]
          .join(" ")
          .toLowerCase();

        const matchesSearch = !query || searchableText.includes(query);
        const matchesStatus =
          selectedStatus === "all" || article.status === selectedStatus;
        const articleCategory = normalizeText(article.category) || "Uncategorized";
        const matchesCategory =
          selectedCategory === "all" || articleCategory === selectedCategory;

        return matchesSearch && matchesStatus && matchesCategory;
      });

      const sortedArticles = sortArticles(filteredArticles, selectedSort);

      storyList.replaceChildren();

      for (const article of sortedArticles) {
        storyList.append(createStoryRow(article));
      }

      const hasResults = sortedArticles.length > 0;
      storyList.hidden = !hasResults;
      emptyState.hidden = hasResults;

      if (visibleCount) {
        visibleCount.textContent = `${sortedArticles.length} ${
          sortedArticles.length === 1 ? "story" : "stories"
        }`;
      }

      if (panelTitle) {
        panelTitle.textContent = STATUS_LABELS[selectedStatus];
      }

      updateSummaryCardState(selectedStatus);
      updateClearButtonState();
    }

    function populateCategoryFilter(): void {
      if (!categoryFilter) {
        return;
      }

      const categories = Array.from(
        new Set(
          articles.map(
            (article) => normalizeText(article.category) || "Uncategorized",
          ),
        ),
      ).sort((first, second) =>
        first.localeCompare(second, "en-US", { sensitivity: "base" }),
      );

      categoryFilter.replaceChildren();

      const allOption = document.createElement("option");
      allOption.value = "all";
      allOption.textContent = "All categories";
      categoryFilter.append(allOption);

      for (const category of categories) {
        const option = document.createElement("option");
        option.value = category;
        option.textContent = category;
        categoryFilter.append(option);
      }
    }

    function syncUrlFromControls(): void {
      const url = new URL(window.location.href);
      const query = searchInput?.value.trim() ?? "";
      const selectedStatus = getSelectedStatus();
      const selectedCategory = categoryFilter?.value ?? "all";
      const selectedSort = getSelectedSort();

      if (query) {
        url.searchParams.set("q", query);
      } else {
        url.searchParams.delete("q");
      }

      if (selectedStatus === "all") {
        url.searchParams.delete("status");
      } else {
        url.searchParams.set("status", selectedStatus);
      }

      if (selectedCategory === "all") {
        url.searchParams.delete("category");
      } else {
        url.searchParams.set("category", selectedCategory);
      }

      if (selectedSort === "updated-desc") {
        url.searchParams.delete("sort");
      } else {
        url.searchParams.set("sort", selectedSort);
      }

      window.history.replaceState({}, "", url);
    }

    function scheduleSearchUrlSync(): void {
      if (searchUrlTimer !== undefined) {
        window.clearTimeout(searchUrlTimer);
      }

      searchUrlTimer = window.setTimeout(() => {
        syncUrlFromControls();
      }, 250);
    }

    function applyStateFromUrl(): void {
      const params = new URLSearchParams(window.location.search);
      const statusFromUrl = params.get("status");
      const categoryFromUrl = params.get("category");
      const sortFromUrl = params.get("sort") as SortOption | null;
      const queryFromUrl = params.get("q") ?? "";

      if (searchInput) {
        searchInput.value = queryFromUrl;
      }

      if (
        statusFilter &&
        (statusFromUrl === "draft" ||
          statusFromUrl === "ready_for_review" ||
          statusFromUrl === "scheduled" ||
          statusFromUrl === "published" ||
          statusFromUrl === "archived")
      ) {
        statusFilter.value = statusFromUrl;
      } else if (statusFilter) {
        statusFilter.value = "all";
      }

      if (
        categoryFilter &&
        categoryFromUrl &&
        Array.from(categoryFilter.options).some(
          (option) => option.value === categoryFromUrl,
        )
      ) {
        categoryFilter.value = categoryFromUrl;
      } else if (categoryFilter) {
        categoryFilter.value = "all";
      }

      if (sortFilter && sortFromUrl && VALID_SORT_OPTIONS.has(sortFromUrl)) {
        sortFilter.value = sortFromUrl;
      } else if (sortFilter) {
        sortFilter.value = "updated-desc";
      }
    }

    function clearFilters(): void {
      if (searchInput) {
        searchInput.value = "";
      }

      if (statusFilter) {
        statusFilter.value = "all";
      }

      if (categoryFilter) {
        categoryFilter.value = "all";
      }

      if (sortFilter) {
        sortFilter.value = "updated-desc";
      }

      syncUrlFromControls();
      renderStories();
      searchInput?.focus();
    }

    async function verifyAdmin(): Promise<boolean> {
      const {
        data: { user },
        error: userError,
      } = await supabaseBrowser.auth.getUser();

      if (userError || !user) {
        window.location.replace("/admin/login");
        return false;
      }

      currentUserId = user.id;

      const { data: adminRecord, error: adminError } = await supabaseBrowser
        .from("admin_users")
        .select("user_id")
        .eq("user_id", user.id)
        .maybeSingle();

      if (!adminError && adminRecord) {
        return true;
      }

      const { data: contributor } = await supabaseBrowser
        .from("publication_contributors")
        .select("role")
        .eq("user_id", user.id)
        .eq("role", "op_ed")
        .maybeSingle();

      if (contributor) {
        isOpEdContributor = true;
        return true;
      }

      await supabaseBrowser.auth.signOut();
      window.location.replace("/admin/login");
      return false;
    }

    async function initializeStories(): Promise<void> {
      const isAdmin = await verifyAdmin();

      if (!isAdmin) {
        return;
      }

      const result = isOpEdContributor
        ? await supabaseBrowser
            .from("gazette_articles")
            .select("id, slug, category, headline, author_name, status, is_featured, published_at, created_at, updated_at, image_url, image_alt")
            .eq("created_by", currentUserId)
            .order("updated_at", { ascending: false })
        : await supabaseBrowser
            .from("editorial_articles")
            .select(
          `
            id,
            slug,
            category,
            headline,
            author_name,
            status,
            status_label,
            is_featured,
            published_at,
            created_at,
            updated_at,
            editorial_date,
            editorial_sort_at,
            can_publish,
            needs_image_alt,
            is_due_for_publishing,
            is_publicly_available
          `,
            )
            .order("editorial_sort_at", { ascending: false });

      const { data, error } = result;

      if (loading) {
        loading.hidden = true;
      }

      if (page) {
        page.hidden = false;
      }

      if (error) {
        if (message) {
          message.textContent = `Unable to load stories: ${error.message}`;
        }

        return;
      }

      articles = isOpEdContributor
        ? (((data ?? []) as Array<{
            id: string;
            slug: string;
            category: string;
            headline: string;
            author_name: string;
            status: string;
            is_featured: boolean;
            published_at: string | null;
            created_at: string;
            updated_at: string;
            image_url: string | null;
            image_alt: string | null;
          }>).map((article) => ({
            ...article,
            status_label: ({
              draft: "Draft",
              ready_for_review: "Ready for review",
              scheduled: "Scheduled",
              published: "Published",
              archived: "Archived",
            } as Record<string, string>)[article.status] ?? article.status,
            editorial_date: article.updated_at,
            editorial_sort_at: article.updated_at,
            can_publish: false,
            needs_image_alt: Boolean(article.image_url && !article.image_alt),
            is_due_for_publishing: article.status === "scheduled" && Boolean(article.published_at && new Date(article.published_at) <= new Date()),
            is_publicly_available: article.status === "published" || (article.status === "scheduled" && Boolean(article.published_at && new Date(article.published_at) <= new Date())),
          })) as ArticleSummary[])
        : ((data ?? []) as ArticleSummary[]);

      if (allCount) {
        allCount.textContent = String(articles.length);
      }

      const countByStatus = (status: ArticleStatus): number =>
        articles.filter((article) => article.status === status).length;

      if (draftCount) {
        draftCount.textContent = String(countByStatus("draft"));
      }

      if (reviewCount) {
        reviewCount.textContent = String(countByStatus("ready_for_review"));
      }

      if (scheduledCount) {
        scheduledCount.textContent = String(countByStatus("scheduled"));
      }

      if (publishedCount) {
        publishedCount.textContent = String(countByStatus("published"));
      }

      if (archivedCount) {
        archivedCount.textContent = String(countByStatus("archived"));
      }

      populateCategoryFilter();
      applyStateFromUrl();
      renderStories();
    }

    searchInput?.addEventListener("input", () => {
      renderStories();
      scheduleSearchUrlSync();
    });

    statusFilter?.addEventListener("change", () => {
      syncUrlFromControls();
      renderStories();
    });

    categoryFilter?.addEventListener("change", () => {
      syncUrlFromControls();
      renderStories();
    });

    sortFilter?.addEventListener("change", () => {
      syncUrlFromControls();
      renderStories();
    });

    clearFiltersButton?.addEventListener("click", clearFilters);

    for (const card of summaryCards) {
      card.addEventListener("click", () => {
        const requestedStatus = card.dataset.statusCard ?? "all";

        if (statusFilter) {
          statusFilter.value = requestedStatus;
        }

        syncUrlFromControls();
        renderStories();
      });
    }

    window.addEventListener("popstate", () => {
      applyStateFromUrl();
      renderStories();
    });

    initializeStories();
  </script>
</AdminLayout>

<style>
  .stories-loading {
    min-height: 20rem;
    display: grid;
    place-items: center;
    color: var(--color-ink-soft);
  }

  .stories-loading[hidden],
  .stories-page[hidden] {
    display: none;
  }

  .stories-page {
    display: grid;
    gap: var(--space-7);
  }

  .stories-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);

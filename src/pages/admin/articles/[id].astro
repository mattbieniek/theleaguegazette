---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArticleEditor from "../../../components/admin/ArticleEditor.astro";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/articles");
}
---

<AdminLayout title="Edit Story | The League Gazette">
  <ArticleEditor articleId={id} />
</AdminLayout>
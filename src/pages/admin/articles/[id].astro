---
export const prerender = false;

import AdminLayout from "../../../layouts/AdminLayout.astro";

const { id } = Astro.params;
---

<AdminLayout title="Edit Article | The League Gazette">
  <div class="admin-shell placeholder-page">
    <p class="eyebrow">Editorial Desk</p>
    <h1>Edit article</h1>
    <p>Article ID: {id}</p>
    <p>The editing form will be added in the next step.</p>

    <a href="/admin">← Return to dashboard</a>
  </div>
</AdminLayout>

<style>
  .placeholder-page {
    padding-block: var(--space-8);
  }

  .placeholder-page h1 {
    font-size: clamp(3rem, 8vw, 6rem);
  }

  .placeholder-page a {
    color: var(--color-green);
    font-weight: 700;
  }
</style>
---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Editorial Desk | The League Gazette">
  <div id="desk-loading" class="admin-shell desk-loading">
    <p>Opening the editorial desk…</p>
  </div>

  <div id="editorial-desk" class="admin-shell editorial-desk" hidden>
    <header class="desk-header">
      <div>
        <p class="eyebrow">Editorial Desk</p>
        <h1 id="desk-greeting">Good morning.</h1>
        <p class="desk-header__description">
          Here’s what is happening inside The League Gazette.
        </p>
      </div>

      <p id="desk-date" class="desk-date"></p>
    </header>

    <section class="desk-overview" aria-label="Publishing overview">
  <a class="desk-stat" href="/admin/articles">
    <span>All stories</span>
    <strong id="all-count">0</strong>
    <small>Open the story archive →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=draft"
  >
    <span>Drafts</span>
    <strong id="draft-count">0</strong>
    <small>Stories still in progress →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=ready_for_review"
  >
    <span>Ready for review</span>
    <strong id="review-count">0</strong>
    <small>Stories awaiting approval →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=scheduled"
  >
    <span>Scheduled</span>
    <strong id="scheduled-count">0</strong>
    <small>Upcoming publications →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=published"
  >
    <span>Published</span>
    <strong id="published-count">0</strong>
    <small>View published work →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=archived"
  >
    <span>Archived</span>
    <strong id="archived-count">0</strong>
    <small>Retired Gazette stories →</small>
  </a>
</section>

    <section class="desk-grid">
      <article class="desk-panel desk-panel--recent">
        <div class="desk-panel__heading">
          <div>
            <p class="eyebrow">Recent work</p>
            <h2>Latest stories</h2>
          </div>

          <a href="/admin/articles">
            View all
          </a>
        </div>

        <div id="recent-stories" class="recent-stories"></div>

        <div
          id="recent-empty"
          class="desk-empty"
          hidden
        >
          <h3>No stories yet</h3>
          <p>
            Your most recently edited stories will appear here.
          </p>
        </div>
      </article>

      <aside class="desk-sidebar">
        <article class="desk-panel">
          <div class="desk-panel__heading">
            <div>
              <p class="eyebrow">Quick actions</p>
              <h2>Start here</h2>
            </div>
          </div>

          <div class="quick-actions">
            <a
              class="quick-action quick-action--primary"
              href="/admin/articles/new"
            >
              <span>
                <strong>Write a new story</strong>
                <small>Open a fresh Gazette draft</small>
              </span>

              <span aria-hidden="true">→</span>
            </a>

            <a
              class="quick-action"
              href="/admin/articles"
            >
              <span>
                <strong>Manage stories</strong>
                <small>Review drafts and published work</small>
              </span>

              <span aria-hidden="true">→</span>
            </a>

            <a
              class="quick-action"
              href="/"
              target="_blank"
              rel="noreferrer"
            >
              <span>
                <strong>View live site</strong>
                <small>Open The League Gazette</small>
              </span>

              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="desk-panel desk-attention">
          <div class="desk-panel__heading">
            <div>
              <p class="eyebrow">Editorial queue</p>
              <h2>Needs attention</h2>
            </div>
          </div>

          <div class="attention-list">
            <a
              class="attention-item"
              href="/admin/articles?status=ready_for_review"
            >
              <span>
                <strong>Ready for review</strong>
                <small>Stories awaiting a final decision</small>
              </span>

              <span id="attention-review-count" class="attention-count">0</span>
            </a>

            <a
              class="attention-item"
              href="/admin/articles?status=scheduled"
            >
              <span>
                <strong>Scheduled stories</strong>
                <small>Upcoming Gazette publications</small>
              </span>

              <span id="attention-scheduled-count" class="attention-count">0</span>
            </a>

            <a
              class="attention-item"
              href="/admin/articles?q=&sort=updated-desc"
            >
              <span>
                <strong>Missing image alt text</strong>
                <small>Artwork that needs an accessible description</small>
              </span>

              <span id="attention-alt-count" class="attention-count">0</span>
            </a>
          </div>

          <p id="attention-clear" class="attention-clear" hidden>
            The editorial queue is clear.
          </p>
        </article>
      </aside>
    </section>

    <div
      id="desk-message"
      class="desk-message"
      role="status"
      aria-live="polite"
    ></div>
  </div>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";

    type ArticleStatus =
  | "draft"
  | "ready_for_review"
  | "scheduled"
  | "published"
  | "archived";

type ArticleSummary = {
  id: string;
  slug: string;
  category: string;
  headline: string;
  author_name: string;
  status: ArticleStatus;
  status_label: string;
  is_featured: boolean;
  published_at: string | null;
  updated_at: string;
  editorial_date: string;
  editorial_sort_at: string;
  can_publish: boolean;
  needs_image_alt: boolean;
};

    const loading =
      document.querySelector<HTMLElement>("#desk-loading");

    const desk =
      document.querySelector<HTMLElement>("#editorial-desk");

    const message =
      document.querySelector<HTMLElement>("#desk-message");

    const dateElement =
      document.querySelector<HTMLElement>("#desk-date");

    const greetingElement =
      document.querySelector<HTMLElement>("#desk-greeting");

    const allCount =
      document.querySelector<HTMLElement>("#all-count");

    const draftCount =
  document.querySelector<HTMLElement>("#draft-count");

const reviewCount =
  document.querySelector<HTMLElement>("#review-count");

const scheduledCount =
  document.querySelector<HTMLElement>("#scheduled-count");

const publishedCount =
  document.querySelector<HTMLElement>("#published-count");

const archivedCount =
  document.querySelector<HTMLElement>("#archived-count");

    const recentStories =
      document.querySelector<HTMLElement>("#recent-stories");

    const recentEmpty =
      document.querySelector<HTMLElement>("#recent-empty");

    const attentionReviewCount =
      document.querySelector<HTMLElement>("#attention-review-count");

    const attentionScheduledCount =
      document.querySelector<HTMLElement>("#attention-scheduled-count");

    const attentionAltCount =
      document.querySelector<HTMLElement>("#attention-alt-count");

    const attentionClear =
      document.querySelector<HTMLElement>("#attention-clear");

    function formatDate(value: string): string {
      return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(new Date(value));
    }

    function getArticleDateLabel(
  article: ArticleSummary
): string {
  if (
    article.status === "scheduled" &&
    article.published_at
  ) {
    return `Scheduled for ${formatDate(
      article.published_at
    )}`;
  }

  if (
    article.status === "published" &&
    article.published_at
  ) {
    return `Published ${formatDate(
      article.published_at
    )}`;
  }

  if (article.status === "archived") {
    return `Archived · Updated ${formatDate(
      article.updated_at
    )}`;
  }

  return `Updated ${formatDate(article.updated_at)}`;
}

    function isPubliclyAvailable(article: ArticleSummary): boolean {
      if (
        article.status !== "published" &&
        article.status !== "scheduled"
      ) {
        return false;
      }

      if (!article.published_at) {
        return false;
      }

      const publicationDate = new Date(article.published_at);

      return (
        !Number.isNaN(publicationDate.getTime()) &&
        publicationDate.getTime() <= Date.now()
      );
    }

    function createRecentStory(
      article: ArticleSummary
    ): HTMLElement {
      const story = document.createElement("article");
      story.className = "recent-story";

      const content = document.createElement("div");
      content.className = "recent-story__content";

      const categoryRow = document.createElement("div");
      categoryRow.className = "recent-story__category-row";

      const category = document.createElement("p");
      category.className = "recent-story__category";
      category.textContent =
        article.category || "Uncategorized";

      categoryRow.append(category);

      if (article.is_featured) {
        const featured = document.createElement("span");
        featured.className = "recent-story__featured";
        featured.textContent = "Featured";
        categoryRow.append(featured);
      }

      const headline = document.createElement("h3");

      const link = document.createElement("a");
      link.href = `/admin/articles/${article.id}`;
      link.textContent =
        article.headline || "Untitled story";

      headline.append(link);

      const meta = document.createElement("p");
      meta.className = "recent-story__meta";
      meta.textContent = getArticleDateLabel(article);

      content.append(categoryRow, headline, meta);

      const side = document.createElement("div");
      side.className = "recent-story__side";

      const status = document.createElement("span");
      status.className =
        `status-badge status-badge--${article.status}`;
      status.textContent = article.status_label;

      const actions = document.createElement("div");
      actions.className = "recent-story__actions";

      const edit = document.createElement("a");
      edit.href = `/admin/articles/${article.id}`;
      edit.textContent = "Edit";

      actions.append(edit);

      if (
        article.slug &&
        isPubliclyAvailable(article)
      ) {
        const view = document.createElement("a");
        view.href = `/gazette/${article.slug}`;
        view.target = "_blank";
        view.rel = "noreferrer";
        view.textContent = "View ↗";
        actions.append(view);
      }

      side.append(status, actions);
      story.append(content, side);

      return story;
    }

    async function verifyAdmin(): Promise<boolean> {
      const {
        data: { user },
        error: userError,
      } = await supabaseBrowser.auth.getUser();

      if (userError || !user) {
        window.location.replace("/admin/login");
        return false;
      }

      const {
        data: adminRecord,
        error: adminError,
      } = await supabaseBrowser
        .from("admin_users")
        .select("user_id")
        .eq("user_id", user.id)
        .maybeSingle();

      if (adminError || !adminRecord) {
        const { data: contributor } = await supabaseBrowser
          .from("publication_contributors")
          .select("role")
          .eq("user_id", user.id)
          .maybeSingle();

        if (contributor?.role === "commissioner") {
          window.location.replace("/admin/articles");
          return false;
        }

        await supabaseBrowser.auth.signOut();
        window.location.replace("/admin/login");
        return false;
      }

      return true;
    }

    async function initializeDesk(): Promise<void> {
      const currentHour = new Date().getHours();

      if (greetingElement) {
        greetingElement.textContent =
          currentHour < 12
            ? "Good morning."
            : currentHour < 18
              ? "Good afternoon."
              : "Good evening.";
      }

      if (dateElement) {
        dateElement.textContent =
          new Intl.DateTimeFormat("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
          }).format(new Date());
      }

      const isAdmin = await verifyAdmin();

      if (!isAdmin) {
        return;
      }

      const { data, error } = await supabaseBrowser
  .from("editorial_articles")
  .select(
    `
      id,
      slug,
      category,
      headline,
      author_name,
      status,
      status_label,
      is_featured,
      published_at,
      updated_at,
      editorial_date,
      editorial_sort_at,
      can_publish,
      needs_image_alt
    `
  )
  .order("editorial_sort_at", {
    ascending: false,
  });

      if (loading) {
        loading.hidden = true;
      }

      if (desk) {
        desk.hidden = false;
      }

      if (error) {
        if (message) {
          message.textContent =
            `Unable to load the editorial desk: ${error.message}`;
        }

        return;
      }

      const articles =
        (data ?? []) as ArticleSummary[];

      if (allCount) {
        allCount.textContent = String(articles.length);
      }

      const countByStatus = (
  status: ArticleStatus
): number =>
  articles.filter(
    (article) => article.status === status
  ).length;

if (draftCount) {
  draftCount.textContent = String(
    countByStatus("draft")
  );
}

if (reviewCount) {
  reviewCount.textContent = String(
    countByStatus("ready_for_review")
  );
}

if (scheduledCount) {
  scheduledCount.textContent = String(
    countByStatus("scheduled")
  );
}

if (publishedCount) {
  publishedCount.textContent = String(
    countByStatus("published")
  );
}

if (archivedCount) {
  archivedCount.textContent = String(
    countByStatus("archived")
  );
}

      const reviewTotal =
        countByStatus("ready_for_review");

      const scheduledTotal =
        countByStatus("scheduled");

      const missingAltTotal =
        articles.filter(
          (article) => article.needs_image_alt
        ).length;

      if (attentionReviewCount) {
        attentionReviewCount.textContent =
          String(reviewTotal);
      }

      if (attentionScheduledCount) {
        attentionScheduledCount.textContent =
          String(scheduledTotal);
      }

      if (attentionAltCount) {
        attentionAltCount.textContent =
          String(missingAltTotal);
      }

      if (attentionClear) {
        attentionClear.hidden =
          reviewTotal + scheduledTotal + missingAltTotal > 0;
      }

      const recent = articles.slice(0, 5);

      if (recentStories) {
        recentStories.replaceChildren();

        for (const article of recent) {
          recentStories.append(
            createRecentStory(article)
          );
        }

        recentStories.hidden = recent.length === 0;
      }

      if (recentEmpty) {
        recentEmpty.hidden = recent.length > 0;
      }
    }

    initializeDesk();
  </script>
</AdminLayout>

<style>
  .desk-loading {
    min-height: 20rem;
    display: grid;
    place-items: center;
    color: var(--color-ink-soft);
  }

  .desk-loading[hidden],
  .editorial-desk[hidden],
  .recent-stories[hidden],
  .desk-empty[hidden],
  .attention-clear[hidden] {
    display: none;
  }

  .editorial-desk {
    display: grid;
    gap: var(--space-7);
  }

  .desk-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: 3px double var(--color-rule-dark);
  }

  .desk-header h1 {
    margin: 0;
    font-size: clamp(3.6rem, 8vw, 7.5rem);
    letter-spacing: -0.06em;
    line-height: 0.86;
  }

  .desk-header__description {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
  }

  .desk-date {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .desk-overview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .desk-stat {
    display: grid;
    min-height: 9.5rem;
    gap: var(--space-3);
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-card);
    transition:
      transform 150ms ease,
      border-color 150ms ease;
  }

  .desk-stat:hover {
    transform: translateY(-2px);
    border-color: var(--color-green);
  }

  .desk-stat > span {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 750;
  }

  .desk-stat strong {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.055em;
    line-height: 0.8;
  }

  .desk-stat small {
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 750;
  }

  .desk-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(18rem, 0.75fr);
    align-items: start;
    gap: var(--space-5);
  }

  .desk-sidebar {
    display: grid;
    gap: var(--space-5);
  }

  .desk-panel {
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .desk-panel__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--color-rule);
  }

  .desk-panel__heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .desk-panel__heading .eyebrow {
    margin-bottom: var(--space-2);
  }

  .desk-panel__heading > a {
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 750;
    text-decoration: none;
  }

  .desk-panel__heading > a:hover {
    text-decoration: underline;
  }

  .recent-stories {
    display: grid;
  }

  :global(.recent-story) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: clamp(1.15rem, 3vw, 1.6rem)
      clamp(1.25rem, 3vw, 1.8rem);
    border-bottom: 1px solid var(--color-rule);
  }

  :global(.recent-story):last-child {
    border-bottom: 0;
  }

  :global(.recent-story__category) {
    margin: 0 0 var(--space-2);
    color: var(--color-green);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :global(.recent-story__category-row) {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem;
  margin-bottom: var(--space-2);
}

:global(.recent-story__category-row)
  :global(.recent-story__category) {
  margin: 0;
}

:global(.recent-story__featured) {
  display: inline-flex;
  padding: 0.2rem 0.4rem;
  border: 1px solid
    color-mix(
      in srgb,
      var(--color-green) 25%,
      transparent
    );
  border-radius: 999px;
  color: var(--color-green);
  font-size: 0.56rem;
  font-weight: 850;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

  :global(.recent-story) h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    letter-spacing: -0.025em;
  }

  :global(.recent-story) h3 a {
    color: inherit;
    text-decoration: none;
  }

  :global(.recent-story) h3 a:hover {
    color: var(--color-green);
  }

  :global(.recent-story__meta) {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  :global(.recent-story__side) {
    display: grid;
    justify-items: end;
    gap: 0.7rem;
  }

  :global(.recent-story__actions) {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  :global(.recent-story__actions) a {
    color: var(--color-green);
    font-size: 0.72rem;
    font-weight: 750;
    text-decoration: none;
  }

  :global(.recent-story__actions) a:hover {
    text-decoration: underline;
  }

  :global(.status-badge) {
    display: inline-flex;
    padding: 0.4rem 0.65rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  :global(.status-badge--published) {
    background: color-mix(
      in srgb,
      var(--color-green) 13%,
      transparent
    );
    color: var(--color-green);
  }

  :global(.status-badge--draft) {
    background: #eee7d7;
    color: #6b592d;
  }

  :global(.status-badge--ready_for_review) {
  background: #e7edf6;
  color: #34587b;
}

:global(.status-badge--scheduled) {
  background: #eee7f6;
  color: #67468a;
}

  :global(.status-badge--archived) {
    background: #ececeb;
    color: #666a66;
  }

  .quick-actions {
    display: grid;
    padding: var(--space-3);
  }

  .quick-action {
    display: flex;
    min-height: 4.7rem;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
  }

  .quick-action:hover {
    background:
      color-mix(
        in srgb,
        var(--color-green) 5%,
        transparent
      );
  }

  .quick-action--primary {
    background: var(--color-green);
    color: #fff;
  }

  .quick-action--primary:hover {
    background: var(--color-green);
    filter: brightness(1.08);
  }

  .quick-action span:first-child {
    display: grid;
    gap: 0.2rem;
  }

  .quick-action strong {
    font-size: 0.92rem;
  }

  .quick-action small {
    color: var(--color-ink-soft);
    font-size: 0.72rem;
  }

  .quick-action--primary small {
    color: rgba(255, 255, 255, 0.72);
  }

  .attention-list {
    display: grid;
    padding: var(--space-3);
  }

  .attention-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.7rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    color: inherit;
    text-decoration: none;
  }

  .attention-item:hover {
    background:
      color-mix(
        in srgb,
        var(--color-green) 5%,
        transparent
      );
  }

  .attention-item > span:first-child {
    display: grid;
    gap: 0.2rem;
  }

  .attention-item strong {
    font-size: 0.92rem;
  }

  .attention-item small {
    color: var(--color-ink-soft);
    font-size: 0.72rem;

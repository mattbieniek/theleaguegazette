---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Editorial Desk | The League Gazette">
  <div id="desk-loading" class="admin-shell desk-loading">
    <p>Opening the editorial desk…</p>
  </div>

  <div id="editorial-desk" class="admin-shell editorial-desk" hidden>
    <header class="desk-header">
      <div>
        <p class="eyebrow">Editorial Desk</p>
        <h1 id="desk-greeting">Good morning.</h1>
        <p class="desk-header__description">
          Here’s what is happening inside The League Gazette.
        </p>
      </div>

      <p id="desk-date" class="desk-date"></p>
    </header>

    <section class="desk-overview" aria-label="Publishing overview">
  <a class="desk-stat" href="/admin/articles">
    <span>All stories</span>
    <strong id="all-count">0</strong>
    <small>Open the story archive →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=draft"
  >
    <span>Drafts</span>
    <strong id="draft-count">0</strong>
    <small>Stories still in progress →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=ready_for_review"
  >
    <span>Ready for review</span>
    <strong id="review-count">0</strong>
    <small>Stories awaiting approval →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=scheduled"
  >
    <span>Scheduled</span>
    <strong id="scheduled-count">0</strong>
    <small>Upcoming publications →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=published"
  >
    <span>Published</span>
    <strong id="published-count">0</strong>
    <small>View published work →</small>
  </a>

  <a
    class="desk-stat"
    href="/admin/articles?status=archived"
  >
    <span>Archived</span>
    <strong id="archived-count">0</strong>
    <small>Retired Gazette stories →</small>
  </a>
</section>

    <section class="operations-hub" aria-labelledby="operations-hub-title">
      <div class="operations-heading"><div><p class="eyebrow">Publication &amp; league operations</p><h2 id="operations-hub-title">Operations hub</h2></div><p>Jump directly to each desk and see what needs attention.</p></div>
      <div class="operations-grid">
        <a href="/admin/rankings"><span>Power Rankings</span><strong id="operation-rankings">Loading…</strong><small>Arrange the weekly edition →</small></a>
        <a href="/admin/awards"><span>Weekly Awards</span><strong id="operation-awards">Loading…</strong><small>Review calculated winners →</small></a>
        <a href="/admin/photos"><span>Photo Desk</span><strong id="operation-photos">Loading…</strong><small>Review artwork coverage →</small></a>
        <a href="/admin/teams"><span>Teams</span><strong id="operation-teams">Loading…</strong><small>Inspect franchise data →</small></a>
        <a href="/admin/archive"><span>Archive</span><strong id="operation-archive">Loading…</strong><small>Check historical coverage →</small></a>
        <a href="/admin/sleeper"><span>Sleeper Data</span><strong id="operation-sleeper">Loading…</strong><small>Manage synchronized data →</small></a>
      </div>
    </section>

    <section class="desk-priority" aria-label="Current editorial priorities">
      <article class="desk-panel">
        <div class="desk-panel__heading">
          <div><p class="eyebrow">Review queue</p><h2>Awaiting your decision</h2></div>
          <a href="/admin/articles?status=ready_for_review">View queue</a>
        </div>
        <div id="dashboard-review-queue" class="dashboard-list"></div>
        <div id="dashboard-review-empty" class="desk-empty" hidden><h3>No reviews waiting</h3><p>Contributor submissions will appear here.</p></div>
      </article>

      <article class="desk-panel">
        <div class="desk-panel__heading">
          <div><p class="eyebrow">Notifications</p><h2>Unread updates</h2></div>
          <a href="/admin/notifications">View all</a>
        </div>
        <div id="dashboard-notifications" class="dashboard-list"></div>
        <div id="dashboard-notifications-empty" class="desk-empty" hidden><h3>You're caught up</h3><p>New editorial activity will appear here.</p></div>
      </article>
    </section>

    <section class="desk-grid">
      <article class="desk-panel desk-panel--recent">
        <div class="desk-panel__heading">
          <div>
            <p class="eyebrow">Recent work</p>
            <h2>Latest stories</h2>
          </div>

          <a href="/admin/articles">
            View all
          </a>
        </div>

        <div id="recent-stories" class="recent-stories"></div>

        <div
          id="recent-empty"
          class="desk-empty"
          hidden
        >
          <h3>No stories yet</h3>
          <p>
            Your most recently edited stories will appear here.
          </p>
        </div>
      </article>

      <aside class="desk-sidebar">
        <article class="desk-panel">
          <div class="desk-panel__heading">
            <div>
              <p class="eyebrow">Quick actions</p>
              <h2>Start here</h2>
            </div>
          </div>

          <div class="quick-actions">
            <a
              class="quick-action quick-action--primary"
              href="/admin/articles/new"
            >
              <span>
                <strong>Write a new story</strong>
                <small>Open a fresh Gazette draft</small>
              </span>

              <span aria-hidden="true">→</span>
            </a>

            <a
              class="quick-action"
              href="/admin/articles"
            >
              <span>
                <strong>Manage stories</strong>
                <small>Review drafts and published work</small>
              </span>

              <span aria-hidden="true">→</span>
            </a>

            <a
              class="quick-action"
              href="/"
              target="_blank"
              rel="noreferrer"
            >
              <span>
                <strong>View live site</strong>
                <small>Open The League Gazette</small>
              </span>

              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="desk-panel desk-attention">
          <div class="desk-panel__heading">
            <div>
              <p class="eyebrow">Editorial queue</p>
              <h2>Needs attention</h2>
            </div>
          </div>

          <div class="attention-list">
            <a
              class="attention-item"
              href="/admin/articles?status=ready_for_review"
            >
              <span>
                <strong>Ready for review</strong>
                <small>Stories awaiting a final decision</small>
              </span>

              <span id="attention-review-count" class="attention-count">0</span>
            </a>

            <a
              class="attention-item"
              href="/admin/articles?status=scheduled"
            >
              <span>
                <strong>Scheduled stories</strong>
                <small>Upcoming Gazette publications</small>
              </span>

              <span id="attention-scheduled-count" class="attention-count">0</span>
            </a>

            <a
              class="attention-item"
              href="/admin/articles?q=&sort=updated-desc"
            >
              <span>
                <strong>Missing image alt text</strong>
                <small>Artwork that needs an accessible description</small>
              </span>

              <span id="attention-alt-count" class="attention-count">0</span>
            </a>
          </div>

          <p id="attention-clear" class="attention-clear" hidden>
            The editorial queue is clear.
          </p>
        </article>
      </aside>
    </section>

    <section class="desk-panel">
      <div class="desk-panel__heading">
        <div><p class="eyebrow">Contributor activity</p><h2>Recent review history</h2></div>
      </div>
      <div id="dashboard-activity" class="dashboard-activity"></div>
      <div id="dashboard-activity-empty" class="desk-empty" hidden><h3>No contributor activity yet</h3><p>Submissions, revision requests, and approvals will be recorded here.</p></div>
    </section>

    <div
      id="desk-message"
      class="desk-message"
      role="status"
      aria-live="polite"
    ></div>
  </div>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";

    type ArticleStatus =
  | "draft"
  | "ready_for_review"
  | "scheduled"
  | "published"
  | "archived";

type ArticleSummary = {
  id: string;
  slug: string;
  category: string;
  headline: string;
  author_name: string;
  status: ArticleStatus;
  status_label: string;
  is_featured: boolean;
  published_at: string | null;
  updated_at: string;
  editorial_date: string;
  editorial_sort_at: string;
  can_publish: boolean;
  needs_image_alt: boolean;
  image_url: string | null;
};
type EditorialNotification = { id: string; kind: string; title: string; message: string; action_url: string | null; created_at: string };
type ReviewEvent = { id: string; article_id: string; action: string; note: string | null; created_at: string };

    const loading =
      document.querySelector<HTMLElement>("#desk-loading");

    const desk =
      document.querySelector<HTMLElement>("#editorial-desk");

    const message =
      document.querySelector<HTMLElement>("#desk-message");

    const dateElement =
      document.querySelector<HTMLElement>("#desk-date");

    const greetingElement =
      document.querySelector<HTMLElement>("#desk-greeting");

    const allCount =
      document.querySelector<HTMLElement>("#all-count");

    const draftCount =
  document.querySelector<HTMLElement>("#draft-count");

const reviewCount =
  document.querySelector<HTMLElement>("#review-count");

const scheduledCount =
  document.querySelector<HTMLElement>("#scheduled-count");

const publishedCount =
  document.querySelector<HTMLElement>("#published-count");

const archivedCount =
  document.querySelector<HTMLElement>("#archived-count");

    const recentStories =
      document.querySelector<HTMLElement>("#recent-stories");

    const recentEmpty =
      document.querySelector<HTMLElement>("#recent-empty");

    const attentionReviewCount =
      document.querySelector<HTMLElement>("#attention-review-count");

    const attentionScheduledCount =
      document.querySelector<HTMLElement>("#attention-scheduled-count");

    const attentionAltCount =
      document.querySelector<HTMLElement>("#attention-alt-count");

    const attentionClear =
      document.querySelector<HTMLElement>("#attention-clear");
    const dashboardReviewQueue = document.querySelector<HTMLElement>("#dashboard-review-queue");
    const dashboardReviewEmpty = document.querySelector<HTMLElement>("#dashboard-review-empty");
    const dashboardNotifications = document.querySelector<HTMLElement>("#dashboard-notifications");
    const dashboardNotificationsEmpty = document.querySelector<HTMLElement>("#dashboard-notifications-empty");
    const dashboardActivity = document.querySelector<HTMLElement>("#dashboard-activity");
    const dashboardActivityEmpty = document.querySelector<HTMLElement>("#dashboard-activity-empty");
    const operationRankings = document.querySelector<HTMLElement>("#operation-rankings");
    const operationAwards = document.querySelector<HTMLElement>("#operation-awards");
    const operationPhotos = document.querySelector<HTMLElement>("#operation-photos");
    const operationTeams = document.querySelector<HTMLElement>("#operation-teams");
    const operationArchive = document.querySelector<HTMLElement>("#operation-archive");
    const operationSleeper = document.querySelector<HTMLElement>("#operation-sleeper");

    function formatDate(value: string): string {
      return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(new Date(value));
    }

    function getArticleDateLabel(
  article: ArticleSummary
): string {
  if (
    article.status === "scheduled" &&
    article.published_at
  ) {
    return `Scheduled for ${formatDate(
      article.published_at
    )}`;
  }

  if (
    article.status === "published" &&
    article.published_at
  ) {
    return `Published ${formatDate(
      article.published_at
    )}`;
  }

  if (article.status === "archived") {
    return `Archived · Updated ${formatDate(
      article.updated_at
    )}`;
  }

  return `Updated ${formatDate(article.updated_at)}`;
}

    function isPubliclyAvailable(article: ArticleSummary): boolean {
      if (
        article.status !== "published" &&
        article.status !== "scheduled"
      ) {
        return false;
      }

      if (!article.published_at) {
        return false;
      }

      const publicationDate = new Date(article.published_at);

      return (
        !Number.isNaN(publicationDate.getTime()) &&
        publicationDate.getTime() <= Date.now()
      );
    }

    function createRecentStory(
      article: ArticleSummary
    ): HTMLElement {
      const story = document.createElement("article");
      story.className = "recent-story";

      const content = document.createElement("div");
      content.className = "recent-story__content";

      const categoryRow = document.createElement("div");
      categoryRow.className = "recent-story__category-row";

      const category = document.createElement("p");
      category.className = "recent-story__category";
      category.textContent =
        article.category || "Uncategorized";

      categoryRow.append(category);

      if (article.is_featured) {
        const featured = document.createElement("span");
        featured.className = "recent-story__featured";
        featured.textContent = "Featured";
        categoryRow.append(featured);
      }

      const headline = document.createElement("h3");

      const link = document.createElement("a");
      link.href = `/admin/articles/${article.id}`;
      link.textContent =
        article.headline || "Untitled story";

      headline.append(link);

      const meta = document.createElement("p");
      meta.className = "recent-story__meta";
      meta.textContent = getArticleDateLabel(article);

      content.append(categoryRow, headline, meta);

      const side = document.createElement("div");
      side.className = "recent-story__side";

      const status = document.createElement("span");
      status.className =
        `status-badge status-badge--${article.status}`;
      status.textContent = article.status_label;

      const actions = document.createElement("div");
      actions.className = "recent-story__actions";

      const edit = document.createElement("a");
      edit.href = `/admin/articles/${article.id}`;
      edit.textContent = "Edit";

      actions.append(edit);

      if (
        article.slug &&
        isPubliclyAvailable(article)
      ) {
        const view = document.createElement("a");
        view.href = `/gazette/${article.slug}`;
        view.target = "_blank";
        view.rel = "noreferrer";
        view.textContent = "View ↗";
        actions.append(view);
      }

      side.append(status, actions);
      story.append(content, side);

      return story;
    }

    function renderReviewQueue(articles: ArticleSummary[]): void {
      if (!dashboardReviewQueue || !dashboardReviewEmpty) return;
      dashboardReviewQueue.replaceChildren();
      const reviews = articles.filter((article) => article.status === "ready_for_review").slice(0, 4);
      for (const article of reviews) {
        const link = document.createElement("a"); link.className = "dashboard-row"; link.href = `/admin/articles/${article.id}`;
        const copy = document.createElement("span"); const title = document.createElement("strong"); title.textContent = article.headline || "Untitled story";
        const detail = document.createElement("small"); detail.textContent = `${article.author_name} · ${formatDate(article.updated_at)}`;
        copy.append(title, detail); const action = document.createElement("b"); action.textContent = "Review →"; link.append(copy, action); dashboardReviewQueue.append(link);
      }
      dashboardReviewQueue.hidden = reviews.length === 0; dashboardReviewEmpty.hidden = reviews.length > 0;
    }

    function renderNotifications(notifications: EditorialNotification[]): void {
      if (!dashboardNotifications || !dashboardNotificationsEmpty) return;
      dashboardNotifications.replaceChildren();
      for (const notification of notifications) {
        const link = document.createElement("a"); link.className = "dashboard-row"; link.href = notification.action_url ?? "/admin/notifications";
        link.addEventListener("click", () => { void supabaseBrowser.from("editorial_notifications").update({ read_at: new Date().toISOString() }).eq("id", notification.id); });
        const copy = document.createElement("span"); const title = document.createElement("strong"); title.textContent = notification.title;
        const detail = document.createElement("small"); detail.textContent = notification.message;
        copy.append(title, detail); const date = document.createElement("time"); date.dateTime = notification.created_at; date.textContent = formatDate(notification.created_at);
        link.append(copy, date); dashboardNotifications.append(link);
      }
      dashboardNotifications.hidden = notifications.length === 0; dashboardNotificationsEmpty.hidden = notifications.length > 0;
    }

    function renderActivity(events: ReviewEvent[], articles: ArticleSummary[]): void {
      if (!dashboardActivity || !dashboardActivityEmpty) return;
      dashboardActivity.replaceChildren(); const articleMap = new Map(articles.map((article) => [article.id, article]));
      const labels: Record<string, string> = { submitted: "submitted for review", changes_requested: "returned for changes", approved: "approved and published" };
      for (const event of events) {
        const article = articleMap.get(event.article_id); if (!article) continue;
        const item = document.createElement("a"); item.className = "activity-row"; item.href = `/admin/articles/${article.id}`;
        const marker = document.createElement("span"); marker.className = `activity-row__marker activity-row__marker--${event.action}`; marker.setAttribute("aria-hidden", "true");
        const copy = document.createElement("span"); const text = document.createElement("strong"); text.textContent = `${article.author_name} ${labels[event.action] ?? "updated"} “${article.headline}”`;
        const detail = document.createElement("small"); detail.textContent = event.note ? `${formatDate(event.created_at)} · ${event.note}` : formatDate(event.created_at);
        copy.append(text, detail); item.append(marker, copy); dashboardActivity.append(item);
      }
      const hasActivity = dashboardActivity.childElementCount > 0; dashboardActivity.hidden = !hasActivity; dashboardActivityEmpty.hidden = hasActivity;
    }

    async function verifyAdmin(): Promise<boolean> {
      const {
        data: { user },
        error: userError,
      } = await supabaseBrowser.auth.getUser();

      if (userError || !user) {
        window.location.replace("/admin/login");
        return false;
      }

      const {
        data: adminRecord,
        error: adminError,
      } = await supabaseBrowser
        .from("admin_users")
        .select("user_id")
        .eq("user_id", user.id)
        .maybeSingle();

      if (adminError || !adminRecord) {
        const { data: contributor } = await supabaseBrowser
          .from("publication_contributors")
          .select("role")
          .eq("user_id", user.id)
          .maybeSingle();

        if (contributor?.role === "op_ed") {
          window.location.replace("/admin/articles");
          return false;
        }

        await supabaseBrowser.auth.signOut();
        window.location.replace("/admin/login");
        return false;
      }

      return true;
    }

    async function initializeDesk(): Promise<void> {
      const currentHour = new Date().getHours();

      if (greetingElement) {
        greetingElement.textContent =
          currentHour < 12
            ? "Good morning."
            : currentHour < 18
              ? "Good afternoon."
              : "Good evening.";
      }

      if (dateElement) {
        dateElement.textContent =
          new Intl.DateTimeFormat("en-US", {
            weekday: "long",
            month: "long",
            day: "numeric",
          }).format(new Date());
      }

      const isAdmin = await verifyAdmin();

      if (!isAdmin) {
        return;
      }

      const db = supabaseBrowser as any;
      const [articleResult, notificationResult, activityResult, rankingsResult, weeklyResult, teamsResult, seasonsResult, sleeperResult] = await Promise.all([
        supabaseBrowser
  .from("editorial_articles")
  .select(
    `
      id,
      slug,
      category,
      headline,
      author_name,
      status,
      status_label,
      is_featured,
      published_at,
      updated_at,
      editorial_date,
      editorial_sort_at,
      can_publish,
      needs_image_alt,
      image_url
    `
  )
  .order("editorial_sort_at", {
    ascending: false,
  }),
        supabaseBrowser.from("editorial_notifications").select("id,kind,title,message,action_url,created_at").is("read_at", null).order("created_at", { ascending: false }).limit(4),
        supabaseBrowser.from("editorial_review_events").select("id,article_id,action,note,created_at").order("created_at", { ascending: false }).limit(8),
        db.from("power_rankings").select("id,status,season_year,week"),
        supabaseBrowser.from("team_weekly_results").select("season_year,week,fantasy_team_id").order("season_year", { ascending: false }).order("week", { ascending: false }),
        supabaseBrowser.from("fantasy_teams").select("id,last_synced_at,seasons!inner(year)").order("last_synced_at", { ascending: false }).limit(20),
        supabaseBrowser.from("seasons").select("id,year").order("year", { ascending: false }),
        supabaseBrowser.rpc("admin_sleeper_status"),
      ]);

      const { data, error } = articleResult;

      if (loading) {
        loading.hidden = true;
      }

      if (desk) {
        desk.hidden = false;
      }

      if (error) {
        if (message) {
          message.textContent =
            `Unable to load the editorial desk: ${error.message}`;
        }

        return;
      }

      const articles =
        (data ?? []) as ArticleSummary[];

      const rankingRows = rankingsResult.data ?? [];
      const readyRankings = rankingRows.filter((row:any) => row.status === "ready").length;
      if (operationRankings) operationRankings.textContent = rankingRows.length ? `${readyRankings} ready · ${rankingRows.length} saved` : "No editions saved";
      const weeklyRows = weeklyResult.data ?? [];
      const latestWeekly = weeklyRows[0];
      const latestWeekCount = latestWeekly ? weeklyRows.filter((row) => row.season_year === latestWeekly.season_year && row.week === latestWeekly.week).length : 0;
      if (operationAwards) operationAwards.textContent = latestWeekly ? `Week ${latestWeekly.week} · ${latestWeekCount >= 10 ? "complete" : `${latestWeekCount}/10 teams`}` : "No matchup results";
      const missingImages = articles.filter((article:any) => !article.image_url).length;
      const missingAlt = articles.filter((article) => article.needs_image_alt).length;
      if (operationPhotos) operationPhotos.textContent = missingImages || missingAlt ? `${missingImages} need art · ${missingAlt} need alt text` : "Artwork complete";
      const teamRows = teamsResult.data ?? [];
      const latestSeason = teamRows[0]?.seasons?.year;
      const currentTeams = latestSeason ? teamRows.filter((row) => row.seasons?.year === latestSeason).length : 0;
      if (operationTeams) operationTeams.textContent = latestSeason ? `${currentTeams} teams · ${latestSeason}` : "No teams found";
      const seasonRows = seasonsResult.data ?? [];
      if (operationArchive) operationArchive.textContent = seasonRows.length ? `${seasonRows.length} season${seasonRows.length === 1 ? "" : "s"} · since ${seasonRows.at(-1)?.year}` : "No seasons recorded";
      const datasetDates = ((sleeperResult.data as any)?.datasets ?? []).map((item:any) => item.last_synced_at).filter(Boolean).sort();
      if (operationSleeper) operationSleeper.textContent = datasetDates.length ? `Updated ${formatDate(datasetDates.at(-1))}` : "Check data status";

      renderReviewQueue(articles);
      renderNotifications((notificationResult.data ?? []) as EditorialNotification[]);
      renderActivity((activityResult.data ?? []) as ReviewEvent[], articles);

      if (allCount) {
        allCount.textContent = String(articles.length);
      }

      const countByStatus = (
  status: ArticleStatus
): number =>
  articles.filter(
    (article) => article.status === status
  ).length;

if (draftCount) {
  draftCount.textContent = String(
    countByStatus("draft")
  );
}

if (reviewCount) {
  reviewCount.textContent = String(
    countByStatus("ready_for_review")
  );
}

if (scheduledCount) {
  scheduledCount.textContent = String(
    countByStatus("scheduled")
  );
}

if (publishedCount) {
  publishedCount.textContent = String(
    countByStatus("published")
  );
}

if (archivedCount) {
  archivedCount.textContent = String(
    countByStatus("archived")
  );
}

      const reviewTotal =
        countByStatus("ready_for_review");

      const scheduledTotal =
        countByStatus("scheduled");

      const missingAltTotal =
        articles.filter(
          (article) => article.needs_image_alt
        ).length;

      if (attentionReviewCount) {
        attentionReviewCount.textContent =
          String(reviewTotal);
      }

      if (attentionScheduledCount) {
        attentionScheduledCount.textContent =
          String(scheduledTotal);
      }

      if (attentionAltCount) {
        attentionAltCount.textContent =
          String(missingAltTotal);
      }

      if (attentionClear) {
        attentionClear.hidden =
          reviewTotal + scheduledTotal + missingAltTotal > 0;
      }

      const recent = articles.slice(0, 5);

      if (recentStories) {
        recentStories.replaceChildren();

        for (const article of recent) {
          recentStories.append(
            createRecentStory(article)
          );
        }

        recentStories.hidden = recent.length === 0;
      }

      if (recentEmpty) {
        recentEmpty.hidden = recent.length > 0;
      }
    }

    initializeDesk();
  </script>
</AdminLayout>

<style>
  .desk-loading {
    min-height: 20rem;
    display: grid;
    place-items: center;
    color: var(--color-ink-soft);

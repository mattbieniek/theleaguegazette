---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Homepage Curation | The League Gazette">
  <div id="curation-loading" class="admin-shell curation-loading">Opening homepage curation…</div>
  <div id="curation-page" class="admin-shell curation-page" hidden>
    <header class="curation-header">
      <div>
        <p class="eyebrow">Publication</p>
        <h1>Homepage curation</h1>
        <p>Choose one lead story and up to two supporting headlines. Publishing status is managed in the story editor.</p>
      </div>
      <button id="save-curation" type="button">Save homepage</button>
    </header>
    <p id="curation-message" class="curation-message" role="status" aria-live="polite"></p>
    <section class="curation-preview" aria-labelledby="curation-preview-title">
      <div class="curation-preview__heading"><p class="eyebrow">Homepage preview</p><h2 id="curation-preview-title">Top stories</h2><small>Updates instantly as positions change. The live site changes only after saving.</small></div>
      <div class="curation-preview__layout">
        <div id="preview-lead" class="preview-slot preview-slot--lead"></div>
        <div class="curation-preview__rail">
          <div id="preview-support-1" class="preview-slot"></div>
          <div id="preview-support-2" class="preview-slot"></div>
        </div>
      </div>
    </section>
    <aside id="curation-warning" class="curation-warning" hidden></aside>
    <section id="curation-list" class="curation-list" aria-label="Published stories"></section>
    <div id="curation-empty" class="curation-empty" hidden>
      <h2>No public stories available</h2>
      <p>Publish or schedule a story before adding it to the homepage.</p>
    </div>
  </div>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";

    type Story = {
      id: string;
      headline: string;
      category: string;
      author_name: string;
      status: string;
      published_at: string | null;
      is_featured: boolean;
      homepage_order: number | null;
    };

    const loading = document.querySelector<HTMLElement>("#curation-loading");
    const page = document.querySelector<HTMLElement>("#curation-page");
    const list = document.querySelector<HTMLElement>("#curation-list");
    const empty = document.querySelector<HTMLElement>("#curation-empty");
    const message = document.querySelector<HTMLElement>("#curation-message");
    const saveButton = document.querySelector<HTMLButtonElement>("#save-curation");
    const previewLead = document.querySelector<HTMLElement>("#preview-lead");
    const previewSupport1 = document.querySelector<HTMLElement>("#preview-support-1");
    const previewSupport2 = document.querySelector<HTMLElement>("#preview-support-2");
    const warning = document.querySelector<HTMLElement>("#curation-warning");
    let stories: Story[] = [];
    let stalePlacementIds: string[] = [];

    function setMessage(text: string, type = "") {
      if (!message) return;
      message.textContent = text;
      message.dataset.type = type;
    }

    function formatDate(value: string | null) {
      if (!value) return "Publication date unavailable";
      return new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(new Date(value));
    }

    function isLive(story: Story): boolean {
      return story.status === "published" || Boolean(story.published_at && new Date(story.published_at).getTime() <= Date.now());
    }

    function availabilityLabel(story: Story): string {
      return isLive(story) ? `Live · ${formatDate(story.published_at)}` : `Scheduled for ${formatDate(story.published_at)}`;
    }

    function renderPreviewSlot(target: HTMLElement | null, story: Story | undefined, label: string): void {
      if (!target) return; target.replaceChildren();
      const position = document.createElement("p"); position.className = "preview-slot__position"; position.textContent = label; target.append(position);
      if (!story) { const emptySlot = document.createElement("span"); emptySlot.className = "preview-slot__empty"; emptySlot.textContent = "No story selected"; target.append(emptySlot); return; }
      const category = document.createElement("small"); category.textContent = story.category;
      const headline = document.createElement("h3"); headline.textContent = story.headline;
      const state = document.createElement("span"); state.className = `story-availability ${isLive(story) ? "story-availability--live" : "story-availability--scheduled"}`; state.textContent = availabilityLabel(story);
      target.append(category, headline, state);
    }

    function renderPreview(): void {
      renderPreviewSlot(previewLead, stories.find((story) => story.homepage_order === 1), "Lead story");
      renderPreviewSlot(previewSupport1, stories.find((story) => story.homepage_order === 2), "Supporting story 1");
      renderPreviewSlot(previewSupport2, stories.find((story) => story.homepage_order === 3), "Supporting story 2");
    }

    function render() {
      if (!list) return;
      list.replaceChildren();
      for (const story of stories) {
        const row = document.createElement("article");
        row.className = "curation-story";
        const copy = document.createElement("div");
        const category = document.createElement("p");
        category.textContent = story.category;
        const headline = document.createElement("h2");
        headline.textContent = story.headline;
        const byline = document.createElement("small");
        byline.textContent = `${story.author_name} · ${availabilityLabel(story)}`;
        const state = document.createElement("span"); state.className = `story-availability ${isLive(story) ? "story-availability--live" : "story-availability--scheduled"}`; state.textContent = isLive(story) ? "Live" : "Scheduled";
        copy.append(category, headline, byline, state);
        const position = document.createElement("label");
        position.innerHTML = `<span>Homepage position</span>`;
        const select = document.createElement("select");
        select.dataset.storyId = story.id;
        for (const [value, label] of [["", "Not featured"], ["1", "Lead story"], ["2", "Supporting story 1"], ["3", "Supporting story 2"]]) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = label;
          option.selected = story.homepage_order === Number(value) || (value === "1" && story.is_featured);
          select.append(option);
        }
        position.append(select);
        select.addEventListener("change", () => {
          const nextOrder = select.value ? Number(select.value) : null;
          if (nextOrder) {
            for (const other of stories) { if (other.id !== story.id && other.homepage_order === nextOrder) other.homepage_order = null; }
          }
          story.homepage_order = nextOrder;
          render();
        });
        row.append(copy, position);
        list.append(row);
      }
      if (empty) empty.hidden = stories.length > 0;
      renderPreview();
    }

    async function verifyAdmin() {
      const { data: { user } } = await supabaseBrowser.auth.getUser();
      if (!user) return false;
      const { data } = await supabaseBrowser.from("admin_users").select("user_id").eq("user_id", user.id).maybeSingle();
      return Boolean(data);
    }

    async function initialize() {
      if (!(await verifyAdmin())) {
        window.location.replace("/admin/articles/new");
        return;
      }
      const [candidateResult, placedResult] = await Promise.all([
        supabaseBrowser.from("gazette_articles")
          .select("id, headline, category, author_name, status, published_at, is_featured, homepage_order")
          .in("status", ["published", "scheduled"])
          .neq("category", "Commissioner's Corner")
          .order("published_at", { ascending: false }),
        supabaseBrowser.from("gazette_articles").select("id,status,category").not("homepage_order", "is", null),
      ]);
      loading?.setAttribute("hidden", "");
      if (page) page.hidden = false;
      if (candidateResult.error) { setMessage(`Unable to load stories: ${candidateResult.error.message}`, "error"); return; }
      stories = (candidateResult.data ?? []) as Story[];
      const candidateIds = new Set(stories.map((story) => story.id));
      stalePlacementIds = (placedResult.data ?? []).filter((story) => !candidateIds.has(story.id)).map((story) => story.id);
      if (warning) {
        warning.hidden = stalePlacementIds.length === 0;
        warning.textContent = stalePlacementIds.length ? `${stalePlacementIds.length} unavailable homepage placement${stalePlacementIds.length === 1 ? " was" : "s were"} found. Saving will remove ${stalePlacementIds.length === 1 ? "it" : "them"}.` : "";
      }
      render();
    }

    saveButton?.addEventListener("click", async () => {
      const selects = Array.from(document.querySelectorAll<HTMLSelectElement>("[data-story-id]"));
      const chosen = selects.map((select) => select.value).filter(Boolean);
      if (new Set(chosen).size !== chosen.length) { setMessage("Each homepage position can be used only once.", "error"); return; }
      saveButton.disabled = true;
      saveButton.textContent = "Saving…";
      const results = await Promise.all([...selects.map((select) => {
        const order = select.value ? Number(select.value) : null;
        return supabaseBrowser.from("gazette_articles").update({ homepage_order: order, is_featured: order === 1 }).eq("id", select.dataset.storyId!);
      }), ...stalePlacementIds.map((id) => supabaseBrowser.from("gazette_articles").update({ homepage_order: null, is_featured: false }).eq("id", id))]);
      saveButton.disabled = false;
      saveButton.textContent = "Save homepage";
      const failure = results.find((result) => result.error);
      if (!failure?.error) { stalePlacementIds = []; if (warning) warning.hidden = true; }
      setMessage(failure?.error ? `Unable to save homepage: ${failure.error.message}` : "Homepage curation saved.", failure?.error ? "error" : "success");
    });

    initialize();
  </script>
</AdminLayout>

<style>
  .curation-loading { min-height: 20rem; display: grid; place-items: center; }
  .curation-loading[hidden] { display: none; }
  .curation-page { display: grid; gap: var(--space-6); }
  .curation-header { display: flex; align-items: end; justify-content: space-between; gap: var(--space-5); }
  .curation-header h1 { margin-bottom: var(--space-2); }
  .curation-header p:last-child { max-width: 44rem; color: var(--color-ink-soft); }
  .curation-header button { min-height:2.8rem;padding:.8rem 1.1rem;border:1px solid var(--color-green,#315c45);border-radius:.55rem;background:var(--color-green,#315c45);color:#fff;font:inherit;font-weight:800;white-space:nowrap;cursor:pointer;box-shadow:0 .35rem 1rem rgb(24 35 29 / 16%); }
  .curation-header button:hover { filter:brightness(1.1); }
  .curation-header button:focus-visible { outline:3px solid color-mix(in srgb,var(--color-green,#315c45) 35%,transparent);outline-offset:3px; }
  .curation-header button:disabled { cursor:wait;opacity:.65; }
  .curation-preview { overflow:hidden;border:1px solid var(--color-rule-dark);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card); }
  .curation-preview__heading { padding:1.25rem 1.5rem;border-bottom:1px solid var(--color-rule); }
  .curation-preview__heading h2 { margin:.2rem 0;font-size:clamp(1.8rem,4vw,2.8rem); }
  .curation-preview__heading small { color:var(--color-ink-soft); }
  .curation-preview__layout { display:grid;grid-template-columns:minmax(0,1.6fr) minmax(16rem,.8fr);min-height:18rem; }
  .curation-preview__rail { display:grid;grid-template-rows:repeat(2,minmax(0,1fr));border-left:1px solid var(--color-rule); }
  .preview-slot { display:flex;align-items:flex-start;flex-direction:column;justify-content:center;gap:.6rem;padding:1.4rem; }
  .preview-slot + .preview-slot { border-top:1px solid var(--color-rule); }
  .preview-slot--lead { padding:clamp(1.5rem,4vw,3rem);background:linear-gradient(145deg,color-mix(in srgb,var(--color-green) 8%,transparent),transparent 70%); }
  :global(.preview-slot__position) { margin:0;color:var(--color-green);font-size:.65rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase; }
  :global(.preview-slot h3) { margin:0;font-size:clamp(1.2rem,2.5vw,2.2rem);line-height:1.05; }
  :global(.preview-slot small) { color:var(--color-ink-soft); }
  :global(.preview-slot__empty) { color:var(--color-ink-soft);font-family:var(--font-display);font-size:1.2rem;font-style:italic; }
  .curation-warning { padding:1rem 1.15rem;border:1px solid #d3b26a;border-radius:.6rem;background:#fff7df;color:#6d521a; }
  .curation-warning[hidden] { display:none; }
  .curation-list { display: grid; gap: .75rem; }
  :global(.curation-story) { display: grid; grid-template-columns: 1fr minmax(12rem, 16rem); gap: 1rem; align-items: center; padding: 1rem 1.15rem; border: 1px solid var(--color-rule); border-radius: .75rem; background: white; }
  :global(.curation-story p) { margin: 0 0 .25rem; color: var(--color-accent); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  :global(.curation-story h2) { margin: 0 0 .3rem; font-size: 1.15rem; }
  :global(.curation-story small) { color: var(--color-ink-soft); }
  :global(.story-availability) { display:inline-flex;width:fit-content;margin-top:.65rem;padding:.2rem .45rem;border-radius:999px;font-size:.62rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase; }
  :global(.story-availability--live) { background:color-mix(in srgb,var(--color-green) 12%,transparent);color:var(--color-green); }
  :global(.story-availability--scheduled) { background:#eee7f6;color:#67468a; }
  :global(.curation-story label) { display: grid; gap: .35rem; font-size: .75rem; font-weight: 800; }
  :global(.curation-story select) { width: 100%; padding: .65rem; border: 1px solid var(--color-rule-dark); border-radius: .4rem; background: white; }
  .curation-message { min-height: 1.25rem; margin: 0; }
  .curation-message[data-type="error"] { color: #a22b25; }
  .curation-message[data-type="success"] { color: #28613d; }
  .curation-empty { padding: 3rem; text-align: center; border: 1px dashed var(--color-rule-dark); }
  @media (max-width: 700px) { .curation-header { align-items: stretch; flex-direction: column; } .curation-preview__layout{grid-template-columns:1fr}.curation-preview__rail{border-top:1px solid var(--color-rule);border-left:0}.preview-slot--lead{min-height:13rem} :global(.curation-story) { grid-template-columns: 1fr; } }
</style>

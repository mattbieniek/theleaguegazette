---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Photo Desk | The League Gazette">
  <main id="photo-desk" class="admin-shell photo-desk" hidden>
    <header class="photo-header"><div><p class="eyebrow">Publication</p><h1>Photo Desk</h1><p>Review story artwork, image descriptions, and articles still waiting for a featured image.</p></div><a href="/admin/articles/new">Create story</a></header>
    <section id="photo-summary" class="photo-summary" aria-label="Artwork summary"></section>
    <div class="photo-toolbar"><label class="photo-search">Find artwork or story<input id="photo-search" type="search" placeholder="Headline, category, author, or image description" /></label><label>Show<select id="photo-filter"><option value="artwork">Artwork library</option><option value="missing-alt">Missing alt text</option><option value="missing-image">Stories without artwork</option></select></label></div>
    <p id="photo-message" class="photo-message" role="status" aria-live="polite"></p>
    <section id="photo-grid" class="photo-grid" aria-label="Story artwork"></section>
    <section id="photo-empty" class="photo-empty" hidden><h2>Nothing to review</h2><p>No stories match the current Photo Desk filter.</p></section>
  </main>
  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    type Article={id:string;slug:string;headline:string;category:string;author_name:string;status:string;image_url:string|null;image_alt:string|null;updated_at:string};const page=document.querySelector<HTMLElement>("#photo-desk");const summary=document.querySelector<HTMLElement>("#photo-summary");const grid=document.querySelector<HTMLElement>("#photo-grid");const empty=document.querySelector<HTMLElement>("#photo-empty");const search=document.querySelector<HTMLInputElement>("#photo-search");const filter=document.querySelector<HTMLSelectElement>("#photo-filter");const message=document.querySelector<HTMLElement>("#photo-message");let articles:Article[]=[];
    function setMessage(text:string,error=false){if(message){message.textContent=text;message.dataset.error=String(error)}}function stat(label:string,value:string){const item=document.createElement("div"),small=document.createElement("span"),strong=document.createElement("strong");small.textContent=label;strong.textContent=value;item.append(small,strong);return item}function normalize(value:string|null){return value?.trim().toLowerCase()??""}
    function render(){if(!grid||!empty)return;const mode=filter?.value??"artwork",query=normalize(search?.value??"");let visible=articles.filter(article=>mode==="artwork"?Boolean(article.image_url):mode==="missing-alt"?Boolean(article.image_url&&!article.image_alt):!article.image_url).filter(article=>!query||[article.headline,article.category,article.author_name,article.image_alt].some(value=>normalize(value).includes(query)));grid.replaceChildren();for(const article of visible){const card=document.createElement("article");card.className="photo-card";if(article.image_url){const image=document.createElement("img");image.src=article.image_url;image.alt=article.image_alt??"";image.loading="lazy";card.append(image)}else{const placeholder=document.createElement("div");placeholder.className="photo-card__placeholder";placeholder.textContent="No artwork";card.append(placeholder)}const body=document.createElement("div");body.className="photo-card__body";const meta=document.createElement("p");meta.textContent=`${article.category} · ${article.status.replaceAll("_"," ")}`;const title=document.createElement("h2");title.textContent=article.headline;const alt=document.createElement("p");alt.className="photo-card__alt";alt.textContent=article.image_url?(article.image_alt||"Alternative text is missing."):"Open the story editor to upload featured artwork.";if(article.image_url&&!article.image_alt)alt.dataset.warning="true";const actions=document.createElement("div");actions.className="photo-card__actions";const edit=document.createElement("a");edit.href=`/admin/articles/${article.id}`;edit.textContent=article.image_url?"Edit artwork":"Add artwork";actions.append(edit);if(article.image_url){const copy=document.createElement("button");copy.type="button";copy.textContent="Copy image URL";copy.addEventListener("click",async()=>{await navigator.clipboard.writeText(article.image_url!);setMessage("Image URL copied.")});actions.append(copy)}body.append(meta,title,alt,actions);card.append(body);grid.append(card)}empty.hidden=visible.length>0;grid.hidden=visible.length===0}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}setMessage("Loading artwork…");const{data,error}=await supabaseBrowser.from("gazette_articles").select("id,slug,headline,category,author_name,status,image_url,image_alt,updated_at").neq("status","archived").order("updated_at",{ascending:false});if(page)page.hidden=false;if(error){setMessage(error.message,true);return}articles=(data??[]) as Article[];const withImages=articles.filter(article=>article.image_url);const uniqueImages=new Set(withImages.map(article=>article.image_url)).size;const missingAlt=withImages.filter(article=>!article.image_alt).length;const missingImage=articles.filter(article=>!article.image_url).length;summary?.replaceChildren(stat("Artwork in use",String(uniqueImages)),stat("Stories with images",String(withImages.length)),stat("Missing alt text",String(missingAlt)),stat("Needs artwork",String(missingImage)));setMessage("");render()}
    search?.addEventListener("input",render);filter?.addEventListener("change",render);void initialize();
  </script>
</AdminLayout>
<style>
  .photo-desk{display:grid;gap:1.5rem}.photo-desk[hidden],.photo-empty[hidden],.photo-grid[hidden]{display:none}.photo-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.photo-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.photo-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.photo-header>a{padding:.75rem 1rem;border-radius:.45rem;background:var(--color-green);color:#fff;font-weight:750;text-decoration:none}.photo-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid var(--color-rule);background:var(--color-rule)}.photo-summary>div{display:grid;gap:.35rem;padding:1rem;background:var(--color-surface)}.photo-summary span{color:var(--color-ink-soft);font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.photo-toolbar{display:flex;align-items:end;gap:1rem;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface)}.photo-toolbar label{display:grid;gap:.35rem;font-weight:750}.photo-search{flex:1}.photo-toolbar input,.photo-toolbar select{min-height:2.65rem;padding:.6rem;border:1px solid var(--color-rule-dark);background:#fff}.photo-message{min-height:1.25rem;margin:0;color:var(--color-green)}.photo-message[data-error="true"]{color:#a32320}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.photo-card{overflow:hidden;border:1px solid var(--color-rule);background:var(--color-surface);box-shadow:var(--shadow-card)}.photo-card>img,.photo-card__placeholder{width:100%;aspect-ratio:16/9;object-fit:cover;background:#e9e5dc}.photo-card__placeholder{display:grid;place-items:center;color:var(--color-ink-soft);font-family:var(--font-display);font-size:1.4rem}.photo-card__body{display:grid;gap:.6rem;padding:1rem}.photo-card p,.photo-card h2{margin:0}.photo-card__body>p:first-child{color:var(--color-ink-soft);font-size:.68rem;font-weight:800;text-transform:uppercase}.photo-card h2{font-size:1.35rem}.photo-card__alt{color:var(--color-ink-soft);font-size:.8rem;line-height:1.45}.photo-card__alt[data-warning="true"]{color:#a32320;font-weight:750}.photo-card__actions{display:flex;gap:.5rem;padding-top:.4rem}.photo-card__actions a,.photo-card__actions button{padding:.55rem .7rem;border:1px solid var(--color-rule-dark);background:#fff;color:inherit;font:inherit;font-size:.75rem;font-weight:750;text-decoration:none}.photo-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:950px){.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.photo-header,.photo-toolbar{align-items:flex-start;flex-direction:column}.photo-summary,.photo-grid{grid-template-columns:1fr}.photo-toolbar label{width:100%}}
</style>

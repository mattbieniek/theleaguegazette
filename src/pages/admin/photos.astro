---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Photo Desk | The League Gazette">
  <main id="photo-desk" class="admin-shell photo-desk" hidden>
    <header class="photo-header">
      <div>
        <p class="eyebrow">Publication</p>
        <h1>Photo Desk</h1>
        <p>
          Upload, organize, and review the artwork that supports Gazette
          stories. Standalone photos can be prepared here before they are
          attached to a story.
        </p>
      </div>
      <a href="/admin/articles/new">Create story</a>
    </header>

    <section class="photo-upload-panel" aria-labelledby="photo-upload-title">
      <div class="photo-upload-panel__heading">
        <div>
          <p class="eyebrow">New artwork</p>
          <h2 id="photo-upload-title">Add a photo to the desk</h2>
        </div>
        <p>
          Save artwork independently now, then choose it from the story editor
          whenever it is ready to publish.
        </p>
      </div>

      <form id="photo-upload-form" class="photo-upload-form">
        <div class="photo-upload-fields">
          <label>
            <span>Photo title</span>
            <input id="photo-title" name="title" type="text" required maxlength="160" placeholder="A short, useful name" />
          </label>
          <label>
            <span>Alternative text</span>
            <textarea id="photo-alt" name="image_alt" rows="3" required maxlength="300" placeholder="Describe what readers should know about the image"></textarea>
          </label>
          <label>
            <span>Caption <small>(optional)</small></span>
            <textarea id="photo-caption" name="caption" rows="3" maxlength="300" placeholder="Add context that can accompany the image"></textarea>
          </label>
        </div>

        <div class="photo-upload-form__footer">
          <div class="photo-upload-file">
            <input id="photo-file" class="sr-only" type="file" accept="image/jpeg,image/png,image/webp" required />
            <button id="photo-file-button" class="photo-button photo-button--secondary" type="button">Choose photo</button>
            <span id="photo-file-name">No photo selected</span>
          </div>
          <button id="photo-upload-button" class="photo-button photo-button--primary" type="submit">Upload to Photo Desk</button>
        </div>
        <small class="photo-upload-help">JPEG, PNG, or WebP up to 6 MB. Recommended: 1600 × 900 px (16:9).</small>
      </form>
    </section>

    <section id="photo-summary" class="photo-summary" aria-label="Artwork summary"></section>

    <div class="photo-toolbar">
      <label class="photo-search">
        Find artwork or story
        <input id="photo-search" type="search" placeholder="Title, story, category, caption, or image description" />
      </label>
      <label>
        Show
        <select id="photo-filter">
          <option value="all">All artwork</option>
          <option value="standalone">Standalone photos</option>
          <option value="artwork">Story artwork</option>
          <option value="missing-alt">Missing alt text</option>
          <option value="missing-image">Stories without artwork</option>
        </select>
      </label>
    </div>

    <p id="photo-message" class="photo-message" role="status" aria-live="polite"></p>
    <section id="photo-grid" class="photo-grid" aria-label="Photo Desk artwork"></section>
    <section id="photo-empty" class="photo-empty" hidden>
      <h2>Nothing to review</h2>
      <p>No artwork matches the current Photo Desk filter.</p>
    </section>
  </main>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";

    type Article = {
      id: string;
      slug: string;
      headline: string;
      category: string;
      author_name: string;
      status: string;
      image_url: string | null;
      image_alt: string | null;
      body: unknown;
      updated_at: string;
    };

    type Photo = {
      id: string;
      title: string;
      caption: string | null;
      image_alt: string;
      image_url: string;
      storage_path: string;
      updated_at: string;
    };

    const IMAGE_BUCKET = "gazette-images";
    const MAX_IMAGE_SIZE = 6 * 1024 * 1024;
    const ALLOWED_IMAGE_TYPES = new Set([
      "image/jpeg",
      "image/png",
      "image/webp",
    ]);

    const page = document.querySelector<HTMLElement>("#photo-desk");
    const summary = document.querySelector<HTMLElement>("#photo-summary");
    const grid = document.querySelector<HTMLElement>("#photo-grid");
    const empty = document.querySelector<HTMLElement>("#photo-empty");
    const search = document.querySelector<HTMLInputElement>("#photo-search");
    const filter = document.querySelector<HTMLSelectElement>("#photo-filter");
    const message = document.querySelector<HTMLElement>("#photo-message");
    const uploadForm = document.querySelector<HTMLFormElement>("#photo-upload-form");
    const photoTitle = document.querySelector<HTMLInputElement>("#photo-title");
    const photoAlt = document.querySelector<HTMLTextAreaElement>("#photo-alt");
    const photoCaption = document.querySelector<HTMLTextAreaElement>("#photo-caption");
    const photoFile = document.querySelector<HTMLInputElement>("#photo-file");
    const photoFileButton = document.querySelector<HTMLButtonElement>("#photo-file-button");
    const photoFileName = document.querySelector<HTMLElement>("#photo-file-name");
    const photoUploadButton = document.querySelector<HTMLButtonElement>("#photo-upload-button");
    let articles: Article[] = [];
    let photos: Photo[] = [];

    function setMessage(text: string, error = false): void {
      if (!message) return;
      message.textContent = text;
      message.dataset.error = String(error);
    }

    function stat(label: string, value: string): HTMLElement {
      const item = document.createElement("div");
      const small = document.createElement("span");
      const strong = document.createElement("strong");
      small.textContent = label;
      strong.textContent = value;
      item.append(small, strong);
      return item;
    }

    function normalize(value: string | null | undefined): string {
      return value?.trim().toLowerCase() ?? "";
    }

    function formatDate(value: string): string {
      return new Intl.DateTimeFormat("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(new Date(value));
    }

    function photoIsUsed(photo: Photo): boolean {
      return articles.some((article) =>
        article.image_url === photo.image_url ||
        JSON.stringify(article.body ?? {}).includes(photo.image_url),
      );
    }

    function appendCopyButton(actions: HTMLElement, imageUrl: string): void {
      const copy = document.createElement("button");
      copy.type = "button";
      copy.className = "photo-card__button";
      copy.textContent = "Copy image URL";
      copy.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(imageUrl);
          setMessage("Image URL copied.");
        } catch {
          setMessage("Unable to copy the image URL.", true);
        }
      });
      actions.append(copy);
    }

    function renderArticleCard(article: Article): HTMLElement {
      const card = document.createElement("article");
      card.className = "photo-card";
      if (article.image_url) {
        const image = document.createElement("img");
        image.src = article.image_url;
        image.alt = article.image_alt ?? "";
        image.loading = "lazy";
        card.append(image);
      } else {
        const placeholder = document.createElement("div");
        placeholder.className = "photo-card__placeholder";
        placeholder.textContent = "No artwork";
        card.append(placeholder);
      }

      const body = document.createElement("div");
      body.className = "photo-card__body";
      const meta = document.createElement("p");
      meta.className = "photo-card__meta";
      meta.textContent = `${article.category} · ${article.status.replaceAll("_", " ")}`;
      const title = document.createElement("h2");
      title.textContent = article.headline;
      const alt = document.createElement("p");
      alt.className = "photo-card__alt";
      alt.textContent = article.image_url
        ? article.image_alt || "Alternative text is missing."
        : "Open the story editor to upload featured artwork.";
      if (article.image_url && !article.image_alt) alt.dataset.warning = "true";
      const actions = document.createElement("div");
      actions.className = "photo-card__actions";
      const edit = document.createElement("a");
      edit.href = `/admin/articles/${article.id}`;
      edit.className = "photo-card__button photo-card__button--link";
      edit.textContent = article.image_url ? "Edit artwork" : "Add artwork";
      actions.append(edit);
      if (article.image_url) appendCopyButton(actions, article.image_url);
      body.append(meta, title, alt, actions);
      const date = document.createElement("small");
      date.className = "photo-card__date";
      date.textContent = `Updated ${formatDate(article.updated_at)}`;
      body.append(date);
      card.append(body);
      return card;
    }

    function renderPhotoCard(photo: Photo): HTMLElement {
      const card = document.createElement("article");
      card.className = "photo-card photo-card--standalone";
      const image = document.createElement("img");
      image.src = photo.image_url;
      image.alt = photo.image_alt;
      image.loading = "lazy";
      card.append(image);

      const body = document.createElement("div");
      body.className = "photo-card__body";
      const meta = document.createElement("p");
      meta.className = "photo-card__meta photo-card__meta--standalone";
      meta.textContent = "Standalone photo";
      const title = document.createElement("h2");
      title.textContent = photo.title;
      const description = document.createElement("p");
      description.className = "photo-card__alt";
      description.textContent = photo.caption || photo.image_alt;
      const actions = document.createElement("div");
      actions.className = "photo-card__actions";
      appendCopyButton(actions, photo.image_url);
      const remove = document.createElement("button");
      remove.type = "button";
      remove.className = "photo-card__button photo-card__button--danger";
      remove.textContent = "Delete photo";
      remove.addEventListener("click", () => void deletePhoto(photo));
      remove.disabled = photoIsUsed(photo);
      remove.title = photoIsUsed(photo)
        ? "This photo is in use by a story and cannot be deleted."
        : "Delete this standalone photo";
      actions.append(remove);
      const date = document.createElement("small");
      date.className = "photo-card__date";
      date.textContent = `Added ${formatDate(photo.updated_at)}`;
      body.append(meta, title, description, actions, date);
      card.append(body);
      return card;
    }

    function render(): void {
      if (!grid || !empty) return;
      const mode = filter?.value ?? "all";
      const query = normalize(search?.value ?? "");
      const visibleArticles = articles
        .filter((article) => {
          if (mode === "standalone") return false;
          if (mode === "artwork") return Boolean(article.image_url);
          if (mode === "missing-alt") return Boolean(article.image_url && !article.image_alt);
          if (mode === "missing-image") return !article.image_url;
          return true;
        })
        .filter((article) =>
          !query ||
          [article.headline, article.category, article.author_name, article.image_alt]
            .some((value) => normalize(value).includes(query)),
        );
      const visiblePhotos = photos
        .filter((photo) => mode === "all" || mode === "standalone" || (mode === "missing-alt" && !photo.image_alt))
        .filter((photo) =>
          !query ||
          [photo.title, photo.caption, photo.image_alt]
            .some((value) => normalize(value).includes(query)),
        );
      grid.replaceChildren(
        ...visibleArticles.map(renderArticleCard),
        ...visiblePhotos.map(renderPhotoCard),
      );
      const visibleCount = visibleArticles.length + visiblePhotos.length;
      empty.hidden = visibleCount > 0;
      grid.hidden = visibleCount === 0;
    }

    function updateSummary(): void {
      const storyImages = articles.filter((article) => article.image_url);
      const missingAlt = storyImages.filter((article) => !article.image_alt).length + photos.filter((photo) => !photo.image_alt).length;
      summary?.replaceChildren(
        stat("Standalone photos", String(photos.length)),
        stat("Story artwork", String(storyImages.length)),
        stat("Missing alt text", String(missingAlt)),
        stat("Stories needing artwork", String(articles.filter((article) => !article.image_url).length)),
      );
    }

    function getFileExtension(file: File): string {
      return file.type === "image/jpeg" ? "jpg" : file.type.split("/")[1] ?? "jpg";
    }

    function validateFile(file: File): string | null {
      if (!ALLOWED_IMAGE_TYPES.has(file.type)) return "Choose a JPEG, PNG, or WebP image.";
      if (file.size > MAX_IMAGE_SIZE) return "The selected image is larger than 6 MB.";
      return null;
    }

    async function deletePhoto(photo: Photo): Promise<void> {
      if (photoIsUsed(photo)) {
        setMessage("This photo is already used by a story and cannot be deleted.", true);
        return;
      }
      if (!window.confirm(`Delete “${photo.title}” from the Photo Desk? This cannot be undone.`)) return;
      setMessage("Deleting photo…");
      const { error: rowError } = await supabaseBrowser.from("gazette_photos").delete().eq("id", photo.id);
      if (rowError) {
        setMessage(`Unable to delete photo: ${rowError.message}`, true);
        return;
      }
      const { error: storageError } = await supabaseBrowser.storage.from(IMAGE_BUCKET).remove([photo.storage_path]);
      photos = photos.filter((item) => item.id !== photo.id);
      updateSummary();
      render();
      setMessage(storageError ? "Photo record deleted, but its stored file could not be removed." : "Photo deleted.", Boolean(storageError));
    }

    async function uploadPhoto(event: SubmitEvent): Promise<void> {
      event.preventDefault();
      const file = photoFile?.files?.[0];
      const title = photoTitle?.value.trim() ?? "";
      const imageAlt = photoAlt?.value.trim() ?? "";
      const caption = photoCaption?.value.trim() ?? "";
      if (!file) {
        setMessage("Choose a photo before uploading.", true);
        return;
      }
      const validationError = validateFile(file);
      if (validationError) {
        setMessage(validationError, true);
        return;
      }
      if (!title || !imageAlt) {
        setMessage("Add a title and alternative text before uploading.", true);
        return;
      }
      if (photoUploadButton) {
        photoUploadButton.disabled = true;
        photoUploadButton.textContent = "Uploading…";
      }
      setMessage("Uploading photo…");
      const photoId = crypto.randomUUID();
      const storagePath = `photos/${photoId}.${getFileExtension(file)}`;
      const { error: uploadError } = await supabaseBrowser.storage.from(IMAGE_BUCKET).upload(storagePath, file, {
        cacheControl: "3600",
        contentType: file.type,
        upsert: false,
      });
      if (uploadError) {
        if (photoUploadButton) {
          photoUploadButton.disabled = false;
          photoUploadButton.textContent = "Upload to Photo Desk";
        }
        setMessage(`Unable to upload photo: ${uploadError.message}`, true);
        return;
      }
      const { data: publicUrlData } = supabaseBrowser.storage.from(IMAGE_BUCKET).getPublicUrl(storagePath);
      const imageUrl = publicUrlData.publicUrl;
      const { data: userData } = await supabaseBrowser.auth.getUser();
      const { data, error: rowError } = await supabaseBrowser.from("gazette_photos").insert({
        id: photoId,
        title,
        caption: caption || null,
        image_alt: imageAlt,
        image_url: imageUrl,
        storage_path: storagePath,
        created_by: userData.user?.id ?? null,
      }).select("id,title,caption,image_alt,image_url,storage_path,updated_at").single();
      if (rowError || !data) {
        await supabaseBrowser.storage.from(IMAGE_BUCKET).remove([storagePath]);
        if (photoUploadButton) {
          photoUploadButton.disabled = false;
          photoUploadButton.textContent = "Upload to Photo Desk";
        }
        setMessage(`The file uploaded, but its Photo Desk record could not be saved: ${rowError?.message ?? "Unknown error"}`, true);
        return;
      }
      photos = [data as Photo, ...photos];
      uploadForm?.reset();
      if (photoFileName) photoFileName.textContent = "No photo selected";
      if (photoUploadButton) {
        photoUploadButton.disabled = false;
        photoUploadButton.textContent = "Upload to Photo Desk";
      }
      updateSummary();
      if (filter) filter.value = "standalone";
      render();
      setMessage("Photo added to the Photo Desk.");
    }

    async function initialize(): Promise<void> {
      const { data: { user } } = await supabaseBrowser.auth.getUser();
      if (!user) {
        window.location.replace("/admin/login");
        return;
      }
      const { data: admin } = await supabaseBrowser.from("admin_users").select("user_id").eq("user_id", user.id).maybeSingle();
      if (!admin) {
        window.location.replace("/admin/articles");
        return;
      }
      setMessage("Loading artwork…");
      const [articleResult, photoResult] = await Promise.all([
        supabaseBrowser.from("gazette_articles").select("id,slug,headline,category,author_name,status,image_url,image_alt,body,updated_at").neq("status", "archived").order("updated_at", { ascending: false }),
        supabaseBrowser.from("gazette_photos").select("id,title,caption,image_alt,image_url,storage_path,updated_at").order("updated_at", { ascending: false }),
      ]);
      if (page) page.hidden = false;
      if (articleResult.error || photoResult.error) {
        setMessage(`Unable to load the Photo Desk: ${articleResult.error?.message ?? photoResult.error?.message ?? "Unknown error"}`, true);
        return;
      }
      articles = (articleResult.data ?? []) as Article[];
      photos = (photoResult.data ?? []) as Photo[];
      updateSummary();
      setMessage("");
      render();
    }

    photoFileButton?.addEventListener("click", () => photoFile?.click());
    photoFile?.addEventListener("change", () => {
      if (photoFileName) photoFileName.textContent = photoFile.files?.[0]?.name ?? "No photo selected";
    });
    uploadForm?.addEventListener("submit", (event) => void uploadPhoto(event));
    search?.addEventListener("input", render);
    filter?.addEventListener("change", render);
    void initialize();
  </script>
</AdminLayout>

<style>
  .photo-desk{display:grid;gap:1.5rem}.photo-desk[hidden],.photo-empty[hidden],.photo-grid[hidden]{display:none}.photo-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.photo-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.photo-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.photo-header>a{padding:.75rem 1rem;border-radius:.45rem;background:var(--color-green);color:#fff;font-weight:750;text-decoration:none}.photo-upload-panel{display:grid;gap:1.25rem;padding:clamp(1.25rem,3vw,2rem);border:1px solid var(--color-rule-dark);border-top:5px solid var(--color-green);background:linear-gradient(145deg,color-mix(in srgb,var(--color-green) 6%,var(--color-surface)),var(--color-surface) 65%)}.photo-upload-panel__heading{display:flex;align-items:end;justify-content:space-between;gap:2rem}.photo-upload-panel__heading h2{margin:.2rem 0 0;font-size:clamp(1.8rem,4vw,3rem)}.photo-upload-panel__heading>p{max-width:34rem;margin:0;color:var(--color-ink-soft)}.photo-upload-form{display:grid;gap:1rem}.photo-upload-fields{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.photo-upload-fields label{display:grid;gap:.4rem;font-weight:750}.photo-upload-fields label>span{font-size:.78rem}.photo-upload-fields label small{color:var(--color-ink-soft);font-weight:500}.photo-upload-fields input,.photo-upload-fields textarea{width:100%;padding:.7rem;border:1px solid var(--color-rule-dark);background:#fff;font:inherit}.photo-upload-form__footer{display:flex;align-items:center;justify-content:space-between;gap:1rem}.photo-upload-file{display:flex;align-items:center;gap:.7rem;min-width:0;color:var(--color-ink-soft);font-size:.8rem}.photo-upload-file span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.photo-upload-help{color:var(--color-ink-soft)}.photo-button{min-height:2.7rem;padding:.65rem .9rem;border:1px solid var(--color-rule-dark);font:inherit;font-size:.78rem;font-weight:800;cursor:pointer}.photo-button:disabled,.photo-card__button:disabled{cursor:not-allowed;opacity:.55}.photo-button--secondary{background:#fff;color:var(--color-ink)}.photo-button--primary{border-color:var(--color-green);background:var(--color-green);color:#fff}.photo-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid var(--color-rule);background:var(--color-rule)}.photo-summary>div{display:grid;gap:.35rem;padding:1rem;background:var(--color-surface)}.photo-summary span{color:var(--color-ink-soft);font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.photo-toolbar{display:flex;align-items:end;gap:1rem;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface)}.photo-toolbar label{display:grid;gap:.35rem;font-weight:750}.photo-search{flex:1}.photo-toolbar input,.photo-toolbar select{min-height:2.65rem;padding:.6rem;border:1px solid var(--color-rule-dark);background:#fff}.photo-message{min-height:1.25rem;margin:0;color:var(--color-green)}.photo-message[data-error="true"]{color:#a32320}.photo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.photo-card{overflow:hidden;border:1px solid var(--color-rule);background:var(--color-surface);box-shadow:var(--shadow-card)}.photo-card>img,.photo-card__placeholder{width:100%;aspect-ratio:16/9;object-fit:cover;background:#e9e5dc}.photo-card__placeholder{display:grid;place-items:center;color:var(--color-ink-soft);font-family:var(--font-display);font-size:1.4rem}.photo-card__body{display:grid;gap:.6rem;padding:1rem}.photo-card p,.photo-card h2{margin:0}.photo-card__meta{color:var(--color-ink-soft);font-size:.68rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase}.photo-card__meta--standalone{color:var(--color-green)}.photo-card h2{font-size:1.35rem}.photo-card__alt{color:var(--color-ink-soft);font-size:.8rem;line-height:1.45}.photo-card__alt[data-warning="true"]{color:#a32320;font-weight:750}.photo-card__actions{display:flex;flex-wrap:wrap;gap:.5rem;padding-top:.4rem}.photo-card__button{padding:.55rem .7rem;border:1px solid var(--color-rule-dark);background:#fff;color:inherit;font:inherit;font-size:.75rem;font-weight:750;text-decoration:none;cursor:pointer}.photo-card__button--link{display:inline-block}.photo-card__button--danger{border-color:#a32320;color:#8e2620}.photo-card__date{color:var(--color-ink-muted);font-family:var(--font-data);font-size:.62rem;text-transform:uppercase}.photo-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:950px){.photo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.photo-upload-fields{grid-template-columns:1fr 1fr}.photo-upload-fields label:first-child{grid-column:1/-1}}@media(max-width:650px){.photo-header,.photo-toolbar,.photo-upload-panel__heading,.photo-upload-form__footer{align-items:flex-start;flex-direction:column}.photo-summary,.photo-grid,.photo-upload-fields{grid-template-columns:1fr}.photo-upload-fields label:first-child{grid-column:auto}.photo-toolbar label{width:100%}.photo-upload-form__footer{width:100%}.photo-upload-button{width:100%}}
</style>

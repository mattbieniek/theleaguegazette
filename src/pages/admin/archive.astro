---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Archive | The League Gazette">
  <main id="archive-desk" class="admin-shell archive-desk" hidden>
    <header class="archive-header">
      <div><p class="eyebrow">League operations</p><h1>Archive</h1><p>Review historical coverage across seasons, matchups, drafts, and the transaction ledger.</p></div>
      <a href="/history" target="_blank" rel="noreferrer">View public archive ↗</a>
    </header>

    <section id="archive-summary" class="archive-summary" aria-label="Archive summary"></section>
    <section class="archive-destinations" aria-label="Public archive destinations">
      <a href="/history" target="_blank" rel="noreferrer"><span>Season archive</span><strong id="history-count">—</strong><small>seasons recorded ↗</small></a>
      <a href="/records" target="_blank" rel="noreferrer"><span>Record book</span><strong id="matchup-count">—</strong><small>completed matchups ↗</small></a>
      <a href="/draft" target="_blank" rel="noreferrer"><span>Draft archive</span><strong id="draft-count">—</strong><small>draft editions ↗</small></a>
      <a href="/transactions" target="_blank" rel="noreferrer"><span>Transaction ledger</span><strong id="transaction-count">—</strong><small>completed moves ↗</small></a>
    </section>

    <div class="archive-toolbar">
      <div><h2>Season coverage</h2><p>Counts reflect material currently available to the public archive.</p></div>
      <button id="refresh-archive" type="button">Refresh archive sources</button>
    </div>
    <p id="archive-message" class="archive-message" role="status" aria-live="polite"></p>
    <section id="season-grid" class="season-grid" aria-label="Archive coverage by season"></section>
    <section id="archive-empty" class="archive-empty" hidden><h2>No archived seasons found</h2><p>Sync Sleeper league data to begin building the historical record.</p></section>
  </main>

  <script>
    import { supabaseBrowser } from "../../lib/supabase-browser";
    type SeasonRow={id:string;year:number;status:string;total_rosters:number|null;updated_at:string};
    type Coverage={season:SeasonRow;teams:number;matchups:Set<string>;weeks:Set<number>;drafts:Set<string>;picks:number;transactions:number};
    const page=document.querySelector<HTMLElement>("#archive-desk");const summary=document.querySelector<HTMLElement>("#archive-summary");const seasonGrid=document.querySelector<HTMLElement>("#season-grid");const empty=document.querySelector<HTMLElement>("#archive-empty");const message=document.querySelector<HTMLElement>("#archive-message");const refreshButton=document.querySelector<HTMLButtonElement>("#refresh-archive");let leagueId="";
    function setMessage(text:string,error=false){if(message){message.textContent=text;message.dataset.error=String(error)}}
    function stat(label:string,value:string){const item=document.createElement("div");const small=document.createElement("span");small.textContent=label;const strong=document.createElement("strong");strong.textContent=value;item.append(small,strong);return item}
    function freshness(date:string){const days=Math.floor((Date.now()-new Date(date).getTime())/86400000);if(!Number.isFinite(days))return "Unknown";if(days===0)return "Today";if(days===1)return "Yesterday";return `${days} days ago`}
    async function initialize(){const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){window.location.replace("/admin/login");return}const{data:admin}=await supabaseBrowser.from("admin_users").select("user_id").eq("user_id",user.id).maybeSingle();if(!admin){window.location.replace("/admin/articles");return}setMessage("Loading archive coverage…");const[{data:seasons,error:seasonError},{data:teams},{data:results},{data:drafts},{data:transactions},{data:statusData}]=await Promise.all([supabaseBrowser.from("seasons").select("id,year,status,total_rosters,updated_at").order("year",{ascending:false}),supabaseBrowser.from("fantasy_teams").select("season_id"),supabaseBrowser.from("team_weekly_results").select("season_id,season_year,week,matchup_id,result"),supabaseBrowser.from("drafts").select("id,season_id,season_year,draft_picks(id)"),supabaseBrowser.from("league_transactions").select("id,season_id,season_year,status"),supabaseBrowser.rpc("admin_sleeper_status")]);if(page)page.hidden=false;if(seasonError){setMessage(seasonError.message,true);return}leagueId=String((statusData as any)?.league?.sleeper_league_id??"");const coverage=(seasons??[]).map((season):Coverage=>({season:season as SeasonRow,teams:(teams??[]).filter(team=>team.season_id===season.id).length,matchups:new Set<string>(),weeks:new Set<number>(),drafts:new Set<string>(),picks:0,transactions:0}));const byId=new Map(coverage.map(item=>[item.season.id,item]));const byYear=new Map(coverage.map(item=>[item.season.year,item]));for(const result of results??[]){if(!result.matchup_id||!["W","L","T"].includes(String(result.result)))continue;const item=(result.season_id?byId.get(result.season_id):undefined)??byYear.get(Number(result.season_year));if(item){item.matchups.add(String(result.matchup_id));item.weeks.add(Number(result.week))}}for(const draft of drafts??[]){const item=(draft.season_id?byId.get(draft.season_id):undefined)??byYear.get(Number(draft.season_year));if(item){item.drafts.add(String(draft.id));item.picks+=draft.draft_picks?.length??0}}for(const transaction of transactions??[]){if(transaction.status!=="complete")continue;const item=(transaction.season_id?byId.get(transaction.season_id):undefined)??byYear.get(Number(transaction.season_year));if(item)item.transactions++}render(coverage);setMessage("")}
    function render(coverage:Coverage[]){const totalMatchups=coverage.reduce((sum,item)=>sum+item.matchups.size,0);const totalDrafts=coverage.reduce((sum,item)=>sum+item.drafts.size,0);const totalTransactions=coverage.reduce((sum,item)=>sum+item.transactions,0);const earliest=coverage.at(-1)?.season.year;summary?.replaceChildren(stat("Recorded seasons",String(coverage.length)),stat("First recorded",earliest?String(earliest):"—"),stat("Completed matchups",String(totalMatchups)),stat("Last updated",coverage[0]?freshness(coverage[0].season.updated_at):"Unknown"));for(const [id,value] of [["history-count",coverage.length],["matchup-count",totalMatchups],["draft-count",totalDrafts],["transaction-count",totalTransactions]] as const){const element=document.getElementById(id);if(element)element.textContent=String(value)}if(!seasonGrid||!empty)return;seasonGrid.replaceChildren();for(const item of coverage){const expected=item.season.total_rosters??10;const issues:string[]=[];if(item.teams<expected)issues.push(`${item.teams}/${expected} teams`);if(item.matchups.size===0)issues.push("No completed matchups");if(item.drafts.size===0)issues.push("No stored draft");if(item.transactions===0)issues.push("No transactions");const card=document.createElement("article");card.className="season-review";card.dataset.health=issues.length?"attention":"ready";const heading=document.createElement("div");const label=document.createElement("p");label.textContent=`${item.season.status} season`;const title=document.createElement("h2");title.textContent=String(item.season.year);heading.append(label,title);const badge=document.createElement("span");badge.textContent=issues.length?`${issues.length} gap${issues.length===1?"":"s"}`:"Complete";const top=document.createElement("div");top.className="season-review__top";top.append(heading,badge);const stats=document.createElement("div");stats.className="season-review__stats";stats.append(stat("Teams",String(item.teams)),stat("Weeks",String(item.weeks.size)),stat("Matchups",String(item.matchups.size)),stat("Draft picks",String(item.picks)),stat("Transactions",String(item.transactions)));const footer=document.createElement("div");footer.className="season-review__footer";const note=document.createElement("p");note.textContent=issues.length?issues.join(" · "):"Core historical datasets are represented.";const link=document.createElement("a");link.href=`/history/${item.season.year}`;link.target="_blank";link.rel="noreferrer";link.textContent="View season ↗";footer.append(note,link);card.append(top,stats,footer);seasonGrid.append(card)}empty.hidden=coverage.length>0;seasonGrid.hidden=coverage.length===0}
    refreshButton?.addEventListener("click",async()=>{if(!leagueId){setMessage("The current Sleeper league is unavailable.",true);return}refreshButton.disabled=true;refreshButton.textContent="Refreshing…";setMessage("Refreshing draft and transaction archives…");for(const functionName of ["sync-sleeper-drafts","sync-sleeper-transactions"]){const{data,error}=await supabaseBrowser.functions.invoke(functionName,{body:{sleeper_league_id:leagueId}});if(error||data?.success===false){refreshButton.disabled=false;refreshButton.textContent="Refresh archive sources";setMessage(`Refresh failed: ${data?.error?.message??data?.error??error?.message}`,true);return}}window.location.reload()});void initialize();
  </script>
</AdminLayout>

<style>
  .archive-desk{display:grid;gap:1.5rem}.archive-desk[hidden],.archive-empty[hidden],.season-grid[hidden]{display:none}.archive-header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-bottom:1.5rem;border-bottom:3px double var(--color-rule-dark)}.archive-header h1{margin:.25rem 0;font-size:clamp(3rem,7vw,6rem)}.archive-header p:last-child{max-width:48rem;color:var(--color-ink-soft)}.archive-header>a,.season-review__footer a{color:var(--color-green);font-weight:750}.archive-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid var(--color-rule);background:var(--color-rule)}.archive-summary>div{display:grid;gap:.35rem;padding:1rem;background:var(--color-surface)}.archive-summary span,.season-review__stats span{color:var(--color-ink-soft);font-size:.68rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.archive-destinations{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.archive-destinations a{display:grid;gap:.35rem;padding:1.25rem;border:1px solid var(--color-rule);border-top:4px solid var(--color-green);background:var(--color-surface);color:inherit;text-decoration:none}.archive-destinations span{font-weight:750}.archive-destinations strong{font-family:var(--font-display);font-size:2.25rem}.archive-destinations small{color:var(--color-ink-soft)}.archive-toolbar{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding-top:.5rem}.archive-toolbar h2,.archive-toolbar p{margin:0}.archive-toolbar p{margin-top:.3rem;color:var(--color-ink-soft)}.archive-toolbar button{padding:.75rem 1rem;border:0;border-radius:.45rem;background:var(--color-green);color:#fff;font-weight:750}.archive-toolbar button:disabled{opacity:.55}.archive-message{min-height:1.25rem;margin:0;color:var(--color-green)}.archive-message[data-error="true"]{color:#a32320}.season-grid{display:grid;gap:1rem}.season-review{border:1px solid var(--color-rule);border-left:5px solid var(--color-green);background:var(--color-surface);box-shadow:var(--shadow-card)}.season-review[data-health="attention"]{border-left-color:#b37b22}.season-review__top,.season-review__footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem}.season-review__top p,.season-review__top h2,.season-review__footer p{margin:0}.season-review__top p{color:var(--color-ink-soft);font-size:.7rem;font-weight:800;text-transform:uppercase}.season-review__top h2{font-size:2rem}.season-review__top>span{padding:.3rem .55rem;border-radius:999px;background:#e4f0e8;color:var(--color-green);font-size:.68rem;font-weight:850;text-transform:uppercase}.season-review[data-health="attention"] .season-review__top>span{background:#fff1cf;color:#7b5717}.season-review__stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-block:1px solid var(--color-rule)}.season-review__stats>div{display:grid;gap:.35rem;padding:.85rem 1.25rem;border-right:1px solid var(--color-rule)}.season-review__stats>div:last-child{border-right:0}.season-review__footer p{color:var(--color-ink-soft);font-size:.78rem}.archive-empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:900px){.archive-destinations,.archive-summary,.season-review__stats{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.archive-header,.archive-toolbar,.season-review__top,.season-review__footer{align-items:flex-start;flex-direction:column}.archive-destinations,.archive-summary,.season-review__stats{grid-template-columns:1fr}.archive-toolbar button{width:100%}}
</style>

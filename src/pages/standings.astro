---
import StandingsTable from "../components/StandingsTable.astro";
import { getSeasonStandings } from "../lib/queries/standings";

const sleeperLeagueId = import.meta.env.PUBLIC_SLEEPER_LEAGUE_ID;

if (!sleeperLeagueId) {
  throw new Error("Missing PUBLIC_SLEEPER_LEAGUE_ID.");
}

const standings = await getSeasonStandings(sleeperLeagueId);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Standings | The League Gazette</title>
  </head>

  <body class="bg-slate-100 text-slate-950">
    <main class="mx-auto max-w-6xl px-4 py-12">
      <section class="rounded-xl bg-white p-6 shadow-sm">
        <div class="mb-6">
          <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">
            Far Far Away Football
          </p>

          <h1 class="mt-2 text-4xl font-bold">
            Season Standings
          </h1>
        </div>

        <StandingsTable standings={standings} />
      </section>
    </main>
  </body>
</html>
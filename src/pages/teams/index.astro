---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { teams } from '../../data/teams';
---
<BaseLayout title="Teams | The League Gazette"><div class="shell page"><div class="eyebrow">Franchises</div><h1>Far Far Away Football Teams</h1><p class="intro">The 2025 identities shown here use legacy artwork as temporary placeholders. Team names and branding can be replaced independently for 2026.</p><div class="team-grid">{teams.map(team=><a class="team-card card" href={`/teams/${team.slug}`} style={`--team:${team.primary};--secondary:${team.secondary}`}><div class="color"></div><img src={team.logo} alt={`${team.name} logo`}/><div><h2>{team.name}</h2><p>{team.owner}</p><small>Legacy identity: {team.legacyName}</small></div></a>)}</div></div></BaseLayout>
<style>.page{padding-top:48px}.page h1{font:700 clamp(2.7rem,6vw,5.2rem)/.95 Georgia,serif;margin:9px 0}.intro{max-width:720px;color:#555;line-height:1.6}.team-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:34px}.team-card{display:grid;grid-template-columns:7px 95px 1fr;align-items:center;gap:20px;padding:17px;overflow:hidden}.team-card:hover{transform:translateY(-2px);box-shadow:0 20px 45px rgba(0,0,0,.1)}.color{height:100%;background:var(--team)}.team-card img{width:92px;height:92px;border-radius:50%;object-fit:cover}.team-card h2{font:700 1.4rem Georgia,serif;margin:0}.team-card p{margin:5px 0}.team-card small{color:var(--muted)}@media(max-width:700px){.team-grid{grid-template-columns:1fr}.team-card{grid-template-columns:6px 72px 1fr}.team-card img{width:70px;height:70px}}</style>

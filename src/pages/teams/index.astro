---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSeasonStandings } from "../../lib/queries/standings";
import { getFormerTeamNames, teams } from "../../data/teams";

const sleeperLeagueId =
  import.meta.env.PUBLIC_SLEEPER_LEAGUE_ID;

const standings = sleeperLeagueId
  ? await getSeasonStandings(sleeperLeagueId)
  : [];

const seasonYear =
  standings.find(
    (standing) =>
      typeof standing.season_year === "number"
  )?.season_year ?? null;

function normalizeTeamName(value: string | null): string {
  return value?.trim().toLowerCase() ?? "";
}

function getTeamStanding(teamName: string) {
  return standings.find(
    (standing) =>
      normalizeTeamName(standing.team_name) ===
      normalizeTeamName(teamName)
  );
}

function formatRecord(
  wins: number | null,
  losses: number | null,
  ties: number | null
): string {
  const record = `${wins ?? 0}-${losses ?? 0}`;

  return (ties ?? 0) > 0
    ? `${record}-${ties}`
    : record;
}

function formatPoints(value: number | null): string {
  return Number(value ?? 0).toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}
---

<BaseLayout
  title="Teams"
  description="Meet the franchises and owners competing in Far Far Away Football."
>
  <div class="site-shell">
    <header class="page-header">
      <div class="page-header__title">
        <p class="eyebrow">
          {seasonYear
            ? `${seasonYear} Franchises`
            : "League Franchises"}
        </p>

        <h1>Meet the Teams</h1>
      </div>

      <div class="page-header__intro">
        <p>
          Ten franchises, ten owners and an unreasonable
          amount of emotional investment in imaginary
          football.
        </p>
      </div>
    </header>

    <section
      class="teams-section"
      aria-labelledby="teams-grid-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            Far Far Away Football
          </p>

          <h2 id="teams-grid-title">
            League Directory
          </h2>
        </div>

        <p>
          Current identities are shown with temporary legacy
          artwork. Final team branding can be substituted
          without changing the page structure.
        </p>
      </div>

      <div class="team-grid">
        {
          teams.map((team) => {
            const standing = getTeamStanding(team.name);
            const formerNames = getFormerTeamNames(team);

            const record = standing
              ? formatRecord(
                  standing.wins,
                  standing.losses,
                  standing.ties
                )
              : "—";

            const rank =
              standing?.standings_rank !== null &&
              standing?.standings_rank !== undefined
                ? `No. ${standing.standings_rank}`
                : "Unranked";

            const points =
              standing?.points_for !== null &&
              standing?.points_for !== undefined
                ? formatPoints(standing.points_for)
                : "—";

            return (
              <article
                class="team-card"
                style={`--team-color: ${team.primary}; --secondary-color: ${team.secondary};`}
              >
                <a
                  class="team-card__link"
                  href={`/teams/${team.slug}`}
                  aria-label={`View ${team.name} team profile`}
                >
                  <div class="team-card__accent"></div>

                  <div class="team-card__top">
                    <div class="team-card__logo-wrap">
                      <img
                        class="team-card__logo"
                        src={team.logo}
                        alt={`${team.name} logo`}
                        width="144"
                        height="144"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>

                    <span class="team-card__rank">
                      {rank}
                    </span>
                  </div>

                  <div class="team-card__identity">
                    <p class="team-card__owner">
                      {team.owner}
                    </p>

                    <h3>{team.name}</h3>

                    {
                      formerNames.length > 0 && (
                        <p class="team-card__legacy">
                          Formerly {formerNames.join(" · ")}
                        </p>
                      )
                    }
                  </div>

                  <dl class="team-card__stats">
                    <div>
                      <dt>Record</dt>
                      <dd>{record}</dd>
                    </div>

                    <div>
                      <dt>Points For</dt>
                      <dd>{points}</dd>
                    </div>
                  </dl>

                  <div class="team-card__footer">
                    <span>Franchise profile</span>

                    <span
                      class="team-card__arrow"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(18rem, 31rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding-bottom: var(--space-6);
    border-bottom: 3px double var(--color-rule-dark);
  }

  .page-header h1 {
    max-width: 12ch;
    margin-bottom: 0;
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .page-header__intro {
    justify-self: end;
    max-width: 31rem;
  }

  .page-header__intro p {
    margin: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.45;
  }

  .teams-section {
    padding-top: var(--space-8);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-rule-dark);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .section-heading > p {
    max-width: 32rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    text-align: right;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    padding-top: var(--space-6);
  }

  .team-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(
        145deg,
        color-mix(
          in srgb,
          var(--team-color) 7%,
          transparent
        ),
        transparent 55%
      ),
      var(--color-surface);
    transition:
      border-color var(--transition-standard),
      box-shadow var(--transition-standard),
      transform var(--transition-standard);
  }

  .team-card:hover {
    border-color:
      color-mix(
        in srgb,
        var(--team-color) 40%,
        var(--color-rule)
      );
    box-shadow: var(--shadow-card);
    transform: translateY(-3px);
  }

  .team-card__link {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    color: inherit;
  }

  .team-card__accent {
    height: 0.35rem;
    background:
      linear-gradient(
        90deg,
        var(--team-color),
        var(--secondary-color)
      );
  }

  .team-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding:
      clamp(1.25rem, 3vw, 2rem)
      clamp(1.25rem, 3vw, 2rem)
      0;
  }

  .team-card__logo-wrap {
    display: grid;
    width: clamp(5.75rem, 10vw, 8rem);
    aspect-ratio: 1;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid
      color-mix(
        in srgb,
        var(--team-color) 30%,
        var(--color-rule)
      );
    border-radius: 50%;
    background: var(--color-surface);
  }

  .team-card__logo {
    width: 76%;
    height: 76%;
    object-fit: contain;
    transition: transform var(--transition-standard);
  }

  .team-card:hover .team-card__logo {
    transform: scale(1.04);
  }

  .team-card__rank {
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .team-card__identity {
    padding:
      var(--space-5)
      clamp(1.25rem, 3vw, 2rem);
  }

  .team-card__owner {
    margin-bottom: var(--space-2);
    color: var(--color-green);
    font-family: var(--font-data);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .team-card h3 {
    max-width: 18ch;
    margin-bottom: var(--space-3);
    font-size: clamp(1.8rem, 3.5vw, 2.7rem);
    letter-spacing: -0.04em;
    line-height: 0.98;
    transition: color var(--transition-fast);
  }

  .team-card:hover h3 {
    color: var(--team-color);
  }

  .team-card__legacy {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .team-card__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-inline: clamp(1.25rem, 3vw, 2rem);
    margin: auto 0 0;
  }

  .team-card__stats > div {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }

  .team-card__stats > div + div {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-rule);
  }

  .team-card__stats dt {
    margin-bottom: var(--space-2);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .team-card__stats dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .team-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding:
      var(--space-4)
      clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .team-card__arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--team-color);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .team-card:hover .team-card__arrow {
    border-color: var(--team-color);
    background: var(--team-color);
    color: white;
    transform: translateX(2px);
  }

  @media (max-width: 820px) {
    .page-header {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-items: start;
    }

    .page-header__intro {
      justify-self: start;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-3);
    }

    .section-heading > p {
      text-align: left;
    }

    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .team-card__stats {
      grid-template-columns: 1fr;
    }

    .team-card__stats > div + div {
      padding-left: 0;
      border-left: 0;
    }

    .team-card__stats > div + div {
      border-top: 1px solid var(--color-rule);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-card,
    .team-card__logo,
    .team-card__arrow {
      transition: none;
    }

    .team-card:hover {
      transform: none;
    }

    .team-card:hover .team-card__logo {
      transform: none;
    }

    .team-card:hover .team-card__arrow {
      transform: none;
    }
  }
</style>

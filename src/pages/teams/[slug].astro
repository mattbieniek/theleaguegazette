---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StandingsTable from '../../components/StandingsTable.astro';
import { teams } from '../../data/teams';
export function getStaticPaths(){return teams.map(team=>({params:{slug:team.slug},props:{team}}));}
const {team}=Astro.props;
---
<BaseLayout title={`${team.name} | The League Gazette`}><section class="team-hero" style={`--team:${team.primary};--secondary:${team.secondary}`}><div class="shell hero-inner"><img src={team.logo} alt={`${team.name} logo`}/><div><div class="eyebrow">2025 Franchise Profile</div><h1>{team.name}</h1><p>Owned by <strong>{team.owner}</strong> · Legacy identity: {team.legacyName}</p></div></div></section><div class="shell profile"><section><h2 class="rule-title">Season Snapshot</h2><div class="stats"><article class="card"><span>Record</span><b data-team-record>—</b></article><article class="card"><span>Points For</span><b data-team-pf>—</b></article><article class="card"><span>Standing</span><b>2025</b></article><article class="card"><span>Power Rank</span><b>Editorial</b></article></div><h2 class="rule-title section">Franchise Desk</h2><div class="copy card"><p>This page establishes the reusable team profile layout. Once the 2025 Sleeper archive resolves, the record, points, roster, recent results and schedule can populate automatically. Editorial fields—including the franchise biography, rivalries and running jokes—remain manually controlled.</p></div></section><aside><h2 class="rule-title">League Table</h2><StandingsTable compact={true}/></aside></div></BaseLayout>
<style>.team-hero{background:linear-gradient(115deg,color-mix(in srgb,var(--team) 22%,var(--paper)),color-mix(in srgb,var(--secondary) 9%,white));border-bottom:5px solid var(--team)}.hero-inner{min-height:285px;display:flex;align-items:center;gap:35px}.hero-inner img{width:190px;height:190px;object-fit:cover;border-radius:50%;border:8px solid rgba(255,255,255,.8);box-shadow:0 20px 55px rgba(0,0,0,.18)}.hero-inner h1{font:700 clamp(3rem,7vw,6.5rem)/.88 Georgia,serif;margin:8px 0 12px}.profile{display:grid;grid-template-columns:1fr 380px;gap:30px;padding-top:38px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.stats article{padding:18px;border-top:5px solid var(--team)}.stats span,.stats b{display:block}.stats span{font-size:.66rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.stats b{font:700 1.6rem Georgia,serif;margin-top:7px}.section{margin-top:34px}.copy{padding:24px;font:1.05rem/1.7 Georgia,serif}.copy p{margin:0}@media(max-width:900px){.profile{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}}@media(max-width:600px){.hero-inner{min-height:230px;gap:18px}.hero-inner img{width:100px;height:100px}.hero-inner h1{font-size:2.55rem}.stats{grid-template-columns:1fr 1fr}}</style>

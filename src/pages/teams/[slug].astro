---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StandingsTable from "../../components/StandingsTable.astro";
import PlayerCard from "../../components/teams/PlayerCard.astro";
import RecentResultCard from "../../components/teams/RecentResultCard.astro";
import TeamDraftClass from "../../components/teams/TeamDraftClass.astro";
import TransactionHighlight from "../../components/transactions/TransactionHighlight.astro";
import { getSeasonStandings } from "../../lib/queries/standings";
import { getHistoricalResults } from "../../lib/queries/records";
import { getTeamRoster } from "../../lib/queries/rosters";
import { getDraftArchive } from "../../lib/queries/drafts";
import {
  getTransactionArchive,
  type LeagueTransaction,
} from "../../lib/queries/transactions";
import {
  buildFranchiseHistory,
  formatFranchiseRecord,
} from "../../lib/gazette/franchises";
import {
  buildTeamRecentForm,
  formatStreak,
} from "../../lib/gazette/recentForm";
import { buildTeamDraftHistory } from "../../lib/gazette/teamDrafts";
import { getTeamTransactionHighlights } from "../../lib/gazette/transactionHighlights";
import { teams } from "../../data/teams";

type Team = (typeof teams)[number];

interface Props {
  team: Team;
  teamTransactions: LeagueTransaction[];
}

export async function getStaticPaths() {
  const transactionArchive = await getTransactionArchive();

  return teams.map((team) => ({
    params: {
      slug: team.slug,
    },
    props: {
      team,
      teamTransactions: getTeamTransactionHighlights(
        transactionArchive,
        team
      ),
    },
  }));
}

const { team, teamTransactions } = Astro.props as Props;

const sleeperLeagueId =
  import.meta.env.PUBLIC_SLEEPER_LEAGUE_ID;

const standings = sleeperLeagueId
  ? await getSeasonStandings(sleeperLeagueId)
  : [];

const historicalResults = await getHistoricalResults();

const roster = sleeperLeagueId
  ? await getTeamRoster(sleeperLeagueId, team.name)
  : null;

const draftArchive = sleeperLeagueId
  ? await getDraftArchive(sleeperLeagueId)
  : [];

const primaryPositions = ["QB", "RB", "WR", "TE", "K", "DEF"];
const rosterGroups = [...primaryPositions, "Other"]
  .map((position) => ({
    position,
    players: roster?.players.filter((player) =>
      position === "Other"
        ? !primaryPositions.includes(player.position)
        : player.position === position
    ) ?? [],
  }))
  .filter((group) => group.players.length > 0);

const starterCount = roster?.players.filter((player) => player.isStarter).length ?? 0;
const reserveCount = roster?.players.filter((player) => player.isReserve).length ?? 0;

const franchiseHistory = buildFranchiseHistory(
  historicalResults,
  team
);

const recentForm = buildTeamRecentForm(
  historicalResults,
  team
);

const draftHistory = buildTeamDraftHistory(
  draftArchive,
  team
);

const teamStanding = standings.find(
  (standing) =>
    standing.team_name?.trim().toLowerCase() ===
    team.name.trim().toLowerCase()
);

const seasonYear =
  teamStanding?.season_year ??
  standings.find(
    (standing) =>
      typeof standing.season_year === "number"
  )?.season_year ??
  null;

const record = teamStanding
  ? `${teamStanding.wins ?? 0}-${teamStanding.losses ?? 0}${
      (teamStanding.ties ?? 0) > 0
        ? `-${teamStanding.ties}`
        : ""
    }`
  : "—";

const pointsFor =
  teamStanding?.points_for !== null &&
  teamStanding?.points_for !== undefined
    ? formatPoints(teamStanding.points_for)
    : "—";

const pointsAgainst =
  teamStanding?.points_against !== null &&
  teamStanding?.points_against !== undefined
    ? formatPoints(teamStanding.points_against)
    : "—";

const pointDifferential =
  teamStanding?.point_differential !== null &&
  teamStanding?.point_differential !== undefined
    ? Number(teamStanding.point_differential)
    : null;

const standingRank =
  teamStanding?.standings_rank !== null &&
  teamStanding?.standings_rank !== undefined
    ? `No. ${teamStanding.standings_rank}`
    : "—";

const surroundingStandings =
  teamStanding?.standings_rank !== null &&
  teamStanding?.standings_rank !== undefined
    ? standings.filter((standing) => {
        const rank = standing.standings_rank;

        return (
          rank !== null &&
          rank >= teamStanding.standings_rank! - 2 &&
          rank <= teamStanding.standings_rank! + 2
        );
      })
    : standings.slice(0, 5);

const hasLegacyIdentity =
  team.legacyName.trim().toLowerCase() !==
  team.name.trim().toLowerCase();

function formatPoints(value: number | null): string {
  return Number(value ?? 0).toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
}
---

<BaseLayout
  title={team.name}
  description={`${team.name} franchise profile, owner information and season standings for Far Far Away Football.`}
>
  <section
    class="team-hero"
    style={`--team-color: ${team.primary}; --secondary-color: ${team.secondary};`}
  >
    <div class="site-shell team-hero__inner">
      <div class="team-hero__logo-wrap">
        <img
          class="team-hero__logo"
          src={team.logo}
          alt={`${team.name} logo`}
          width="180"
          height="180"
          decoding="async"
        />
      </div>

      <div class="team-hero__copy">
        <p class="eyebrow">
          {
            seasonYear
              ? `${seasonYear} Franchise Profile`
              : "Franchise Profile"
          }
        </p>

        <h1>{team.name}</h1>

        <div class="team-hero__meta">
          <span>
            Owned by <strong>{team.owner}</strong>
          </span>

          {
            hasLegacyIdentity && (
              <>
                <span aria-hidden="true">·</span>

                <span>
                  Formerly {team.legacyName}
                </span>
              </>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <div
    class="site-shell team-profile"
    style={`--team-color: ${team.primary}; --secondary-color: ${team.secondary};`}
  >
    <div class="team-profile__main">
      <section aria-labelledby="season-snapshot-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Current Campaign
            </p>

            <h2 id="season-snapshot-title">
              Season Snapshot
            </h2>
          </div>

          <p>
            Current franchise performance from the latest
            synced Sleeper league data.
          </p>
        </div>

        <dl class="stats-grid">
          <div class="stat-card">
            <dt>Record</dt>
            <dd>{record}</dd>
          </div>

          <div class="stat-card">
            <dt>Standing</dt>
            <dd>{standingRank}</dd>
          </div>

          <div class="stat-card">
            <dt>Points For</dt>
            <dd>{pointsFor}</dd>
          </div>

          <div class="stat-card">
            <dt>Points Against</dt>
            <dd>{pointsAgainst}</dd>
          </div>
        </dl>
      </section>

      {
        recentForm && (
          <section
            class="recent-form"
            aria-labelledby="recent-form-title"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">Last Five</p>
                <h2 id="recent-form-title">Recent Form</h2>
              </div>

              <p>
                The franchise’s latest completed results from the
                {` ${recentForm.seasonYear} season`}.
              </p>
            </div>

            <div class="form-overview">
              <div class="form-strip" aria-label="Last five results">
                {recentForm.games.map((game) => (
                  <a
                    class:list={[`is-${game.result.toLowerCase()}`]}
                    href={`/matchups?week=${game.week}`}
                    aria-label={`Week ${game.week}: ${game.result}`}
                  >
                    {game.result}
                  </a>
                ))}
              </div>

              <dl>
                <div>
                  <dt>Recent Record</dt>
                  <dd>
                    {recentForm.wins}-{recentForm.losses}
                    {recentForm.ties > 0 ? `-${recentForm.ties}` : ""}
                  </dd>
                </div>
                <div><dt>Average Score</dt><dd>{formatPoints(recentForm.averageScore)}</dd></div>
                <div><dt>Current Run</dt><dd>{formatStreak(recentForm)}</dd></div>
              </dl>
            </div>

            <div class="recent-results">
              {recentForm.games.map((game, index) => (
                <RecentResultCard
                  game={game}
                  teamName={team.name}
                  latest={index === 0}
                />
              ))}
            </div>

            <div class="recent-highlights">
              <article>
                <p>Best Recent Score</p>
                <strong>{formatPoints(recentForm.bestPerformance.pointsFor)}</strong>
                <span>
                  Week {recentForm.bestPerformance.week} vs. {recentForm.bestPerformance.opponentName}
                </span>
              </article>
              <article>
                <p>Closest Recent Finish</p>
                <strong>{formatPoints(recentForm.closestGame.margin)}</strong>
                <span>
                  Week {recentForm.closestGame.week} vs. {recentForm.closestGame.opponentName}
                </span>
              </article>
            </div>
          </section>
        )
      }

      {
        teamTransactions.length > 0 && (
          <section
            class="recent-moves"
            aria-labelledby="recent-moves-title"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">Front Office Activity</p>
                <h2 id="recent-moves-title">Recent Moves</h2>
              </div>

              <p>
                The latest completed transactions involving this franchise.
              </p>
            </div>

            <div class="recent-moves__grid">
              {teamTransactions.map((transaction) => (
                <TransactionHighlight
                  transaction={transaction}
                  contextTeamName={team.name}
                />
              ))}
            </div>

            <a
              class="transaction-archive-link"
              href={`/transactions?team=${team.slug}&week=all`}
            >
              View every {team.name} transaction
              <span aria-hidden="true">→</span>
            </a>
          </section>
        )
      }

      {
        franchiseHistory && (
          <section
            class="franchise-history"
            aria-labelledby="franchise-history-title"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">Historical Ledger</p>
                <h2 id="franchise-history-title">
                  Franchise History
                </h2>
              </div>

              <p>
                Completed results recorded under the franchise’s
                current and previous identities.
              </p>
            </div>

            <dl class="career-summary">
              <div>
                <dt>All-Time Record</dt>
                <dd>
                  {formatFranchiseRecord(
                    franchiseHistory.wins,
                    franchiseHistory.losses,
                    franchiseHistory.ties
                  )}
                </dd>
              </div>
              <div>
                <dt>Career Points</dt>
                <dd>{formatPoints(franchiseHistory.pointsFor)}</dd>
              </div>
              <div>
                <dt>Weekly Average</dt>
                <dd>{formatPoints(franchiseHistory.averageScore)}</dd>
              </div>
              <div>
                <dt>Championships</dt>
                <dd>{franchiseHistory.championships}</dd>
              </div>
            </dl>

            <div class="franchise-records">
              {franchiseHistory.performances.map((performance) => (
                <article>
                  <p>{performance.label}</p>
                  <strong>{performance.value}</strong>
                  <span>
                    {performance.opponentName
                      ? `vs. ${performance.opponentName} · `
                      : ""}
                    {performance.seasonYear} · Week {performance.week}
                  </span>
                </article>
              ))}
            </div>

            <div class="season-history">
              <div class="season-history__heading">
                <h3>Season by Season</h3>
                <a href="/history">
                  League history <span aria-hidden="true">→</span>
                </a>
              </div>

              <div
                class="season-history__scroll"
                role="region"
                aria-label={`${team.name} season history`}
                tabindex="0"
              >
                <table>
                  <caption class="sr-only">{team.name} season-by-season history</caption>
                  <thead>
                    <tr>
                      <th scope="col">Season</th>
                      <th scope="col">Finish</th>
                      <th scope="col">Record</th>
                      <th scope="col">PF</th>
                      <th scope="col">PA</th>
                      <th scope="col">Average</th>
                    </tr>
                  </thead>
                  <tbody>
                    {franchiseHistory.seasons.map((season) => (
                      <tr>
                        <td>
                          <a href={`/history/${season.year}`}>
                            {season.year}
                          </a>
                        </td>
                        <td>
                          {season.champion
                            ? "Champion"
                            : season.runnerUp
                              ? "Runner-up"
                              : "—"}
                        </td>
                        <td>
                          {formatFranchiseRecord(
                            season.wins,
                            season.losses,
                            season.ties
                          )}
                        </td>
                        <td>{formatPoints(season.pointsFor)}</td>
                        <td>{formatPoints(season.pointsAgainst)}</td>
                        <td>{formatPoints(season.averageScore)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        )
      }

      <section
        class="active-roster"
        aria-labelledby="active-roster-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">Current Personnel</p>
            <h2 id="active-roster-title">Active Roster</h2>
          </div>

          <p>
            {roster
              ? `${roster.players.length} players from the latest ${roster.seasonYear} Sleeper roster sync.`
              : "The current player roster will appear after Sleeper data is synchronized."}
          </p>
        </div>

        {roster && roster.players.length > 0 ? (
          <>
            <dl class="roster-summary">
              <div><dt>Total Players</dt><dd>{roster.players.length}</dd></div>
              <div><dt>Starters</dt><dd>{starterCount}</dd></div>
              <div><dt>Reserve</dt><dd>{reserveCount}</dd></div>
              <div><dt>Position Groups</dt><dd>{rosterGroups.length}</dd></div>
            </dl>

            <div class="roster-groups">
              {rosterGroups.map((group) => (
                <section aria-labelledby={`roster-${team.slug}-${group.position.toLowerCase()}`}>
                  <header>
                    <div>
                      <span>{group.position}</span>
                      <h3 id={`roster-${team.slug}-${group.position.toLowerCase()}`}>
                        {group.position === "DEF" ? "Defense" : group.position}
                      </h3>
                    </div>
                    <p>{group.players.length} {group.players.length === 1 ? "player" : "players"}</p>
                  </header>

                  <div class="roster-group__players">
                    {group.players.map((player) => <PlayerCard player={player} />)}
                  </div>
                </section>
              ))}
            </div>
          </>
        ) : (
          <div class="roster-empty">
            <p>No active roster data is available yet.</p>
          </div>
        )}
      </section>

      {
        draftHistory && (
          <section
            class="team-draft-history"
            aria-labelledby="team-draft-history-title"
          >
            <div class="section-heading">
              <div>
                <p class="eyebrow">War Room Ledger</p>
                <h2 id="team-draft-history-title">Draft History</h2>
              </div>

              <p>
                Every recorded selection made under the franchise’s
                current and previous identities.
              </p>
            </div>

            <dl class="draft-history-summary">
              <div><dt>Draft Classes</dt><dd>{draftHistory.seasonsDrafted}</dd></div>
              <div><dt>Total Selections</dt><dd>{draftHistory.totalPicks}</dd></div>
              <div><dt>Archive Span</dt><dd>{draftHistory.earliestSeason}–{draftHistory.latestSeason}</dd></div>
            </dl>

            <div class="draft-class-list">
              {draftHistory.classes.map((draftClass, index) => (
                <TeamDraftClass draftClass={draftClass} featured={index === 0} />
              ))}
            </div>

            <a class="draft-archive-link" href="/draft">
              Explore the complete draft archive
              <span aria-hidden="true">→</span>
            </a>
          </section>
        )
      }

      <section
        class="franchise-summary"
        aria-labelledby="franchise-summary-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">
              Team File
            </p>

            <h2 id="franchise-summary-title">
              Franchise Summary
            </h2>
          </div>
        </div>

        <div class="franchise-summary__card">
          <div class="franchise-summary__identity">
            <div>
              <p class="franchise-summary__label">
                Owner
              </p>

              <p class="franchise-summary__value">
                {team.owner}
              </p>
            </div>

            <div>
              <p class="franchise-summary__label">
                Current Identity
              </p>

              <p class="franchise-summary__value">
                {team.name}
              </p>
            </div>

            {
              hasLegacyIdentity && (
                <div>
                  <p class="franchise-summary__label">
                    Previous Identity
                  </p>

                  <p class="franchise-summary__value">
                    {team.legacyName}
                  </p>
                </div>
              )
            }
          </div>

          <div class="franchise-summary__performance">
            <p class="franchise-summary__label">
              Point Differential
            </p>

            <p
              class:list={[
                "franchise-summary__differential",
                pointDifferential !== null &&
                  pointDifferential > 0 &&
                  "franchise-summary__differential--positive",
                pointDifferential !== null &&
                  pointDifferential < 0 &&
                  "franchise-summary__differential--negative",
              ]}
            >
              {
                pointDifferential === null
                  ? "—"
                  : `${
                      pointDifferential > 0 ? "+" : ""
                    }${formatPoints(pointDifferential)}`
              }
            </p>

            <p class="franchise-summary__note">
              The difference between total points scored and
              total points allowed this season.
            </p>
          </div>
        </div>
      </section>

    </div>

    <aside
      class="team-profile__sidebar"
      aria-labelledby="league-position-title"
    >
      <div class="sidebar-heading">
        <p class="eyebrow">
          League Context
        </p>

        <h2 id="league-position-title">
          Around {team.name}
        </h2>

        <p>
          The closest teams to this franchise in the current
          standings.
        </p>
      </div>

      <div class="league-table">
        <StandingsTable
          standings={surroundingStandings}
          compact
          caption={`Standings around ${team.name}`}
        />
      </div>

      <a class="standings-link" href="/standings">
        View full standings
        <span aria-hidden="true">→</span>
      </a>

      <a class="teams-link" href="/teams">
        Back to all teams
        <span aria-hidden="true">←</span>
      </a>
    </aside>
  </div>
</BaseLayout>

<style>
  .team-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule);
    background:
      linear-gradient(
        120deg,
        color-mix(
          in srgb,
          var(--team-color) 13%,
          transparent
        ),
        transparent 55%
      ),
      var(--color-paper-light);
  }

  .team-hero::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.4rem;
    background:
      linear-gradient(
        var(--team-color),
        var(--secondary-color)
      );
    content: "";
  }

  .team-hero__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    min-height: 22rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .team-hero__logo-wrap {
    display: grid;
    width: clamp(8rem, 16vw, 11rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid
      color-mix(
        in srgb,
        var(--team-color) 35%,
        var(--color-rule)
      );
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .team-hero__logo {
    width: 78%;
    height: 78%;
    object-fit: contain;
  }

  .team-hero__copy {
    min-width: 0;
  }

  .team-hero h1 {
    max-width: 15ch;
    margin-bottom: var(--space-4);
    font-size: clamp(3rem, 8vw, 6.75rem);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .team-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .team-profile {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(18rem, 24rem);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: var(--space-8) var(--space-9);
  }

  .team-profile__main,
  .team-profile__sidebar {
    min-width: 0;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-rule-dark);
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .section-heading > p {
    max-width: 27rem;
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: right;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--space-5) 0 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .stat-card {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .stat-card + .stat-card {
    border-left: 1px solid var(--color-rule);
  }

  .stat-card dt {
    margin-bottom: var(--space-3);
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.63rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .stat-card dd {
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .franchise-summary,
  .franchise-history,
  .active-roster,
  .recent-form,
  .recent-moves,
  .team-draft-history {
    margin-top: var(--space-8);
  }

  .recent-moves__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-top: var(--space-5);
  }

  .transaction-archive-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    margin-top: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .transaction-archive-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .draft-history-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: var(--space-5) 0 0;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-surface);

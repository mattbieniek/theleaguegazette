---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StandingsTable from "../../components/StandingsTable.astro";
import { getSeasonStandings } from "../../lib/queries/standings";
import { teams } from "../../data/teams";

type Team = (typeof teams)[number];

interface Props {
  team: Team;
}

export function getStaticPaths() {
  return teams.map((team) => ({
    params: {
      slug: team.slug,
    },
    props: {
      team,
    },
  }));
}

const { team } = Astro.props as Props;

const sleeperLeagueId = import.meta.env.PUBLIC_SLEEPER_LEAGUE_ID;

if (!sleeperLeagueId) {
  throw new Error("Missing PUBLIC_SLEEPER_LEAGUE_ID.");
}

const standings = await getSeasonStandings(sleeperLeagueId);

const teamStanding = standings.find(
  (standing) =>
    standing.team_name?.trim().toLowerCase() ===
    team.name.trim().toLowerCase()
);

const record = teamStanding
  ? `${teamStanding.wins ?? 0}-${teamStanding.losses ?? 0}${
      (teamStanding.ties ?? 0) > 0 ? `-${teamStanding.ties}` : ""
    }`
  : "—";

const pointsFor =
  teamStanding?.points_for !== null &&
  teamStanding?.points_for !== undefined
    ? Number(teamStanding.points_for).toFixed(2)
    : "—";

const standingRank = teamStanding?.standings_rank
  ? `No. ${teamStanding.standings_rank}`
  : "—";
---

<BaseLayout
  title={team.name}
  description={`${team.name} franchise profile, standings and season information for the Far Far Away Fantasy Football League.`}
>
  <section
    class="team-hero"
    style={`--team-color: ${team.primary}; --secondary-color: ${team.secondary};`}
  >
    <div class="site-shell team-hero__inner">
      <div class="team-hero__logo-wrap">
        <img
          class="team-hero__logo"
          src={team.logo}
          alt={`${team.name} logo`}
          width="180"
          height="180"
        />
      </div>

      <div class="team-hero__copy">
        <p class="eyebrow">2025 Franchise Profile</p>

        <h1>{team.name}</h1>

        <p class="team-hero__meta">
          Owned by <strong>{team.owner}</strong>
          <span aria-hidden="true">·</span>
          Legacy identity: {team.legacyName}
        </p>
      </div>
    </div>
  </section>

  <div class="site-shell team-profile">
    <main class="team-profile__main">
      <section aria-labelledby="season-snapshot-title">
        <h2 id="season-snapshot-title" class="rule-title">
          Season Snapshot
        </h2>

        <div class="stats-grid">
          <article class="stat-card surface-card">
            <span class="stat-card__label">Record</span>
            <strong class="stat-card__value">{record}</strong>
          </article>

          <article class="stat-card surface-card">
            <span class="stat-card__label">Points For</span>
            <strong class="stat-card__value">{pointsFor}</strong>
          </article>

          <article class="stat-card surface-card">
            <span class="stat-card__label">Standing</span>
            <strong class="stat-card__value">{standingRank}</strong>
          </article>

          <article class="stat-card surface-card">
            <span class="stat-card__label">Power Rank</span>
            <strong class="stat-card__value">Editorial</strong>
          </article>
        </div>
      </section>

      <section
        class="franchise-desk"
        aria-labelledby="franchise-desk-title"
      >
        <h2 id="franchise-desk-title" class="rule-title">
          Franchise Desk
        </h2>

        <div class="franchise-copy surface-card">
          <p>
            This page establishes the reusable team profile layout. The
            franchise record, points scored and league standing are populated
            from the current Sleeper season data.
          </p>

          <p>
            Future additions will include the active roster, recent results,
            upcoming schedule, franchise history, rivalries and the running
            jokes that define this team around the league.
          </p>
        </div>
      </section>
    </main>

    <aside
      class="team-profile__sidebar"
      aria-labelledby="league-table-title"
    >
      <h2 id="league-table-title" class="rule-title">
        League Table
      </h2>

      <div class="league-table surface-card">
        <StandingsTable standings={standings} compact />
      </div>

      <a class="standings-link" href="/standings">
        View full standings
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  </div>
</BaseLayout>

<style>
  .team-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-rule);
    background:
      linear-gradient(
        120deg,
        color-mix(in srgb, var(--team-color) 13%, transparent),
        transparent 55%
      ),
      var(--color-paper-light);
  }

  .team-hero::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0.4rem;
    background: var(--team-color);
    content: "";
  }

  .team-hero__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    min-height: 22rem;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .team-hero__logo-wrap {
    display: grid;
    width: clamp(8rem, 16vw, 11rem);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid
      color-mix(in srgb, var(--team-color) 35%, var(--color-rule));
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  .team-hero__logo {
    width: 78%;
    height: 78%;
    object-fit: contain;
  }

  .team-hero__copy {
    min-width: 0;
  }

  .team-hero h1 {
    max-width: 15ch;
    margin-bottom: var(--space-4);
    font-size: clamp(3rem, 8vw, 6.75rem);
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .team-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .team-profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: var(--space-7) var(--space-9);
  }

  .team-profile__main {
    min-width: 0;
  }

  .team-profile__sidebar {
    min-width: 0;
  }

  .rule-title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--font-data);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .rule-title::after {
    flex: 1;
    height: 1px;
    background: var(--color-rule);
    content: "";
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-5);
  }

  .stat-card__label {
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stat-card__value {
    overflow: hidden;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 650;
    line-height: 1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .franchise-desk {
    margin-top: var(--space-7);
  }

  .franchise-copy {
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .franchise-copy p {
    max-width: 44rem;
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .franchise-copy p:last-child {
    margin-bottom: 0;
  }

  .league-table {
    overflow: hidden;
    padding: var(--space-3);
  }

  .standings-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .standings-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 1050px) {
    .team-profile {
      grid-template-columns: 1fr;
    }

    .team-profile__sidebar {
      max-width: 48rem;
    }
  }

  @media (max-width: 760px) {
    .team-hero__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      text-align: center;
    }

    .team-hero__logo-wrap {
      margin-inline: auto;
    }

    .team-hero h1 {
      margin-inline: auto;
    }

    .team-hero__meta {
      justify-content: center;
    }

    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleBody from "../../components/gazette/ArticleBody.astro";
import CommentBody from "../../components/gazette/CommentBody.astro";
import {
  getPublishedArticleBySlug,
  getPublishedArticles,
} from "../../lib/queries/gazette";
import { supabase } from "../../lib/supabase";
import { formatPublicationDate, formatPublicationDateTime } from "../../lib/formatDate";
import { formatStoryCategory } from "../../lib/gazette/categories";
import { normalizeArticleBody, type RichTextDocument } from "../../lib/gazette/articleBody";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing Gazette article slug.");
}

const story = await getPublishedArticleBySlug(slug);

if (!story) {
  return Astro.redirect("/404");
}

if (story.exclude_from_search) {
  Astro.response.headers.set("X-Robots-Tag", "noindex");
}

type GazetteComment = {
  id: string;
  userId: string;
  body: RichTextDocument;
  createdAt: string;
  updatedAt: string;
  displayName: string;
};

async function getArticleComments(articleId: string): Promise<GazetteComment[]> {
  const { data, error } = await supabase
    .from("gazette_comments")
    .select("id, user_id, body, created_at, updated_at")
    .eq("article_id", articleId)
    .order("created_at", { ascending: true });

  if (error || !data?.length) {
    return [];
  }

  const userIds = [...new Set(data.map((comment) => comment.user_id))];
  const { data: profiles } = await supabase
    .from("public_reader_profiles")
    .select("user_id, display_name")
    .in("user_id", userIds);

  const displayNames = new Map(
    (profiles ?? []).map((profile) => [profile.user_id, profile.display_name]),
  );

  return data.map((comment) => ({
    id: comment.id,
    userId: comment.user_id,
    body: normalizeArticleBody(comment.body),
    createdAt: comment.created_at,
    updatedAt: comment.updated_at,
    displayName: displayNames.get(comment.user_id) ?? "Gazette reader",
  }));
}

const comments = await getArticleComments(story.id);

const publishedArticles = await getPublishedArticles();

const currentIndex = publishedArticles.findIndex(
  (article) => article.slug === story.slug
);

const newerStory =
  currentIndex > 0
    ? publishedArticles[currentIndex - 1]
    : null;

const olderStory =
  currentIndex >= 0 &&
  currentIndex < publishedArticles.length - 1
    ? publishedArticles[currentIndex + 1]
    : null;

const relatedStories = publishedArticles
  .filter((article) => article.slug !== story.slug)
  .sort((first, second) => {
    const firstMatchesCategory =
      first.category?.trim().toLowerCase() ===
      story.category?.trim().toLowerCase();

    const secondMatchesCategory =
      second.category?.trim().toLowerCase() ===
      story.category?.trim().toLowerCase();

    return Number(secondMatchesCategory) -
      Number(firstMatchesCategory);
  })
  .slice(0, 3);

function getPlainText(value: unknown): string {
  if (typeof value === "string") {
    return value;
  }

  if (Array.isArray(value)) {
    return value
      .map((item) => getPlainText(item))
      .join(" ");
  }

  if (
    value &&
    typeof value === "object"
  ) {
    const record = value as Record<string, unknown>;

    const currentText =
      typeof record.text === "string"
        ? record.text
        : "";

    const childText = getPlainText(record.content);

    return `${currentText} ${childText}`.trim();
  }

  return "";
}

function calculateReadingTime(body: unknown): number {
  const wordCount = getPlainText(body)
    .trim()
    .split(/\s+/)
    .filter(Boolean).length;

  return Math.max(1, Math.ceil(wordCount / 225));
}

function getArticleImage(
  imageUrl: string | null
): string {
  return (
    imageUrl ??
    "/images/gazette/article-placeholder.webp"
  );
}

const readingTime = calculateReadingTime(story.body);
const canonicalUrl = new URL(
  `/gazette/${story.slug}`,
  Astro.site ?? Astro.url
).toString();
---

<BaseLayout
  title={story.headline}
  description={story.summary}
  image={story.image_url ?? "/images/gazette/article-placeholder.webp"}
  imageAlt={story.image_alt ?? story.headline}
  type="article"
  publishedTime={story.published_at}
  modifiedTime={story.updated_at}
  author={story.author_name}
  noindex={story.exclude_from_search}
>
  <article class="article-page">
    <header class="article-header site-shell">
      <nav
        class="article-header__breadcrumb"
        aria-label="Breadcrumb"
      >
        <a href="/gazette">
          The Gazette
        </a>

        <span aria-hidden="true">/</span>

        <span>{formatStoryCategory(story.category, story.subcategory)}</span>
      </nav>

      <div class="article-header__content">
        <p class="eyebrow">
          {formatStoryCategory(story.category, story.subcategory)}
        </p>

        <h1>{story.headline}</h1>

        {
          story.summary && (
            <p class="article-header__dek">
              {story.summary}
            </p>
          )
        }

        <div class="article-header__footer">
          <div class="article-header__meta">
            <span>
              By <strong>{story.author_name}</strong>
            </span>

            {
              story.published_at && (
                <>
                  <span aria-hidden="true">·</span>

                  <time datetime={story.published_at}>
                    {formatPublicationDateTime(
                      story.published_at
                    )}
                  </time>
                </>
              )
            }

            <span aria-hidden="true">·</span>

            <span>
              {readingTime}
              {" "}
              {readingTime === 1
                ? "minute"
                : "minutes"}
              {" "}read
            </span>
          </div>

          <div
            class="article-actions"
            aria-label="Article actions"
          >
            <button
              id="share-story"
              type="button"
              data-title={story.headline}
              data-url={canonicalUrl}
            >
              Share
            </button>

            <button
              id="copy-story-link"
              type="button"
              data-url={canonicalUrl}
            >
              Copy link
            </button>
          </div>
        </div>

        <p
          id="article-action-message"
          class="article-action-message"
          role="status"
          aria-live="polite"
        ></p>
      </div>
    </header>

    {
      story.image_url && (
        <figure class="article-image site-shell">
          <div class="article-image__frame">
            <img
              src={story.image_url}
              alt={story.image_alt ?? ""}
              width="1600"
              height="1000"
              decoding="async"
            />
          </div>
        </figure>
      )
    }

    <div class="article-reading-layout site-shell">
      <aside
        class="article-reading-layout__rail"
        aria-label="Article navigation"
      >
        <a href="/gazette">
          <span aria-hidden="true">←</span>
          All stories
        </a>

        <p>
          {formatStoryCategory(story.category, story.subcategory)}
        </p>
      </aside>

      <div class="article-body">
        <ArticleBody body={story.body} />
      </div>
    </div>

    <span id="article-view-tracker" data-article-id={story.id} hidden></span>

    <section
      class="article-comments site-shell"
      id="article-comments"
      data-article-id={story.id}
      aria-labelledby="article-comments-title"
    >
      <div class="article-comments__heading">
        <div>
          <p class="eyebrow">Reader conversation</p>
          <h2 id="article-comments-title">Join the conversation</h2>
          <p>
            Share your take on this story. Comments publish immediately, and
            you can edit your own comment whenever you need to.
          </p>
        </div>
        <span class="article-comments__count">
          {comments.length} {comments.length === 1 ? "comment" : "comments"}
        </span>
      </div>

      <div class="article-comments__account" id="comments-sign-in">
        <p>Sign in to add your perspective.</p>
        <div class="article-comments__account-links">
          <a href="/account/login">Sign in</a>
          <a href="/account/register">Create account</a>
        </div>
      </div>

      <form
        class="comment-form"
        id="comment-form"
        data-comment-form
        hidden
      >
        <label for="comment-body">Your comment</label>
        <div class="comment-editor-shell">
          <div class="comment-toolbar" role="toolbar" aria-label="Comment formatting">
            <button type="button" data-comment-command="bold" aria-label="Bold" aria-pressed="false" title="Bold"><strong>B</strong></button>
            <button type="button" data-comment-command="italic" aria-label="Italic" aria-pressed="false" title="Italic"><em>I</em></button>
            <button type="button" data-comment-command="underline" aria-label="Underline" aria-pressed="false" title="Underline"><u>U</u></button>
            <button type="button" data-comment-command="link" aria-label="Add or edit link" aria-pressed="false" title="Add or edit link">Link</button>
            <button type="button" data-comment-command="inline-image" aria-label="Insert image" title="Insert image by URL">Image</button>
            <span class="comment-toolbar__divider" aria-hidden="true"></span>
            <button type="button" data-comment-command="heading-2" aria-label="Heading level 2" aria-pressed="false" title="Heading level 2">H2</button>
            <button type="button" data-comment-command="heading-3" aria-label="Heading level 3" aria-pressed="false" title="Heading level 3">H3</button>
            <button type="button" data-comment-command="bullet-list" aria-label="Bulleted list" aria-pressed="false" title="Bulleted list">• List</button>
            <button type="button" data-comment-command="ordered-list" aria-label="Numbered list" aria-pressed="false" title="Numbered list">1. List</button>
            <button type="button" data-comment-command="blockquote" aria-label="Blockquote" aria-pressed="false" title="Blockquote">Quote</button>
            <button type="button" data-comment-command="horizontal-rule" aria-label="Horizontal divider" title="Horizontal divider">Divider</button>
            <span class="comment-toolbar__divider" aria-hidden="true"></span>
            <button type="button" data-comment-command="undo" aria-label="Undo" title="Undo">↶</button>
            <button type="button" data-comment-command="redo" aria-label="Redo" title="Redo">↷</button>
          </div>
          <div
            id="comment-body"
            class="comment-editor"
            data-comment-editor
            contenteditable="true"
            role="textbox"
            aria-multiline="true"
            aria-label="Your comment"
            aria-describedby="comment-count"
            data-placeholder="What do you think?"
          ></div>
        </div>
        <div class="comment-form__footer">
          <span id="comment-count" data-comment-count>0 / 2,000 characters</span>
          <button type="submit">Post comment</button>
        </div>
      </form>

      <p
        class="article-comments__message"
        id="comments-message"
        role="status"
        aria-live="polite"
      ></p>

      <div class="article-comments__list" id="comments-list">
        {
          comments.length > 0 ? (
            comments.map((comment) => (
              <article
                class="comment-card"
                data-comment-id={comment.id}
                data-comment-user-id={comment.userId}
              >
                <header class="comment-card__header">
                  <div>
                    <strong>{comment.displayName}</strong>
                    <time datetime={comment.createdAt}>
                      {formatPublicationDate(comment.createdAt)}
                      {comment.updatedAt !== comment.createdAt ? " · Edited" : ""}
                    </time>
                  </div>
                  <button
                    class="comment-card__edit"
                    type="button"
                    data-edit-comment
                    hidden
                  >
                    Edit
                  </button>
                </header>

                <div class="comment-card__body" data-comment-body>
                  <CommentBody body={comment.body} />
                </div>

                <form class="comment-edit-form" data-edit-form hidden>
                  <label class="sr-only" for={`edit-comment-${comment.id}`}>
                    Edit your comment
                  </label>
                  <div class="comment-toolbar" role="toolbar" aria-label="Comment formatting">
                    <button type="button" data-comment-command="bold" aria-label="Bold" aria-pressed="false" title="Bold"><strong>B</strong></button>
                    <button type="button" data-comment-command="italic" aria-label="Italic" aria-pressed="false" title="Italic"><em>I</em></button>
                    <button type="button" data-comment-command="underline" aria-label="Underline" aria-pressed="false" title="Underline"><u>U</u></button>
                    <button type="button" data-comment-command="link" aria-label="Add or edit link" aria-pressed="false" title="Add or edit link">Link</button>
                    <button type="button" data-comment-command="inline-image" aria-label="Insert image" title="Insert image by URL">Image</button>
                    <span class="comment-toolbar__divider" aria-hidden="true"></span>
                    <button type="button" data-comment-command="heading-2" aria-label="Heading level 2" aria-pressed="false" title="Heading level 2">H2</button>
                    <button type="button" data-comment-command="heading-3" aria-label="Heading level 3" aria-pressed="false" title="Heading level 3">H3</button>
                    <button type="button" data-comment-command="bullet-list" aria-label="Bulleted list" aria-pressed="false" title="Bulleted list">• List</button>
                    <button type="button" data-comment-command="ordered-list" aria-label="Numbered list" aria-pressed="false" title="Numbered list">1. List</button>
                    <button type="button" data-comment-command="blockquote" aria-label="Blockquote" aria-pressed="false" title="Blockquote">Quote</button>
                    <button type="button" data-comment-command="horizontal-rule" aria-label="Horizontal divider" title="Horizontal divider">Divider</button>
                    <span class="comment-toolbar__divider" aria-hidden="true"></span>
                    <button type="button" data-comment-command="undo" aria-label="Undo" title="Undo">↶</button>
                    <button type="button" data-comment-command="redo" aria-label="Redo" title="Redo">↷</button>
                  </div>
                  <div
                    id={`edit-comment-${comment.id}`}
                    class="comment-editor"
                    data-comment-editor
                    data-content={JSON.stringify(comment.body)}
                    contenteditable="true"
                    role="textbox"
                    aria-multiline="true"
                    aria-label="Edit your comment"
                    aria-describedby={`edit-comment-count-${comment.id}`}
                    data-placeholder="What do you think?"
                  ></div>
                  <div class="comment-form__footer">
                    <span id={`edit-comment-count-${comment.id}`} data-comment-count>0 / 2,000 characters</span>
                    <div class="comment-edit-form__actions">
                      <button type="button" data-cancel-edit>Cancel</button>
                      <button type="submit">Save changes</button>
                    </div>
                  </div>
                </form>
              </article>
            ))
          ) : (
            <p class="article-comments__empty" data-comments-empty>
              No comments yet. Be the first to share a thought.
            </p>
          )
        }
      </div>
    </section>

    {
      newerStory || olderStory ? (
        <nav
          class="story-navigation site-shell"
          aria-label="Previous and next Gazette stories"
        >
          {
            olderStory ? (
              <a
                class="story-navigation__item"
                href={`/gazette/${olderStory.slug}`}
              >
                <span class="story-navigation__direction">
                  ← Older story
                </span>

                <strong>
                  {olderStory.headline}
                </strong>
              </a>
            ) : (
              <div></div>
            )
          }

          {
            newerStory ? (
              <a
                class="story-navigation__item story-navigation__item--next"
                href={`/gazette/${newerStory.slug}`}
              >
                <span class="story-navigation__direction">
                  Newer story →
                </span>

                <strong>
                  {newerStory.headline}
                </strong>
              </a>
            ) : (
              <div></div>
            )
          }
        </nav>
      ) : null
    }

    {
      relatedStories.length > 0 && (
        <section
          class="more-stories site-shell"
          aria-labelledby="more-stories-title"
        >
          <div class="section-heading">
            <div>
              <p class="eyebrow">
                Continue Reading
              </p>

              <h2 id="more-stories-title">
                More from the Gazette
              </h2>
            </div>

            <a href="/gazette">
              View the full archive
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="more-stories__grid">
            {
              relatedStories.map((article) => (
                <article class="related-story">
                  <a
                    class="related-story__image"
                    href={`/gazette/${article.slug}`}
                    aria-label={`Read ${article.headline}`}
                  >
                    <img
                      src={getArticleImage(
                        article.image_url
                      )}
                      alt={article.image_alt ?? ""}
                      width="900"
                      height="600"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>

                  <div class="related-story__content">
                    <p class="eyebrow">
                      {formatStoryCategory(article.category, article.subcategory)}
                    </p>

                    <h3>
                      <a
                        href={`/gazette/${article.slug}`}
                      >
                        {article.headline}
                      </a>
                    </h3>

                    {
                      article.published_at && (
                        <time
                          datetime={article.published_at}
                        >
                          {formatPublicationDateTime(
                            article.published_at
                          )}
                        </time>
                      )
                    }
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      )
    }
  </article>

  <script>
    import { Editor, Mark, Node, mergeAttributes } from "@tiptap/core";
    import StarterKit from "@tiptap/starter-kit";
    import Link from "@tiptap/extension-link";
    import { supabaseBrowser } from "../../lib/supabase-browser";
    import type { Json } from "../../types/database";

    const UnderlineMark = Mark.create({
      name: "underline",
      parseHTML: () => [{ tag: "u" }],
      renderHTML: ({ HTMLAttributes }) => [
        "u",
        mergeAttributes(HTMLAttributes),
        0,
      ],
    });

    const InlineImage = Node.create({
      name: "image",
      group: "block",
      atom: true,
      addAttributes: () => ({
        src: { default: null },
        alt: { default: "" },
        title: { default: null },
      }),
      parseHTML: () => [{ tag: "img[src]" }],
      renderHTML: ({ HTMLAttributes }) => [
        "img",
        mergeAttributes(HTMLAttributes, { loading: "lazy" }),
      ],
    });

    const shareButton =
      document.querySelector<HTMLButtonElement>(
        "#share-story"
      );

    const copyButton =
      document.querySelector<HTMLButtonElement>(
        "#copy-story-link"
      );

    const message =
      document.querySelector<HTMLElement>(
        "#article-action-message"
      );

    function setMessage(value: string): void {
      if (!message) {
        return;
      }

      message.textContent = value;

      window.setTimeout(() => {
        if (message.textContent === value) {
          message.textContent = "";
        }
      }, 3000);
    }

    shareButton?.addEventListener("click", async () => {
      const title =
        shareButton.dataset.title ??
        document.title;

      const url =
        shareButton.dataset.url ??
        window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({
            title,
            url,
          });
        } catch (error) {
          if (
            error instanceof DOMException &&
            error.name === "AbortError"
          ) {
            return;
          }

          setMessage(
            "The share menu could not be opened."
          );
        }

        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        setMessage("Story link copied.");
      } catch {
        setMessage(
          "Copy the address from your browser to share this story."
        );
      }
    });

    copyButton?.addEventListener("click", async () => {
      const url =
        copyButton.dataset.url ??
        window.location.href;

      try {
        await navigator.clipboard.writeText(url);
        setMessage("Story link copied.");
      } catch {
        setMessage(
          "The link could not be copied automatically."
        );
      }
    });

    const comments = document.querySelector<HTMLElement>("#article-comments");
    const viewTracker = document.querySelector<HTMLElement>("#article-view-tracker");

    function getVisitorKey(): string {
      const storageKey = "gazette-visitor-key";
      try {
        const existing = window.localStorage.getItem(storageKey);
        if (existing && existing.length >= 16) return existing;
        const generated = window.crypto?.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`;
        window.localStorage.setItem(storageKey, generated);
        return generated;
      } catch {
        return `${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }
    }

    async function trackArticleView(): Promise<void> {
      const articleId = viewTracker?.dataset.articleId;
      if (!articleId) return;
      await supabaseBrowser.rpc("track_gazette_article_view", {
        target_article_id: articleId,
        target_visitor_key: getVisitorKey(),
      });
    }

    void trackArticleView();

    const commentForm = document.querySelector<HTMLFormElement>("#comment-form");
    const commentsSignIn = document.querySelector<HTMLElement>("#comments-sign-in");
    const commentsMessage = document.querySelector<HTMLElement>("#comments-message");
    const commentEditors = new Map<HTMLElement, Editor>();

    function setCommentsMessage(value: string, isError = false): void {
      if (!commentsMessage) return;
      commentsMessage.textContent = value;
      commentsMessage.dataset.error = isError ? "true" : "false";
    }

    function updateCommentCount(editorElement: HTMLElement, editor: Editor): void {
      const count = editor.getText({ blockSeparator: "\n" }).trim().length;
      const counter = editorElement
        .closest("form")
        ?.querySelector<HTMLElement>("[data-comment-count]");

      if (counter) {
        counter.textContent = `${count.toLocaleString()} / 2,000 characters`;
      }
    }

    function updateCommentToolbar(editorElement: HTMLElement, editor: Editor): void {
      const toolbar = editorElement
        .closest("form")
        ?.querySelector<HTMLElement>(".comment-toolbar");

      toolbar?.querySelectorAll<HTMLButtonElement>("[data-comment-command]").forEach((button) => {
        const command = button.dataset.commentCommand;
        let active = false;
        let disabled = false;

        switch (command) {
          case "bold": active = editor.isActive("bold"); break;
          case "italic": active = editor.isActive("italic"); break;
          case "underline": active = editor.isActive("underline"); break;
          case "link": active = editor.isActive("link"); break;
          case "heading-2": active = editor.isActive("heading", { level: 2 }); break;
          case "heading-3": active = editor.isActive("heading", { level: 3 }); break;
          case "bullet-list": active = editor.isActive("bulletList"); break;
          case "ordered-list": active = editor.isActive("orderedList"); break;
          case "blockquote": active = editor.isActive("blockquote"); break;
          case "undo": disabled = !editor.can().chain().focus().undo().run(); break;
          case "redo": disabled = !editor.can().chain().focus().redo().run(); break;
        }

        button.classList.toggle("is-active", active);
        button.disabled = disabled;
        if (command !== "undo" && command !== "redo" && command !== "horizontal-rule") {
          button.setAttribute("aria-pressed", String(active));
        }
      });
    }

    function editCommentLink(editor: Editor): void {
      const currentHref = editor.getAttributes("link").href;
      const enteredUrl = window.prompt(
        "Enter the destination URL. Leave blank to remove the current link.",
        typeof currentHref === "string" ? currentHref : "https://",
      );

      if (enteredUrl === null) return;
      const url = enteredUrl.trim();
      if (!url) {
        editor.chain().focus().extendMarkRange("link").unsetLink().run();
        return;
      }

      editor.chain().focus().extendMarkRange("link").setLink({
        href: url,
        target: "_blank",
        rel: "noopener noreferrer",
      }).run();
    }

    function runCommentCommand(editor: Editor, command: string): void {
      switch (command) {
        case "bold": editor.chain().focus().toggleBold().run(); break;
        case "italic": editor.chain().focus().toggleItalic().run(); break;
        case "underline": editor.chain().focus().toggleMark("underline").run(); break;
        case "link": editCommentLink(editor); break;
        case "inline-image": {
          const source = window.prompt("Paste an image URL (https:// or a site-relative path).");
          if (!source) break;
          const url = source.trim();
          if (!(url.startsWith("https://") || url.startsWith("/"))) {
            setCommentsMessage("Images must use an https:// URL or a site-relative path.", true);
            break;
          }
          const alt = window.prompt("Add a short description for the image (optional).") ?? "";
          editor.chain().focus().insertContent({
            type: "image",
            attrs: { src: url, alt: alt.trim() },
          }).run();
          break;
        }
        case "heading-2": editor.chain().focus().toggleHeading({ level: 2 }).run(); break;
        case "heading-3": editor.chain().focus().toggleHeading({ level: 3 }).run(); break;
        case "bullet-list": editor.chain().focus().toggleBulletList().run(); break;
        case "ordered-list": editor.chain().focus().toggleOrderedList().run(); break;
        case "blockquote": editor.chain().focus().toggleBlockquote().run(); break;
        case "horizontal-rule": editor.chain().focus().setHorizontalRule().run(); break;
        case "undo": editor.chain().focus().undo().run(); break;
        case "redo": editor.chain().focus().redo().run(); break;
      }
      updateCommentToolbar(editor.options.element as HTMLElement, editor);
    }

    function initializeCommentEditors(): void {
      document.querySelectorAll<HTMLElement>("[data-comment-editor]").forEach((element) => {
        if (commentEditors.has(element)) return;

        let content: Record<string, unknown> | undefined;
        if (element.dataset.content) {
          try {
            content = JSON.parse(element.dataset.content) as Record<string, unknown>;
          } catch {
            content = undefined;
          }
        }

        const editor = new Editor({
          element,
          extensions: [
            StarterKit.configure({ heading: { levels: [2, 3] }, link: false, underline: false }),
            Link.configure({
              openOnClick: false,
              autolink: true,
              linkOnPaste: true,
              HTMLAttributes: { rel: "noopener noreferrer", target: "_blank" },
            }),
            UnderlineMark,
            InlineImage,
          ],
          content,
          editorProps: {
            attributes: {
              class: "comment-editor__surface",
              spellcheck: "true",
            },
          },
          onCreate: ({ editor: createdEditor }) => {
            updateCommentCount(element, createdEditor);
            updateCommentToolbar(element, createdEditor);
          },
          onUpdate: ({ editor: updatedEditor }) => {
            updateCommentCount(element, updatedEditor);
            updateCommentToolbar(element, updatedEditor);
          },
          onSelectionUpdate: ({ editor: selectedEditor }) => {
            updateCommentToolbar(element, selectedEditor);
          },
        });

        commentEditors.set(element, editor);

        element
          .closest("form")
          ?.querySelectorAll<HTMLButtonElement>("[data-comment-command]")
          .forEach((button) => {
            button.addEventListener("click", () => {
              const command = button.dataset.commentCommand;
              if (command) runCommentCommand(editor, command);
            });
          });
      });
    }

    function getCommentContent(form: HTMLFormElement): { body: Json; text: string } | null {
      const editorElement = form.querySelector<HTMLElement>("[data-comment-editor]");
      const editor = editorElement ? commentEditors.get(editorElement) : undefined;
      if (!editor) return null;

      const text = editor.getText({ blockSeparator: "\n" }).trim();
      if (!text || text.length > 2000) return null;
      return { body: editor.getJSON() as unknown as Json, text };
    }

    async function initializeComments(): Promise<void> {
      if (!comments || !commentForm || !commentsSignIn) return;

      const { data: { user } } = await supabaseBrowser.auth.getUser();
      if (!user) return;

      commentsSignIn.hidden = true;
      commentForm.hidden = false;
      initializeCommentEditors();

      document.querySelectorAll<HTMLElement>("[data-comment-user-id]").forEach((card) => {
        if (card.dataset.commentUserId === user.id) {
          card.querySelector<HTMLElement>("[data-edit-comment]")?.removeAttribute("hidden");
        }
      });
    }

    commentForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const submitButton = commentForm.querySelector<HTMLButtonElement>("button[type=submit]");
      const articleId = comments?.dataset.articleId;
      const content = getCommentContent(commentForm);
      if (!content || !articleId || !submitButton) {
        setCommentsMessage("Add a comment between 1 and 2,000 characters.", true);
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Posting…";
      const { data: { user } } = await supabaseBrowser.auth.getUser();
      if (!user) {
        setCommentsMessage("Sign in before posting a comment.", true);
        submitButton.disabled = false;
        submitButton.textContent = "Post comment";
        return;
      }

      const { error } = await supabaseBrowser.from("gazette_comments").insert({
        article_id: articleId,
        user_id: user.id,
        body: content.body,
      });

      if (error) {
        setCommentsMessage("Your comment could not be posted. Please try again.", true);
        submitButton.disabled = false;
        submitButton.textContent = "Post comment";
        return;
      }

      window.location.reload();
    });

    document.querySelectorAll<HTMLButtonElement>("[data-edit-comment]").forEach((editButton) => {
      editButton.addEventListener("click", () => {
        const card = editButton.closest<HTMLElement>("[data-comment-id]");
        const editForm = card?.querySelector<HTMLFormElement>("[data-edit-form]");
        if (!card || !editForm) return;
        editButton.hidden = true;
        card.querySelector<HTMLElement>("[data-comment-body]")?.setAttribute("hidden", "true");
        editForm.hidden = false;
        editForm.querySelector<HTMLElement>("[data-comment-editor]")?.focus();
      });
    });

    document.querySelectorAll<HTMLButtonElement>("[data-cancel-edit]").forEach((cancelButton) => {
      cancelButton.addEventListener("click", () => {
        const card = cancelButton.closest<HTMLElement>("[data-comment-id]");
        const editForm = card?.querySelector<HTMLFormElement>("[data-edit-form]");
        if (!card || !editForm) return;
        editForm.hidden = true;
        card.querySelector<HTMLElement>("[data-comment-body]")?.removeAttribute("hidden");
        card.querySelector<HTMLButtonElement>("[data-edit-comment]")?.removeAttribute("hidden");
      });
    });

    document.querySelectorAll<HTMLFormElement>("[data-edit-form]").forEach((editForm) => {
      editForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const card = editForm.closest<HTMLElement>("[data-comment-id]");
        const saveButton = editForm.querySelector<HTMLButtonElement>("button[type=submit]");
        const commentId = card?.dataset.commentId;
        const content = getCommentContent(editForm);
        if (!commentId || !content || !saveButton) {
          setCommentsMessage("Add a comment between 1 and 2,000 characters.", true);
          return;
        }

        saveButton.disabled = true;
        saveButton.textContent = "Saving…";
        const { error } = await supabaseBrowser
          .from("gazette_comments")
          .update({ body: content.body })
          .eq("id", commentId);

        if (error) {
          setCommentsMessage("Your comment could not be updated. Please try again.", true);
          saveButton.disabled = false;
          saveButton.textContent = "Save changes";
          return;
        }

        window.location.reload();
      });
    });

    void initializeComments();
  </script>
</BaseLayout>


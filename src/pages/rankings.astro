---
import BaseLayout from "../layouts/BaseLayout.astro";
import RankingJourney from "../components/history/RankingJourney.astro";
import { supabase } from "../lib/supabase";
import { buildComputerPoll } from "../lib/gazette/powerRankings";
export const prerender=false;
type GazetteEntry={teamId:string;teamName:string;rank:number;previousRank:number|null;record:string;pointsFor:number;note:string};
const db=supabase as any;
const {data:availableRows}=await supabase.from("team_weekly_results").select("season_year,week").in("result",["W","L","T"]).order("season_year",{ascending:false}).order("week",{ascending:false});
const seasons=[...new Set((availableRows??[]).map(row=>Number(row.season_year)).filter(year=>Number.isInteger(year)&&year>0))].sort((a,b)=>b-a);
const requestedSeason=Number(Astro.url.searchParams.get("season"));
const selectedSeason=seasons.includes(requestedSeason)?requestedSeason:seasons[0]??null;
const latestWeek=selectedSeason?Math.max(...(availableRows??[]).filter(row=>Number(row.season_year)===selectedSeason).map(row=>Number(row.week))):0;
const [{data:edition},{data:results},{data:lineups}]=selectedSeason?await Promise.all([
  db.from("power_rankings").select("season_year,week,title,entries,updated_at").eq("status","ready").eq("season_year",selectedSeason).order("week",{ascending:false}).limit(1).maybeSingle(),
  supabase.from("team_weekly_results").select("season_year,fantasy_team_id,team_name,week,points_for,point_differential,result").eq("season_year",selectedSeason).lte("week",latestWeek).in("result",["W","L","T"]),
  supabase.rpc("public_computer_poll_lineups",{target_season_year:selectedSeason,target_through_week:latestWeek}),
]):[{data:null},{data:[]},{data:[]}];
const computer=buildComputerPoll(results??[],latestWeek,lineups??[]);const previousComputer=latestWeek>1?buildComputerPoll(results??[],latestWeek-1,lineups??[]):[];const previousComputerByTeam=new Map(previousComputer.map(item=>[item.teamId,item.rank]));const gazette=(edition?.entries??[]) as GazetteEntry[];const computerByTeam=new Map(computer.map(item=>[item.teamId,item]));
---
<BaseLayout title="Power Rankings" description="The Computer Poll meets The Gazette Poll: performance data versus unapologetic editorial bias.">
  <main class="rankings-page site-shell">
    <header class="rankings-hero"><p class="eyebrow">Data Meets Editorial Mischief</p><h1>Power Rankings</h1><p>The Computer Poll follows the numbers. The Gazette Poll follows instinct, grudges, narrative convenience and whatever else the editorial board finds persuasive.</p>{selectedSeason&&<div><strong>{selectedSeason} Season · Through Week {latestWeek}</strong>{edition&&<span>{edition.title} · Week {edition.week}</span>}</div>}</header>
    {seasons.length>0&&<form class="season-picker" method="get"><label for="ranking-season">Season</label><select id="ranking-season" name="season" onchange="this.form.submit()">{seasons.map(season=><option value={season} selected={season===selectedSeason}>{season}</option>)}</select><noscript><button type="submit">View season</button></noscript></form>}
    {selectedSeason&&computer.length? <>
      <aside class="formula"><strong>Computer Poll formula</strong><span>25% League Win% · 25% Standard Win% · 25% Efficiency% · 25% CV Factor</span></aside>
      <section class="poll-grid">
        <div class="poll"><header><p class="eyebrow">No Feelings Allowed</p><h2>Computer Poll</h2></header>{computer.map(team=>{const previousRank=previousComputerByTeam.get(team.teamId);const movement=previousRank==null?null:previousRank-team.rank;return <article><b>{team.rank}</b><div><div class="poll-team-heading"><h3>{team.teamName}</h3><span class:list={["weekly-movement",movement&&movement>0&&"is-up",movement&&movement<0&&"is-down"]} title={previousRank==null?"No previous Computer Poll ranking":`Previously ranked ${previousRank}`}>{movement===null?"NEW":movement>0?`▲ ${movement}`:movement<0?`▼ ${Math.abs(movement)}`:"—"}</span></div><p>{team.record} · {team.score.toFixed(1)} rating</p></div><span>All-play {(team.leagueWinRate*100).toFixed(1)}% · Eff. {(team.efficiencyRate*100).toFixed(1)}%</span></article>})}</div>
        <div class="poll poll--gazette"><header><p class="eyebrow">Editorial Agenda</p><h2>Gazette Poll</h2>{edition&&<small>{edition.title} · Week {edition.week}</small>}</header>{gazette.length?gazette.map(team=>{const computerTeam=computerByTeam.get(team.teamId);const difference=computerTeam?computerTeam.rank-team.rank:0;const movement=team.previousRank==null?null:team.previousRank-team.rank;return <article><b>{team.rank}</b><div><div class="poll-team-heading"><h3>{team.teamName}</h3><span class:list={["weekly-movement",movement&&movement>0&&"is-up",movement&&movement<0&&"is-down"]} title={team.previousRank==null?"No previous Gazette Poll ranking":`Previously ranked ${team.previousRank}`}>{movement===null?"NEW":movement>0?`▲ ${movement}`:movement<0?`▼ ${Math.abs(movement)}`:"—"}</span></div><p>{team.note||"The editorial board declines to elaborate."}</p></div><span class:list={[difference>0&&"favored",difference<0&&"snubbed"]}>{computerTeam?difference===0?"Agrees":difference>0?`${difference} spot${difference===1?"":"s"} favored`:`${Math.abs(difference)} spot${difference===-1?"":"s"} snubbed`:"Unranked"}</span></article>}):<div class="poll-empty"><p class="eyebrow">From the archive</p><h3>No Gazette Poll was published for this season.</h3><p>The Computer Poll and its complete weekly journey are still available.</p></div>}</div>
      </section>
      <RankingJourney results={results??[]} season={selectedSeason} playerRows={lineups??[]} />
    </>:<section class="empty"><p class="eyebrow">Rankings Desk</p><h2>No completed seasons are available yet.</h2><p>The Computer Poll will appear as soon as completed matchup data is available.</p></section>}
  </main>
</BaseLayout>
<style>
  .rankings-page{padding-block:clamp(2.5rem,6vw,5rem) var(--space-9)}.rankings-hero{padding-bottom:2rem;border-bottom:3px double var(--color-rule-dark)}.rankings-hero h1{margin:.2rem 0;font-size:clamp(4rem,10vw,8rem)}.rankings-hero>p:last-of-type{max-width:55rem;color:var(--color-ink-soft);font-family:var(--font-editorial);font-size:1.25rem;line-height:1.5}.rankings-hero>div{display:flex;gap:1rem;margin-top:1.5rem}.rankings-hero>div span{color:var(--color-ink-soft)}.season-picker{display:flex;align-items:center;gap:.75rem;margin-top:1.5rem;padding:1rem;border:1px solid var(--color-rule-dark);border-top:5px solid var(--color-green);background:var(--color-surface)}.season-picker label{font-family:var(--font-data);font-size:.7rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.season-picker select,.season-picker button{min-height:2.5rem;padding:.5rem .8rem;border:1px solid var(--color-rule-dark);background:#fff;font-weight:800}.formula{display:flex;justify-content:space-between;gap:1rem;margin-block:1.5rem;padding:1rem;border:1px solid var(--color-rule);background:var(--color-surface)}.formula span{color:var(--color-ink-soft)}.poll-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.poll{border:1px solid var(--color-rule);background:var(--color-surface)}.poll>header{padding:1.5rem;border-bottom:3px solid var(--color-green)}.poll>header small{display:block;margin-top:.35rem;color:var(--color-ink-soft)}.poll--gazette>header{border-color:#9b352d}.poll h2{margin:0;font-size:2.5rem}.poll article{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;align-items:center;gap:1rem;padding:1rem;border-bottom:1px solid var(--color-rule)}.poll article:last-child{border-bottom:0}.poll article>b{font-family:var(--font-display);font-size:2rem;text-align:center}.poll h3,.poll article p{margin:0}.poll-team-heading{display:flex;align-items:center;gap:.5rem}.weekly-movement{flex:none;min-width:2rem;padding:.15rem .35rem;border:1px solid currentColor;color:var(--color-ink-soft);font-size:.6rem;font-weight:900;text-align:center}.weekly-movement.is-up{color:var(--color-green)}.weekly-movement.is-down{color:#9b352d}.poll article p{margin-top:.25rem;color:var(--color-ink-soft);font-size:.78rem;line-height:1.4}.poll article>span{max-width:8rem;color:var(--color-ink-soft);font-size:.68rem;font-weight:800;text-align:right;text-transform:uppercase}.poll article>span.favored{color:var(--color-green)}.poll article>span.snubbed{color:#9b352d}.poll-empty{display:flex;min-height:26rem;align-items:flex-start;justify-content:center;flex-direction:column;padding:clamp(2rem,5vw,4rem);background:linear-gradient(145deg,color-mix(in srgb,#9b352d 7%,transparent),transparent)}.poll-empty h3{max-width:24rem;margin:.25rem 0;font-size:clamp(1.8rem,3vw,3rem);line-height:1}.poll-empty>p:last-child{max-width:26rem;color:var(--color-ink-soft);line-height:1.5}.empty{padding:5rem 1rem;text-align:center}.empty h2{font-size:3rem}@media(max-width:850px){.poll-grid{grid-template-columns:1fr}.formula{flex-direction:column}}@media(max-width:520px){.poll article{grid-template-columns:2.5rem 1fr}.poll article>span{grid-column:2;text-align:left}}
</style>

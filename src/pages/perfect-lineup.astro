---
import BaseLayout from "../layouts/BaseLayout.astro";
import HistoryNav from "../components/history/HistoryNav.astro";
import LineupTable from "../components/LineupTable.astro";
import { buildPerfectLineup, getPlayerWeeklyScores } from "../lib/queries/playerScores";
import { getHistoricalResults } from "../lib/queries/records";
export const prerender = false;
const historicalResults = await getHistoricalResults();
const seasons = [...new Set(historicalResults.map((row) => row.season_year))].sort((a,b) => b-a);
const requestedSeason = Number(Astro.url.searchParams.get("season"));
const season = Number.isInteger(requestedSeason) && seasons.includes(requestedSeason) ? requestedSeason : seasons[0] ?? null;
const allScores = season ? await getPlayerWeeklyScores(season) : [];
const weeks = [...new Set(historicalResults.filter((row) => row.season_year === season).map((row) => row.week))].sort((a,b) => a-b);
const requestedWeek = Number(Astro.url.searchParams.get("week"));
const week = Number.isInteger(requestedWeek) && weeks.includes(requestedWeek) ? requestedWeek : weeks.at(-1) ?? null;
const lineup = buildPerfectLineup(allScores.filter((row) => row.season_year === season && row.week === week));
---
<BaseLayout title="Perfect Lineup" description="The highest-scoring legal fantasy lineup from every NFL player in a selected week.">
  <div class="perfect-page site-shell"><HistoryNav />
    <header><div><p class="eyebrow">The Weekly Ideal</p><h1>Perfect Lineup</h1><p>Every NFL player is eligible. The highest-scoring legal lineup wins—rostered, benched or sitting untouched in free agency.</p></div><div class="perfect-score"><span>{season ?? "—"} · Week {week ?? "—"}</span><strong>{lineup.reduce((sum,row)=>sum+row.points,0).toFixed(2)}</strong><small>perfect points</small></div></header>
    <form method="get" action="/perfect-lineup"><label>Season<select name="season">{seasons.map((value)=><option value={value} selected={value===season}>{value}</option>)}</select></label><label>Week<select name="week">{weeks.map((value)=><option value={value} selected={value===week}>Week {value}</option>)}</select></label><button>Build lineup</button></form>
    <section><div class="section-heading"><div><p class="eyebrow">Optimal Roster</p><h2>{season} Week {week}</h2></div><p>One QB, two RBs, two WRs, one TE, two FLEX players, one kicker and one defense. No player may appear twice in the same weekly lineup.</p></div>
      {lineup.length ? <LineupTable entries={lineup} caption={`${season} Week ${week} perfect lineup`} /> : <div class="empty"><h2>Player scores have not been imported for this week.</h2><p>Use the Sleeper Data desk to import all-player weekly scores.</p></div>}
    </section>
  </div>
</BaseLayout>
<style>
  .perfect-page{padding-top:clamp(2.5rem,6vw,5rem);padding-bottom:var(--space-9)}header{display:grid;grid-template-columns:minmax(0,1fr) minmax(15rem,22rem);align-items:end;gap:var(--space-7);padding-bottom:var(--space-7);border-bottom:3px double var(--color-rule-dark)}header h1{margin:.2rem 0;font-size:clamp(4rem,10vw,8rem);letter-spacing:-.07em;line-height:.84}header p:last-child{max-width:48rem;color:var(--color-ink-soft);font-family:var(--font-editorial);font-size:1.25rem;line-height:1.5}.perfect-score{display:grid;padding:2rem;border-top:5px solid var(--color-green);background:var(--color-green);color:white}.perfect-score span,.perfect-score small{font-family:var(--font-data);font-size:.65rem;letter-spacing:.07em;text-transform:uppercase}.perfect-score strong{font-family:var(--font-display);font-size:4rem;line-height:1}form{display:flex;align-items:end;gap:1rem;margin:var(--space-6) 0;padding:1.25rem;border:1px solid var(--color-rule);background:var(--color-surface)}form label{display:grid;gap:.35rem;font-family:var(--font-data);font-size:.62rem;font-weight:750;text-transform:uppercase}form select,form button{min-height:2.8rem;padding:.6rem .9rem;border:1px solid var(--color-rule-dark);background:white}form button{margin-left:auto;border-color:var(--color-green);background:var(--color-green);color:white;font-weight:750}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:var(--space-5);padding-bottom:var(--space-5);border-bottom:1px solid var(--color-rule-dark)}.section-heading h2{margin:0;font-size:3rem}.section-heading>p{max-width:34rem;color:var(--color-ink-muted);text-align:right}.empty{padding:3rem;border:1px dashed var(--color-rule-dark);text-align:center}@media(max-width:760px){header{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column}.section-heading>p{text-align:left}form{align-items:stretch;flex-direction:column}form button{margin-left:0}}
</style>

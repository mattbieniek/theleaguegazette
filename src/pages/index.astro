---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadStory from "../components/home/LeadStory.astro";
import SecondaryStory from "../components/home/SecondaryStory.astro";
import { getHomepageArticles } from "../lib/queries/gazette";
import GazetteRankings from "../components/gazette/GazetteRankings.astro";
import { getLatestPublishedPowerRanking } from "../lib/queries/powerRankings";
import LeagueOverview from "../components/home/LeagueOverview.astro";
import LeagueNotebook from "../components/home/LeagueNotebook.astro";
import LeagueWire from "../components/home/LeagueWire.astro";
import WeeklyScoreboard from "../components/home/WeeklyScoreboard.astro";
import { getAwardsPageData } from "../lib/queries/awards";
import { buildWeeklyAwards } from "../lib/gazette/awards";
import { getHistoricalResults } from "../lib/queries/records";
import { buildLeagueRecords } from "../lib/gazette/records";
import { seasonHistoryMetadata } from "../data/seasonHistory";
import { getTransactionArchive } from "../lib/queries/transactions";
import { getHomepageTransactionHighlights } from "../lib/gazette/transactionHighlights";
import { getHomepageLeagueData } from "../lib/queries/homepage";
import { ACTIVE_SLEEPER_LEAGUE_ID } from "../lib/currentLeague";
import { setPublicCache } from "../lib/public-cache";

export const prerender = false;
setPublicCache(Astro.response, 30, 300);

const currentYear = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  timeZone: "America/Chicago",
}).format(new Date());

const sleeperLeagueId = ACTIVE_SLEEPER_LEAGUE_ID;

const [
  stories,
  latestGazetteRanking,
  homepageLeagueData,
  awardsData,
  historicalResults,
  transactionArchive,
] = await Promise.all([
  getHomepageArticles(),
  getLatestPublishedPowerRanking(),
  sleeperLeagueId
    ? getHomepageLeagueData(sleeperLeagueId)
    : Promise.resolve({
        standings: [],
        matchupWeeks: [],
        seasonYear: null,
        usedFallback: false,
      }),
  getAwardsPageData(),
  getHistoricalResults(),
  getTransactionArchive(),
]);

const standings = homepageLeagueData.standings;
const matchupWeeks = homepageLeagueData.matchupWeeks;

const leadStory =
  stories.find((story) => story.is_featured) ??
  stories[0] ??
  null;

const secondaryStories = stories
  .filter((story) => story.id !== leadStory?.id)
  .slice(0, 2);

const fullSlateSize = matchupWeeks.reduce(
  (largest, matchupWeek) => Math.max(largest, matchupWeek.matchups.length),
  0
);
const homepageMatchupWeek = [...matchupWeeks]
  .reverse()
  .find((matchupWeek) => matchupWeek.matchups.length === fullSlateSize) ??
  matchupWeeks.at(-1) ??
  null;

const weeklyAwards = awardsData.selectedOption
  ? buildWeeklyAwards(
      awardsData.results,
      awardsData.selectedOption.week
    )
  : [];

const leagueRecords = buildLeagueRecords(historicalResults);
const reigningSeason = [...seasonHistoryMetadata]
  .filter((season) => season.champion)
  .sort((first, second) => second.year - first.year)[0] ?? null;
const transactionHighlights = getHomepageTransactionHighlights(
  transactionArchive
);
---

<BaseLayout
  description="The latest stories, analysis, standings and league coverage from Far Far Away Football."
>
  <div class="site-shell">
    <section
      class="front-page-intro"
      aria-labelledby="front-page-title"
    >
      <div class="front-page-intro__heading">
        <p class="eyebrow">
          The {currentYear} Season
        </p>

        <h1 id="front-page-title">
          Around the League
        </h1>
      </div>

      <div class="front-page-intro__description">
        <p>
          Reporting, analysis and deeply unnecessary commentary from
          Far Far Away Football.
        </p>

        <a href="/gazette">
          Browse the Gazette
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    {
      leadStory ? (
        <section
          class="top-stories"
          aria-labelledby="top-stories-title"
        >
          <h2 id="top-stories-title" class="sr-only">
            Top stories
          </h2>

          <div class="top-stories__lead">
            <LeadStory story={leadStory} />
          </div>

          {
            secondaryStories.length > 0 && (
              <aside
                class="top-stories__rail"
                aria-label="More top stories"
              >
                <div class="top-stories__rail-heading">
                  <p>Latest Headlines</p>

                  <span>
                    {secondaryStories.length}
                    {secondaryStories.length === 1
                      ? " story"
                      : " stories"}
                  </span>
                </div>

                <div class="top-stories__rail-list">
                  {
                    secondaryStories.map((story, index) => (
                      <SecondaryStory
                        story={story}
                        position={index + 1}
                      />
                    ))
                  }
                </div>

                <a
                  class="top-stories__archive-link"
                  href="/gazette"
                >
                  View all stories
                  <span aria-hidden="true">→</span>
                </a>
              </aside>
            )
          }
        </section>
      ) : (
        <section class="empty-state">
          <p class="eyebrow">Latest Edition</p>

          <h2>No stories have been published yet.</h2>

          <p>
            Published Gazette stories will appear here once they are
            available.
          </p>
        </section>
      )
    }
    <GazetteRankings ranking={latestGazetteRanking} context="homepage" />
    <WeeklyScoreboard matchupWeek={homepageMatchupWeek} />
    <LeagueOverview standings={standings} />
    <LeagueWire transactions={transactionHighlights} />
    <LeagueNotebook
      featuredAward={weeklyAwards[0] ?? null}
      awardWeek={awardsData.selectedOption?.week ?? null}
      awardSeason={awardsData.selectedOption?.seasonYear ?? null}
      featuredRecord={leagueRecords[0] ?? null}
      reigningSeason={reigningSeason}
    />
  </div>
</BaseLayout>

<style>
  .front-page-intro {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(18rem, 31rem);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
    padding-bottom: var(--space-6);
    border-bottom: 3px double var(--color-rule-dark);
  }

  .front-page-intro__heading {
    min-width: 0;
  }

  .front-page-intro__heading h1 {
    margin-bottom: 0;
    font-size: clamp(2.75rem, 6vw, 5.35rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .front-page-intro__description {
    justify-self: end;
    max-width: 31rem;
  }

  .front-page-intro__description p {
    margin-bottom: var(--space-4);
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.45;
  }

  .front-page-intro__description a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .front-page-intro__description a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .top-stories {
    display: grid;
    grid-template-columns:
      minmax(0, 1.55fr)
      minmax(20rem, 0.72fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: stretch;
    padding-top: var(--space-6);
  }

  .top-stories__lead {
    min-width: 0;
  }

  .top-stories__lead :global(.lead-story) {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: start;
    padding-top: 0;
    padding-bottom: 0;
  }

  .top-stories__lead :global(.lead-story__image-frame) {
    border-radius: var(--radius-lg);
  }

  .top-stories__lead :global(.lead-story__image-frame::after) {
    border-radius: inherit;
  }

  .top-stories__lead :global(.lead-story__content) {
    max-width: 55rem;
  }

  .top-stories__lead :global(.lead-story__headline) {
    max-width: 14ch;
    font-size: clamp(3rem, 6vw, 5.9rem);
  }

  .top-stories__rail {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding-left: clamp(1.5rem, 3vw, 2.75rem);
    border-left: 1px solid var(--color-rule);
  }

  .top-stories__rail-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-rule-dark);
  }

  .top-stories__rail-heading p {
    margin-bottom: 0;
    color: var(--color-ink);
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
    font-weight: 650;
    line-height: 1;
  }

  .top-stories__rail-heading span {
    color: var(--color-ink-muted);
    font-family: var(--font-data);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .top-stories__rail-list {
    display: grid;
  }

  .top-stories__rail-list
    > :global(article) {
    padding-block: var(--space-5);
  }

  .top-stories__rail-list
    > :global(article)
    + :global(article) {
    border-top: 1px solid var(--color-rule);
  }

  .top-stories__archive-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    margin-top: auto;
    border-top: 1px solid var(--color-rule-dark);
    color: var(--color-green);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .top-stories__archive-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .empty-state {
    max-width: 48rem;
    padding-block: var(--space-9);
  }

  .empty-state h2 {
    max-width: 14ch;
    margin-bottom: var(--space-5);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .empty-state > p:last-child {
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: var(--text-xl);
  }

  @media (max-width: 1060px) {
    .top-stories {
      grid-template-columns: 1fr;
    }

    .top-stories__rail {
      padding-top: var(--space-7);
      padding-left: 0;
      border-top: 3px double var(--color-rule-dark);
      border-left: 0;
    }

    .top-stories__rail-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }

    .top-stories__rail-list
      > :global(article)
      + :global(article) {
      padding-left: var(--space-6);
      border-top: 0;
      border-left: 1px solid var(--color-rule);
    }

    .top-stories__archive-link {
      margin-top: var(--space-2);
    }
  }

  @media (max-width: 780px) {
    .front-page-intro {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      align-items: start;
    }

    .front-page-intro__description {
      justify-self: start;
    }

    .top-stories__rail-list {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .top-stories__rail-list
      > :global(article)
      + :global(article) {
      padding-left: 0;
      border-top: 1px solid var(--color-rule);
      border-left: 0;
    }
  }

  @media (max-width: 560px) {
    .front-page-intro__heading h1 {
      font-size: clamp(2.7rem, 14vw, 4.2rem);
    }

    .top-stories__lead :global(.lead-story__headline) {
      font-size: clamp(2.7rem, 13vw, 4.3rem);
    }

    .top-stories__rail-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="site-shell">
    <section class="homepage-intro">
      <p class="eyebrow">The 2026 Season</p>

      <h1>The front page of Far Far Away Football.</h1>

      <p class="homepage-intro__summary">
        Weekly stories, league analysis, matchup coverage and an
        unreasonable amount of commentary about fantasy football.
      </p>
    </section>

    <hr class="section-rule" />

    <section
      class="homepage-placeholder surface-card"
      aria-labelledby="next-step-title"
    >
      <p class="eyebrow">Homepage vertical slice</p>

      <h2 id="next-step-title">
        The latest edition is coming next.
      </h2>

      <p>
        This space will become the lead story module from the approved
        editorial homepage design.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .homepage-intro {
    display: grid;
    max-width: 62rem;
    padding-block: clamp(1rem, 3vw, 3rem);
  }

  .homepage-intro h1 {
    max-width: 13ch;
    margin-bottom: var(--space-5);
    font-size: clamp(3.1rem, 8vw, 7.25rem);
    letter-spacing: -0.055em;
    line-height: 0.91;
  }

  .homepage-intro__summary {
    max-width: 42rem;
    margin-bottom: 0;
    color: var(--color-ink-soft);
    font-family: var(--font-editorial);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.35;
  }

  .homepage-placeholder {
    max-width: 52rem;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .homepage-placeholder h2 {
    max-width: 14ch;
    margin-bottom: var(--space-4);
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.035em;
  }

  .homepage-placeholder p:last-child {
    max-width: 35rem;
    margin-bottom: 0;
    color: var(--color-ink-soft);
  }
</style>
---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Draft | The League Gazette"><div class="shell placeholder"><div class="eyebrow">Version 1</div><h1>Draft</h1><div class="card"><h2>Page foundation ready</h2><p>This route is included in the prototype so the information architecture and navigation can be tested immediately. The next development pass will connect the appropriate Sleeper endpoints and reusable editorial components.</p><a class="button green" href="/">Return to the front page</a></div></div></BaseLayout><style>.placeholder{padding-top:60px;max-width:850px}.placeholder h1{font:700 clamp(3.5rem,9vw,7rem)/.9 Georgia,serif;margin:8px 0 32px}.placeholder .card{padding:35px;border-top:6px solid var(--green)}.placeholder h2{font:700 1.8rem Georgia,serif}.placeholder p{line-height:1.7;color:#555;max-width:650px;margin-bottom:24px}</style>

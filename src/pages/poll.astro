---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase";

type Team = { teamId: string; teamName: string; record: string };
type Ranking = { teamId: string; teamName: string; rank: number };
type Ballot = { id: string; user_id: string; rankings: Ranking[]; updated_at: string };
const db = supabase as any;
const { data: standingsData } = await db.from("season_standings").select("season_year,fantasy_team_id,team_name,wins,losses,ties,standings_rank").order("season_year",{ascending:false}).order("standings_rank");
const seasons: number[] = [...new Set<number>((standingsData??[]).map((row:any)=>Number(row.season_year)))];
const requestedSeason = Number(Astro.url.searchParams.get("season"));
const season = seasons.includes(requestedSeason) ? requestedSeason : (seasons[0] ?? new Date().getFullYear());
const requestedWeek = Number(Astro.url.searchParams.get("week"));
const { data: weekRows } = await db.from("team_weekly_results").select("week").eq("season_year",season).order("week",{ascending:false}).limit(1);
const latestWeek = Number(weekRows?.[0]?.week ?? 1);
const week = Number.isInteger(requestedWeek) && requestedWeek >= 1 && requestedWeek <= 17 ? requestedWeek : Math.min(latestWeek + (latestWeek < 17 ? 1 : 0),17);
const teams: Team[] = (standingsData??[]).filter((row:any)=>Number(row.season_year)===season).map((row:any)=>({teamId:String(row.fantasy_team_id),teamName:String(row.team_name),record:`${row.wins}-${row.losses}${Number(row.ties)?`-${row.ties}`:""}`}));
const [{ data: ballotsData }, { data: profilesData }, { data: windowData }, { data: previousData }] = await Promise.all([
  db.from("reader_power_ballots").select("id,user_id,rankings,updated_at").eq("season_year",season).eq("week",week).order("updated_at",{ascending:false}),
  db.from("public_reader_profiles").select("user_id,display_name"),
  db.from("reader_poll_windows").select("is_open,closes_at").eq("season_year",season).eq("week",week).maybeSingle(),
  week > 1 ? db.from("reader_power_ballots").select("rankings").eq("season_year",season).eq("week",week-1) : Promise.resolve({data:[]}),
]);
const ballots = (ballotsData??[]) as Ballot[];
const names = new Map((profilesData??[]).map((profile:any)=>[String(profile.user_id),String(profile.display_name)]));
function totalsFor(source: Array<{rankings:Ranking[]}>){const totals=new Map<string,{points:number;firsts:number;ballots:number}>();for(const ballot of source){for(const entry of ballot.rankings??[]){const item=totals.get(entry.teamId)??{points:0,firsts:0,ballots:0};item.points+=11-Number(entry.rank);item.firsts+=Number(entry.rank)===1?1:0;item.ballots++;totals.set(entry.teamId,item)}}return totals}
const totals=totalsFor(ballots),previousTotals=totalsFor((previousData??[]) as Array<{rankings:Ranking[]}>);
function orderFor(source:Map<string,{points:number;firsts:number}>){return [...source.entries()].sort((a,b)=>b[1].points-a[1].points||b[1].firsts-a[1].firsts).map(([id],index)=>[id,index+1] as const)}
const previousOrder=new Map(orderFor(previousTotals));
const combined=orderFor(totals).map(([teamId,rank])=>{const team=teams.find(item=>item.teamId===teamId);const item=totals.get(teamId)!;const prior=previousOrder.get(teamId);return{teamId,teamName:team?.teamName??"Unknown team",rank,points:item.points,firsts:item.firsts,movement:prior==null?null:prior-rank}});
const pollOpen = windowData ? Boolean(windowData.is_open) && (!windowData.closes_at || new Date(windowData.closes_at)>new Date()) : true;
const teamJson = JSON.stringify(teams).replaceAll("<","\\u003c");
---
<BaseLayout title="Gazette Readers Poll" description="Submit and explore the weekly public Far Far Away Football readers’ rankings.">
  <main class="poll-page site-shell">
    <header class="poll-header"><div><p class="eyebrow">The public ballot</p><h1>Gazette Readers Poll</h1></div><p>Every verified reader ranks all ten teams. First place earns 10 points, second earns 9, and tenth earns 1.</p></header>
    <form class="edition-picker" method="get"><label>Season<select name="season">{seasons.map(value=><option value={value} selected={value===season}>{value}</option>)}</select></label><label>Week<select name="week">{Array.from({length:17},(_,index)=>index+1).map(value=><option value={value} selected={value===week}>Week {value}</option>)}</select></label><button type="submit">View edition</button></form>

    <section class="poll-results"><header><div><p class="eyebrow">Combined vote</p><h2>{season} · Week {week}</h2></div><strong>{ballots.length} {ballots.length===1?"ballot":"ballots"}</strong></header>{combined.length?<ol>{combined.map(entry=><li><b>{entry.rank}</b><div><strong>{entry.teamName}</strong><small>{entry.points} points · {entry.firsts} first-place {entry.firsts===1?"vote":"votes"}</small></div><span class:list={[entry.movement&&entry.movement>0&&"up",entry.movement&&entry.movement<0&&"down"]}>{entry.movement==null?"NEW":entry.movement>0?`▲ ${entry.movement}`:entry.movement<0?`▼ ${Math.abs(entry.movement)}`:"—"}</span></li>)}</ol>:<p class="empty">No ballots yet. The first submission will establish this week’s Readers Poll.</p>}</section>

    <section class="ballot-builder" data-season={season} data-week={week} data-open={String(pollOpen)} data-teams={teamJson}>
      <header><div><p class="eyebrow">Your vote</p><h2>Rank all ten teams</h2></div><span>{pollOpen?"Ballot open":"Ballot closed"}</span></header>
      <p id="ballot-auth">Sign in or create a verified account to submit your ballot.</p><ol id="ballot-list"></ol><p id="ballot-message" role="status"></p><button id="save-ballot" type="button" disabled>Save my public ballot</button>
      <div class="ballot-account-links"><a href="/account/login">Sign in</a><a href="/account/register">Create account</a></div>
    </section>

    <section class="public-ballots"><header><p class="eyebrow">How everyone voted</p><h2>Public ballots</h2></header>{ballots.length?<div>{ballots.map(ballot=><article><h3>{names.get(ballot.user_id)??"Gazette Reader"}</h3><ol>{[...(ballot.rankings??[])].sort((a,b)=>a.rank-b.rank).map(entry=><li><b>{entry.rank}</b><span>{entry.teamName}</span></li>)}</ol></article>)}</div>:<p class="empty">Public ballots will appear here after readers vote.</p>}</section>
  </main>
  <script>
    import { supabaseBrowser } from "../lib/supabase-browser";
    type Team={teamId:string;teamName:string;record:string};type Entry=Team&{rank:number};
    const builder=document.querySelector<HTMLElement>(".ballot-builder"),list=document.querySelector<HTMLOListElement>("#ballot-list"),save=document.querySelector<HTMLButtonElement>("#save-ballot"),message=document.querySelector<HTMLElement>("#ballot-message"),authCopy=document.querySelector<HTMLElement>("#ballot-auth"),links=document.querySelector<HTMLElement>(".ballot-account-links");let entries:Entry[]=[],userId="";
    function render(){if(!list)return;list.replaceChildren();entries.forEach((entry,index)=>{entry.rank=index+1;const item=document.createElement("li"),rank=document.createElement("b"),copy=document.createElement("div"),name=document.createElement("strong"),record=document.createElement("small"),controls=document.createElement("span");rank.textContent=String(entry.rank);name.textContent=entry.teamName;record.textContent=entry.record;copy.append(name,record);for(const [label,direction] of [["Move up",-1],["Move down",1]] as const){const button=document.createElement("button");button.type="button";button.textContent=direction<0?"↑":"↓";button.title=label;button.disabled=(direction<0&&index===0)||(direction>0&&index===entries.length-1);button.addEventListener("click",()=>{const target=index+direction;[entries[index],entries[target]]=[entries[target],entries[index]];render()});controls.append(button)}item.append(rank,copy,controls);list.append(item)})}
    async function initialize(){if(!builder)return;const teams=JSON.parse(builder.dataset.teams??"[]") as Team[];entries=teams.map((team,index)=>({...team,rank:index+1}));const{data:{user}}=await supabaseBrowser.auth.getUser();if(!user){render();return}userId=user.id;links?.setAttribute("hidden","");if(authCopy)authCopy.textContent=`Signed in as ${user.email}. Your display name will appear publicly.`;const season=Number(builder.dataset.season),week=Number(builder.dataset.week);const{data}=await (supabaseBrowser as any).from("reader_power_ballots").select("rankings").eq("user_id",user.id).eq("season_year",season).eq("week",week).maybeSingle();if(data?.rankings){const order=new Map<string,number>(data.rankings.map((entry:any)=>[String(entry.teamId),Number(entry.rank)]));entries.sort((a,b)=>(order.get(a.teamId)??99)-(order.get(b.teamId)??99))}if(save)save.disabled=builder.dataset.open!=="true"||entries.length!==10;render()}
    save?.addEventListener("click",async()=>{if(!builder||!message||!userId)return;save.disabled=true;save.textContent="Saving…";const payload={user_id:userId,season_year:Number(builder.dataset.season),week:Number(builder.dataset.week),rankings:entries.map(({teamId,teamName,rank})=>({teamId,teamName,rank}))};const{error}=await (supabaseBrowser as any).from("reader_power_ballots").upsert(payload,{onConflict:"user_id,season_year,week"});save.textContent="Save my public ballot";save.disabled=false;message.textContent=error?error.message:"Ballot saved. Refreshing the public results…";if(!error)window.setTimeout(()=>window.location.reload(),700)});void initialize();
  </script>
</BaseLayout>
<style>
  .poll-page{padding-block:clamp(2.5rem,7vw,6rem)}.poll-header{display:grid;grid-template-columns:1.4fr .6fr;gap:2rem;align-items:end;padding-bottom:2rem;border-bottom:3px double var(--color-rule-dark)}.poll-header h1{margin:.2rem 0;font-size:clamp(3.5rem,8vw,7rem);line-height:.85}.poll-header>p{color:var(--color-ink-soft);font-family:var(--font-editorial);font-size:1.2rem;line-height:1.5}.edition-picker{display:flex;align-items:end;gap:1rem;padding-block:1.25rem}.edition-picker label{display:grid;gap:.3rem;font-weight:750}.edition-picker select,.edition-picker button{min-height:2.7rem;padding:.55rem .75rem;border:1px solid var(--color-rule-dark);background:var(--color-surface);font:inherit}.edition-picker button{background:var(--color-green);color:#fff;font-weight:800}.poll-results,.ballot-builder,.public-ballots{margin-top:1.5rem;border:1px solid var(--color-rule);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card);overflow:hidden}.poll-results>header,.ballot-builder>header,.public-ballots>header{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:1.3rem 1.5rem;border-bottom:1px solid var(--color-rule)}section h2{margin:.2rem 0;font-size:2.1rem}.poll-results>ol,#ballot-list{padding:0;margin:0;list-style:none}.poll-results li,#ballot-list li{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;align-items:center;gap:1rem;padding:.85rem 1.5rem;border-bottom:1px solid var(--color-rule)}.poll-results li>b,#ballot-list li>b{font-family:var(--font-editorial);font-size:2rem;text-align:center}.poll-results li div,#ballot-list li div{display:grid;gap:.15rem}.poll-results small,#ballot-list small{color:var(--color-ink-soft)}.poll-results span{font-family:var(--font-data);font-size:.7rem;font-weight:800}.up{color:#287545}.down{color:#a53631}.ballot-builder>p,.ballot-builder>button,.ballot-account-links{margin-inline:1.5rem}.ballot-builder>p{color:var(--color-ink-soft)}#ballot-list button{width:2.2rem;height:2.2rem;border:1px solid var(--color-rule-dark);background:transparent;font-weight:900}#save-ballot{margin-block:1rem 1.5rem;padding:.75rem 1rem;border:0;background:var(--color-green);color:#fff;font-weight:800}.ballot-account-links{display:flex;gap:1rem;margin-bottom:1.5rem}.public-ballots>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--color-rule)}.public-ballots article{padding:1.25rem;background:var(--color-surface)}.public-ballots article h3{margin:0 0 .8rem}.public-ballots article ol{display:grid;gap:.35rem;padding:0;margin:0;list-style:none}.public-ballots article li{display:grid;grid-template-columns:1.6rem 1fr;gap:.4rem;font-size:.82rem}.empty{padding:2rem;color:var(--color-ink-soft)}@media(max-width:800px){.poll-header{grid-template-columns:1fr}.public-ballots>div{grid-template-columns:1fr}.edition-picker{align-items:stretch;flex-direction:column}.edition-picker button{width:100%}}
</style>
